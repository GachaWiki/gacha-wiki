---
import { getFactionData } from '../../data/zone-nova/factions.js';
import { Image } from 'astro:assets';
import {
  ZNCharacterImage,
  ZNClassImage,
  ZNMemoryImage,
} from '../../components/zone-nova/index.astro';
import {
  highlightAllSkills,
  highlightSkillText,
  defaultZNHighlightPatterns,
} from '../../utils/zone-nova/skill-highlighting.js';
import { BUFF_EXPLANATIONS } from '../../data/zone-nova/memories.js';
import { getCharGallery } from '../../data/zone-nova/char-galleries.js';
import CharacterNavigation from '../../components/zone-nova/CharacterNavigation.astro';

interface Props {
  characterData: any;
}

const { characterData } = Astro.props;

// URL slug of this character page (e.g. /guides/zone-nova/characters/erika/ → erika)
// — used by the mobile side-tap navigation. Matches the index's slug/detailUrl.
const currentSlug = Astro.url.pathname.replace(/\/+$/, '').split('/').pop() ?? '';

// Story event artwork for this character (R2 gallery), if any exists
const gallery = getCharGallery(currentSlug);

// Buff/debuff tokens in the memory card's effect text that the text never defines
const memoryEffectText = (characterData.memoryCard?.effects ?? []).join('\n');
const memoryBuffNotes = Object.entries(BUFF_EXPLANATIONS)
  .filter(([token]) => memoryEffectText.includes(`[${token}]`))
  .map(([token, text]) => ({ token, text }));
const factionData = getFactionData(characterData.faction);
const ITEM_ICON_R2 = 'https://k2b1c5ab57ed98e51.gachawiki.info/zone-nova/items/';
const MONEY_ICON = `${ITEM_ICON_R2}General_Money.png`;

// Apply skill highlighting for better readability
const highlightedSkills = highlightAllSkills(characterData.skills, defaultZNHighlightPatterns);
const highlightedTeamSkill = characterData.teamSkill
  ? {
      ...characterData.teamSkill,
      description: highlightSkillText(
        characterData.teamSkill.description,
        defaultZNHighlightPatterns
      ),
    }
  : characterData.teamSkill;

// Apply highlighting to awakening effects
const highlightedAwakenings = characterData.awakenings
  ? characterData.awakenings.map(awakening => ({
      ...awakening,
      effect: highlightSkillText(awakening.effect, defaultZNHighlightPatterns),
    }))
  : characterData.awakenings;

// Per-level skill description variants for the level picker (Lv.1-14)
const DEFAULT_SKILL_LV = 14;
function levelDescriptions(skill) {
  if (!skill?.template || !skill?.levelValues) return null;
  return skill.levelValues.map((vals) =>
    highlightSkillText(
      skill.template.replace(/\{(\d+)\}/g, (m, i) => (i < vals.length ? vals[i] : m)),
      defaultZNHighlightPatterns
    )
  );
}
const skillLevelVariants = {
  normal: levelDescriptions(characterData.skills.normal),
  auto: levelDescriptions(characterData.skills.auto),
  ultimate: levelDescriptions(characterData.skills.ultimate),
  passive: levelDescriptions(characterData.skills.passive),
};
const hasSkillPicker = Object.values(skillLevelVariants).some(Boolean);

// Helper function to render skill with conditional state descriptions
function renderSkillWithState(skill, highlightedSkill) {
  const hasState = skill.frostAshDescription ||
                   (skill.description && skill.description.includes('【Frost Ash】'));

  if (hasState) {
    return {
      hasDescription: true,
      hasState: true,
      description: highlightedSkill.description,
      stateDescription: skill.frostAshDescription
        ? highlightSkillText(skill.frostAshDescription, defaultZNHighlightPatterns)
        : null,
      stateName: "【Frost Ash】State"
    };
  } else {
    return {
      hasDescription: true,
      hasState: false,
      description: highlightedSkill.description,
      stateDescription: null,
      stateName: null
    };
  }
}

// Helper function to categorize character tags for styling
function getTagCategory(tag: string): string {
  const lowerTag = tag.toLowerCase();

  // Damage/Scaling tags - Orange
  if (
    lowerTag.includes('def-scale') ||
    lowerTag.includes('hp scale') ||
    lowerTag.includes('scale') ||
    lowerTag.includes('crit rate') ||
    lowerTag.includes('crit dmg') ||
    lowerTag.includes('normal atk') ||
    lowerTag.includes('normal attack') ||
    lowerTag.includes('dot') ||
    lowerTag.includes('extra attack') ||
    lowerTag.includes('aoe') ||
    lowerTag.includes('enhanced ultimate') ||
    lowerTag.includes('penetration') ||
    lowerTag.includes('damage increase') ||
    lowerTag.includes('interrupt') ||
    lowerTag.includes('dot intake increases') ||
    lowerTag.includes('atk increase') ||
    lowerTag.includes('crit rate increase') ||
    lowerTag.includes('crit dmg increases') ||
    lowerTag.includes('atk increases') ||
    lowerTag.includes('hp-scale') ||
    lowerTag.includes('increase attack')
  ) {
    return 'damage-scaling';
  }

  // Team utility tags - Blue
  if (
    lowerTag.includes('shield') ||
    lowerTag.includes('buff') ||
    lowerTag.includes('healing') ||
    lowerTag.includes('debuff') ||
    lowerTag.includes('reduce') ||
    lowerTag.includes('inc skill cooldown') ||
    lowerTag.includes('revive') ||
    lowerTag.includes('increase max hp') ||
    lowerTag.includes('aoe healing') ||
    lowerTag.includes('stop ultimate') ||
    lowerTag.includes('revival') ||
    lowerTag.includes('reduced damage') ||
    lowerTag.includes('continuously heals') ||
    lowerTag.includes('healing damage increase') ||
    lowerTag.includes('vulnerability') ||
    lowerTag.includes('debuffer') ||
    lowerTag.includes('weakness')
  ) {
    return 'team-utility';
  }

  // Self utility tags - Green
  if (
    lowerTag.includes('damage reduction') ||
    lowerTag.includes('atk speed') ||
    lowerTag.includes('attack speed') ||
    lowerTag.includes('energy recovery') ||
    lowerTag.includes('hp consume') ||
    lowerTag.includes('cooldown reduction') ||
    lowerTag.includes('energy') ||
    lowerTag.includes('block') ||
    lowerTag.includes('speed attack')
  ) {
    return 'self-utility';
  }

  // General mechanic tags - Purple
  if (lowerTag.includes('melee') || lowerTag.includes('range')) {
    return 'general-mechanic';
  }

  // Default fallback
  return 'general-mechanic';
}
---

<!-- Mobile navigation instruction at top of main content -->
<div class="swipeable-indicator">Touch the sides to move between characters</div>
<CharacterNavigation currentCharacterSlug={currentSlug} />

<!-- Character Header & Overview -->
<section class="content-section character-overview-section">
  <h2 class="section-title character-overview-title">Character Overview</h2>
  <div class="character-overview-flex">
    <!-- Hero Card (Left) -->
    <div class="character-hero-card">
      <div class="character-hero-container">
        <div class="character-portrait-container">
          <ZNCharacterImage
            imageName={characterData.image}
            alt={`${characterData.name} - ${characterData.rarity} ${characterData.class} character from Zone Nova gacha game`}
            width={300}
            height={300}
            class="character-portrait"
          />
        </div>
        <h1 class="character-name">
          {characterData.name}
        </h1>
        <p class="character-class-info">
          {characterData.rarity}
          {characterData.class}
        </p>
        <p class="character-faction-info">
          {factionData?.name || characterData.faction}
          {factionData?.chineseName && `(${factionData.chineseName})`}
        </p>
        {
          factionData?.description && (
            <p class="character-faction-description">{factionData.description}</p>
          )
        }
      </div>

      <!-- Character Info -->
      <div class="character-info-card">
        <div class="character-info-grid">
          <div class="character-info-item">
            <div class="character-info-label">Class</div>
            <span
              class={`class-badge ${characterData.class ? characterData.class.toLowerCase() : 'unknown'}`}
              >{characterData.class || 'TBA'}</span
            >
          </div>
          <div class="character-info-item">
            <div class="character-info-label">Rarity</div>
            <span class={`rarity-badge ${characterData.rarity.toLowerCase()}`}
              >{characterData.rarity}</span
            >
          </div>
          <div class="character-info-item">
            <div class="character-info-label">Element</div>
            <span class={`element-badge ${characterData.element.toLowerCase()}`}
              >{characterData.element}</span
            >
          </div>
          <div class="character-info-item">
            <div class="character-info-label">Role</div>
            <span
              class={`role-badge ${characterData.role ? characterData.role.toLowerCase() : 'unknown'}`}
              >{characterData.role || 'TBA'}</span
            >
          </div>
          <div class="faction-section">
            <div class="character-info-label">Faction</div>
            <span
              class={`faction-badge ${(factionData?.name || characterData.faction).toLowerCase().replace(/\s+/g, '-').replace(/\./g, '')}`}
              style={factionData?.color
                ? `background-color: ${factionData.color}; border: 2px solid ${factionData.color}; color: white; font-weight: 700; padding: 0.5rem 1rem; border-radius: 8px; display: inline-block; box-shadow: 0 2px 8px ${factionData.color}40; text-shadow: 0 1px 2px rgba(0,0,0,0.3);`
                : 'background-color: var(--neutral-50); border: 2px solid var(--text-secondary); color: var(--text-secondary); font-weight: 700; padding: 0.5rem 1rem; border-radius: 8px; display: inline-block;'}
            >
              {factionData?.name || characterData.faction}
              {
                factionData?.chineseName && (
                  <span class="faction-chinese-name">({factionData.chineseName})</span>
                )
              }
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Complete Stats Box (Right) -->
    <div class="character-stats-container">
      <div class="character-stats-box">
        <!-- Base + Max Stats -->
        <h3 class="character-stats-title">Character Stats</h3>

        <!-- Core Combat Stats -->
        <h4 class="character-stats-subtitle">Core Combat Stats</h4>
        <div class="character-stats-grid">
          <div class="stat-item">
            <div class="stat-label">HP</div>
            <div class="stat-value">
              {characterData.stats.hp}
            </div>
            {characterData.maxStats && (
              <div class="stat-value stat-max">Max: {characterData.maxStats.hp}</div>
            )}
          </div>
          <div class="stat-item">
            <div class="stat-label">Attack</div>
            <div class="stat-value">
              {characterData.stats.attack}
            </div>
            {characterData.maxStats && (
              <div class="stat-value stat-max">Max: {characterData.maxStats.attack}</div>
            )}
          </div>
          <div class="stat-item">
            <div class="stat-label">Defense</div>
            <div class="stat-value">
              {characterData.stats.defense}
            </div>
            {characterData.maxStats && (
              <div class="stat-value stat-max">Max: {characterData.maxStats.defense}</div>
            )}
          </div>
        </div>
        {characterData.maxStats && (
          <p class="stat-max-note">Max values are base stats with the full talent tree unlocked.</p>
        )}

        <!-- Additional Stats -->
        <h4 class="character-stats-subtitle">Additional Stats</h4>
        <div class="character-stats-grid additional-stats">
          <div class="stat-item">
            <div class="stat-label small">Energy Regen</div>
            <div class="stat-value small">0.25/s</div>
          </div>
          <div class="stat-item">
            <div class="stat-label small">Crit Rate</div>
            <div class="stat-value small">
              {characterData.stats?.critRate ? `${characterData.stats.critRate}` : '0%'}
            </div>
            {characterData.stats?.maxCritRate != null && characterData.stats.maxCritRate !== '0%' && (
              <div class="stat-value small stat-max">Max: {characterData.stats.maxCritRate}</div>
            )}
          </div>
          <div class="stat-item">
            <div class="stat-label small">Crit Damage</div>
            <div class="stat-value small">
              {characterData.stats?.critDmg ? `${characterData.stats.critDmg}` : '50%'}
            </div>
            {characterData.stats?.maxCritDmg != null && characterData.stats.maxCritDmg !== '50%' && (
              <div class="stat-value small stat-max">Max: {characterData.stats.maxCritDmg}</div>
            )}
          </div>
        </div>

        <!-- Class Section -->
        <h4 class="character-class-section character-stats-subtitle">Class</h4>
        <div class="character-class-box">
          <ZNClassImage
            className={characterData.class}
            alt={`${characterData.class} class icon`}
            size="medium"
            class="character-class-icon"
          />
          <div class="character-class-content">
            <div class="character-class-badges">
              <span
                class={`class-badge ${characterData.class ? characterData.class.toLowerCase() : 'unknown'}`}
                >{characterData.class || 'TBA'}</span
              >
            </div>
            <p class="character-class-compatibility">
              Memory Compatibility: <strong class="character-class-highlight"
                >{characterData.class}</strong
              > class only
            </p>
          </div>
        </div>

        <!-- Character Tags Section -->
        {
          characterData.tags && characterData.tags.length > 0 && (
            <div class="character-tags-container">
              <div class="character-tags-label">Gameplay Tags</div>
              <div class="character-tags-wrapper">
                {characterData.tags.map((tag: string) => (
                  <span class={`character-tag ${getTagCategory(tag)}`}>{tag}</span>
                ))}
              </div>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>

<!-- Skills Section -->
<section class="content-section skills-section">
  <h2 class="section-title">Skills</h2>

  {
    hasSkillPicker && (
      <div class="skill-level-picker">
        <span class="picker-label">Skill Level</span>
        <div class="picker-pills" role="group" aria-label="Skill level selector">
          {Array.from({ length: 14 }, (_, i) => i + 1).map((n) => (
            <button
              type="button"
              class={`lv-pill${n === DEFAULT_SKILL_LV ? ' active' : ''}`}
              data-lv={n}
              title={n >= 13 ? 'Requires Dupe 5 awakening' : n >= 11 ? 'Requires Dupe 3 awakening' : ''}
            >
              {n}
              {n === 11 && <sup class="pill-mark">D3</sup>}
              {n === 13 && <sup class="pill-mark">D5</sup>}
            </button>
          ))}
        </div>
      </div>
    )
  }

  {
    (() => {
      const normalSkillData = renderSkillWithState(characterData.skills.normal, highlightedSkills.normal);
      return (
        <div class="skill-card normal-attack">
          <div class="skill-header">
            <h3 class="skill-title">
              {characterData.skills.normal.name}
            </h3>
            <span class="skill-badge normal-attack"> Normal Attack </span>
          </div>
          {normalSkillData.hasDescription && (skillLevelVariants.normal ? (
            <div class="skill-levels">
              {skillLevelVariants.normal.map((html, i) => (
                <div
                  class={`skill-description skill-lv${i + 1 === DEFAULT_SKILL_LV ? ' active' : ''}`}
                  data-lv={i + 1}
                  set:html={html}
                />
              ))}
            </div>
          ) : (
            <p class="skill-description" set:html={normalSkillData.description} />
          ))}
          {normalSkillData.hasState && normalSkillData.stateDescription && (
            <div class="skill-state-section">
              <h4 class="skill-state-title">{normalSkillData.stateName}</h4>
              <p class="skill-state-description" set:html={normalSkillData.stateDescription} />
            </div>
          )}
        </div>
      );
    })()
  }

  {
    (() => {
      const autoSkillData = renderSkillWithState(characterData.skills.auto, highlightedSkills.auto);
      return (
        <div class="skill-card auto-skill">
          <div class="skill-header">
            <h3 class="skill-title">
              {characterData.skills.auto.name}
            </h3>
            <div class="skill-meta">
              <span class="skill-badge auto-skill"> Auto Skill </span>
              <span class="skill-cooldown">
                Cooldown: {characterData.skills.auto.cooldown}
              </span>
            </div>
          </div>
          {autoSkillData.hasDescription && (skillLevelVariants.auto ? (
            <div class="skill-levels">
              {skillLevelVariants.auto.map((html, i) => (
                <div
                  class={`skill-description skill-lv${i + 1 === DEFAULT_SKILL_LV ? ' active' : ''}`}
                  data-lv={i + 1}
                  set:html={html}
                />
              ))}
            </div>
          ) : (
            <p class="skill-description" set:html={autoSkillData.description} />
          ))}
          {autoSkillData.hasState && autoSkillData.stateDescription && (
            <div class="skill-state-section">
              <h4 class="skill-state-title">{autoSkillData.stateName}</h4>
              <p class="skill-state-description" set:html={autoSkillData.stateDescription} />
            </div>
          )}
        </div>
      );
    })()
  }

  {
    (() => {
      const ultimateSkillData = renderSkillWithState(characterData.skills.ultimate, highlightedSkills.ultimate);
      const hasAdditionalRules = characterData.skills.ultimate.additionalRules &&
                                characterData.skills.ultimate.additionalRules.length > 0;

      return (
        <div class="skill-card ultimate">
          <div class="skill-header">
            <h3 class="skill-title">
              {characterData.skills.ultimate.name}
            </h3>
            <div class="skill-meta">
              <span class="skill-badge ultimate"> Ultimate </span>
              <span class="skill-cost">
                Cost: {characterData.skills.ultimate.energyCost}
              </span>
            </div>
          </div>
          {ultimateSkillData.hasDescription && (skillLevelVariants.ultimate ? (
            <div class="skill-levels">
              {skillLevelVariants.ultimate.map((html, i) => (
                <div
                  class={`skill-description skill-lv${i + 1 === DEFAULT_SKILL_LV ? ' active' : ''}`}
                  data-lv={i + 1}
                  set:html={html}
                />
              ))}
            </div>
          ) : (
            <p class="skill-description" set:html={ultimateSkillData.description} />
          ))}
          {ultimateSkillData.hasState && ultimateSkillData.stateDescription && (
            <div class="skill-state-section">
              <h4 class="skill-state-title">{ultimateSkillData.stateName}</h4>
              <p class="skill-state-description" set:html={ultimateSkillData.stateDescription} />
            </div>
          )}
          {hasAdditionalRules && (
            <div class="skill-additional-rules">
              <h4 class="skill-additional-rules-title">Additional Rules</h4>
              <ul class="skill-additional-rules-list">
                {characterData.skills.ultimate.additionalRules.map((rule) => (
                  <li class="skill-additional-rule-item" set:html={highlightSkillText(rule, defaultZNHighlightPatterns)} />
                ))}
              </ul>
            </div>
          )}
        </div>
      );
    })()
  }

  {
    (() => {
      const passiveSkillData = renderSkillWithState(characterData.skills.passive, highlightedSkills.passive);
      return (
        <div class="skill-card passive">
          <div class="skill-header">
            <h3 class="skill-title">
              {characterData.skills.passive.name}
            </h3>
            <span class="skill-badge passive"> Passive </span>
          </div>
          {passiveSkillData.hasDescription && (skillLevelVariants.passive ? (
            <div class="skill-levels">
              {skillLevelVariants.passive.map((html, i) => (
                <div
                  class={`skill-description skill-lv${i + 1 === DEFAULT_SKILL_LV ? ' active' : ''}`}
                  data-lv={i + 1}
                  set:html={html}
                />
              ))}
            </div>
          ) : (
            <p class="skill-description" set:html={passiveSkillData.description} />
          ))}
          {passiveSkillData.hasState && passiveSkillData.stateDescription && (
            <div class="skill-state-section">
              <h4 class="skill-state-title">{passiveSkillData.stateName}</h4>
              <p class="skill-state-description" set:html={passiveSkillData.stateDescription} />
            </div>
          )}
        </div>
      );
    })()
  }

  <!-- Team Skill -->
  <div class="skill-card team-skill">
    <div class="skill-header">
      <h3 class="skill-title">
        {characterData.teamSkill.name}
      </h3>
      <span class="skill-badge team-skill"> Team Skill </span>
    </div>
    <p class="skill-description" set:html={highlightedTeamSkill.description} />
    <div class="team-skill-requirements">
      <strong>Requires:</strong>
      <span>
        2 {characterData.teamSkill.requirements.faction} OR 2 {
          characterData.teamSkill.requirements.element
        } characters</span
      >
    </div>
  </div>

  <script>
    const pills = document.querySelectorAll('.skill-level-picker .lv-pill');
    const variants = document.querySelectorAll('.skill-levels .skill-lv');
    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        pills.forEach((p) => p.classList.toggle('active', p === pill));
        const lv = pill.getAttribute('data-lv');
        variants.forEach((v) => v.classList.toggle('active', v.getAttribute('data-lv') === lv));
      });
    });
  </script>
</section>

<!-- Damage Analysis Section (if available) -->
{characterData.damageAnalysis && (
  <section class="content-section damage-analysis-section">
    <h2 class="section-title">{characterData.damageAnalysis.title}</h2>
    <p class="damage-analysis-description">{characterData.damageAnalysis.description}</p>

    <div class="damage-breakdown-container">
      <h3 class="damage-breakdown-title">Debuff Breakdown</h3>
      <div class="damage-breakdown-table">
        <div class="damage-breakdown-header">
          <span class="breakdown-col source">Source</span>
          <span class="breakdown-col value">Value</span>
          <span class="breakdown-col type">Type</span>
          <span class="breakdown-col duration">Duration</span>
        </div>
        {characterData.damageAnalysis.breakdown.map((item) => (
          <div class="damage-breakdown-row">
            <span class="breakdown-col source">{item.source}</span>
            <span class="breakdown-col value highlight">{item.value}</span>
            <span class="breakdown-col type">{item.type}</span>
            <span class="breakdown-col duration">{item.duration}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="damage-totals-container">
      <h3 class="damage-totals-title">Total Debuffs</h3>
      <div class="damage-totals-grid">
        {characterData.damageAnalysis.totals.map((total) => (
          <div class="damage-total-card">
            <div class="damage-total-label">{total.label}</div>
            <div class="damage-total-value">{total.value}</div>
            <div class="damage-total-calculation">{total.calculation}</div>
            {total.note && <div class="damage-total-note">{total.note}</div>}
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<!-- Talent Tree Section -->
<section class="content-section">
  <h2 class="section-title">Talent Tree</h2>

  {
    characterData.talentTree ? (
      <>
        <!-- Full tree totals -->
        <div class="talent-totals-box">
          <h3 class="talent-totals-title">
            Complete Tree Grants ({characterData.name}):
          </h3>
          <div class="talent-totals-grid">
            {characterData.talentTree.totals.map((t) => (
              <span class="talent-total-badge">{t}</span>
            ))}
          </div>
          <p class="talent-totals-note">
            Max stats shown above are calculated with every node unlocked. The E-nodes and the 10 stat
            nodes below are this character's actual tree — materials come from the elemental dungeon
            and weekly shops.
          </p>
        </div>

        <!-- 1. Skill Enhancement Nodes -->
        <h3 class="node-section-title">1. Enhancement Nodes (E1 - E3)</h3>
        <p class="node-section-subtitle">
          The biggest boosts in the tree - unlock them first. Bonuses vary per character:
        </p>
        <div class="talent-e-nodes">
          {characterData.talentTree.enhancementNodes.map((e) => (
            <div class={`node-tier tier-${e.rank <= 2 ? 1 : e.rank <= 4 ? 2 : 3}`}>
              <div class="node-tier-content">
                <div class="node-tier-title">{e.bonus}</div>
                <div class="node-tier-requirement">Rank {e.rank} Required</div>
                {e.materials?.length > 0 && (
                  <div class="node-tier-materials">
                    {e.materials.map((m) => (
                      <span class="talent-mat">
                        {m.icon && <img src={`${ITEM_ICON_R2}${m.icon}`} alt={m.name} width={18} height={18} loading="lazy" />}
                        {m.name} ×{m.amount}
                      </span>
                    ))}
                    <span class="talent-mat">
                      <img src={MONEY_ICON} alt="Aether Points" width={18} height={18} loading="lazy" />
                      {e.gold.toLocaleString()}
                    </span>
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>

        <!-- 2. Stat Nodes -->
        <h3 class="node-section-title">2. Stat Nodes (N1 - N10)</h3>
        <p class="node-section-subtitle">
          10 nodes tailored to this character's kit. The last two are level-gated capstones.
        </p>
        <div class="talent-table-wrap">
          <table class="talent-table">
            <thead>
              <tr>
                <th>Node</th><th>Stat Bonus</th><th>Unlock</th><th>Materials</th>
                <th><span class="th-cost"><img src={MONEY_ICON} alt="Aether Points" width={16} height={16} loading="lazy" /> Aether Points</span></th>
              </tr>
            </thead>
            <tbody>
              {characterData.talentTree.statNodes.map((s) => (
                <tr>
                  <td class="talent-node-id">{s.node}</td>
                  <td class="talent-node-stat">{s.stat}</td>
                  <td data-label="Unlock">{s.unlock}</td>
                  <td class="talent-node-mats" data-label="Materials">
                    {s.materials?.length
                      ? s.materials.map((m) => (
                          <span class="talent-mat">
                            {m.icon && <img src={`${ITEM_ICON_R2}${m.icon}`} alt={m.name} width={18} height={18} loading="lazy" />}
                            {m.name} ×{m.amount}
                          </span>
                        ))
                      : '—'}
                  </td>
                  <td class="talent-node-cost">
                    <img src={MONEY_ICON} alt="Aether Points" width={16} height={16} loading="lazy" />
                    {s.gold.toLocaleString()}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- 3. Branch Levels -->
        <h3 class="node-section-title">3. Skill Branch Levels</h3>
        <p class="node-section-subtitle">
          Each of the 4 branches (Normal Attack, Auto Skill, Ultimate, Passive) levels up to{' '}
          <strong>14</strong> — the cap starts at 10, and Awakenings at Dupe 3 and Dupe 5 each raise it
          by +2. Costs below are per level and identical for all four branches (levels 2-10 from game
          data).
        </p>
        <div class="talent-table-wrap">
          <table class="talent-table">
            <thead>
              <tr>
                <th>Branch Level</th>
                <th><span class="th-cost"><img src={MONEY_ICON} alt="Aether Points" width={16} height={16} loading="lazy" /> Aether Points</span></th>
                <th>Materials</th>
              </tr>
            </thead>
            <tbody>
              {characterData.talentTree.levels.map((l) => (
                <tr>
                  <td class="talent-node-id">{l.level}</td>
                  <td class="talent-node-cost">
                    <img src={MONEY_ICON} alt="Aether Points" width={16} height={16} loading="lazy" />
                    {l.gold.toLocaleString()}
                  </td>
                  <td class="talent-node-mats" data-label="Materials">
                    {l.materials?.length
                      ? l.materials.map((m) => (
                          <span class="talent-mat">
                            {m.icon && <img src={`${ITEM_ICON_R2}${m.icon}`} alt={m.name} width={18} height={18} loading="lazy" />}
                            {m.name} ×{m.amount}
                          </span>
                        ))
                      : '—'}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    ) : (
      <p class="node-section-subtitle">Talent tree data not yet extracted for this character.</p>
    )
  }
</section>

<!-- Awakening Effects -->
<section class="content-section awakening-section">
  <h2 class="section-title">Awakening Effects</h2>
  {
    highlightedAwakenings.map((awakening, index) => (
      <div class={`awakening-card dupe-${awakening.level}`}>
        <div class="awakening-header">
          <h3 class="awakening-title">
            Dupe <span class="awakening-level-number">{awakening.level}</span>
          </h3>
        </div>
        <p class="awakening-description">
          <strong>Effect:</strong> <span set:html={awakening.effect} />
        </p>
      </div>
    ))
  }
</section>

<!-- Memory Card Section -->
<section class="content-section memory-card-section">
  <h2 class="section-title memory-card-title">
    Memory Card: {characterData.memoryCard.name}
  </h2>

  <div class="memory-card-flex">
    <!-- Memory Card Image (Left) -->
    <div class="memory-card-image-container">
      <div class="memory-card-image-box">
        <div class="memory-card-image-wrapper">
          <ZNMemoryImage
            imageName={characterData.memoryCard.image}
            alt={characterData.memoryCard.name}
            width={200}
            height={300}
          />
        </div>
      </div>
    </div>

    <!-- Memory Stats (Right) -->
    <div class="memory-card-stats-container">
      <div class="memory-card-stats-box">
        <h3 class="memory-card-stats-title">Memory Card Stats (Lv.80 Max)</h3>

        <div class="character-stats-grid">
          <div class="stat-item">
            <div class="stat-label">HP</div>
            <div class="stat-value">
              {characterData.memoryCard.stats.hp}
            </div>
          </div>
          <div class="stat-item">
            <div class="stat-label">Attack</div>
            <div class="stat-value">
              {characterData.memoryCard.stats.attack}
            </div>
          </div>
          <div class="stat-item">
            <div class="stat-label">Defense</div>
            <div class="stat-value">
              {characterData.memoryCard.stats.defense}
            </div>
          </div>
        </div>

        <!-- Memory Effects -->
        <h4 class="memory-effects-title">Memory Effects</h4>
        {characterData.memoryCard.effects.length === 5 ? (
          <div class="mem-awaken">
            <div class="mem-awaken-picker">
              <span class="mem-awaken-label">Awakening</span>
              <div class="mem-awaken-pills" role="group" aria-label="Memory awakening level selector">
                {characterData.memoryCard.effects.map((_, i) => (
                  <button
                    type="button"
                    class={`mem-awaken-pill${i === 4 ? ' active' : ''}`}
                    data-awaken={i + 1}
                  >
                    {i + 1}
                  </button>
                ))}
              </div>
            </div>
            <div class="mem-awaken-variants">
              {characterData.memoryCard.effects.map((levelText, i) => (
                <div
                  class={`memory-effect-item mem-awaken-variant${i === 4 ? ' active' : ''}`}
                  data-awaken={i + 1}
                >
                  {levelText.split('\n').filter(Boolean).map(par => (
                    <p class="memory-effect-text">{par}</p>
                  ))}
                </div>
              ))}
            </div>
          </div>
        ) : (
          characterData.memoryCard.effects.map(effect => (
            <div class="memory-effect-item">
              <p class="memory-effect-text">• {effect}</p>
            </div>
          ))
        )}
        {memoryBuffNotes.length > 0 && (
          <div class="mem-buff-reference">
            <span class="mem-buff-title">Buff Reference</span>
            {memoryBuffNotes.map(n => (
              <p class="mem-buff-note">
                <strong>[{n.token}]:</strong> {n.text}
              </p>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>

  <!-- Equipment Limitation -->
  <div class="equipment-limitation">
    <div class="equipment-limitation-content">
      <!-- Title -->
      <div class="equipment-limitation-title-container">
        <h4 class="equipment-limitation-title">⚠️ Equipment Limitation</h4>
      </div>

      <!-- Content Layout: Image Left, Text Right -->
      {
        characterData.class && (
          <div class="equipment-limitation-layout">
            {/* Image on Left */}
            <div class="equipment-limitation-image">
              <ZNClassImage
                className={characterData.class}
                alt={characterData.class}
                size="large"
              />
            </div>

            {/* Content on Right */}
            <div class="equipment-limitation-text">
              <h5 class="equipment-limitation-class">{characterData.class} Class Only</h5>
              <p class="equipment-limitation-description">
                This memory card is restricted to <strong>{characterData.class}</strong> class
                characters only.
              </p>
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>

{/* Image Gallery Section (story event artwork) */}
{gallery && gallery.length > 0 && (
  <section class="content-section character-gallery-section">
    <h2 class="section-title character-gallery-title">Image Gallery</h2>
    <div class="character-gallery-grid">
      {gallery.map((ev) => (
        <figure class="character-gallery-item">
          <div class="character-gallery-image-box">
            <img
              src={ev.image}
              alt={`${characterData.name} ${ev.label} artwork${ev.title ? `: ${ev.title}` : ''}`}
              width={ev.w}
              height={ev.h}
              loading="lazy"
              class={ev.w / ev.h < 1.4 ? 'character-gallery-img-square' : ''}
            />
          </div>
          <figcaption class="character-gallery-caption">
            <span class="character-gallery-label">{ev.label}</span>
            {ev.title && <span class="character-gallery-event-title">{ev.title}</span>}
          </figcaption>
        </figure>
      ))}
    </div>
    <p class="character-gallery-note">
      Awakened form and event artwork for {characterData.name}.
    </p>
  </section>
)}

  <!-- Memory awakening picker -->
  <script>
    const memPills = document.querySelectorAll('.mem-awaken-picker .mem-awaken-pill');
    const memVariants = document.querySelectorAll('.mem-awaken-variants .mem-awaken-variant');
    memPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        memPills.forEach((p) => p.classList.toggle('active', p === pill));
        const lv = pill.getAttribute('data-awaken');
        memVariants.forEach((v) => v.classList.toggle('active', v.getAttribute('data-awaken') === lv));
      });
    });
  </script>

<!-- Minimal JavaScript for progressive enhancement -->
<script>
  // Lazy load images that aren't immediately visible
  if ('IntersectionObserver' in window) {
    const images = document.querySelectorAll('img[loading="lazy"]');
    const imageObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const img = entry.target as HTMLImageElement;
          img.setAttribute('loading', 'eager');
          observer.unobserve(entry.target);
        }
      });
    });
    images.forEach(img => imageObserver.observe(img));
  }
</script>
