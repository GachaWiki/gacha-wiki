---
// @ts-nocheck
// Zone Nova Memory Page Template
// This template creates individual memory pages with complete information
import ZoneNovaLayout from '../../layouts/zone-nova/LandingLayout.astro';
import ZNMemoryImage from '../../components/zone-nova/ZNMemoryImage.astro';
import ZNClassImage from '../../components/zone-nova/ZNClassImage.astro';

import { getCharacterClass } from '../../data/zone-nova/characters.js';
import { BUFF_EXPLANATIONS, MEMORY_NSFW_ART } from '../../data/zone-nova/memories.js';

export interface Props {
  memoryData: any;
  memorySEO: any;
}

const { memoryData, memorySEO } = Astro.props;

// Buff/debuff tokens referenced by this card's effect text that the text itself
// never defines — explained from the map (verified against live buff data).
const effectTextAll = (
  memoryData.awakenEffects ?? [memoryData.effects.join('\n')]
).join('\n');
const buffNotes = Object.entries(BUFF_EXPLANATIONS)
  .filter(([token]) => effectTextAll.includes(`[${token}]`))
  .map(([token, text]) => ({ token, text }));

// Extract image filename from the path for ZNMemoryImage component
const getImageFilename = (imagePath: string): string => {
  if (!imagePath) return '';
  return imagePath.split('/').pop() || '';
};

const memoryImageFilename = getImageFilename(memoryData.image);

// NSFW (_H) variant art shipped next to the standard card art, when it exists
const nsfwArtUrl = MEMORY_NSFW_ART[memoryData.slug] || null;

// Group a long single-line story into readable paragraphs (~3 sentences each)
function storyParagraphs(story: string): string[] {
  if (!story) return [];
  if (story.includes('\n')) return story.split('\n').filter(Boolean);
  const sentences = story.match(/[^.!?]+[.!?]+(\s|$)/g) || [story];
  const out: string[] = [];
  for (let i = 0; i < sentences.length; i += 3) {
    out.push(sentences.slice(i, i + 3).join('').trim());
  }
  return out;
}
const storyParas = storyParagraphs(memoryData.story || '');

// Escape helper + bold the leading [Token]: of effect lines
function esc(t: string): string {
  return t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}
function effectLineHtml(line: string): string {
  const m = line.match(/^(\[[^\]]+\]:)\s*(.*)$/);
  if (m) {
    return `<strong class="effect-token">${esc(m[1])}</strong> ${esc(m[2])}`;
  }
  return esc(line);
}
function isSubheader(line: string): boolean {
  return /^\[[^\]]+\]:\s*$/.test(line);
}

// Helper function to get memory class type from memory restrictions
function getMemoryClass(memoryData: any): string {
  // First check if memory has explicit class field
  if (memoryData.class) {
    return memoryData.class;
  }
  
  // Check memory effects for class restrictions
  if (memoryData.effects && memoryData.effects.length > 0) {
    const effectsText = memoryData.effects.join(' ').toLowerCase();
    
    if (effectsText.includes('only effective for guardians') || effectsText.includes('guardian class restriction')) {
      return 'Tank';
    }
    if (effectsText.includes('only effective for healers') || effectsText.includes('healer class restriction')) {
      return 'Healer';
    }
    if (effectsText.includes('only effective for warriors') || effectsText.includes('warrior class restriction')) {
      return 'Warrior';
    }
    if (effectsText.includes('only effective for rogues') || effectsText.includes('rogue class restriction')) {
      return 'Attacker';
    }
    if (effectsText.includes('only effective for mages') || effectsText.includes('mage class restriction')) {
      return 'Destroyer';
    }
    if (effectsText.includes('only effective for buffers') || effectsText.includes('buffer class restriction')) {
      return 'Supporter';
    }
    if (effectsText.includes('only effective for debuffers') || effectsText.includes('debuffer class restriction')) {
      return 'Disruptor';
    }
    if (effectsText.includes('only effective for dps') || effectsText.includes('dps class restriction')) {
      return 'DPS';
    }
  }
  
  // For character-specific memories, check the character's actual class
  if (memoryData.character) {
    const characterClass = getCharacterClass(memoryData.character);
    if (characterClass) return characterClass;
  }
  
  return 'Universal';
}

// Helper function to convert character names to URL slugs
function getCharacterUrl(characterName: string): string {
  const baseUrl = '/guides/zone-nova/characters/';

  // Handle special cases
  const specialCases: { [key: string]: string } = {
    'Jeanne D Arc': 'jeanne-darc',
    'Greed Mammon': 'greed-mammon',
    'Snow Girl': 'snow-girl',
    'Zashiki-warashi': 'zashiki-warashi',
    // game-EN names whose wiki pages live under the launch-era slug
    Aphrodite: 'afrodite',
    Pennie: 'penny',
    Naya: 'naiya',
    Lyla: 'lyra',
    Cynia: 'chiya',
    Clara: 'kela',
    Saya: 'shanna',
    Zeus: 'yuis',
    Behemoth: 'leviathan',
    Belphegor: 'belphegar',
    Mammon: 'greed-mammon',
    'Morgan Le Fey': 'morgan-le-fay',
    'Joan of Arc': 'jeanne-darc',
    'Yuki-onna': 'snow-girl',
    'Shuten-dōji': 'shuten-doji',
    'Lust - Asmodeus': 'lust-asmodeus',
    'Pride - Lucifer': 'pride-lucifer',
    'Wrath - Samael': 'wrath-samael',
    'Gluttony - Beelzebub': 'gluttony-beelzebub',
  };

  if (specialCases[characterName]) {
    return baseUrl + specialCases[characterName] + '/';
  }

  // Default: convert to lowercase and replace spaces with hyphens
  return baseUrl + characterName.toLowerCase().replace(/\s+/g, '-').replace(/'/g, '') + '/';
}


---

<ZoneNovaLayout
  title={memorySEO.title}
  description={memorySEO.description}
  gameTitle={`${memoryData.name} - Memory Card`}
>
  <div class="memory-page">
    <!-- Memory Card Header -->
    <section class="memory-header">
      <div class="memory-container">
        <div class="memory-card-display">
          <div class="memory-card-frames">
            <div class="memory-card-frame">
              <ZNMemoryImage
                imageName={memoryImageFilename}
                alt={memoryData.name}
                width={200}
                height={300}
                loading="lazy"
                class="memory-card-image"
              />
              <span class="memory-card-caption">Standard</span>
            </div>
            {nsfwArtUrl && (
              <div class="memory-card-frame">
                <div class="memory-nsfw-wrap" data-nsfw-reveal>
                  <img
                    src={nsfwArtUrl}
                    alt={`${memoryData.name} NSFW art`}
                    width={200}
                    height={300}
                    loading="lazy"
                    class="memory-card-image"
                  />
                  <span class="memory-nsfw-cover">NSFW art: double-click to show</span>
                </div>
                <span class="memory-card-caption">NSFW Variant</span>
              </div>
            )}
          </div>
        </div>

        <div class="memory-info">
          <div class="memory-header-info">
            <h1 class="memory-title">{memoryData.name}</h1>
          </div>
          
          <div class="memory-details">
            {memoryData.element && (
              <div class="detail-item">
                <span class="detail-label">Element</span>
                <span class={`element-badge ${memoryData.element.toLowerCase()}`}>
                  {memoryData.element}
                </span>
              </div>
            )}
            
            {memoryData.character && (
              <div class="detail-item">
                <span class="detail-label">Character</span>
                <span class="character-text">{memoryData.character}</span>
              </div>
            )}
            
            <div class="detail-item">
              <span class="detail-label">Card Type</span>
              <div class="card-type-info">
                <ZNClassImage 
                  className={getMemoryClass(memoryData)} 
                  alt={getMemoryClass(memoryData)} 
                  size="small"
                  class="class-icon-small"
                />
                <span class="type-badge-text">
                  {getMemoryClass(memoryData)}
                  {memoryData.character ? ' - Exclusive' : ' - Universal'}
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Memory Stats -->
    <section class="memory-stats">
      <h2 class="section-title">Card Stats</h2>
      <div class="stats-grid">
        <div class="stat-card hp">
          <div class="stat-value">{memoryData.stats.hp.toLocaleString()}</div>
          <div class="stat-label">HP</div>
          <div class="stat-range">Lv.1: {(memoryData.lv1Stats?.hp ?? memoryData.stats.hp).toLocaleString()}</div>
        </div>
        <div class="stat-card attack">
          <div class="stat-value">{memoryData.stats.attack.toLocaleString()}</div>
          <div class="stat-label">Attack</div>
          <div class="stat-range">Lv.1: {(memoryData.lv1Stats?.attack ?? memoryData.stats.attack).toLocaleString()}</div>
        </div>
        <div class="stat-card defense">
          <div class="stat-value">{memoryData.stats.defense.toLocaleString()}</div>
          <div class="stat-label">Defense</div>
          <div class="stat-range">Lv.1: {(memoryData.lv1Stats?.defense ?? memoryData.stats.defense).toLocaleString()}</div>
        </div>
      </div>
      <p class="stats-note">
        Big number = Lv.80 (fully leveled) value. Card stats grow with level — a fresh card starts at
        Lv.1 (shown underneath) at roughly 4.5% of max, and each limit break raises the level cap by
        10 (Lv.20 → 30 → … → 80).
      </p>
    </section>

    <!-- Memory Effects -->
    <section class="memory-effects">
      <h2 class="section-title">Card Effects</h2>
      {memoryData.awakenEffects ? (
        <div class="awaken-picker">
          <span class="awaken-label">Awakening Level</span>
          <div class="awaken-pills" role="group" aria-label="Awakening level selector">
            {memoryData.awakenEffects.map((_, i) => (
              <button type="button" class={`awaken-pill${i === 4 ? ' active' : ''}`} data-awaken={i + 1}>
                {i + 1}
              </button>
            ))}
          </div>
        </div>
      ) : null}
      {memoryData.awakenEffects ? (
        <div class="awaken-variants">
          {memoryData.awakenEffects.map((levelText, i) => (
            <div class={`effects-container awaken-variant${i === 4 ? ' active' : ''}`} data-awaken={i + 1}>
              {levelText.split('\n').filter(Boolean).map((paragraph, index) => (
                isSubheader(paragraph) ? (
                  <p class="effect-subheader" key={index}>{paragraph}</p>
                ) : (
                  <p class="effect-paragraph" key={index} set:html={effectLineHtml(paragraph)} />
                )
              ))}
            </div>
          ))}
        </div>
      ) : (
        <div class="effects-container">
          {memoryData.effects.map((effect, index) => (
            <div class="effect-item" key={index}>
              <div class="effect-number">{index + 1}</div>
              <div class="effect-text">{effect}</div>
            </div>
          ))}
        </div>
      )}
      {buffNotes.length > 0 && (
        <div class="buff-reference">
          <h3 class="buff-reference-title">Buff Reference</h3>
          {buffNotes.map(n => (
            <p class="buff-note">
              <strong>[{n.token}]:</strong> {n.text}
            </p>
          ))}
        </div>
      )}
    </section>

    <script>
      const pills = document.querySelectorAll('.awaken-picker .awaken-pill');
      const variants = document.querySelectorAll('.awaken-variants .awaken-variant');
      pills.forEach((pill) => {
        pill.addEventListener('click', () => {
          pills.forEach((p) => p.classList.toggle('active', p === pill));
          const lv = pill.getAttribute('data-awaken');
          variants.forEach((v) => v.classList.toggle('active', v.getAttribute('data-awaken') === lv));
        });
      });

      // NSFW art stays blurred until double-clicked (toggle) so it is safe to
      // open the page in public; single click never reveals it.
      document.querySelectorAll('[data-nsfw-reveal]').forEach((el) => {
        el.addEventListener('dblclick', () => {
          el.classList.toggle('revealed');
        });
      });
    </script>

    <!-- Card Story -->
    {memoryData.story && (
      <section class="memory-story">
        <h2 class="section-title">Card Story</h2>
        <div class="story-container">
          {storyParas.map(par => (
            <p class="story-paragraph">{par}</p>
          ))}
        </div>
      </section>
    )}

    <!-- Character Synergy -->
    {memoryData.character && (
      <section class="memory-synergy">
        <h2 class="section-title">Character Synergy</h2>
        <div class="synergy-card">
          <div class="synergy-content">
            <p>
              This memory card is specifically designed for <strong>{memoryData.character}</strong> 
              and provides optimal synergy with their abilities and playstyle. The effects complement 
              their kit perfectly for maximum effectiveness.
            </p>
            <a href={getCharacterUrl(memoryData.character)} class="symlink">
              <span>View {memoryData.character} Character Guide</span>
              <span class="arrow">→</span>
            </a>
          </div>
        </div>
      </section>
    )}
  </div>

  <style>
    /* Awaken level picker */
    .awaken-picker {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.75rem;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 12px;
      padding: 0.75rem 1rem;
      margin-bottom: 1.25rem;
    }
    .awaken-picker .awaken-label {
      font-size: var(--text-md);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      opacity: 0.7;
    }
    .awaken-pills {
      display: flex;
      gap: 0.35rem;
    }
    .awaken-pill {
      min-width: 2rem;
      padding: 0.3rem 0.5rem;
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.2);
      background: transparent;
      color: inherit;
      font-weight: 600;
      font-size: var(--text-md);
      cursor: pointer;
    }
    .awaken-pill:hover {
      border-color: #4fc3f7;
    }
    .awaken-pill.active {
      background: #4fc3f7;
      border-color: #4fc3f7;
      color: #08131c;
    }
    .awaken-variants .awaken-variant {
      display: none;
    }
    .awaken-variants .awaken-variant.active {
      display: block;
    }

    /* Card story */
    .memory-story {
      margin-top: 2rem;
    }
    .story-container {
      background: var(--zn-bg-secondary);
      border: 1px solid var(--zn-border-primary);
      border-radius: 8px;
      padding: 1.5rem;
      margin-bottom: 2rem;
    }
    .story-paragraph {
      line-height: 1.7;
      margin-bottom: 0.9rem;
    }
    .story-paragraph:last-child {
      margin-bottom: 0;
    }

    /* Effect text (single flowing block) */
    .effect-paragraph {
      line-height: 1.7;
      margin: 0 0 0.9rem;
    }
    .effect-paragraph:last-child {
      margin-bottom: 0;
    }
    .effect-subheader {
      font-weight: 700;
      color: #4fc3f7;
      margin: 0.9rem 0 0.45rem;
    }
    .effect-subheader:first-child {
      margin-top: 0;
    }
    .effect-token {
      font-weight: 700;
      color: #4fc3f7;
    }

    .memory-page {   max-width: 1000px;
      margin: 0 auto;
      padding: 1.5rem;
    }

    .memory-header {
      margin-bottom: 2rem;
    }

    .memory-container {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 2rem;
      background: var(--zn-bg-secondary);
      border: 1px solid var(--zn-border-primary);
      border-radius: 8px;
      padding: 1.5rem;
      align-items: start;
    }

    .memory-card-display {
      position: relative;
    }

    .memory-card-frames {
      display: flex;
      gap: 0.75rem;
    }

    .memory-card-frames .memory-card-frame {
      width: 200px;
      flex: 0 0 auto;
    }

    .memory-card-frame {
      background: var(--zn-bg-tertiary);
      border: 1px solid var(--zn-border-primary);
      border-radius: 6px;
      padding: 0.75rem;
    }

    .memory-card-caption {
      display: block;
      text-align: center;
      margin-top: 0.5rem;
      font-size: var(--text-xs);
      color: var(--zn-text-secondary);
    }

    .memory-nsfw-wrap {
      position: relative;
      cursor: pointer;
      user-select: none;
    }

    .memory-nsfw-wrap .memory-card-image {
      filter: blur(26px);
    }

    .memory-nsfw-wrap.revealed .memory-card-image {
      filter: none;
    }

    .memory-nsfw-cover {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      padding: 0.35rem 0.6rem;
      background: var(--zn-bg-tertiary);
      border: 1px solid var(--zn-border-primary);
      border-radius: 4px;
      font-size: var(--text-xs);
      color: var(--zn-text-secondary);
      text-align: center;
      pointer-events: none;
    }

    .memory-nsfw-wrap.revealed .memory-nsfw-cover {
      display: none;
    }

    .memory-card-image {
      border-radius: 4px;
      width: 100%;
      height: auto;
      display: block;
    }

    .memory-info {
      padding-top: 0.5rem;
    }

    .memory-header-info {
      margin-bottom: 1.5rem;
    }

    .memory-title {
      font-size: var(--text-3xl);
      font-weight: 700;
      color: var(--zn-text-primary);
      line-height: 1.2;
      margin: 0;
      font-family: system-ui, -apple-system, sans-serif;
    }

    .memory-details {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .detail-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.75rem;
      background: var(--zn-bg-tertiary);
      border-radius: 6px;
      border: 1px solid var(--zn-border-primary);
    }

    .detail-label {
      color: var(--zn-text-primary);
      font-size: var(--text-body);
      font-weight: 600;
      font-family: system-ui, -apple-system, sans-serif;
    }

    .card-type-info {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .class-icon-small {
      width: 24px;
      height: 24px;
    }

    .element-badge {
      padding: 0.375rem 0.75rem;
      border-radius: 6px;
      font-size: var(--text-md);
      font-weight: 500;
      text-transform: capitalize;
    }

    .element-badge.fire { background: var(--zn-badge-fire); color: var(--zn-badge-white); }
    .element-badge.ice { background: var(--zn-badge-ice); color: var(--zn-badge-white); }
    .element-badge.wind { background: var(--zn-badge-wind); color: var(--zn-badge-black); }
    .element-badge.holy { background: var(--zn-badge-holy); color: var(--zn-badge-black); }
    .element-badge.chaos { background: var(--zn-badge-chaos); color: var(--zn-badge-white); }

    .type-badge-text {
      color: var(--zn-text-primary);
      font-size: var(--text-body);
      font-weight: 600;
      font-family: system-ui, -apple-system, sans-serif;
    }

    .character-text {
      color: var(--zn-text-primary);
      font-size: var(--text-body);
      font-weight: 600;
      font-family: system-ui, -apple-system, sans-serif;
    }

    .section-title {
      font-size: var(--text-xl);
      font-weight: 600;
      color: var(--zn-primary-amber);
      margin-bottom: 1rem;
      border-bottom: 2px solid var(--zn-primary-amber);
      padding-bottom: 0.5rem;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
    }

    .stat-card {
      background: var(--zn-bg-secondary);
      border: 1px solid var(--zn-border-primary);
      border-radius: 8px;
      padding: 1rem;
      text-align: center;
    }



    .stat-value {
      font-size: var(--text-xl);
      font-weight: 600;
      color: var(--zn-text-primary);
      margin-bottom: 0.25rem;
    }

    .stat-label {
      font-size: var(--text-xs);
      color: var(--zn-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .stat-range {
      margin-top: 0.5rem;
      padding-top: 0.5rem;
      border-top: 1px dashed var(--zn-border-primary);
      font-size: var(--text-sm);
      color: var(--zn-text-muted);
    }

    .stats-note {
      font-size: var(--text-md);
      color: var(--zn-text-muted);
      line-height: 1.6;
      margin: -1rem 0 2rem;
    }

    .buff-reference {
      background: rgba(0, 172, 193, 0.06);
      border: 1px solid rgba(0, 172, 193, 0.25);
      border-radius: 8px;
      padding: 0.9rem 1.1rem;
      margin-top: 1.25rem;
    }

    .buff-reference-title {
      font-size: var(--text-sm);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--zn-primary-amber);
      margin: 0 0 0.5rem;
    }

    .buff-note {
      font-size: var(--text-md);
      color: var(--zn-text-secondary);
      line-height: 1.65;
      margin: 0 0 0.4rem;
    }

    .buff-note:last-child {
      margin-bottom: 0;
    }

    .buff-note strong {
      color: var(--zn-text-primary);
    }

    .effects-container {
      background: var(--zn-bg-secondary);
      border: 1px solid var(--zn-border-primary);
      border-radius: 8px;
      padding: 1.5rem;
      margin-bottom: 2rem;
    }

    .effect-item {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      margin-bottom: 1rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--zn-border-primary);
    }

    .effect-item:last-child {
      margin-bottom: 0;
      padding-bottom: 0;
      border-bottom: none;
    }

    .effect-number {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      background: var(--zn-primary-amber);
      color: var(--zn-bg-primary);
      border-radius: 50%;
      font-weight: 600;
      font-size: var(--text-xs);
      flex-shrink: 0;
    }

    .effect-text {
      color: var(--zn-text-secondary);
      line-height: 1.5;
      font-size: var(--text-body);
    }

    .synergy-card {
      background: var(--zn-bg-secondary);
      border: 1px solid var(--zn-border-primary);
      border-radius: 8px;
      padding: 1.5rem;
    }

    .synergy-content p {
      color: var(--zn-text-secondary);
      line-height: 1.5;
      margin-bottom: 1rem;
    }

    .symlink {
      color: var(--zn-primary-amber);
      text-decoration: none;
      font-weight: 500;
    }

    /* Tablet Optimization */
    @media (min-width: 769px) and (max-width: 1024px) {
      .memory-page {
        padding: 1.25rem;
        max-width: 900px;
      }

      .memory-container {
        grid-template-columns: 180px 1fr;
        gap: 1.5rem;
        padding: 1.25rem;
      }

      .memory-title {
        font-size: var(--text-3xl);
      }

      .memory-card-image {
        max-width: 180px;
        height: auto;
      }

      .stats-grid {
        grid-template-columns: repeat(3, 1fr);
