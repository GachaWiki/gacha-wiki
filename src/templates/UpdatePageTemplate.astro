---
// @ts-nocheck
// News-article template for Zone Nova update/announcement pages.
// No highlighting, no nested cards: title + meta, TL;DR, flowing article body.
import ZoneNovaUpdateLayout from '../layouts/zone-nova/UpdateLayout.astro';
import Breadcrumb from '../components/zone-nova/Breadcrumb.astro';

export interface Props {
  updateData: {
    title: string;
    date: string;
    type: string;
    tldr?: string[];
    officialUpdate: {
      greeting?: string;
      content: string[];
      closing?: string;
    };
    sourceInfo: {
      source: string;
      verified: boolean;
      gameUrl?: string;
    };
  };
  seoData: {
    title: string;
    description: string;
  };
}

const { updateData, seoData } = Astro.props;

const TYPE_LABELS = {
  maintenance: 'Maintenance',
  announcement: 'Announcement',
  recruitment: 'Recruitment',
  event: 'Event',
};
const typeLabel = TYPE_LABELS[updateData.type] || 'Update';

// Notice section headers: 【1. ...】 bracketed titles or numbered lines
function isSectionHeader(text) {
  return /^【.+】$/.test(text) || /^\d+\.\s+\S/.test(text);
}

// Short "Label: value" lines (Event Period, Class, Attribute...) get label styling.
// Long sentences that merely contain a colon must stay body paragraphs.
function splitKeyValue(text) {
  if (text.length > 90) return null;
  const m = text.match(/^([A-Z][A-Za-z ]{1,24}):\s+(\S.*)$/);
  return m ? { label: `${m[1]}:`, value: m[2] } : null;
}

const bodyBlocks = (updateData.officialUpdate.content || [])
  .map(item => (typeof item === 'string' ? item.trim() : ''))
  .filter(text => text.length > 0)
  .map(text => {
    if (isSectionHeader(text)) return { kind: 'header', text };
    const kv = splitKeyValue(text);
    if (kv) return { kind: 'kv', ...kv };
    return { kind: 'p', text };
  });

// Security: only allow http(s) source links
function isValidUrl(url) {
  try {
    const urlObj = new URL(url);
    return urlObj.protocol === 'http:' || urlObj.protocol === 'https:';
  } catch {
    return false;
  }
}
const sourceUrl =
  updateData.sourceInfo.gameUrl && isValidUrl(updateData.sourceInfo.gameUrl)
    ? updateData.sourceInfo.gameUrl
    : undefined;
---

<ZoneNovaUpdateLayout title={seoData.title} description={seoData.description} gameTitle={updateData.title}>
  <Fragment slot="head">
    <style>
      /* Update pages: keep the page title static (news article look) */
      .hero-title,
      .title-only-heading {
        animation: none !important;
      }
    </style>
  </Fragment>

  <Breadcrumb autoGenerate={true} gameKey="zone-nova" currentPageName={updateData.title} showBackButton={true} />

  <article class="zn-article">
    <div class="zn-article-meta">
      <span class="zn-article-date" set:text={updateData.date} />
      <span class="zn-article-type" set:text={typeLabel} />
    </div>

    {
      updateData.tldr && updateData.tldr.length > 0 && (
        <section class="zn-article-tldr">
          <h2 class="zn-article-heading">TL;DR</h2>
          <ul>
            {updateData.tldr.map(point => (
              <li set:text={point} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="zn-article-body">
      {
        updateData.officialUpdate.greeting && (
          <p class="zn-article-greeting" set:text={updateData.officialUpdate.greeting} />
        )
      }
      {
        bodyBlocks.map(block =>
          block.kind === 'header' ? (
            <h3 class="zn-article-sub" set:text={block.text} />
          ) : block.kind === 'kv' ? (
            <p class="zn-article-kv">
              <span class="zn-kv-label" set:text={block.label} />
              <span set:text={block.value} />
            </p>
          ) : (
            <p set:text={block.text} />
          )
        )
      }
      {
        updateData.officialUpdate.closing && (
          <p class="zn-article-closing" set:text={updateData.officialUpdate.closing} />
        )
      }
    </div>

    <div class="zn-article-source">
      Source:{' '}
      {
        sourceUrl ? (
          <a href={sourceUrl} target="_blank" rel="noopener noreferrer" class="zn-source-link" set:text={updateData.sourceInfo.source} />
        ) : (
          <span set:text={updateData.sourceInfo.source} />
        )
      }
    </div>
  </article>
</ZoneNovaUpdateLayout>
