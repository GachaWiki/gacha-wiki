                          </span>
                        </div>
                      )}
                    </div>

                    {/* Arrow connector */}
                    <div class="skill-replacement-arrow"></div>

                    {/* Replacement skill */}
                    <div class={getSkillCardClasses(pair.replacementSkill, pair.replacementKey, false, true, false)}>
