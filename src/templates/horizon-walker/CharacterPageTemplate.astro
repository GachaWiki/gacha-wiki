<!-- Click-to-play facade for the Videos section: swaps the thumbnail for the YouTube iframe on click -->
<script>
  function activateHwVideoFacade(facade: Element) {
    if (facade.getAttribute('data-yt-active')) return;
    const id = facade.getAttribute('data-yt-id');
    const slot = facade.querySelector('.hw-video-frame-slot');
    if (!id || !slot) return;
    facade.setAttribute('data-yt-active', '1');
    const frame = document.createElement('iframe');
    frame.className = 'hw-video-frame';
    frame.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0';
    frame.title = facade.getAttribute('data-yt-title') || 'YouTube video';
    frame.allow =
      'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    frame.allowFullscreen = true;
    slot.replaceChildren(frame);
  }

  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    const facade = target ? target.closest('[data-yt-facade]') : null;
    if (facade) activateHwVideoFacade(facade);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    const target = e.target as Element | null;
    const facade = target ? target.closest('[data-yt-facade]') : null;
    if (facade) {
      e.preventDefault();
      activateHwVideoFacade(facade);
    }
  });
</script>
