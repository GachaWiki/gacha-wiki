        } else {
          // Render normal skill
          const { key, skill } = group.data;
          return (
            <div class={getSkillCardClasses(skill, key)}>
              <div class="skill-header">
                {skill.icon && (
                  <SkillIcon iconName={skill.icon} />
                )}
                <h3 class="skill-title">{skill.name}</h3>
                <div class="skill-meta">
                  {skill.type === 'Passive' ? (
                    <span class="skill-type-label passive-label">{labels.passiveLabel}</span>
                  ) : (
                    <span class="skill-type-label skill-label">{labels.skillLabel}</span>
                  )}
                  {skillLevelData[key] && (
                    <input type="number" class="skill-level-input" data-skill={key} min="1" max={skillLevelData[key].maxLevel} value={skillLevelData[key].maxLevel} />
                  )}
                  {skill.type !== 'Passive' && skill.apCost != null && skill.apCost > 0 && (
                    <span class="skill-cost">{fill(labels.apLabel, { n: skill.apCost })}</span>
                  )}
                  {skill.type !== 'Passive' && skill.cooldown != null && skill.cooldown > 0 && (
                    <span class="skill-cooldown">{fill(labels.cdLabel, { n: skill.cooldown })}</span>
                  )}
                </div>
              </div>
              <p class="skill-description" set:html={safeRenderHtml(renderSkillDesc(skill.description, key)).content} />
              {skill.damage && (
                <div class="skill-damage">
                  <span class="damage-label">{labels.damageLabel}</span>{' '}
                  <span class="damage-value" data-skill-key={key} data-damage-suffix={getDamageSuffix(skill.damage)}>
                    {formatDamage(key, skill.damage)}
                  </span>
                </div>
              )}
            </div>
          );
        }
      });
    })()
  }
  <script define:vars={{ skillLevelJson }}>
    (function() {
      var data = JSON.parse(skillLevelJson || '{}');
      var section = document.currentScript.closest('.skills-section');
      if (!section || !Object.keys(data).length) return;

      function updateDamage(input) {
        var key = input.getAttribute('data-skill');
        var level = parseInt(input.value) || 1;
        var maxLevel = parseInt(input.getAttribute('max')) || 10;
        if (level < 1) level = 1;
        if (level > maxLevel) level = maxLevel;
        input.value = level;

        var skillData = data[key];
        if (!skillData) return;
        var levelInfo = skillData.levels ? skillData.levels[String(level)] : null;

        var card = input.closest('.skill-card') || input.closest('[class*=skill]');
        if (!card) return;

        if (levelInfo) {
          var val = Math.round(parseFloat(levelInfo.min) * 100);
          card.querySelectorAll('.skill-n[data-skill-target="' + key + '"]').forEach(function(el) {
            el.textContent = val + '%';
          });
          var dmgEl = card.querySelector('[data-skill-key="' + key + '"]');
          if (dmgEl) {
            var suffix = dmgEl.getAttribute('data-damage-suffix') || '';
            dmgEl.textContent = val + '%' + suffix;
          }
        }

        // per-level value arrays inside the description: pick the value for this level
        card.querySelectorAll('.skill-arr[data-skill-target="' + key + '"]').forEach(function(el) {
          var vals = (el.getAttribute('data-vals') || '').split(',');
          if (!vals.length) return;
          el.textContent = vals[Math.min(level, vals.length) - 1];
        });
      }

      section.querySelectorAll('.skill-level-input').forEach(function(input) {
        input.addEventListener('input', function() { updateDamage(this); });
        input.addEventListener('change', function() { updateDamage(this); });
      });
    })();
  </script>
</section>

