                            <span class="skill-type-label passive-label">{labels.passiveLabel}</span>
                          ) : (
                            <span class="skill-type-label skill-label">{labels.skillLabel}</span>
                          )}
                          {skillLevelData[pair.replacementKey] && (
                            <input type="number" class="skill-level-input" data-skill={pair.replacementKey} min="1" max={skillLevelData[pair.replacementKey].maxLevel} value={skillLevelData[pair.replacementKey].maxLevel} />
                          )}
                          {pair.replacementSkill.type !== 'Passive' && pair.replacementSkill.apCost != null && pair.replacementSkill.apCost > 0 && (
                            <span class="skill-cost">{fill(labels.apLabel, { n: pair.replacementSkill.apCost })}</span>
                          )}
                          {pair.replacementSkill.type !== 'Passive' && pair.replacementSkill.cooldown != null && pair.replacementSkill.cooldown > 0 && (
