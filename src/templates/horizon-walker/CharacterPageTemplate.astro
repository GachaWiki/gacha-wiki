  highValueGiftsTitle: 'High-Value Gifts',
  highValueGiftsDesc:
    'These rare gifts provide exceptional affection points (80+ total) and are extremely valuable',
  favoriteGiftsTitle: 'Favorite Gifts',
  favoriteGiftsDesc:
    'These gifts give bonus points (20+ more) and are highly valued by this character',
  likedGiftsTitle: 'Liked Gifts',
  likedGiftsDesc: 'These gifts give 10 points more and are appreciated by this character',
  altHighValueTitle: 'Alternative High-Value Option',
  altHighValueDesc:
    "Queen's Tiara provides the highest affection points (100) for any character, regardless of preferences",
  basePointsLabel: 'Base:',
  bonusPointsLabel: '+ Bonus:',
  totalPointsLabel: '= Total:',
  maxAffectionLabel: 'For Max Affection:',
  giftsCountLabel: '{n} gifts',
