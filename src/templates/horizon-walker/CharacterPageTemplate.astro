---
import {
  highlightAllSkills,
  highlightUniqueTraits,
  highlightWeaponSkills,
  defaultHWHighlightPatterns,
} from '../../utils/horizon-walker/skill-highlighting.js';
import { safeHtmlRenderer, batchValidateHtml } from '../../utils/horizon-walker/safe-html-renderer.js';
import { validateCharacterData, validateSkillReplacements } from '../../utils/horizon-walker/character-data-validator.js';
import { getCharacterById } from '../../data/horizon-walker/character-gifts.js';
import { GIFT_BOXES } from '../../data/horizon-walker/gifts.js';
import { getTagCategory, HORIZON_WALKER_CHARACTERS } from '../../data/horizon-walker/characters.js';
import { SKILL_LEVELS } from '../../data/horizon-walker/skill-levels.js';
import { r2Url } from '../../data/r2-config.js';
import { getSkinsByHeroId } from '../../data/horizon-walker/char-skins.js';
import { getStoryCgByHeroId } from '../../data/horizon-walker/story-cg.js';
import { getDemiskillData, getMightSkillList, TIER_PROBABILITIES } from '../../data/horizon-walker/demiskills.js';
import { getCommunityBuild } from '../../data/horizon-walker/community-builds.js';
import RecommendedBuildSection from '../../components/horizon-walker/RecommendedBuildSection.astro';
import { getReworkArchive } from '../../data/horizon-walker/rework-archive.js';
import { getVideosBySlug, VIDEO_TYPE_LABELS } from '../../data/horizon-walker/videos.js';

// Import image components from central location
import {
  CharacterImage,
  WeaponImage,
  GiftImage,
  HWRarityIcon,
  CrystalIcon,
} from '../../components/horizon-walker/index.astro';
import CharacterFullBodyImage from '../../components/horizon-walker/CharacterFullBodyImage.astro';
import CommunityBuildSection from '../../components/horizon-walker/CommunityBuildSection.astro';
import SkillIcon from '../../components/horizon-walker/SkillIcon.astro';

interface CharacterStats {
  strength: string;
  technic: string;
  intelligence: string;
  vitality: string;
  agility: string;
  maxHp: string;
  meleeAtk: string;
  rangedAtk: string;
  magicAtk: string;
  spd: string;
  startingAp: string;
  apRecovery: string;
  accuracy: string;
  evade: string;
  critRate: string;
  critDmg: string;
  slashBoost: string;
  pierceBoost: string;
  crushBoost: string;
  heatBoost: string;
  coldBoost: string;
  electricBoost: string;
  immaterialBoost: string;
  poisonBoost: string;
  slashDef: string;
  pierceDef: string;
  crushDef: string;
  heatDef: string;
  coldDef: string;
  electricDef: string;
  immaterialDef: string;
  poisonDef: string;
  blockRate: string;
}

interface CharacterProfile {
  age: string;
  racial: string;
  homeland: string;
  height: string;
  birthday: string;
  bwhRatio: string;
}

interface Skill {
  name: string;
  gameKey?: string;
  icon?: string;
  level?: string;
  type: string;
  apCost: number;
  cooldown: number;
  damage?: {
    type: string;
    value: string;
  };
  description: string;
}

interface WeaponSkill {
  name: string;
  type: string;
  description: string;
  note?: string;
}

interface Trait {
  name: string;
  description: string;
}

interface Effect {
  name: string;
  description: string;
}

interface WeaponStats {
  weaponMagicAtk?: string;
  maxHpBonus?: string;
}

interface Weapon {
  name: string;
  image: string;
  rarity: string;
  type: string;
  stats?: WeaponStats;
  uniqueSkills?: Record<string, WeaponSkill>;
}

interface CharacterData {
  name: string;
  image: string;
  rarity: string;
  cost: number;
  tags?: string[];
  profile?: CharacterProfile;
  story?: string;
  description?: string;
  stats: CharacterStats;
  skills?: Record<string, Skill>;
  uniqueTraits?: Record<string, Trait>;
  weapon?: Weapon;
  effects?: Record<string, Effect>;
}

interface Props {
  characterData: CharacterData;
  labels?: Partial<HWPageLabels>;
}

