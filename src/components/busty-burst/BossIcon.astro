---
// Displays boss icons from R2 (icon-arrive-arrive-limit)
import { R2, BOSS_ICONS } from './bb-r2';

interface Props {
  fileName: string;
  alt: string;
  width?: number;
  height?: number;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const { fileName, alt, width, height, loading = 'lazy', class: className = '' } = Astro.props;

const base = fileName.replace(/\.png$/, '');
const imageSrc = BOSS_ICONS.has(base) ? `${R2}/Limited_Boss/icon-arrive-arrive-limit/${base}.webp` : null;

const imageWidth = width || 350;
const imageHeight = height || 350;
---

{
  imageSrc ? (
    <img
      src={imageSrc}
      alt={alt}
      width={imageWidth}
      height={imageHeight}
      loading={loading}
      class={`boss-icon ${className}`.trim()}
    />
  ) : (
    <div
      class={`boss-icon-placeholder ${className}`.trim()}
      style={`width: ${imageWidth}px; height: ${imageHeight}px;`}
      title={alt}
    >
      ?
    </div>
  )
}

<style>
  .boss-icon {
    display: inline-block;
    object-fit: contain;
  }

  .boss-icon-placeholder {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--bb-bg-secondary, #2a2a3d);
    border: 1px solid var(--bb-border, #3d3d5c);
    border-radius: 8px;
    color: var(--bb-text-secondary, #a0a0b0);
    font-size: var(--text-base);
  }
</style>
