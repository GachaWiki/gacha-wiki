---
// Busty Burst breadcrumb: shared pill design restyled with BB tokens
// (bordered button, game font system), bb- legacy class kept for
// busty-burst-landing.css z-index hook.
import BreadcrumbBase from '../BreadcrumbBase.astro';
const style =
  '--bc-accent:var(--bb-primary-light);--bc-focus:var(--bb-accent-light);' +
  '--bc-list:var(--bb-text-secondary);--bc-list-weight:var(--font-medium);' +
  '--bc-current:var(--bb-text-primary);--bc-current-weight:var(--bb-font-semibold);' +
  '--bc-sep:var(--bb-primary-light);--bc-sep-opacity:0.7;--bc-sep-size:var(--text-base);--bc-sep-weight:var(--font-normal);' +
  '--bc-back-bg:var(--bb-bg-secondary);--bc-back-border:1px solid var(--bb-border);' +
  '--bc-weight:var(--font-medium);--bc-font:var(--font-primary);--bc-size:var(--text-sm);' +
  '--bc-size-480:var(--text-sm);--bc-leading:var(--leading-normal);--bc-tracking:var(--tracking-normal)';
---

<BreadcrumbBase {...Astro.props} classPrefix="bb" style={style} />
