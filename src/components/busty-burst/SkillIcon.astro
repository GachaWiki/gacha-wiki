---
// Skill icons served from R2 (skill_icons_final/sprite_skill*.webp)
import { R2, SKILL_ICONS } from './bb-r2';

export interface Props {
  skillId: string; // Format: "skill001/skill0004" or "skill0004" or "0004"
  alt?: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
  format?: 'webp' | 'png';
  quality?: number;
}

const {
  skillId,
  alt = 'Skill Icon',
  width = 48,
  height = 48,
  class: className,
  loading = 'lazy',
} = Astro.props;

// Extract skill number from various formats
// "skill001/skill0004" -> "0004"
// "skill0004" -> "0004"
// "0004" -> "0004"
function extractSkillNumber(id: string): string {
  let cleanId = id.replace(/^skill\d+\//, '');
  cleanId = cleanId.replace(/^skill/, '');
  return cleanId;
}

const skillNumber = extractSkillNumber(skillId);

// Icons are named: sprite_skill0004 or sprite_skill0006_1 (ultimate ranks).
// Manifest entries have no extension — match exactly or with a _rank suffix.
const matches = (f: string, n: string) => f === `sprite_skill${n}` || f.startsWith(`sprite_skill${n}_`);
let iconFile = SKILL_ICONS.find(f => matches(f, skillNumber));

// Fallback to a default icon if not found
if (!iconFile) {
  iconFile = SKILL_ICONS.find(f => matches(f, '0001'));
}

const imageSrc = iconFile ? `${R2}/skill_icons_final/${iconFile}.webp` : null;
---

{imageSrc ? (
  <div class={`skill-icon-wrapper ${className || ''}`}>
    <img
      src={imageSrc}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      decoding="async"
      class="skill-icon"
    />
  </div>
) : (
  <div class={`skill-icon-wrapper skill-icon-fallback ${className || ''}`} style={`width: ${width}px; height: ${height}px;`}>
    <span>?</span>
  </div>
)}

<style>
  .skill-icon-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.2);
  }

  .skill-icon {
    object-fit: contain;
  }

  .skill-icon-fallback {
    background: var(--bb-bg-secondary, #2a2a3e);
    color: var(--bb-text-secondary, #aaa);
    font-weight: 600;
    font-size: var(--text-xl);
  }
</style>
