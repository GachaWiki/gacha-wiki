---
// Character portrait/body art served from the gachawiki-images R2 bucket.
import { R2, SPRITE_IDS, BODY_IDS } from './bb-r2';

export interface Props {
  characterId: number;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
  imageType?: 'icon' | 'body';
}

const {
  characterId,
  alt,
  width = 180,
  height = 180,
  class: className,
  loading = 'lazy',
  imageType = 'icon', // Default to icon for small displays
} = Astro.props;

let url: string | null = null;
if (imageType === 'body') {
  // No sprite fallback for the body slot — characters without body art show
  // the placeholder until their art is uploaded to the bucket
  if (characterId && BODY_IDS.has(characterId)) {
    // v=crop1: portraits were re-cropped around the subject (2026-09-03) —
    // bump to force caches to drop the old full-canvas versions
    url = `${R2}/character/full_body/No_${characterId}_${characterId}_body.webp?v=crop1`;
  }
} else if (characterId && SPRITE_IDS.has(characterId)) {
  url = `${R2}/character/sprites/${characterId}.webp`;
}

// No art yet — monogram placeholder scaled to its container
const initial = (alt || '?')
  .replace(/[【\[\]「」'"]+/g, '')
  .trim()
  .charAt(0)
  .toUpperCase() || '?';
---

{url ? (
  <div class={`paladin-image-wrapper ${className || ''}`}>
    <img
      src={url}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      decoding="async"
      class="paladin-image"
    />
  </div>
) : (
  <div class={`paladin-image-wrapper ${className || ''}`}>
    <div class="paladin-image-fallback" title={`${alt} — art not released yet`}>
      <span class="paladin-image-fallback-initial">{initial}</span>
      <span class="paladin-image-fallback-hint">TBA</span>
    </div>
  </div>
)}

<style>
.paladin-image-fallback {
  container-type: size;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5cqh;
  width: 100%;
  height: 100%;
  /* contexts with no definite wrapper height collapse height:100% to 0,
     which zeroes the cqh monogram; aspect-ratio rescues those cases */
  aspect-ratio: 1;
  background:
    repeating-linear-gradient(45deg, rgba(255, 255, 255, 0.035) 0 6px, transparent 6px 12px),
    var(--bb-bg-tertiary, #242b33);
  border: 1px dashed rgba(255, 255, 255, 0.18);
  border-radius: 6px;
  box-sizing: border-box;
  overflow: hidden;
  cursor: help;
}

.paladin-image-fallback-initial {
  font-size: 42cqh;
  font-weight: 800;
  line-height: 1;
  color: rgba(255, 255, 255, 0.22);
  user-select: none;
}

.paladin-image-fallback-hint {
  font-size: max(11cqh, 0.55rem);
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  line-height: 1;
  color: rgba(109, 184, 216, 0.75);
  user-select: none;
}

/* Hide the TBA tag inside very small cells (table avatars) */
@container (max-height: 72px) {
  .paladin-image-fallback-hint {
    display: none;
  }
}
</style>
