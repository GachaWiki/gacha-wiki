---
// Shared background music player for every game guide: header toggle plus an
// optional track switcher (hidden when the game has a single track). Config
// comes from src/data/game-music.ts; colors flow in as CSS custom properties
// so each game keeps its exact palette. Persists across page navigations:
// preference + track in localStorage, per-track playback position in
// sessionStorage (legacy per-game key prefixes), and an autoplay-block
// fallback that resumes on the first user interaction.
import type { GameMusicConfig } from '../data/game-music';

interface Props {
  config: GameMusicConfig;
  variant?: 'desktop' | 'mobile';
}
const { config, variant = 'desktop' } = Astro.props;
const single = config.tracks.length === 1;
const cssVars = [
  `--gmp-accent:${config.accent}`,
  `--gmp-accent-border:${config.accentBorder}`,
  `--gmp-border:${config.idleBorder}`,
  `--gmp-fg:${config.idleColor}`,
].join(';');
---

<div
  class:list={['gmp-music', variant === 'mobile' && 'gmp-music-mobile', single && 'gmp-music-single']}
  style={cssVars}
  data-gmp-prefix={config.storagePrefix}
  data-gmp-tracks={JSON.stringify(config.tracks)}
>
  <button
    type="button"
    class="gmp-music-btn"
    aria-label={`Toggle ${config.gameLabel} background music`}
    aria-pressed="false"
    title="Background music"
  >
    <svg class="gmp-music-icon gmp-music-on-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
      <path
        d="M9 18V6l10-2v12"
        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
      ></path>
      <circle cx="6.5" cy="18" r="2.5" fill="currentColor"></circle>
      <circle cx="16.5" cy="16" r="2.5" fill="currentColor"></circle>
    </svg>
    <svg class="gmp-music-icon gmp-music-off-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
      <path
        d="M9 18V6l10-2v12"
        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
      ></path>
      <circle cx="6.5" cy="18" r="2.5" fill="none" stroke="currentColor" stroke-width="2"></circle>
      <line x1="3" y1="3" x2="21" y2="21" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
    </svg>
    <span class="gmp-music-label">Music</span>
  </button>
  {!single && (
    <button
      type="button"
      class="gmp-music-btn gmp-music-track-btn"
      aria-label="Switch background music track"
      title="Background music track"
    >
      <span class="gmp-music-track-num">1</span>
    </button>
  )}
  {/* One shared audio per page: only the desktop header instance renders it */}
  {
    variant === 'desktop' && (
      <audio
        id={`${config.storagePrefix}-music-audio`}
        data-gmp-audio={config.storagePrefix}
        src={config.tracks[0]}
        loop
        preload="none"
      />
    )
  }
</div>

<style>
  .gmp-music {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    --gmp-fg: #b3b3b3;
    --gmp-border: rgba(255, 255, 255, 0.15);
    --gmp-accent: #ffb74a;
    --gmp-accent-border: rgba(255, 183, 77, 0.4);
  }

  .gmp-music-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--gmp-border);
    color: var(--gmp-fg);
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
  }

  .gmp-music-single .gmp-music-btn {
    border-radius: 999px;
  }

  .gmp-music:not(.gmp-music-single) .gmp-music-btn:first-child {
    border-radius: 999px 0 0 999px;
    border-right: none;
  }

  .gmp-music-track-btn {
    border-radius: 0 999px 999px 0;
    min-width: 1.8rem;
    justify-content: center;
    padding: 0.35rem 0.5rem;
  }

  .gmp-music-btn .gmp-music-on-icon {
    display: none;
  }

  .gmp-music-btn.playing {
    color: var(--gmp-accent);
    border-color: var(--gmp-accent-border);
  }

  .gmp-music-btn.playing + .gmp-music-track-btn {
    border-color: var(--gmp-accent-border);
    color: var(--gmp-accent);
  }

  .gmp-music-btn.playing .gmp-music-on-icon {
    display: block;
  }

  .gmp-music-btn.playing .gmp-music-off-icon {
    display: none;
  }

  .gmp-music-track-num {
    min-width: 0.6rem;
    text-align: center;
  }

  @media (max-width: 768px) {
    .gmp-music-label {
      display: none;
    }
  }
</style>

<script is:inline>
  (function () {
    // Desktop + mobile header instances both render; init once, bind all.
    if (window.__gmpMusicInit) return;
    window.__gmpMusicInit = true;

    document.addEventListener('DOMContentLoaded', function () {
      var wrap = document.querySelector('.gmp-music[data-gmp-prefix]');
      var audio = document.querySelector('audio[data-gmp-audio]');
      var playBtns = document.querySelectorAll('.gmp-music-btn:not(.gmp-music-track-btn)');
      var trackBtns = document.querySelectorAll('.gmp-music-track-btn');
      if (!wrap || !audio || !playBtns.length) return;

      var PREFIX = wrap.getAttribute('data-gmp-prefix');
      var TRACKS = JSON.parse(wrap.getAttribute('data-gmp-tracks') || '[]');
      var multi = TRACKS.length > 1;
      var PREF = PREFIX + '-music-on';
      var TRACK = PREFIX + '-music-track';

      function posKey() {
        // single-track players keep the legacy unsuffixed position key
        return multi ? PREFIX + '-music-pos-' + currentTrack() : PREFIX + '-music-pos';
      }

      function currentTrack() {
        var t = parseInt(localStorage.getItem(TRACK) || '0', 10);
        return t >= 0 && t < TRACKS.length ? t : 0;
      }

      function setTrack(t, keepPlaying) {
        localStorage.setItem(TRACK, String(t));
        var wasPlaying = !audio.paused;
        if (!keepPlaying) wasPlaying = false;
        audio.src = TRACKS[t];
        trackBtns.forEach(function (b) {
          b.querySelector('.gmp-music-track-num').textContent = String(t + 1);
        });
        var pos = parseFloat(sessionStorage.getItem(posKey()) || '0');
        if (isFinite(pos) && pos > 0) {
          try {
            audio.currentTime = pos;
          } catch (e) {}
        }
        if (wasPlaying) tryPlay();
      }

      function setPlaying(on) {
        playBtns.forEach(function (b) {
          b.classList.toggle('playing', on);
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
      }

      function tryPlay() {
        audio.play().then(
          function () {
            setPlaying(true);
            localStorage.setItem(PREF, '1');
          },
          function () {
            // Autoplay blocked - resume on the first user interaction
            setPlaying(false);
            var resume = function () {
              audio.play().then(
                function () {
                  setPlaying(true);
                },
                function () {}
              );
              document.removeEventListener('pointerdown', resume);
              document.removeEventListener('keydown', resume);
            };
            document.addEventListener('pointerdown', resume);
            document.addEventListener('keydown', resume);
          }
        );
      }

      if (multi) {
        // restore track selection, then position for near-seamless playback
        var t = currentTrack();
        if (audio.src !== TRACKS[t]) audio.src = TRACKS[t];
        trackBtns.forEach(function (b) {
          b.querySelector('.gmp-music-track-num').textContent = String(t + 1);
        });
      }
      var pos = parseFloat(sessionStorage.getItem(posKey()) || '0');
      if (isFinite(pos) && pos > 0) {
        try {
          audio.currentTime = pos;
        } catch (e) {}
      }

      if (localStorage.getItem(PREF) === '1') {
        tryPlay();
      }

      audio.addEventListener('playing', function () {
        setPlaying(true);
      });
      audio.addEventListener('pause', function () {
        setPlaying(false);
      });

      setInterval(function () {
        if (!audio.paused) sessionStorage.setItem(posKey(), String(audio.currentTime));
      }, 1000);
      window.addEventListener('beforeunload', function () {
        if (!audio.paused) sessionStorage.setItem(posKey(), String(audio.currentTime));
      });

      playBtns.forEach(function (b) {
        b.addEventListener('click', function () {
          if (audio.paused) {
            tryPlay();
          } else {
            audio.pause();
            localStorage.removeItem(PREF);
            sessionStorage.removeItem(posKey());
            setPlaying(false);
          }
        });
      });

      if (multi) {
        trackBtns.forEach(function (b) {
          b.addEventListener('click', function () {
            setTrack((currentTrack() + 1) % TRACKS.length, true);
          });
        });
      }
    });
  })();
</script>
