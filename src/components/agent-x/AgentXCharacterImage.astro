---
// Agent X character art, served from the gachawiki-images R2 bucket (keeps the
// Pages deployment under the 20,000-file limit). /agent-x/characters/ namespace, webp.
const R2 = 'https://k2b1c5ab57ed98e51.gachawiki.info/agent-x/characters';

export interface Props {
  filename: string;
  alt?: string;
  class?: string;
  loading?: 'eager' | 'lazy';
}

const { filename, alt = 'Agent', class: className = '', loading = 'lazy' } = Astro.props;
const src = `${R2}/${filename.replace(/\.png$/, '.webp')}`;
---

<img src={src} alt={alt} class={className} loading={loading} decoding="async" />
