---
// MAJO in-game icons (rarity/class badges, skill icons, item icons, buff icons),
// served from the gachawiki-images R2 bucket (keeps the Pages deployment under
// the 20,000-file limit). Flat /majo/ namespace, webp.
const R2 = 'https://img.gachawiki.info/majo';

export interface Props {
  /** full icon filename, e.g. 'CharacterDetails_Icon_UR.png' or 'P0016_ClassSkill.png' */
  filename: string;
  alt?: string;
  class?: string;
}

const { filename, alt = '', class: className = '' } = Astro.props;
const src = `${R2}/${filename.replace(/\.png$/, '.webp')}`;
---

<img src={src} alt={alt} class={className} loading="lazy" decoding="async" width="128" height="128" />
