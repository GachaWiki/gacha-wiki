---
const today = new Date();
import packageInfo from '../../package.json';
import SocialLinks from './SocialLinks.astro';
const version = packageInfo.version;
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-content">
      <!-- Left Side: Version and License -->
      <div class="footer-left">
        <div class="version-license-row">
          <a
            href="https://github.com/boring877/gacha-wiki"
            target="_blank"
            rel="noopener noreferrer"
            class="version-link"
          >
            <div class="version-pill">
              v{version}
            </div>
          </a>
          <span class="license-text">
            Open source under <a href="/LICENSE" class="license-link">MIT License</a> · <a href="/about" class="license-link">About</a>
          </span>
        </div>
      </div>

      <!-- Center: Copyright -->
      <div class="footer-center">
        <p>© {today.getFullYear()} - I Hope You Have Wonderful Day ✨</p>
      </div>

      <!-- Right Side: Social Links -->
      <div class="footer-right">
        <SocialLinks />
      </div>
    </div>
  </div>
</footer>

<style>
  /* Footer Base Styles */
  .footer {
    background: linear-gradient(135deg, var(--bg-dark) 0%, #2a2a2a 50%, var(--bg-dark) 100%);
    backdrop-filter: blur(12px);
    border-top: 1px solid rgba(255, 183, 77, 0.3);
    margin-top: auto;
  }

  .footer-container {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0.75rem;
  }

  .footer-content {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: 1rem 0;
    min-height: 60px;
  }

  /* Footer Left: Version and License */
  .footer-left {
    display: flex;
    justify-content: flex-start;
  }

  /* Footer Center: Copyright */
  .footer-center {
    display: flex;
    justify-content: center;
  }

  .footer-center p {
    color: var(--text-inverse);
    font-size: var(--text-md);
    opacity: 0.9;
    font-weight: 500;
    margin: 0;
    line-height: 1.2;
  }

  /* Footer Right: Social Links */
  .footer-right {
    display: flex;
    justify-content: flex-end;
  }

  /* Version and License Row */
  .version-license-row {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .version-link {
    text-decoration: none;
    display: block;
    flex-shrink: 0;
  }

  .version-pill {
    background: var(--amber-glow);
    padding: 0.35rem 0.75rem;
    border-radius: 8px;
    font-family: var(--font-display), sans-serif;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--bg-dark);
    text-align: center;
    cursor: pointer;
    min-height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .license-text {
    color: var(--text-inverse);
    font-size: var(--text-xs);
    opacity: 0.7;
    margin: 0;
    line-height: 1.3;
  }

  .license-link {
    color: var(--amber-glow);
    text-decoration: none;
  }

  /* Hide footer completely on touch devices and small screens for cleaner mobile experience */
  @media (max-width: 1024px), (hover: none) and (pointer: coarse) {
    .footer {
      display: none;
    }
  }

  /* Note: Mobile responsive styles removed since footer is hidden on touch devices */

  /* Touch Device Optimizations */
  @media (hover: none) and (pointer: coarse) {
    .version-pill {
      min-height: 48px;
      padding: 0.75rem 1.25rem;
    }
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .version-pill {
      transition: none;
    }
  }

  /* Footer Right: spacing between social links */
  .footer-right {
    gap: 1rem;
  }
</style>
