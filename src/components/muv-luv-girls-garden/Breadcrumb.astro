---
// Muv-Luv Girls Garden breadcrumb: shared pill design, MLGG pink accent, mlgg- legacy class.
import BreadcrumbBase from '../BreadcrumbBase.astro';
const style =
  '--bc-accent:var(--mlgg-accent, #fa3c8c);--bc-focus:var(--mlgg-accent, #fa3c8c);--bc-link:var(--mlgg-accent-light, #ff7cb1);--bc-list:rgba(255, 255, 255, 0.5);--bc-back-bg:#241d24';
---

<BreadcrumbBase {...Astro.props} classPrefix="mlgg" style={style} />
