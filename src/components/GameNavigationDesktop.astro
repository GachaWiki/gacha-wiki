---
import { getGameData, isValidGameKey, type GameKey } from '../data/game-navigation';
import { getGameLanguageSection } from '../data/game-languages';
import { getGameById } from '../data/games';
import { getMusicConfig } from '../data/game-music';
import { Image } from 'astro:assets';
import GameMusicPlayer from './GameMusicPlayer.astro';

interface Props {
  currentPath?: string;
  gameKey?: GameKey;
  // Optional override for localized wikis (e.g. /zh/): replaces the English
  // section names/links and the game landing URL; identity stays from gameKey.
  navOverride?: {
    name?: string;
    gameUrl?: string;
    sections: { title: string; links: { name: string; href: string }[] }[];
  };
}

const { currentPath = '', gameKey, navOverride } = Astro.props;

// Import Stella Sora colors if needed.
const isStellaSora = gameKey === 'stella-sora';

// Validate and sanitize gameKey
const validatedGameKey = isValidGameKey(gameKey) ? gameKey : undefined;
const game = navOverride
  ? { ...getGameData(validatedGameKey), ...navOverride }
  : getGameData(validatedGameKey);
// Game landing URL from the single registry (fixes every game at once — no per-game chain).
const gameUrl =
  navOverride?.gameUrl ||
  (validatedGameKey && getGameById(validatedGameKey)?.url) ||
  '/guides/silver-and-blood/';

// Activate only the LONGEST matching nav href, so a deeper page like
// /builds/community/ lights "Community Builds" instead of "Builds" too.
const currentPathNorm = currentPath.endsWith('/') ? currentPath : currentPath + '/';
const navHrefs = (game?.sections ?? []).flatMap((section: any) =>
  section.links.map((link: any) => link.href)
);
const bestMatch = navHrefs
  .filter((href: string) => currentPathNorm === href || currentPathNorm.startsWith(href))
  .sort((a: string, b: string) => b.length - a.length)[0];
const isActive = (href: string) => href === bestMatch;

const musicConfig = getMusicConfig(validatedGameKey);

// Languages dropdown for games with localized wikis (registry-driven, so both
// the English wiki and the localized wikis get the same switcher). Appended
// after the game's own sections; not part of the active-link matching above.
const langSection = getGameLanguageSection(validatedGameKey);
const navSections = langSection && game ? [...game.sections, langSection] : (game?.sections ?? []);

---

<style>
  @import '../styles/components/game-navigation-desktop.css';

  /* Hide desktop on mobile/tablet devices */
  @media (max-width: 1024px) {
    .game-nav-desktop {
      display: none;
    }
  }

  /* Additional hide for touch devices */
  @media (hover: none) and (pointer: coarse) {
    .game-nav-desktop {
      display: none;
    }
  }
</style>

{game && (
<nav class="game-nav-desktop" data-game={validatedGameKey}>
  <div class="container">
    <div class="game-nav-header">
      <div class="game-info">
        <a
          href={gameUrl}
          class="game-link"
        >
          <div class="game-image-container">
            <Image
              src={game.image}
              alt={`${game.name} gacha game logo and navigation`}
              class="game-image"
              loading="lazy"
              width={80}
              height={80}
              format="webp"
              quality={90}
            />
            <div class="game-image-overlay"></div>
          </div>
          <h2 class="game-title">{game.name}</h2>
        </a>
      </div>

      {musicConfig && <GameMusicPlayer config={musicConfig} />}

      <!-- Desktop Section Navigation -->
      <div class="section-nav">
        {
          navSections.map(section => (
            <div class="section-item">
              <button
                type="button"
                class="section-trigger"
                aria-haspopup="true"
                aria-expanded="false"
              >
                <span class="section-name">{section.title}</span>
              </button>
              <div class="section-dropdown">
                {section.links.map(link => (
                  <a
                    href={link.href}
                    class={isActive(link.href) ? 'dropdown-link active' : 'dropdown-link'}
                    aria-current={isActive(link.href) ? 'page' : undefined}
                  >
                    {link.name}
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</nav>
)}

<script>
  // Desktop dropdown functionality with proper cleanup and performance optimizations
  document.addEventListener('DOMContentLoaded', () => {
    const nav = document.querySelector('.game-nav-desktop');
    if (!nav) return;

    const sectionItems = nav.querySelectorAll('.section-item');
    const dropdowns = nav.querySelectorAll('.section-dropdown');

    // Store timeout references for cleanup
    const hoverTimeouts = new Map();

    // Close all dropdowns efficiently and sync aria-expanded on triggers
    const closeAllDropdowns = () => {
      dropdowns.forEach(dropdown => {
        (dropdown as HTMLElement).style.opacity = '0';
        (dropdown as HTMLElement).style.visibility = 'hidden';
      });
      nav.querySelectorAll('.section-trigger').forEach(t => {
        (t as HTMLElement).setAttribute('aria-expanded', 'false');
      });
    };

    // Open a single dropdown and close the rest (used by click, key, focus)
    const openDropdown = (dropdown: Element) => {
      dropdowns.forEach(otherDropdown => {
        if (otherDropdown !== dropdown) {
          (otherDropdown as HTMLElement).style.opacity = '0';
          (otherDropdown as HTMLElement).style.visibility = 'hidden';
        }
      });
      const dropdownElement = dropdown as HTMLElement;
      const trigger = dropdownElement.closest('.section-item')?.querySelector('.section-trigger');
      dropdownElement.style.opacity = '1';
      dropdownElement.style.visibility = 'visible';
      trigger?.setAttribute('aria-expanded', 'true');
    };

    const closeDropdown = (dropdown: Element) => {
      const dropdownElement = dropdown as HTMLElement;
      const trigger = dropdownElement.closest('.section-item')?.querySelector('.section-trigger');
      dropdownElement.style.opacity = '0';
      dropdownElement.style.visibility = 'hidden';
      trigger?.setAttribute('aria-expanded', 'false');
    };

    // Optimized dropdown toggle with event delegation
    nav.addEventListener('click', (e: Event) => {
      const target = e.target as HTMLElement;
      if (!target) return;

      const trigger = target.closest('.section-trigger');
      if (!trigger) return;

      const item = trigger.closest('.section-item');
      const dropdown = item?.querySelector('.section-dropdown');

      if (!dropdown) return;

      const dropdownElement = dropdown as HTMLElement;
      const isVisible = dropdownElement.style.visibility === 'visible';
      if (isVisible) {
        closeDropdown(dropdown);
      } else {
        openDropdown(dropdown);
      }
    });

    // Keyboard support: Enter/Space on a trigger toggles its dropdown
    nav.addEventListener('keydown', (e: KeyboardEvent) => {
      const target = e.target as HTMLElement;
      const trigger = target.closest('.section-trigger');
      if (!trigger) return;
      if (e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar') {
        e.preventDefault();
        const dropdown = trigger.closest('.section-item')?.querySelector('.section-dropdown');
        if (!dropdown) return;
        const isVisible = (dropdown as HTMLElement).style.visibility === 'visible';
        if (isVisible) {
          closeDropdown(dropdown);
        } else {
          openDropdown(dropdown);
        }
      }
    });

    // Close dropdowns when clicking outside
    const handleOutsideClick = (e: Event) => {
      const target = e.target as HTMLElement;
      if (!target || !nav.contains(target)) {
        closeAllDropdowns();
      }
    };

    // Close dropdowns on ESC key
    const handleEscKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        closeAllDropdowns();
      }
    };

    // Enhanced hover behavior with proper timeout management
    sectionItems.forEach(item => {
      const dropdown = item.querySelector('.section-dropdown');
      if (!dropdown) return;

      const handleMouseEnter = () => {
        // Clear any existing timeout for this item
        const existingTimeout = hoverTimeouts.get(item);
        if (existingTimeout) {
          clearTimeout(existingTimeout);
          hoverTimeouts.delete(item);
        }
        openDropdown(dropdown);
      };

      const handleMouseLeave = () => {
        // Clear existing timeout
        const existingTimeout = hoverTimeouts.get(item);
        if (existingTimeout) {
          clearTimeout(existingTimeout);
        }

        // Set new timeout and store reference
        const timeoutId = window.setTimeout(() => {
          if (!item.matches(':hover')) {
            closeDropdown(dropdown);
          }
          hoverTimeouts.delete(item);
        }, 100);

        hoverTimeouts.set(item, timeoutId);
      };

      item.addEventListener('mouseenter', handleMouseEnter);
      item.addEventListener('mouseleave', handleMouseLeave);
    });

    // Add global event listeners
    document.addEventListener('click', handleOutsideClick);
    document.addEventListener('keydown', handleEscKey);

    // Enhanced prefetching system for instant navigation
    const MAX_PREFETCH_LINKS = 12;
    const prefetchCleanupInterval = setInterval(() => {
      const oldLinks = document.querySelectorAll('link[rel="prefetch"][data-nav-prefetch]');
      oldLinks.forEach(link => {
        if (Date.now() - (parseInt(link.getAttribute('data-prefetch-time') || '0')) > 30000) {
          link.remove();
        }
      });
    }, 30000);

    function prefetchPage(url: string | null) {
      if (!url) return;

      const existing = document.querySelector(`link[href="${url}"]`);
      if (existing) return;

      // Evict oldest prefetch links if at capacity
      const allPrefetchLinks = document.querySelectorAll('link[rel="prefetch"][data-nav-prefetch]');
      if (allPrefetchLinks.length >= MAX_PREFETCH_LINKS) {
        allPrefetchLinks[0].remove();
      }

      const link = document.createElement('link');
      link.rel = 'prefetch';
      link.href = url;
      link.setAttribute('data-nav-prefetch', 'true');
      link.setAttribute('data-prefetch-time', Date.now().toString());
      document.head.appendChild(link);
    }

    // Prefetch on dropdown link hover for instant navigation
    nav.addEventListener('mouseover', (e: Event) => {
      const target = e.target as HTMLElement;
      if (target && target.classList.contains('dropdown-link')) {
        const href = (target as HTMLAnchorElement).href;
        if (href) {
          prefetchPage(href);
        }
      }
    });

    // Prefetch main game pages on section hover
    sectionItems.forEach(item => {
      item.addEventListener('mouseenter', () => {
        const dropdown = item.querySelector('.section-dropdown');
        if (dropdown) {
          const links = dropdown.querySelectorAll('.dropdown-link');
          // Prefetch the first 3 links in each section for faster navigation
          Array.from(links)
            .slice(0, 3)
            .forEach(link => {
              const href = (link as HTMLAnchorElement).href;
              prefetchPage(href);
            });
        }
      });
    });
  });
</script>
