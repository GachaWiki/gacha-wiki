---
// Rebellion Gilgamesh boss/enemy image component
// Displays enemy art from public/images/games/rebellion-gilgamesh/bosses/<picId>.png
// Uses public/ folder (plain URLs) instead of Astro Image to reduce build output.
export interface Props {
  image?: string;
  alt: string;
  width?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const { image, alt, width = 64, class: className, loading = 'lazy' } = Astro.props;
const imgUrl = image ? `/images/games/rebellion-gilgamesh/bosses/${image}` : '';
---

{imgUrl ? (
  <div class={`rg-boss-img-wrapper ${className || ''}`} style={`--rg-boss-img-width: ${width}px`}>
    <img
      src={imgUrl}
      alt={alt}
      loading={loading}
      class="rg-boss-img"
      onerror="this.style.display='none';this.parentElement.classList.add('rg-boss-img-fallback');this.parentElement.innerHTML='<span>'+(this.alt[0]||'?')+'</span>'"
    />
  </div>
) : (
  <div class={`rg-boss-img-fallback ${className || ''}`} style={`--rg-boss-img-width: ${width}px`}>
    <span>{alt[0] || '?'}</span>
  </div>
)}

<style>
  .rg-boss-img-wrapper {
    width: var(--rg-boss-img-width, 64px);
    border-radius: var(--rg-radius-md, 8px);
    background: var(--rg-bg-tertiary);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    line-height: 0;
  }
  .rg-boss-img-wrapper :global(img) {
    width: 100%;
    height: auto;
    max-height: calc(var(--rg-boss-img-width, 64px) * 1.4);
    display: block;
    object-fit: cover;
    object-position: center top;
  }
  .rg-boss-img-fallback {
    width: var(--rg-boss-img-width, 64px);
    height: var(--rg-boss-img-width, 64px);
    border-radius: var(--rg-radius-md, 8px);
    background: var(--rg-bg-tertiary);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-base);
    color: var(--rg-text-muted);
  }
</style>
