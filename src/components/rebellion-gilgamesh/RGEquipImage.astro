---
// Rebellion Gilgamesh equipment icon image component
// Displays equipment icons from public/images/games/rebellion-gilgamesh/equipment/
// Icon field from data (e.g. "劍_31") is matched as substring of filename
// Uses public/ folder (plain URLs) instead of Astro Image to reduce build output.

export interface Props {
  icon?: string;
  alt: string;
  width?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const { icon, alt, width = 64, class: className, loading = 'lazy' } = Astro.props;

// Equipment icons are in public/images/games/rebellion-gilgamesh/equipment/
// The icon field is a substring like "劍_31" that matches a filename
const iconUrl = icon ? `/images/games/rebellion-gilgamesh/equipment/${icon}.png` : '';
---

{iconUrl ? (
  <div class={`rg-equip-img-wrapper ${className || ''}`} style={`--rg-equip-img-width: ${width}px`}>
    <img
      src={iconUrl}
      alt={alt}
      width={width}
      height={width}
      loading={loading}
      class="rg-equip-img"
      onerror="this.parentElement.className+=' rg-equip-img-fallback';this.style.display='none';this.parentElement.querySelector('span')||(this.parentElement.innerHTML='<span>'+(this.alt[0]||'?')+'</span>')"
    />
  </div>
) : (
  <div class={`rg-equip-img-fallback ${className || ''}`} style={`--rg-equip-img-width: ${width}px`}>
    <span>{alt[0] || '?'}</span>
  </div>
)}

<style>
  .rg-equip-img-wrapper {
    width: var(--rg-equip-img-width, 64px);
    height: var(--rg-equip-img-width, 64px);
    border-radius: var(--rg-radius-md, 8px);
    background: var(--rg-bg-tertiary);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .rg-equip-img-wrapper :global(img) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    border-radius: var(--rg-radius-md, 8px);
  }

  .rg-equip-img-fallback {
    width: var(--rg-equip-img-width, 64px);
    height: var(--rg-equip-img-width, 64px);
    border-radius: var(--rg-radius-md, 8px);
    background: var(--rg-bg-tertiary);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-base);
    color: var(--rg-text-muted);
  }
</style>
