---
// Horizon Walker breadcrumb: shared pill design, HW warm accent, full-width
// (no 75rem cap), hw- legacy class.
import BreadcrumbBase from '../BreadcrumbBase.astro';
const style =
  '--bc-accent:var(--hw-primary-warm, #e8a547);--bc-focus:var(--hw-primary-warm, #e8a547);--bc-sep:var(--hw-text-muted, rgba(232, 165, 71, 0.6));--bc-max-width:none;--bc-margin-x:0';
---

<BreadcrumbBase {...Astro.props} classPrefix="hw" ariaLabel="Breadcrumb navigation" style={style} />
