export interface Props {
  imageName: string;
  alt: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  format?: 'webp' | 'jpg' | 'png';
  quality?: number;
}

const {
  imageName,
  alt,
  class: className,
  loading = 'eager',
  format = 'webp',
  quality = 90,
} = Astro.props;

let imageKey = imageName;
if (!imageKey.includes('.')) {
  imageKey = `${imageKey}.jpg`;
}
const imageSrc = characterImageMap[imageKey];
import { r2Url } from '../../data/r2-config.js';
---

<img
  src={r2Url('horizon-walker', imageSrc)}
  alt={alt}
  class={className}
  loading={loading}
/>
