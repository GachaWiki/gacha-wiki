interface Props {
  characterImage: string;
  alt?: string;
  size?: number;
  class?: string;
}

const {
  characterImage,
  alt,
  size = 48,
  class: className,
} = Astro.props;

const crystalSrc = crystalMap[characterImage];
import { r2Url } from '../../data/r2-config.js';
---

{crystalSrc && (
  <div class={`crystal-icon-wrapper ${className || ''}`}>
    <img
      src={r2Url('horizon-walker', crystalSrc)}
      alt={alt || `${characterImage} crystal icon`}
      width={size}
      height={size}
      loading="lazy"
      format="webp"
      class="crystal-icon-img"
    />
  </div>
)}
