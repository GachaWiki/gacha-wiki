---
// Taimanin Squad Character Image Component
// Art is served from the R2 image CDN; image-manifest.js carries each file's
// dimensions and byte size so variant selection works without local files.
// Icon slots: the canonical <icon>_face.png (user-verified per unit), then
// 256x256 squares, then 128x128. Side slots: 256x512 standing art, falling
// back to the 512x2048 loading illustration.
import { TS_IMAGE_MANIFEST } from '../../data/taimanin-squad/image-manifest.js';
import { r2Url } from '../../data/r2-config.js';

export interface Props {
  icon: string;
  alt?: string;
  width?: number;
  height?: number;
  class?: string;
  variant?: 'icon' | 'side';
}

const { icon, alt = 'Character', width = 128, height = 128, class: className = '', variant = 'icon' } = Astro.props;

const iconParts = icon.split('_');
const charId = iconParts[0];
const charName = iconParts.slice(1).join('_');

const ALL = TS_IMAGE_MANIFEST.characterimage;
const charKeys = Object.keys(ALL).filter(
  (k) => k.startsWith(charName + '/') && k.slice(charName.length + 1).startsWith(charId + '_')
);
const dims = (k) => ALL[k][0] + 'x' + ALL[k][1];

function findCharacterImage() {
  if (charKeys.length === 0) return null;

  // canonical face: user-verified per unit; only when it is a square crop
  if (variant === 'icon') {
    const face = charKeys.find((k) => k.endsWith(`/${charId}_${charName}_face.png`) && ALL[k][0] === ALL[k][1]);
    if (face) return face;
  }

  const wanted = variant === 'icon' ? ['256x256', '128x128'] : ['256x512'];
  let matching = [];
  for (const want of wanted) {
    matching = charKeys.filter((k) => dims(k) === want);
    if (matching.length > 0) break;
  }

  // loading illustration is the fallback full-body side portrait for units
  // with no standing art; standing art wins (brighter, cleaner cut)
  if (variant === 'side' && matching.length === 0) {
    const full = charKeys.filter((k) => dims(k) === '512x2048');
    if (full.length) matching = full;
  }

  if (matching.length === 0) {
    const iconMatch = charKeys.find((k) => dims(k) === '128x128');
    if (iconMatch) return iconMatch;
    return null;
  }

  // multiple matches: heaviest file (best quality), per manifest sizes
  return matching.reduce((a, b) => (ALL[b][2] > ALL[a][2] ? b : a));
}

const imageKey = findCharacterImage();
---

{imageKey ? (
  <img
    src={r2Url('taimanin-squad', 'characterimage/' + imageKey)}
    alt={alt}
    width={width}
    height={height}
    class:list={['ts-char-icon', className]}
    loading="lazy"
    decoding="async"
  />
) : (
  <div class:list={['ts-char-icon-fallback', className]} style={`width: ${width}px; height: ${height}px;`}>
    <span>Not Released Yet</span>
  </div>
)}

<style>
  .ts-char-icon {
    object-fit: contain;
  }
</style>
