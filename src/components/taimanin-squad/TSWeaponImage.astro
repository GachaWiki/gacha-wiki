---
// Taimanin Squad Weapon Image Component
// Displays weapon icons from the weaponicon folder on the R2 image CDN

import { tsHas } from '../../data/taimanin-squad/r2-images.js';
import { r2Url } from '../../data/r2-config.js';

export interface Props {
  icon: string;
  alt?: string;
  width?: number;
  height?: number;
  size?: number;
  class?: string;
  variant?: 'base' | 'large';
}

const {
  icon,
  alt = 'Weapon',
  size,
  width = size ?? 40,
  height = size ?? 40,
  class: className = '',
  variant = 'base',
} = Astro.props;

function findWeaponImage() {
  if (tsHas('weaponicon', icon)) return icon;
  if (variant === 'large') {
    const largeIcon = icon.replace('.png', '') + '_l.png';
    if (tsHas('weaponicon', largeIcon)) return largeIcon;
  }
  return null;
}

const imageKey = findWeaponImage();
const imageSrc = imageKey ? r2Url('taimanin-squad', 'weaponicon/' + imageKey) : null;
---

{imageSrc ? (
  <img
    src={imageSrc}
    alt={alt}
    width={width}
    height={height}
    class:list={['ts-weapon-icon', className]}
    loading="lazy"
    decoding="async"
  />
) : (
  <div
    class:list={['ts-weapon-icon-fallback', className]}
    style={`width: ${width}px; height: ${height}px;`}
  >
    <span>W</span>
  </div>
)}

<style>
  .ts-weapon-icon {
    object-fit: contain;
    border-radius: 6px;
    flex-shrink: 0;
  }

  .ts-weapon-icon-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--ts-bg-tertiary, #242028);
    color: var(--ts-text-muted, #888);
    font-weight: 600;
    font-size: var(--text-2xs);
    border-radius: 6px;
    border: 1px dashed var(--ts-border, #2e2838);
  }
</style>
