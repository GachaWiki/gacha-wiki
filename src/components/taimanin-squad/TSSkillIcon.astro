---
// Taimanin Squad Skill Icon Component
// Displays skill icons from Skill_icons folder and Aura icons from Aura folder
// Handles both numeric icons (101.png) and named icons (leader_spd.png)

import { tsImg } from '../../data/taimanin-squad/r2-images.js';

export interface Props {
  icon: string;
  alt?: string;
  size?: number;
  class?: string;
}

const { icon, alt = 'Skill', size = 48, class: className = '' } = Astro.props;

// Find the matching icon (aura icons first, then skill icons)
function findIcon() {
  if (icon.startsWith('leader_')) {
    const aura = tsImg('Aura', `${icon}.png`) || tsImg('Aura', `${icon.toLowerCase()}.png`);
    if (aura) return aura;
  }
  return tsImg('Skill_icons', `${icon}.png`);
}

const iconImage = findIcon();
---

{iconImage ? (
  <img
    src={iconImage}
    alt={alt}
    width={size}
    height={size}
    class:list={['ts-skill-icon', className]}
    loading="lazy"
    decoding="async"
  />
) : (
  <div
    class:list={['ts-skill-icon-fallback', className]}
    style={`width: ${size}px; height: ${size}px;`}
  >
    <span>?</span>
  </div>
)}

<style>
  .ts-skill-icon {
    object-fit: contain;
    display: block;
  }

  .ts-skill-icon-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--ts-bg-tertiary, #242028);
    color: var(--ts-text-muted, #888);
    font-weight: 600;
    font-size: var(--text-base);
    border-radius: 6px;
    border: 1px dashed var(--ts-border, #2e2838);
  }
</style>
