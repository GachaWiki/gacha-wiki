---
// Taimanin Squad Artifact Icon Component
// Displays artifact slot icons from the artifacticon folder on the R2 CDN

import { tsImg } from '../../data/taimanin-squad/r2-images.js';

export interface Props {
  icon: string;
  alt?: string;
  width?: number;
  height?: number;
  class?: string;
}

const {
  icon,
  alt = 'Artifact',
  width = 36,
  height = 36,
  class: className = '',
} = Astro.props;

const imageSrc = tsImg('artifacticon', icon);
---

{imageSrc ? (
  <img
    src={imageSrc}
    alt={alt}
    width={width}
    height={height}
    class:list={['ts-artifact-icon', className]}
    loading="lazy"
    decoding="async"
  />
) : (
  <div
    class:list={['ts-artifact-icon-fallback', className]}
    style={`width: ${width}px; height: ${height}px;`}
  >
    <span>A</span>
  </div>
)}

<style>
  .ts-artifact-icon {
    object-fit: contain;
    border-radius: 6px;
    flex-shrink: 0;
  }

  .ts-artifact-icon-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--ts-bg-tertiary, #242028);
    color: var(--ts-text-muted, #888);
    font-weight: 600;
    font-size: var(--text-2xs);
    border-radius: 6px;
    border: 1px dashed var(--ts-border, #2e2838);
  }
</style>
