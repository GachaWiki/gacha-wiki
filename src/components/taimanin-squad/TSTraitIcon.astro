---
// Taimanin Squad Trait Icon Component
// Displays planetary trait icons (Mars, Venus, Sun, Mercury, Saturn, Moon, Jupiter)

import { tsImg } from '../../data/taimanin-squad/r2-images.js';

const traitMapping: Record<string, number> = {
  'Moon': 1,
  'Mars': 2,
  'Mercury': 3,
  'Jupiter': 4,
  'Venus': 5,
  'Saturn': 6,
  'Sun': 7
};

export interface Props {
  trait: string;
  size?: number;
}

const { trait, size = 24 } = Astro.props;
const iconNumber = traitMapping[trait];
const imageSrc = iconNumber ? tsImg('disposition', `UnitDisPosition_${iconNumber}_Big.png`) : null;
---

{imageSrc && (
  <img
    src={imageSrc}
    alt={trait}
    width={size}
    height={size}
    class="ts-trait-icon"
    title={trait}
    loading="lazy"
    decoding="async"
  />
)}

<style>
  .ts-trait-icon {
    vertical-align: middle;
  }
</style>
