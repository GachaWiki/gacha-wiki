---
// Zone Nova Rune image component — images served from Cloudflare R2
// All sets use the current square game icons (<Name>.webp, same art as the runes page).
// Legacy fan-era icon keys (Shattered-Foundation, Zahn, Giants, Tide, ...) resolve to
// the same canonical files so old build data keeps working.
const R2 = 'https://k2b1c5ab57ed98e51.gachawiki.info/zone-nova/runes';

const setAliases: Record<string, string[]> = {
  Alpha: ['Alpha'],
  Beth: ['Beth'],
  Gimel: ['Gimel', 'Gimel-Continuous-Damage'],
  Daleth: ['Daleth'],
  Epsilon: ['Epsilon'],
  Poki: ['Poki', 'Shattered-Foundation'],
  Zane: ['Zane', 'Zahn'],
  Het: ['Het', 'Hert', 'Hert-Pursuit-Damage'],
  Iota: ['Iota', 'Giants'],
  Kappa: ['Kappa', 'Tide'],
  Kryos: ['Kryos'],
  Anemos: ['Anemos'],
  Hepha: ['Hepha'],
  Skota: ['Skota'],
  Aether: ['Aether'],
  Harmonia: ['Harmonia'],
};

const runeImageMap: Record<string, string> = {};
for (const [canonical, aliases] of Object.entries(setAliases)) {
  for (const alias of aliases) {
    runeImageMap[alias] = `${R2}/${canonical}.webp`;
    runeImageMap[`${alias}.jpg`] = `${R2}/${canonical}.webp`;
    runeImageMap[`${alias}.webp`] = `${R2}/${canonical}.webp`;
  }
}
runeImageMap['element.jpg'] = `${R2}/element.jpg`;

const {
  imageName,
  alt,
  width = 200,
  height = 200,
  class: className = '',
  loading = 'lazy',
} = Astro.props;

let imageKey = imageName || 'Alpha';
if (imageKey && imageKey.includes('/')) {
  const parts = imageKey.split('/');
  imageKey = parts[parts.length - 1] || 'Alpha';
}
if (imageKey && !imageKey.includes('.')) {
  imageKey = `${imageKey}.jpg`;
}

// Unknown set names try their own file before giving up — never silently
// fall back to Alpha's icon (that hid the wrong-icon bug for the new sets).
const imageSrc =
  runeImageMap[imageKey] || `${R2}/${imageKey.replace(/\.(jpg|jpeg|png|webp)$/i, '')}.webp`;
---

<img
  src={imageSrc}
  alt={alt}
  width={width}
  height={height}
  class={className}
  loading={loading}
  decoding="async"
/>
