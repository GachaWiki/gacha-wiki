---
import ZNRunesImage from './ZNRunesImage.astro';
// Canonical set data — resolves legacy icon names (Zahn, Giants, Tide, ...) and
// plain names to the current game names (Zane, Iota, Kappa, ...) and live set text.
import { RUNE_SETS } from '../../data/zone-nova/runes.js';

interface Props {
  runeSet: any;
}

const { runeSet } = Astro.props;

const lookupSet = (key: string) =>
  RUNE_SETS[key] || RUNE_SETS[key?.replace(/\.(webp|jpg|png)$/i, '')] || null;

// Function to determine the rune configuration type and extract rune data
function getRuneConfiguration(runeSet) {
  // Generic 2+2+2 configuration: threeSets = ['Poki', 'Kappa', 'Beth']
  if (Array.isArray(runeSet.threeSets) && runeSet.threeSets.length >= 3) {
    const runes = runeSet.threeSets.map((name: string) => ({
      name,
      pieces: '2-piece',
      effect: lookupSet(name)?.twoPiece || '',
    }));
    return {
      type: '3-set',
      runes,
      name:
        runeSet.englishName ||
        runes.map(r => lookupSet(r.name)?.name || r.name).join(' 2-piece + ') + ' 2-piece',
    };
  }
  // Check if this is a 3-set configuration (separate 2-piece runes)
  if (
    (runeSet.shatteredFoundation && runeSet.tide && runeSet.zahn) ||
    (runeSet.giants && runeSet.epsilon && runeSet.alpha)
  ) {
    const runes = [];
    const effects = [];

    // Giants + Epsilon + Alpha configuration
    if (runeSet.giants && runeSet.epsilon && runeSet.alpha) {
      runes.push(
        { name: 'Giants', pieces: '2-piece', effect: runeSet.giants.effect },
        { name: 'Epsilon', pieces: '2-piece', effect: runeSet.epsilon.effect },
        { name: 'Alpha', pieces: '2-piece', effect: runeSet.alpha.effect }
      );
    }
    // Shattered Foundation + Tide + Zahn configuration
    else if (runeSet.shatteredFoundation && runeSet.tide && runeSet.zahn) {
      runes.push(
        {
          name: 'Shattered-Foundation',
          pieces: '2-piece',
          effect: runeSet.shatteredFoundation.effect,
        },
        { name: 'Tide', pieces: '2-piece', effect: runeSet.tide.effect },
        { name: 'Zahn', pieces: '2-piece', effect: runeSet.zahn.effect }
      );
    }

    return {
      type: '3-set',
      runes: runes,
      name:
        runes.map(r => lookupSet(r.name)?.name || r.name.replace('-', ' ')).join(' 2-piece + ') +
          ' 2-piece' ||
        runeSet.englishName ||
        runeSet.name,
    };
  }

  // Check if this is a standard 4-piece + 2-piece configuration
  else if (runeSet.mainRune && runeSet.secondaryRune) {
    const mainSet = lookupSet(runeSet.mainRune);
    const secondarySet = lookupSet(runeSet.secondaryRune);
    const canonicalName =
      mainSet && secondarySet ? `${mainSet.name} 4-piece + ${secondarySet.name} 2-piece` : null;

    return {
      type: '4+2',
      mainRune: runeSet.mainRune,
      mainRuneName: mainSet?.name || runeSet.mainRune,
      secondaryRune: runeSet.secondaryRune,
      secondaryRuneName: secondarySet?.name || runeSet.secondaryRune,
      mainRune4Piece: (mainSet && `4-piece: ${mainSet.fourPiece}`) || runeSet.mainRune4Piece || '',
      mainRune2Piece: (mainSet && `2-piece: ${mainSet.twoPiece}`) || runeSet.mainRune2Piece || '',
      secondaryRuneEffect:
        (secondarySet && `2-piece: ${secondarySet.twoPiece}`) || runeSet.secondaryRuneEffect || '',
      name: canonicalName || runeSet.englishName || runeSet.name,
    };
  }

  // Fallback for unknown configurations
  return {
    type: 'unknown',
    name: runeSet.englishName || runeSet.name || 'Unknown Rune Set',
    runes: [],
  };
}

const config = getRuneConfiguration(runeSet);
---

<div
  style="background-color: var(--zn-bg-secondary); border: 1px solid var(--zn-border); border-radius: 4px; padding: 1rem; text-align: center;"
>
  {
    config.type === '3-set' ? (
      <>
        <div style="display: flex; justify-content: center; align-items: center; gap: 0.75rem; margin-bottom: 1rem; flex-wrap: wrap;">
          {config.runes.map((rune, index) => (
            <>
              <div style="text-align: center;">
                <div style="width: 58px; height: 58px; border-radius: 4px; border: 1px solid var(--zn-border-light); background-color: var(--zn-bg-tertiary); display: flex; align-items: center; justify-content: center; overflow: hidden;">
                  <ZNRunesImage
                    imageName={rune.name}
                    alt={`${lookupSet(rune.name)?.name || rune.name} rune (${rune.pieces})`}
                    width={58}
                    height={58}
                    loading="eager"
                    style="width: 100%; height: 100%; object-fit: contain; display: block;"
                  />
                </div>
                <div style="font-size: var(--text-2xs); color: var(--zn-text-secondary); margin-top: 0.25rem;">
                  {rune.pieces}
                </div>
              </div>
              {index < config.runes.length - 1 && (
                <div style="font-size: var(--text-xl); color: var(--zn-text-secondary); font-weight: 600;">
                  +
                </div>
              )}
            </>
          ))}
        </div>
        <div style="color: var(--zn-text-primary); font-weight: 600; font-size: var(--text-base);">
          {config.name}
        </div>
        <div style="margin-top: 0.75rem; text-align: left;">
          {config.runes.map(rune => (
            <div style="font-size: var(--text-md); color: var(--zn-text-secondary); margin-bottom: 0.5rem;">
              <strong style="color: var(--zn-primary);">{lookupSet(rune.name)?.name || rune.name.replace('-', ' ')}:</strong>{' '}
              {lookupSet(rune.name)?.twoPiece || rune.effect.replace(/^2-piece:\s*/, '')}
            </div>
          ))}
          {runeSet.description && (
            <div style="font-size: var(--text-md); color: var(--zn-text-muted); margin-top: 0.5rem; font-style: italic;">
              {runeSet.description}
            </div>
          )}
        </div>
      </>
    ) : config.type === '4+2' ? (
      <>
        <div style="display: flex; justify-content: center; align-items: center; gap: 1rem; margin-bottom: 1rem;">
          <div style="text-align: center;">
            <div style="width: 64px; height: 64px; border-radius: 4px; border: 1px solid var(--zn-border-light); background-color: var(--zn-bg-tertiary); display: flex; align-items: center; justify-content: center; overflow: hidden;">
              <ZNRunesImage
                imageName={config.mainRune}
                alt={`${config.mainRuneName} rune (4-piece)`}
                width={64}
                height={64}
                loading="eager"
                style="width: 100%; height: 100%; object-fit: contain; display: block;"
              />
            </div>
            <div style="font-size: var(--text-xs); color: var(--zn-text-secondary); margin-top: 0.5rem;">
              4-piece
            </div>
          </div>
          <div style="font-size: var(--text-2xl); color: var(--zn-text-secondary); font-weight: 600;">+</div>
          <div style="text-align: center;">
            <div style="width: 64px; height: 64px; border-radius: 4px; border: 1px solid var(--zn-border-light); background-color: var(--zn-bg-tertiary); display: flex; align-items: center; justify-content: center; overflow: hidden;">
              <ZNRunesImage
                imageName={config.secondaryRune}
                alt={`${config.secondaryRuneName} rune (2-piece)`}
                width={64}
                height={64}
                loading="eager"
                style="width: 100%; height: 100%; object-fit: contain; display: block;"
              />
            </div>
            <div style="font-size: var(--text-xs); color: var(--zn-text-secondary); margin-top: 0.5rem;">
              2-piece
            </div>
          </div>
        </div>
        <div style="color: var(--zn-text-primary); font-weight: 600; font-size: var(--text-base);">
          {config.name}
        </div>
        <div style="margin-top: 0.75rem; text-align: left;">
          {config.mainRune2Piece && (
            <div style="font-size: var(--text-md); color: var(--zn-text-secondary); margin-bottom: 0.5rem;">
              <strong style="color: var(--zn-primary);">2-piece ({config.mainRuneName}):</strong>{' '}
              {config.mainRune2Piece.replace(/^2-piece:\s*/, '')}
            </div>
          )}
          {config.mainRune4Piece && (
            <div style="font-size: var(--text-md); color: var(--zn-text-secondary); margin-bottom: 0.5rem;">
              <strong style="color: var(--zn-primary);">4-piece ({config.mainRuneName}):</strong>{' '}
              {config.mainRune4Piece.replace(/^4-piece:\s*/, '')}
            </div>
          )}
          {config.secondaryRuneEffect && (
            <div style="font-size: var(--text-md); color: var(--zn-text-secondary);">
              <strong style="color: var(--zn-primary);">2-piece ({config.secondaryRuneName}):</strong>{' '}
              {config.secondaryRuneEffect.replace(/^2-piece:\s*/, '')}
            </div>
          )}
          {runeSet.description && (
            <div style="font-size: var(--text-md); color: var(--zn-text-muted); margin-top: 0.5rem; font-style: italic;">
              {runeSet.description}
            </div>
          )}
        </div>
      </>
    ) : (
      <>
        <div style="color: var(--zn-text-primary); font-weight: 600; font-size: var(--text-base);">
          {config.name}
        </div>
        <div style="margin-top: 0.75rem; text-align: left; color: var(--zn-text-secondary);">
          Rune set configuration not recognized
        </div>
      </>
    )
  }
</div>
