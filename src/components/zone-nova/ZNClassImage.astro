---
// Zone Nova class icon component
// Maps Zone Nova class names to the current public class icon assets.

const CLASSES_R2 = 'https://k2b1c5ab57ed98e51.gachawiki.info/zone-nova/classes';

const classImageMap = {
  Attacker: `${CLASSES_R2}/Attacker.png`,
  Warrior: `${CLASSES_R2}/Warrior.png`,
  Destroyer: `${CLASSES_R2}/Destroyer.png`,
  Tank: `${CLASSES_R2}/Tank.png`,
  Supporter: `${CLASSES_R2}/Supporter.png`,
  Healer: `${CLASSES_R2}/Healer.png`,
  Disruptor: `${CLASSES_R2}/Disruptor.png`,
};

interface Props {
  className: string;
  alt: string;
  size?: 'small' | 'medium' | 'large';
  width?: number;
  height?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const {
  className,
  alt,
  size,
  width,
  height,
  class: classNameProp = '',
  loading = 'lazy',
} = Astro.props;

// Size presets for class icons
const sizePresets = {
  small: { width: 24, height: 24 },
  medium: { width: 48, height: 48 },
  large: { width: 80, height: 80 },
};

// Use size preset if provided, otherwise use explicit dimensions
const dimensions = size ? sizePresets[size] : { width: width || 48, height: height || 48 };

// Unknown class names (e.g. "Universal"/"DPS" memory cards) have no icon —
// render nothing rather than a misleading fallback icon.
const imageSrc = classImageMap[className];
---

{imageSrc && (
  <img
    src={imageSrc}
    alt={alt}
    width={dimensions.width}
    height={dimensions.height}
    class={classNameProp}
    loading={loading}
    decoding="async"
  />
)}
