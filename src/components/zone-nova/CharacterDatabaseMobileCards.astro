---
import { ZNCharacterImage, ZNClassImage } from './index.astro';
import { ZONE_NOVA_CHARACTERS } from '../../data/zone-nova/characters.js';
---

<!-- Mobile card view container -->
<div class="mobile-card-view" id="mobile-cards-container">
  {
    ZONE_NOVA_CHARACTERS.map(char => (
      <div
        class="mobile-character-card"
        data-character-id={char.id}
        data-slug={char.slug}
        data-url={char.detailUrl}
        role="button"
        tabindex="0"
        style="cursor:pointer;"
      >
        <div class="mobile-card-header">
          <div class="mobile-card-images">
            <div style="width: 64px; height: 64px; border-radius: 10px; border: 2px solid var(--amber-glow); overflow: hidden;">
              <ZNCharacterImage
                imageName={char.image}
                alt={char.name}
                class="character-img"
                width={64}
                height={64}
              />
            </div>
            <ZNClassImage
              className={char.class}
              alt={char.class}
              class="mobile-class-icon-standalone"
              width={24}
              height={24}
            />
          </div>
          <div class="mobile-card-title-group">
            <h3>{char.name}</h3>
          </div>
        </div>

        {/* Character meta line (plain text, no badges) */}
        <p class="mobile-card-meta">
          {char.rarity}, {char.element}, {char.class}, {char.faction}
        </p>

        <div class="mobile-card-stats">
          <div>
            <span class="stat-label">Max HP:</span> {(char.maxStats?.hp ?? char.stats.hp).toLocaleString()}
          </div>
          <div>
            <span class="stat-label">Max ATK:</span> {(char.maxStats?.attack ?? char.stats.attack).toLocaleString()}
          </div>
          <div>
            <span class="stat-label">Max DEF:</span> {(char.maxStats?.defense ?? char.stats.defense).toLocaleString()}
          </div>
        </div>
        <div class="mobile-card-stats mobile-card-stats-secondary">
          <div>
            <span class="stat-label">Max Crit Rate:</span> {char.maxCritRate}%
          </div>
          <div>
            <span class="stat-label">Max Crit DMG:</span> {char.maxCritDmg}%
          </div>
        </div>

        {/* Gameplay Tags (plain text, no chips) */}
        {char.tags && char.tags.length > 0 && (
          <div class="mobile-card-tags">
            <div class="tags-label">Gameplay Tags:</div>
            <p class="mobile-card-tags-text">{char.tags.join(', ')}</p>
          </div>
        )}
      </div>
    ))
  }
</div>
