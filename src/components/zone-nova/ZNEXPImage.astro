---
// Zone Nova EXP image component — images served from Cloudflare R2
const R2 = 'https://img.gachawiki.info/zone-nova/EXP';

const expImageMap = {
  'highgrade-cube.jpg': `${R2}/highgrade-cube.jpg`,
  'highgrade-chip.jpg': `${R2}/highgrade-chip.jpg`,
  'highestgrade.jpg': `${R2}/highestgrade.jpg`,
  'lowgrade-cube.jpg': `${R2}/lowgrade-cube.jpg`,
  'lowgrade.jpg': `${R2}/lowgrade.jpg`,
  'lowgrade-chip.jpg': `${R2}/lowgrade-chip.jpg`,
  'midgrade-cube.jpg': `${R2}/midgrade-cube.jpg`,
  'midgrade.jpg': `${R2}/midgrade.jpg`,
  'midgrade-chip.jpg': `${R2}/midgrade-chip.jpg`,
};

const {
  imageName,
  alt,
  width = 200,
  height = 200,
  class: className = '',
  loading = 'lazy',
} = Astro.props;

let imageKey = imageName;
if (imageKey.includes('/')) {
  const parts = imageKey.split('/');
  imageKey = parts[parts.length - 1] || 'lowgrade.jpg';
}
if (!imageKey.includes('.')) {
  imageKey = `${imageKey}.jpg`;
}

const imageSrc = expImageMap[imageKey] || `${R2}/lowgrade.jpg`;
---

<img
  src={imageSrc}
  alt={alt}
  width={width}
  height={height}
  class={className}
  loading={loading}
  decoding="async"
/>
