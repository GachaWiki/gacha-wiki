---
// Zone Nova node tree image component — images served from Cloudflare R2
const R2 = 'https://img.gachawiki.info/zone-nova/nodetree';

const nodeTreeImageMap = {
  '1.jpg': `${R2}/1.jpg`,
  '2.jpg': `${R2}/2.jpg`,
  '3.jpg': `${R2}/3.jpg`,
  'FullTree.jpg': `${R2}/FullTree.jpg`,
  'skills.jpg': `${R2}/skills.jpg`,
};

const {
  imageName,
  alt,
  width = 100,
  height = 100,
  class: className = '',
  loading = 'lazy',
} = Astro.props;

let imageKey = imageName;
if (!imageKey.includes('.')) {
  imageKey = `${imageKey}.jpg`;
}
const imageSrc = nodeTreeImageMap[imageKey] || `${R2}/FullTree.jpg`;
---

<img
  src={imageSrc}
  alt={alt}
  width={width}
  height={height}
  class={className}
  loading={loading}
  decoding="async"
/>
