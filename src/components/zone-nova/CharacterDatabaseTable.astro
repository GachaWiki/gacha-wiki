---
import { ZNCharacterImage, ZNClassImage } from './index.astro';
import { ZONE_NOVA_CHARACTERS } from '../../data/zone-nova/characters.js';
---

<!-- Desktop table view -->
<div class="character-table-container">
  <table class="character-table">
    <caption class="db-max-stats-note">
      Stat columns show <strong>max values</strong> (base stats with the full talent tree unlocked).
      Base values are on each character's page.
    </caption>
    <thead>
      <tr>
        <th>#</th>
        <th>Image</th>
        <th>Name</th>
        <th>Rarity</th>
        <th>Element</th>
        <th>Icon</th>
        <th>Class</th>
        <th>Faction</th>
        <th>Max HP</th>
        <th>Max Attack</th>
        <th>Max Defense</th>
        <th>Max Crit Rate</th>
        <th>Max Crit DMG</th>
      </tr>
    </thead>
    <tbody id="character-table-body">
      {
        ZONE_NOVA_CHARACTERS.map((char, idx) => (
          <tr
            data-character-id={char.id}
            data-slug={char.slug}
            data-url={char.detailUrl}
            role="button"
            tabindex="0"
            style="cursor:pointer;"
          >
            <td>{idx + 1}</td>
            <td>
              <div style="width: 40px; height: 40px; border-radius: 8px; border: 1px solid var(--amber-glow); overflow: hidden;">
                <ZNCharacterImage
                  imageName={char.image}
                  alt={char.name}
                  class="character-img"
                  width={40}
                  height={40}
                />
              </div>
            </td>
            <td class={`zn-text-${char.element.toLowerCase()}`}>{char.name}</td>
            <td data-sort-key="rarity" class={`zn-text-${char.rarity.toLowerCase()}`}>{char.rarity}</td>
            <td data-sort-key="element" class={`zn-text-${char.element.toLowerCase()}`}>{char.element}</td>
            <td style="text-align: center; vertical-align: middle;">
              <ZNClassImage
                className={char.class}
                alt={char.class}
                class="class-icon-standalone"
                width={24}
                height={24}
              />
            </td>
            <td data-sort-key="class">{char.class}</td>
            <td data-sort-key="faction">{char.faction}</td>
            <td data-sort-key="hp">{(char.maxStats?.hp ?? char.stats.hp).toLocaleString()}</td>
            <td data-sort-key="attack">{(char.maxStats?.attack ?? char.stats.attack).toLocaleString()}</td>
            <td data-sort-key="defense">{(char.maxStats?.defense ?? char.stats.defense).toLocaleString()}</td>
            <td data-sort-key="critRate">{char.maxCritRate}%</td>
            <td data-sort-key="critDmg">{char.maxCritDmg}%</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
