---
// Site-wide news ticker bar in Header.astro.
// (1) The coupon CODE chip: ONE split-flap chip that cycles through the
//     live codes of ALL games (each ticker.js entry carrying a `code`
//     object contributes panels). Every panel carries its own game label,
//     expiry and link; the code itself machine-flips, the rest swaps with
//     it at the flip midpoint.
// (2) The UPDATES tape: a slow CSS marquee looping pinned items from
//     src/data/ticker.js plus wiki updates AUTO-GENERATED from git history
//     by src/utils/ticker-updates.ts. Scrolling text has no spacing issues:
//     every item just scrolls by at its natural length. The item list is
//     duplicated in the markup so the translateX(-50%) loop is seamless.
// (3) The live $GW price chip stays pinned on the right.
import { tickerItems } from '../data/ticker';
import { getTickerUpdates } from '../utils/ticker-updates';

const codeChips = tickerItems.filter(item => item.code);
const codePanels = codeChips.flatMap(chip =>
  chip.code.panels.map(panel => ({
    label: chip.code.label,
    code: panel,
    until: chip.code.until ?? '',
    isNew: !!chip.code.isNew,
    href: chip.href,
    title: chip.text,
  }))
);
const tapeItems = [...tickerItems.filter(item => !item.code), ...getTickerUpdates()];
---

<div class="news-ticker">
  <div class="ticker-inner">
    {codePanels.length > 0 && (
      <a class="ticker-code-chip" href={codePanels[0].href} title={codePanels[0].title} aria-label={codePanels[0].title}>
        <span class="ticker-code-label" id="ticker-code-label">{codePanels[0].label}</span>
        <span
          class="ticker-code-value"
          id="ticker-code-flip"
          data-panels={JSON.stringify(codePanels)}
        >{codePanels[0].code}</span>
        <span class="ticker-code-new" id="ticker-code-new" hidden={!codePanels[0].isNew}>New</span>
        <span class="ticker-code-until" id="ticker-code-until" hidden={!codePanels[0].until}>{codePanels[0].until}</span>
      </a>
    )}

    <div class="ticker-viewport">
      <div class="ticker-track">
        {
          [false, true].map((isClone) => (
            <ul class:list={['ticker-group', { clone: isClone }]} aria-hidden={isClone ? 'true' : undefined}>
              {tapeItems.map((item) => (
                <li class="ticker-item">
                  <a href={item.href} title={item.text}>
                    <span class="ticker-date">{item.date}</span>
                    <span class="ticker-game">{item.game}</span>
                    <span class="ticker-text">{item.text}</span>
                  </a>
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>

    <!-- Live $GW stats chip, pinned right. Price and the 24h change stay
         visible once loaded; the other stats (1h change / market cap /
         volume / liquidity) cycle next to them every few seconds. Hidden
         until data loads (DexScreener free API, see the script below). -->
    <span class="ticker-price" id="gw-price-chip" hidden>
      <span class="ticker-price-label">$GW</span>
      <span class="ticker-price-stat c-amber" id="gw-price" hidden></span>
      <span class="ticker-price-stat" id="gw-change" hidden></span>
      <span class="ticker-price-stat" id="gw-stat"></span>
    </span>
  </div>
</div>

<style>
  /* Same chrome as the old token banner: dark gradient bar + amber border,
     matching the Header/Footer treatment. */
  .news-ticker {
    display: block;
    width: 100%;
    background: var(--bg-dark);
    border-bottom: 1px solid rgba(255, 183, 77, 0.3);
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }

  .ticker-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0.4rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--text-inverse, #ffffff);
    font-size: var(--text-xs);
  }

  /* Coupon CODE chip: green mono code, red static New tag, expiry date.
     Leads the bar; the updates tape scrolls to its right. */
  .ticker-code-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    height: 1.75rem;
    padding: 0 0.8rem;
    border-radius: 999px;
    background: rgba(76, 175, 80, 0.08);
    border: 1px solid rgba(76, 175, 80, 0.35);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    perspective: 160px;
  }

  .ticker-code-label {
    color: var(--amber-glow, #ffb74d);
    font-size: var(--text-2xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .ticker-code-new {
    color: #ff7676;
    font-size: var(--text-3xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .ticker-code-until {
    color: var(--text-inverse, #ffffff);
    opacity: 0.6;
    font-size: var(--text-2xs);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .ticker-code-value {
    display: inline-block;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--success-color, #4caf50);
    font-size: var(--text-base);
  }

  /* Scrolling updates tape */
  .ticker-viewport {
    overflow: hidden;
    flex: 1;
    min-width: 0;
  }

  /* width:max-content keeps both groups on one line; translating the track
     by exactly half its width (one group) loops the marquee seamlessly.
     Duration comes from the script below so the tape always scrolls at a
     constant px/s; the 55s here is only the no-JS fallback. */
  .ticker-track {
    display: flex;
    width: max-content;
    animation: ticker-scroll 55s linear infinite;
  }

  .ticker-group {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 0;
    margin: 0;
    padding-right: 2rem;
    list-style: none;
  }

  .ticker-item {
    white-space: nowrap;
  }

  .ticker-item a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    text-decoration: none;
    color: var(--text-inverse, #ffffff);
  }

  .ticker-date {
    color: var(--text-inverse, #ffffff);
    opacity: 0.55;
    font-size: var(--text-2xs);
    font-variant-numeric: tabular-nums;
  }

  .ticker-game {
    color: var(--amber-glow, #ffb74d);
    font-size: var(--text-2xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .ticker-text {
    opacity: 0.85;
    font-size: var(--text-xs);
  }

  @keyframes ticker-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* Live $GW stats chip, pinned on the right edge of the bar. Price stays
     visible; the other stats cycle next to it, monospace numbers. */
  .ticker-price[hidden] {
    display: none;
  }

  .ticker-price {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding-left: 0.65rem;
    border-left: 1px solid rgba(255, 183, 77, 0.25);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .ticker-price-label {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    color: var(--amber-glow, #ffb74d);
    font-weight: 700;
    font-size: var(--text-sm);
  }

  .ticker-price-stat {
    font-weight: 700;
    font-size: var(--text-sm);
  }

  /* Color states, set by the script per-stat so each metric gets its accent */
  .ticker-price-stat.c-amber { color: var(--amber-glow, #ffb74d); }
  .ticker-price-stat.c-up { color: var(--success-color, #4caf50); }
  .ticker-price-stat.c-down { color: #ff7676; }
  .ticker-price-stat.c-teal { color: var(--teal-crystal, #00acc1); }
  .ticker-price-stat.c-muted { color: var(--text-inverse, #ffffff); opacity: 0.75; }

  @media (max-width: 600px) {
    .ticker-inner {
      font-size: var(--text-2xs);
      gap: 0.5rem;
      padding: 0.35rem 0.75rem;
    }

    .ticker-code-value {
      font-size: var(--text-xs);
    }

    /* Dates cost width on phones; the game name already anchors each item. */
    .ticker-date {
      display: none;
    }

    .ticker-group {
      gap: 2rem;
      padding-right: 2rem;
    }

    .ticker-price-label,
    .ticker-price-stat {
      font-size: var(--text-xs);
    }

    .ticker-price {
      padding-left: 0.5rem;
      gap: 0.25rem;
    }
  }

  @media (max-width: 380px) {
    /* Very narrow phones: the code chip drops its game label and expiry;
       the code itself stays up. */
    .ticker-code-label,
    .ticker-code-until {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-track {
      animation: none;
    }
  }
</style>

<script>
  // Constant tape speed: the marquee duration is derived from the real track
  // width so the tape always scrolls at TICKER_SPEED px/s. The update items
  // come from the git log at build time, so the item count (and track width)
  // differs between builds; a fixed CSS duration made narrow tickers crawl.
  // One group = half the doubled track, duration = width / speed.
  const TICKER_SPEED = 55; // px per second (calm drift)
  const track = document.querySelector('.ticker-track');
  if (track) {
    const groupWidth = track.scrollWidth / 2;
    if (groupWidth > 0) {
      track.style.animationDuration = `${(groupWidth / TICKER_SPEED).toFixed(1)}s`;
    }
  }
</script>

<script>
  // Code chip cycle: NO animation, the panel just swaps instantly every 5s
  // (code, game label, expiry, New tag and link all change together in one
  // discrete step). Static under prefers-reduced-motion.
  const flipEl = document.getElementById('ticker-code-flip') as HTMLElement | null;
  const labelEl = document.getElementById('ticker-code-label');
  const newEl = document.getElementById('ticker-code-new');
  const untilEl = document.getElementById('ticker-code-until');
  const chipEl = flipEl?.closest('a') as HTMLAnchorElement | null;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  interface CodePanel {
    label: string;
    code: string;
    until: string;
    isNew: boolean;
    href: string;
    title: string;
  }

  let panels: CodePanel[] = [];
  try {
    panels = JSON.parse(flipEl?.dataset.panels || '[]');
  } catch {
    panels = [];
  }

  const applyPanel = (p: CodePanel) => {
    if (flipEl) flipEl.textContent = p.code;
    if (labelEl) labelEl.textContent = p.label;
    if (newEl) newEl.hidden = !p.isNew;
    if (untilEl) {
      untilEl.textContent = p.until;
      untilEl.hidden = !p.until;
    }
    if (chipEl) {
      chipEl.setAttribute('href', p.href);
      chipEl.setAttribute('title', p.title);
    }
  };

  if (flipEl && panels.length > 1 && !reduceMotion) {
    let i = 0;
    window.setInterval(() => {
      i = (i + 1) % panels.length;
      applyPanel(panels[i]);
    }, 5000);
  }
</script>

<script>
  // Live $GW stats for the pinned right chip, fetched from DexScreener's
  // free public API (no key, Robinhood Chain 4663 supported). Price and the
  // 24h change are ALWAYS visible side by side; the remaining metrics (1h
  // change, market cap, volume, liquidity) cycle in the third slot every few
  // seconds, each color-coded.
  // Cached in sessionStorage for 60s so navigating between pages doesn't
  // spam the API (free tier = 60 req/min).
  const GW_CA_KEY = '0x50bE7832849EFEdB15611799074FcC409522f27A';
  const CACHE_KEY = 'gacha-wiki:gw-stats';
  const CACHE_TTL = 60_000; // 60 seconds
  const ROTATE_MS = 3000; // how long each stat shows before cycling

  interface Stats {
    ts: number;
    price: number | null;
    change24h: number | null;
    change1h: number | null;
    mc: number | null;
    volume24h: number | null;
    liquidity: number | null;
  }

  function readCache(): Stats | null {
    try {
      const raw = sessionStorage.getItem(CACHE_KEY);
      if (!raw) return null;
      const parsed = JSON.parse(raw) as Stats;
      if (Date.now() - parsed.ts < CACHE_TTL) return parsed;
    } catch {
      /* ignore */
    }
    return null;
  }

  function writeCache(data: Stats): void {
    try {
      sessionStorage.setItem(CACHE_KEY, JSON.stringify(data));
    } catch {
      /* sessionStorage may be unavailable */
    }
  }

  // --- formatting helpers ------------------------------------------------

  function fmtPrice(usd: number): string {
    if (usd >= 1) return `$${usd.toFixed(4)}`;
    if (usd >= 0.0001) return `$${usd.toFixed(6)}`;
    return `$${usd.toPrecision(4)}`;
  }

  function fmtUsd(usd: number | null): string {
    if (usd == null || !isFinite(usd)) return '';
    if (usd >= 1e6) return `$${(usd / 1e6).toFixed(2)}M`;
    if (usd >= 1e3) return `$${(usd / 1e3).toFixed(1)}K`;
    return `$${usd.toFixed(0)}`;
  }

  function fmtPct(p: number | null): string {
    if (p == null || !isFinite(p)) return '';
    const sign = p >= 0 ? '+' : '';
    return `${sign}${p.toFixed(1)}%`;
  }

  // --- build the list of stats to cycle through --------------------------

  interface StatItem {
    text: string;
    colorClass: string;
  }

  function buildStats(s: Stats): { price: StatItem | null; change: StatItem | null; rest: StatItem[] } {
    const rest: StatItem[] = [];
    if (s.change1h != null) {
      rest.push({
        text: `1h ${fmtPct(s.change1h)}`,
        colorClass: s.change1h >= 0 ? 'c-up' : 'c-down',
      });
    }
    if (s.mc != null) rest.push({ text: `MC ${fmtUsd(s.mc)}`, colorClass: 'c-teal' });
    if (s.volume24h != null) rest.push({ text: `Vol ${fmtUsd(s.volume24h)}`, colorClass: 'c-muted' });
    if (s.liquidity != null) rest.push({ text: `Liq ${fmtUsd(s.liquidity)}`, colorClass: 'c-muted' });
    return {
      price: s.price != null ? { text: fmtPrice(s.price), colorClass: 'c-amber' } : null,
      change:
        s.change24h != null
          ? {
              text: `24h ${fmtPct(s.change24h)}`,
              colorClass: s.change24h >= 0 ? 'c-up' : 'c-down',
            }
          : null,
      rest,
    };
  }

  // --- render + cycle ----------------------------------------------------

  let rotateTimer: ReturnType<typeof setInterval> | undefined;

  function startCycling({
    price,
    change,
    rest,
  }: {
    price: StatItem | null;
    change: StatItem | null;
    rest: StatItem[];
  }) {
    const chip = document.getElementById('gw-price-chip');
    const statEl = document.getElementById('gw-stat');
    const priceEl = document.getElementById('gw-price');
    const changeEl = document.getElementById('gw-change');
    if (!chip || !statEl) return;

    // Price + 24h change get their own always-visible slots; if either's
    // element is somehow missing from the page it falls into the cycle
    // instead so the value is never lost.
    const cycle: StatItem[] = [];
    if (price) {
      if (priceEl) {
        priceEl.textContent = price.text;
        priceEl.hidden = false;
      } else {
        cycle.push(price);
      }
    }
    if (change) {
      if (changeEl) {
        changeEl.textContent = change.text;
        changeEl.className = `ticker-price-stat ${change.colorClass}`;
        changeEl.hidden = false;
      } else {
        cycle.push(change);
      }
    }
    cycle.push(...rest);
    if (cycle.length === 0) return;

    chip.hidden = false;
    let i = 0;

    const show = () => {
      const item = cycle[i % cycle.length];
      statEl.textContent = item.text;
      // reset color classes, apply this stat's color
      statEl.className = `ticker-price-stat ${item.colorClass}`;
      i++;
    };

    show(); // render the first stat immediately
    if (rotateTimer) clearInterval(rotateTimer);
    rotateTimer = setInterval(show, ROTATE_MS);
  }

  async function loadStats(): Promise<void> {
    // 1) Try the cache first (instant, no network).
    const cached = readCache();
    if (cached) {
      startCycling(buildStats(cached));
      return;
    }

    // 2) Fetch fresh data from DexScreener.
    try {
      const res = await fetch(
        `https://api.dexscreener.com/latest/dex/tokens/${GW_CA_KEY}`,
      );
      if (!res.ok) return;
      const json = (await res.json()) as {
        pairs?: Array<{
          chainId?: string;
          priceUsd?: string;
          fdv?: number;
          liquidity?: { usd?: number };
          volume?: { h24?: number };
          priceChange?: { h24?: number; h1?: number };
        }>;
      };

      // Prefer the Robinhood Chain pair; fall back to the first pair.
      const pairs = json.pairs ?? [];
      const pair = pairs.find(p => p.chainId === 'robinhood') ?? pairs[0];
      if (!pair) return;

      const stats: Stats = {
        ts: Date.now(),
        price: pair.priceUsd ? parseFloat(pair.priceUsd) : null,
        change24h: pair.priceChange?.h24 ?? null,
        change1h: pair.priceChange?.h1 ?? null,
        mc: pair.fdv ?? null,
        volume24h: pair.volume?.h24 ?? null,
        liquidity: pair.liquidity?.usd ?? null,
      };

      startCycling(buildStats(stats));
      writeCache(stats);
    } catch {
      /* network/parse failure — leave the chip hidden */
    }
  }

  // Defer the fetch until the browser is idle so it doesn't contend with
  // first paint on any page (the ticker is in the global header). The chip
  // stays hidden until data arrives, so there's no visible downside.
  const start = () => {
    if ('requestIdleCallback' in window) {
      (window as Window).requestIdleCallback(() => loadStats(), { timeout: 4000 });
    } else {
      setTimeout(loadStats, 2000);
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start);
  } else {
    start();
  }
</script>
