---
// Shared character-detail template for the Gene-Sys: Adam non-EN language
// sections: header, Pursuit-system role box, profile, the interactive stats
// calculator (per-language labels + official localized stat names), armament
// and skills. Mirrors the EN/zh pages (gsa-characters.css); pursuit facts
// come from the shared pursuit-roles.js structural data.
import { gsaPursuitRole, GSA_PURSUIT_ROLES } from '../../../data/gene-sys-adam/pursuit-roles.js';
import { GSA_TIER_PLACEMENTS, gsaRarityBadge } from '../../../data/gene-sys-adam/tier-list.js';
import { GSA_STATUSES, GSA_CHAR_STATUSES } from '../../../data/gene-sys-adam/statuses.js';
import { gsaPropertyTypes } from '../../../data/gene-sys-adam/property-types.js';
import { gsaSignatureGear, GSA_GEAR_SLOT_ALIAS, GSA_GEAR_TIER_WORDS } from '../../../data/gene-sys-adam/armament.js';

export interface Props {
  ui: any;
  characters: any[];
  slug: string;
  statLabels: Record<string, string>;
}

const { ui, characters, slug, statLabels } = Astro.props;
const c = characters.find(x => x.slug === slug);
const base = ui.baseUrl;
const L = ui.labels;
const SL = (en) => statLabels[en] || en;
// inverse map: localized stat name -> EN key (affection-track matching)
const INV = Object.fromEntries(Object.entries(statLabels).map(([en, loc]) => [loc, en]));

const profile = c.profile || {};
const stats = c.stats || {};

// Signature gear art (armament.js holds the icon names; join by slug+slot)
const R2 = 'https://pub-dd9a9c01bc7a43d0bb977b255815a5c4.r2.dev/gene-sys-adam';
const gearArt = Object.fromEntries(
  gsaSignatureGear.filter(g => g.icon).map(g => [`${g.slug}|${g.slot}`, `${R2}/${g.icon}.webp`])
);
// EX chain growth per stat (index-aligned with the character's gear stats)
const gearMax = Object.fromEntries(
  gsaSignatureGear.map(g => [`${g.slug}|${g.slot}`, g.stats.map(s => (s.pct ? null : s.max))])
);
// base quality per piece; displayed EX-chain pieces are the Rainbow tier
const gearQuality = Object.fromEntries(gsaSignatureGear.map(g => [`${g.slug}|${g.slot}`, g.quality]));
const TIER_WORDS = GSA_GEAR_TIER_WORDS[ui.htmlLang] || GSA_GEAR_TIER_WORDS.en;
const gearTier = g => (g.name.endsWith(' EX') ? 'Rainbow' : gearQuality[`${c.slug}|${GSA_GEAR_SLOT_ALIAS[g.slot] || g.slot}`] || 'Blue');
const pct = v => `${Number(v) / 100}%`;

const statGroups = [
  { group: L.dpsRating, rows: [
    ['Damage Boost %', '0'], ['ACC %', stats.hitPer], ['Crit %', stats.critPer],
    ['Crit DMG %', stats.critAmpPer], ['Block PEN %', stats.blkPenPer], ['ATK Speed %', stats.atkHastePer],
  ] },
  { group: L.defenseRating, rows: [
    ['Evasion %', stats.ddgPer], ['Crit Evasion %', stats.critRstPer], ['Crit RES %', stats.critDmgRdcPer],
    ['Block %', stats.blkPer], ['DMG BLK %', stats.blkRdcPer],
  ] },
  { group: L.statusRating, rows: [
    ['Freeze RES %', stats.freezeHitRdcPer], ['Burn RES %', stats.burnHitRdcPer],
    ['Electrocute RES %', stats.shockHitRdcPer], ['Petrify RES %', stats.stoneHitRdcPer],
    ['Light RES %', stats.lightHitRdcPer], ['Dark RES %', stats.darkHitRdcPer],
  ] },
  { group: L.specialRating, rows: [
    ['Critical Heal %', stats.healCritPer], ['Critical Heal Bonus %', stats.healCritAmpPer],
    ['Post-Wave HP Recovery %', stats.hpRcvPer], ['Mana Amplification %', stats.manaAmpPer],
    ['Cooldown Speed %', stats.cdHastePer],
  ] },
]
  .map(g => ({ group: g.group, rows: g.rows.map(([label, value]) => [label, value == null || value === '' ? '0%' : pct(value)]) }))
  .filter(g => g.rows.length > 0);
const ratingRows = statGroups.map(g => ({
  group: g.group,
  rows: g.rows.map(([label, value]) => [label, Number(value.replace('%', '')) * 100 || 0]),
}));
const basicTiles = [
  [L.attackRange, stats.atkRange],
  [L.basicGcd, stats.normalAttackGCD ? `${Number(stats.normalAttackGCD) / 1000}s` : null],
].filter(([label, value]) => value != null && value !== '');

const resumeParas = profile.resumeParas || (profile.resume ? [profile.resume] : []);
const tierStats = (c.tierStats || []).slice().sort((a, b) => a.tier - b.tier);
const growth = c.growth || { rate: 1, hp: [0, 0, 0, 0, 0, 0], atk: [0, 0, 0, 0, 0, 0] };
// affection rows carry localized labels; the calculator matches on EN keys
const affectionKeys = (c.affection || []).map(a => ({ key: INV[a.label] || a.label, value: a.value, disp: a.label }));

// pursuit role + partners (factual, from the shared structural data)
const pursuit = gsaPursuitRole(slug);
const ROLE_LABEL = { trigger: L.roleTrigger, enabler: L.roleEnabler, both: L.roleBoth, none: L.roleNone };
const nameBySlug = Object.fromEntries(characters.map(x => [x.slug, x]));
const partners = new Set();
if (pursuit.role !== 'none') {
  for (const [s2, r2] of Object.entries(GSA_PURSUIT_ROLES)) {
    if (s2 === slug || !nameBySlug[s2]) continue;
    const feedsMe = (pursuit.role === 'trigger' || pursuit.role === 'both') &&
      r2.applies.some(a => pursuit.triggers.some(t => t.element === a.element));
    const iFeed = (pursuit.role === 'enabler' || pursuit.role === 'both') &&
      r2.triggers.some(t => pursuit.applies.some(a => a.element === t.element));
    if (feedsMe || iFeed) partners.add(s2);
  }
}
// other playable versions of this character (same nameEn, separate unit)
const versions = characters
  .filter(x => x.slug !== slug && x.nameEn && x.nameEn === c.nameEn)
  .map(x => ({ ...x, rarity: GSA_TIER_PLACEMENTS[x.slug]?.rarity }));
// full display name when two units share a name (title appended)
const nameCount = {};
for (const x of characters) nameCount[x.name] = (nameCount[x.name] || 0) + 1;
const fullName = x => (x && x.title && (nameCount[x.name] || 0) > 1 ? `${x.name} (${x.title})` : x.name);

// statuses/buffs this kit touches, names localized when the loc map has them
const langKey = base.split('/')[1];
const myStatuses = (GSA_CHAR_STATUSES[slug] || [])
  .map(id => GSA_STATUSES[id])
  .filter(Boolean)
  .map(st => ({ ...st, dispName: st.names?.[langKey] || st.name }))
  .sort((a, b) => (a.kind === b.kind ? a.dispName.localeCompare(b.dispName) : a.kind === 'debuff' ? -1 : 1));
---

<div class="gsa-content-section">
  <div class="gsa-detail-header">
    {c.icon ? (
      <img src={c.icon} alt={c.name} class="gsa-detail-art" />
    ) : (
      <div class="gsa-detail-art-monogram">{c.name?.[0]}</div>
    )}
    <div class="gsa-detail-info">
      <h1>{fullName(c)}</h1>
      <p class="gsa-detail-name-zh">{c.nameEn}</p>
      {c.title && <p class="gsa-detail-title">{c.title}</p>}
      {c.epithet && <p class="gsa-detail-epithet">{c.epithet}</p>}
      <div class="gsa-meta">
        {c.attackType && (
          <span class="gsa-chip gsa-chip-type">
            <img src={c.attackType.icon} alt={c.attackType.name} width="20" height="20" loading="lazy" />
            {c.attackType.name}
          </span>
        )}
        {c.job && (
          <span class="gsa-chip gsa-chip-type">
            {c.job.icon && <img src={c.job.icon} alt={c.job.name} width="20" height="20" loading="lazy" />}
            {c.job.name}
          </span>
        )}
        {c.element && (
          <span class="gsa-chip gsa-chip-elem">
            <img src={c.element.icon} alt={c.element.name} width="20" height="20" loading="lazy" />
            {c.element.name}
          </span>
        )}
        {c.rarity && (
          <span class={`gsa-chip ${c.rarity === 'SSR' ? 'solid-gold' : 'solid-accent'}`}>{c.rarity}</span>
        )}
        {!c.inGacha && <span class="gsa-chip solid-muted">{L.notInSummons}</span>}
      </div>
    </div>
  </div>

  <div class={`gsa-pursuit-box${pursuit.role === 'none' ? ' gsa-pursuit-none' : ''}`}>
    <div class="gsa-pursuit-head">
      <span class={`gsa-chip ${pursuit.role === 'none' ? 'solid-muted' : 'solid-accent'}`}>{ROLE_LABEL[pursuit.role]}</span>
      <span class="gsa-pursuit-title">{L.pursuitTitle}</span>
    </div>
    {pursuit.role === 'none' ? (
      <p class="gsa-pursuit-line">{L.pursuitNoneNote}</p>
    ) : (
      <div>
        {pursuit.triggers.map(t => (
          <p class="gsa-pursuit-line">
            {L.pTriggers} <b>{t.pursuit}</b> ({t.status}, {t.element}){L.pOnFinalHitsVs}{t.status} {L.pTargetsColon} {t.skills.join(', ')}.
            {t.grades.length > 0 && ` ${L.pGrade} ${t.grades.join('/')}.`}
          </p>
        ))}
        {pursuit.applies.map(a => (
          <p class="gsa-pursuit-line">
            {L.pApplies} <b>{a.status}</b> ({a.element}){a.grades.length > 0 && ` ${L.pGrade} ${a.grades.join('/')}`}
            {a.chance && ` (${a.chance} ${L.pChance})`}
            {a.via === 'passive' ? ` ${L.pViaPassive}` : ''}: {a.skills.join(', ')}. {L.pConsumedBy}
          </p>
        ))}
        {pursuit.riders.map(r => <p class="gsa-pursuit-line">{r.en}.</p>)}
        {partners.size > 0 && (
          <p class="gsa-pursuit-line gsa-pursuit-partners">
            {L.pPartners}{' '}
            {[...partners].map((s2, i) => (
              <fragment>
                {i > 0 && ', '}
                <a href={`${base}characters/${s2}/`}>{nameBySlug[s2]?.name || s2}</a>
              </fragment>
            ))}.
          </p>
        )}
      </div>
    )}
  </div>

  {versions.length > 0 && (
    <div class="gsa-detail-section gsa-versions">
      <h2>{L.versionsTitle}</h2>
      <p class="gsa-section-note">{L.versionsNote}</p>
      <div class="gsa-version-cards">
        {versions.map(v => (
          <a class="gsa-version-card" href={`${base}characters/${v.slug}/`}>
            {v.icon ? (
              <img class="gsa-version-icon" src={v.icon} alt={fullName(v)} width="72" height="72" loading="lazy" />
            ) : (
              <span class="gsa-version-icon gsa-version-monogram">{v.name?.[0]}</span>
            )}
            <span class="gsa-version-info">
              <span class="gsa-version-name">{fullName(v)}</span>
              <span class="gsa-version-meta">
                {v.rarity && gsaRarityBadge(v.rarity) && (
                  <img class="gsa-version-rarity" src={gsaRarityBadge(v.rarity)} alt={v.rarity} width="38" height="24" loading="lazy" />
                )}
                {v.element && (
                  <span class="gsa-chip gsa-chip-elem">
                    <img src={v.element.icon} alt={v.element.name} width="16" height="16" loading="lazy" />
                    {v.element.name}
                  </span>
                )}
                {v.job && <span class="gsa-chip gsa-chip-type">{v.job.name}</span>}
              </span>
            </span>
          </a>
        ))}
      </div>
    </div>
  )}

  {
    (profile.birthday || profile.age || profile.height || profile.interest || resumeParas.length) ? (
      <div class="gsa-detail-section">
        <h2>{L.profileTitle}</h2>
        <div class="gsa-facts-list">
          {c.sex && <div class="gsa-facts-row"><span>{L.sex}</span><b>{c.sex}</b></div>}
          {profile.birthday && profile.birthday !== '-1' && <div class="gsa-facts-row"><span>{L.birthday}</span><b>{profile.birthday}</b></div>}
          {profile.age && profile.age !== '-1' && <div class="gsa-facts-row"><span>{L.age}</span><b>{profile.age}</b></div>}
          {profile.height && profile.height !== '-1' && <div class="gsa-facts-row"><span>{L.height}</span><b>{profile.height} cm</b></div>}
          {profile.weight && profile.weight !== '-1' && <div class="gsa-facts-row"><span>{L.weight}</span><b>{profile.weight} kg</b></div>}
          {profile.interest && <div class="gsa-facts-row gsa-facts-long"><span>{L.interests}</span><b>{profile.interest}</b></div>}
          {profile.personality && <div class="gsa-facts-row gsa-facts-long"><span>{L.personality}</span><b>{profile.personality}</b></div>}
        </div>
        {resumeParas.length > 0 && (
          <div class="gsa-story">
            <h3 class="gsa-story-title">{L.story}</h3>
            {resumeParas.map(p => <p>{p}</p>)}
          </div>
        )}
      </div>
    ) : null
  }

  <div class="gsa-detail-section" id="gsa-stats">
    <h2>{L.statsTitle}</h2>
    <div class="gsa-calc" id="gsa-calc">
      <div class="gsa-calc-controls">
        <label>
          {L.level}
          <span class="gsa-num">
            <input type="number" id="gsa-calc-lv" min="1" max="50" value="50" />
            <button type="button" class="gsa-num-up" aria-label="+">&#9650;</button>
            <button type="button" class="gsa-num-down" aria-label="-">&#9660;</button>
          </span>
        </label>
        <label>
          {L.classTier}
          <select id="gsa-calc-tier">
            {tierStats.map(t => (
              <option value={t.tier} selected={t.tier === tierStats.length}>{t.tier}</option>
            ))}
          </select>
        </label>
        <label>
          {L.rank}
          <select id="gsa-calc-star">
            {[1, 2, 3, 4, 5, 6].map(s => (
              <option value={s} selected={s === 6}>{s} {L.stars}</option>
            ))}
          </select>
        </label>
        <label>
          {L.affection}
          <select id="gsa-calc-aff">
            <option value="0">{L.affOff}</option>
            <option value="1" selected>{L.affMax}</option>
          </select>
        </label>
      </div>
    </div>

    <table class="gsa-stats-table" id="gsa-allstats" data-aff-group={L.fromAffection}>
      <tbody>
        <tr class="gsa-stats-group"><th colSpan={2}>{L.core}</th></tr>
        <tr>
          <th scope="row"><span>{SL('HP')}</span></th>
          <td id="gsa-row-HP">-</td>
        </tr>
        <tr>
          <th scope="row"><span>{SL('ATK')}</span></th>
          <td id="gsa-row-ATK">-</td>
        </tr>
        {basicTiles.length > 0 && (
          <tr class="gsa-stats-group"><th colSpan={2}>{L.basic}</th></tr>
        )}
        {basicTiles.map(([label, value]) => (
          <tr><th scope="row">{label}</th><td>{value}</td></tr>
        ))}
        {ratingRows.map(g => (
          <>
            <tr class="gsa-stats-group"><th colSpan={2}>{g.group}</th></tr>
            {g.rows.map(([label, baseV]) => (
              <tr>
                <th scope="row"><span>{SL(label)}</span></th>
                <td data-rating={label} data-base={baseV}>{baseV / 100}%</td>
              </tr>
            ))}
          </>
        ))}
      </tbody>
    </table>

    <script type="application/json" id="gsa-calc-data" set:html={JSON.stringify({ tierStats, growth, affection: affectionKeys.map(a => ({ label: a.key, value: a.value })) })} />
    <script is:inline>
      // Stat calculator: Level + Class tier + Rank + Affection -> HP/ATK and
      // rating rows (affection track matched on EN stat keys).
      (function () {
        var dataEl = document.getElementById('gsa-calc-data');
        var lvIn = document.getElementById('gsa-calc-lv');
        var tierIn = document.getElementById('gsa-calc-tier');
        var starIn = document.getElementById('gsa-calc-star');
        var affIn = document.getElementById('gsa-calc-aff');
        if (!dataEl || !lvIn || !tierIn || !starIn || !affIn) return;
        var data = JSON.parse(dataEl.textContent);
        var affGroup = (document.getElementById('gsa-allstats') || {}).getAttribute ? document.getElementById('gsa-allstats').getAttribute('data-aff-group') : '';
        var fmt = function (n) { return Math.round(n).toLocaleString('en-US'); };
        var norm = function (s) { return String(s).replace(/ %$/, '').replace(/%/g, '').trim(); };
        var affMap = {};
        (data.affection || []).forEach(function (a) { affMap[norm(a.label)] = (affMap[norm(a.label)] || 0) + a.value; });
        var affOn = false;
        function statAt(lv, tier, star) {
          var t = data.tierStats.find(function (r) { return r.tier === tier; }) || data.tierStats[data.tierStats.length - 1];
          var g = data.growth;
          var si = Math.max(1, Math.min(6, star)) - 1;
          var atkFlat = affOn ? (affMap['ATK'] || 0) : 0;
          return {
            hp: g.rate * (t.hp + g.hp[si] * lv),
            atk: g.rate * (t.atk + g.atk[si] * lv) + atkFlat,
            hpPer: g.rate * g.hp[si],
            atkPer: g.rate * g.atk[si]
          };
        }
        function renderRows(cur) {
          var hpEl = document.getElementById('gsa-row-HP');
          var atkEl = document.getElementById('gsa-row-ATK');
          if (hpEl) hpEl.textContent = fmt(cur.hp) + ' (+' + fmt(cur.hpPer) + ')';
          if (atkEl) atkEl.textContent = fmt(cur.atk) + ' (+' + fmt(cur.atkPer) + ')';
          var matched = {};
          document.querySelectorAll('#gsa-allstats [data-rating]').forEach(function (td) {
            var base = Number(td.getAttribute('data-base'));
            var key = norm(td.getAttribute('data-rating'));
            var delta = affOn ? (affMap[key] || 0) : 0;
            if (affMap[key]) matched[key] = true;
            td.textContent = delta ? (base + delta) / 100 + '% (+' + delta / 100 + '%)' : base / 100 + '%';
          });
          var table = document.getElementById('gsa-allstats');
          var extras = Object.keys(affMap).filter(function (k) { return !matched[k] && k !== 'ATK' && k !== 'HP'; });
          if (extras.length && !document.getElementById('gsa-aff-extra-body') && table) {
            var wrap = document.createElement('tbody');
            wrap.id = 'gsa-aff-extra-body';
            wrap.innerHTML = '<tr class="gsa-stats-group"><th colSpan="2">' + affGroup + '</th></tr>' +
              extras.map(function (k) {
                return '<tr><th scope="row">' + k + '</th><td>' + affMap[k] / 100 + '%</td>';
              }).join('') + '</tr>';
            table.appendChild(wrap);
          }
          var extraBody = document.getElementById('gsa-aff-extra-body');
          if (extraBody) extraBody.style.display = (affOn && extras.length) ? '' : 'none';
        }
        function render() {
          var lv = Math.max(1, Math.min(50, parseInt(lvIn.value, 10) || 1));
          var tier = parseInt(tierIn.value, 10);
          var star = parseInt(starIn.value, 10);
          affOn = affIn.value === '1';
          renderRows(statAt(lv, tier, star));
        }
        lvIn.addEventListener('input', render);
        tierIn.addEventListener('change', render);
        starIn.addEventListener('change', render);
        affIn.addEventListener('change', render);
        document.querySelectorAll('.gsa-num button').forEach(function (b) {
          b.addEventListener('click', function () {
            var d = b.classList.contains('gsa-num-up') ? 1 : -1;
            lvIn.value = Math.max(1, Math.min(50, (parseInt(lvIn.value, 10) || 1) + d));
            render();
          });
        });
        render();
      })();
    </script>
  </div>

  {(c.gear || []).length > 0 && (
    <div class="gsa-detail-section" id="gsa-armament">
      <h2>{L.armamentTitle}</h2>
        <div class="gsa-gear-grid">
          {c.gear.map(g => {
            const art = gearArt[`${c.slug}|${GSA_GEAR_SLOT_ALIAS[g.slot] || g.slot}`];
            const mxs = gearMax[`${c.slug}|${GSA_GEAR_SLOT_ALIAS[g.slot] || g.slot}`] || [];
            return (
              <div class={`gsa-gear-card gsa-gear-tier-${gearTier(g).toLowerCase()}`}>
                <div class="gsa-gear-head">
                  <span class="gsa-gear-ic" aria-hidden="true">
                    {art
                      ? <img src={art} alt="" width="48" height="48" loading="lazy" />
                      : <span class="gsa-gear-ic-ph">{g.slot[0]}</span>}
                  </span>
                  <span class="gsa-gear-title">
                    <span class="gsa-gear-slot">{g.slot}</span>
                    <span class="gsa-gear-piece">{g.name}</span>
                  </span>
                  <span class="gsa-gear-badges">
                    <span class="gsa-gear-tierpill">{TIER_WORDS[gearTier(g)] || gearTier(g)}</span>
                    <span class="gsa-gear-lv">EX Lv.1-6</span>
                  </span>
                </div>
                <ul class="gsa-gear-rows">
                  {g.stats.map((s, i) => {
                    const mx = mxs[i];
                    const val = s.pct ? `+${s.base / 100}%` : `+${s.base.toLocaleString('en-US')}`;
                    const rng = !s.pct && mx != null && mx !== s.base ? `-${mx.toLocaleString('en-US')}` : '';
                    return <li><span>{s.label}</span><span>{val}{rng}</span></li>;
                  })}
                </ul>
              </div>
            );
          })}
        </div>
    </div>
  )}

  {
    c.skills && c.skills.length ? (
      <div class="gsa-detail-section">
        <h2>{L.skillsTitle}</h2>
        <div class="gsa-skills">
          {c.skills.map(s => (
            <div class={`gsa-skill ${s.slotEn === 'Ultimate' ? 'gsa-skill-ult' : ''}`}>
              <div class="gsa-skill-head">
                <div class="gsa-skill-iconwrap">
                  {s.icon ? (
                    <img src={s.icon} alt="" class="gsa-skill-icon" width="52" height="52" loading="lazy" />
                  ) : (
                    <span class="gsa-skill-icon gsa-skill-icon-ph" aria-hidden="true">{s.name?.[0]}</span>
                  )}
                  {s.slotEn === 'Ultimate' && <span class="gsa-skill-ex">EX</span>}
                </div>
                <div class="gsa-skill-heading">
                  <p class="gsa-skill-name">
                    <span class="gsa-skill-tag">[{s.slot}]</span>
                    {s.name}
                  </p>
                  <div class="gsa-skill-props">
                    {s.mainStat && <p class="gsa-skill-prop"><span>{L.mainStat}:</span> <b>{s.mainStat}</b></p>}
                    {s.type && <p class="gsa-skill-prop"><span>{L.type}:</span> <b>{s.type}</b></p>}
                    {s.cost ? <p class="gsa-skill-prop"><span>{L.cost}:</span> <b>{s.cost} EN</b></p> : null}
                    {s.gcd ? <p class="gsa-skill-prop"><span>{L.gcd}:</span> <b>{s.gcd}</b></p> : null}
                    {s.cooldown ? <p class="gsa-skill-prop"><span>{L.cooldown}:</span> <b>{s.cooldown}</b></p> : null}
                  </div>
                </div>
                {s.unlockStar > 0 && <span class="gsa-chip gsa-star-chip">{s.unlockStar}★</span>}
              </div>
              {s.desc && s.desc.split('\n').map(line => <p class="gsa-skill-desc">{line}</p>)}
              {s.detail && <p class="gsa-skill-detail">{s.detail}</p>}
              {s.awakened && (s.awakened.desc || s.awakened.detail) && (
                <div class="gsa-skill-awake">
                  <span class="gsa-chip solid-accent">{L.awakened}</span>
                  {s.awakened.desc && s.awakened.desc.split('\n').map(line => <p class="gsa-skill-desc">{line}</p>)}
                  {s.awakened.detail && <p class="gsa-skill-detail">{s.awakened.detail}</p>}
                </div>
              )}
              {s.statuses?.length ? (
                <div class="gsa-skill-statuses">
                  {s.statuses.map(st => <span class="gsa-chip solid-muted">{st}</span>)}
                </div>
              ) : null}
            </div>
          ))}
        </div>
      </div>
    ) : null
  }

  {myStatuses.length > 0 && (
    <div class="gsa-detail-section" id="gsa-statuses">
      <h2>{L.statusesTitle}</h2>
      <div class="gsa-status-grid">
        {myStatuses.map(st => (
          <div class={`gsa-status-tile gsa-status-${st.kind}`}>
            <span class="gsa-status-head">
              {st.icon ? (
                <img class="gsa-status-icon" src={st.icon} alt={st.dispName} width="28" height="28" loading="lazy" />
              ) : (
                <span class="gsa-status-icon gsa-status-icon-ph">{st.dispName?.[0]}</span>
              )}
              <b class="gsa-status-name">{st.dispName}</b>
              <span class={`gsa-chip ${st.kind === 'buff' ? 'solid-accent' : 'gsa-status-kind-debuff'}`}>{st.kind === 'buff' ? L.buffLabel : L.debuffLabel}</span>
            </span>
          </div>
        ))}
      </div>
    </div>
  )}
</div>
