---
// Shared characters-index template for the Gene-Sys: Adam non-EN language
// sections: card grid in the game's own library sort order, search matching
// the localized + EN names, element/job filters built from the roster's own
// localized names. Mirrors the EN/zh pages (gsa-characters.css).
export interface Props {
  ui: any;
  characters: any[];
}
const { ui, characters: charsIn } = Astro.props;
const characters = [...charsIn].sort((a, b) => (a.sortOrder ?? 9999) - (b.sortOrder ?? 9999));
const base = ui.baseUrl;
const L = ui.labels;

// element + job orders follow element id (Fire..Dark) already encoded in the data
const elementIds = [1, 2, 3, 4, 5, 6];
const elements = elementIds
  .map(id => characters.find(c => c.element?.id === id)?.element)
  .filter(Boolean);
const elByName = new Map(elements.map(e => [e.name, e]));
const jobs = [];
for (const c of characters) {
  if (c.job?.name && !jobs.includes(c.job.name)) jobs.push(c.job.name);
}
---

<div class="gsa-content-section">
  <div class="gsa-toolbar">
    <input type="text" class="gsa-search" placeholder={L.searchPh} id="gsa-search" />
    <span class="gsa-count" id="gsa-count">{characters.length} {L.countUnit}</span>
  </div>
  <div class="gsa-toolbar gsa-toolbar-filters">
    <button class="gsa-filter-btn active" data-filter="all">{L.all}</button>
    <button class="gsa-filter-btn" data-filter="gacha">{L.gachaOnly}</button>
    {elements.map(e => (
      <button class="gsa-filter-btn" data-filter={e.name}>
        <img src={e.icon} alt="" width="14" height="14" loading="lazy" /> {e.name}
      </button>
    ))}
    <span class="gsa-filter-sep" aria-hidden="true"></span>
    {jobs.map(j => (
      <button class="gsa-filter-btn" data-filter={j}>{j}</button>
    ))}
  </div>

  <div class="gsa-grid-cards" id="gsa-grid">
    {characters.map(c => (
      <a
        class="gsa-card"
        href={`${base}characters/${c.slug}/`}
        data-search={`${c.name} ${c.nameEn} ${c.title} ${c.epithet}`.toLowerCase()}
        data-tags={[c.inGacha ? 'gacha' : '', (c.element?.name || ''), (c.job?.name || '')].filter(Boolean).join(' ')}
      >
        <div class="gsa-icon-frame">
          {c.icon ? <img src={c.icon} alt={c.name} loading="lazy" /> : <span class="gsa-monogram">{c.name?.[0]}</span>}
        </div>
        <p class="gsa-card-title">{c.name}</p>
        {c.title && <p class="gsa-card-sub">{c.title}</p>}
        <div class="gsa-card-types">
          {c.attackType && (
            <span class="gsa-type-tile" title={c.attackType.name}>
              <img src={c.attackType.icon} alt={c.attackType.name} width="24" height="24" loading="lazy" />
            </span>
          )}
          {c.element && (
            <span class="gsa-type-tile" title={c.element.name}>
              <img src={c.element.icon} alt={c.element.name} width="24" height="24" loading="lazy" />
            </span>
          )}
          {c.job && (
            <span class="gsa-type-tile" title={c.job.name}>
              {c.job.icon && <img src={c.job.icon} alt={c.job.name} width="24" height="24" loading="lazy" />}
            </span>
          )}
        </div>
        {!c.inGacha && <span class="gsa-card-nogacha">{L.notInSummons}</span>}
      </a>
    ))}
  </div>
</div>

<script is:inline>
  // Card filtering: search box matches data-search, buttons filter data-tags.
  (function () {
    var search = document.getElementById('gsa-search');
    var buttons = document.querySelectorAll('.gsa-filter-btn');
    var cards = document.querySelectorAll('#gsa-grid .gsa-card');
    var count = document.getElementById('gsa-count');
    var active = 'all';
    function norm(s) { return String(s || '').toLowerCase(); }
    function apply() {
      var q = norm(search && search.value).trim();
      var n = 0;
      cards.forEach(function (card) {
        var okText = !q || norm(card.getAttribute('data-search')).indexOf(q) !== -1;
        var tags = norm(card.getAttribute('data-tags'));
        var okTag = active === 'all' || (active === 'gacha' ? tags.indexOf('gacha') !== -1 : tags.indexOf(active) !== -1);
        var show = okText && okTag;
        card.style.display = show ? '' : 'none';
        if (show) n++;
      });
      if (count) count.textContent = n + ' ' + (count.getAttribute('data-unit') || '');
    }
    if (search) search.addEventListener('input', apply);
    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        buttons.forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');
        active = btn.getAttribute('data-filter');
        apply();
      });
    });
  })();
</script>
