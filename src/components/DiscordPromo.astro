---
// Shared "Join the GachaWiki Discord" CTA banner for game landing pages.
// Static design (no hover/glow).
import { SITE } from '../consts';
---

<a
  href={SITE.SOCIAL.DISCORD}
  target="_blank"
  rel="noopener noreferrer"
  class="gw-discord-promo"
  aria-label="Join the GachaWiki Discord server"
>
  <span class="gw-discord-logo" aria-hidden="true">
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path
        d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"
      ></path>
    </svg>
  </span>
  <span class="gw-discord-text">
    <strong class="gw-discord-title">Join the GachaWiki Discord</strong>
    <span class="gw-discord-sub">Chat with the community, report errors, and get wiki update announcements.</span>
  </span>
  <span class="gw-discord-cta">Join &rarr;</span>
</a>

<style>
  .gw-discord-promo {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 1.75rem auto 0;
    max-width: 720px;
    padding: 14px 18px;
    border-radius: 12px;
    background: rgba(16, 18, 27, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #fff;
    text-decoration: none;
  }

  .gw-discord-logo {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: #5865f2;
  }

  .gw-discord-logo svg {
    width: 22px;
    height: 22px;
    fill: #fff;
  }

  .gw-discord-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
    flex: 1;
  }

  .gw-discord-title {
    font-size: var(--text-body);
    font-weight: 700;
    letter-spacing: 0.2px;
    line-height: 1.2;
    color: #fff;
  }

  .gw-discord-sub {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.35;
  }

  .gw-discord-cta {
    flex-shrink: 0;
    font-size: var(--text-md);
    font-weight: 700;
    color: #fff;
    background: #5865f2;
    border-radius: 8px;
    padding: 8px 16px;
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    .gw-discord-promo {
      flex-wrap: wrap;
      gap: 10px;
    }

    .gw-discord-cta {
      width: 100%;
      text-align: center;
    }
  }
</style>
