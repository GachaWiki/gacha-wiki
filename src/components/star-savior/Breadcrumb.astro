---
// Star Savior breadcrumb: shared pill design, SS gold accent, ss- legacy class.
import BreadcrumbBase from '../BreadcrumbBase.astro';
const style =
  '--bc-accent:var(--ss-primary, #c9a84c);--bc-focus:var(--ss-primary, #c9a84c);--bc-list:rgba(255, 255, 255, 0.5)';
---

<BreadcrumbBase {...Astro.props} classPrefix="ss" style={style} />
