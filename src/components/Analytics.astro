---
// Site-wide third-party scripts: GA4 analytics. Included inside <head> by
// every layout.

const gaId = import.meta.env.PUBLIC_GA_ID || 'G-LZV7DF140B';
const isDev = import.meta.env.DEV;
---

{
  gaId && !isDev && (
    <>
      <script
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}
        data-cfasync="false"
      />
      <script
        is:inline
        data-cfasync="false"
        set:html={`window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', '${gaId}');`}
      />
    </>
  )
}
