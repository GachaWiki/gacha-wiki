---
// Site-wide third-party scripts: GA4 analytics + the Google AdSense loader.
// Included inside <head> by every layout. The AdSense loader only renders
// once ADSENSE_CLIENT is filled in src/consts.ts.
import { ADSENSE_CLIENT } from '../consts';

const gaId = import.meta.env.PUBLIC_GA_ID || 'G-LZV7DF140B';
const isDev = import.meta.env.DEV;
---

{
  gaId && !isDev && (
    <>
      <script
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}
        data-cfasync="false"
      />
      <script
        is:inline
        data-cfasync="false"
        set:html={`window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', '${gaId}');`}
      />
    </>
  )
}

{
  ADSENSE_CLIENT && !isDev && (
    <script
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
      crossorigin="anonymous"
      data-cfasync="false"
    />
  )
}
