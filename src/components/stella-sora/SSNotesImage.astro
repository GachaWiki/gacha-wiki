---
// Stella Sora Support Notes (Melody) Image Component
// Served from the gachawiki-images R2 bucket (keeps the Pages deployment under the 20,000-file limit).
const R2 = 'https://k2b1c5ab57ed98e51.gachawiki.info/stella-sora';

// Files present in Notes/ on R2 (frozen listing; extend when new art uploads)
const FILES = new Set([
  'Melody_of_Aqua', 'Melody_of_Burst', 'Melody_of_Focus', 'Melody_of_Ignis', 'Melody_of_Luck',
  'Melody_of_Lux', 'Melody_of_Pummel', 'Melody_of_Skill', 'Melody_of_Stamina', 'Melody_of_Terra',
  'Melody_of_Ultimate', 'Melody_of_Umbra', 'Melody_of_Ventus',
]);

export interface Props {
  imageName: string;
  alt: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
  class?: string;
  quality?: number;
}

const {
  imageName,
  alt,
  width = 120,
  height = 120,
  loading = 'lazy',
  class: className,
} = Astro.props;

// Build the image path - handle both with and without extension
// Convert spaces to underscores for image filename lookup
let imageKey = imageName.replace(/\s+/g, '_');
imageKey = imageKey.replace(/\.(jpg|jpeg|png|webp)$/i, '');

let imageSrc: string | null = null;
let imageAlt = alt;
if (FILES.has(imageKey)) {
  imageSrc = `${R2}/Notes/${imageKey}.jpg`;
} else {
  // Fallback if image not found
  imageAlt = `Image not found: ${alt}`;
}
---

{
  imageSrc ? (
    <img
      src={imageSrc}
      alt={imageAlt}
      width={width * 2}
      height={height * 2}
      loading={loading}
      class={`notes-image ${className || ''}`}
      style={`width: ${width}px; height: ${height}px;`}
      decoding="async"
    />
  ) : (
    <div
      class={`notes-image-placeholder ${className || ''}`}
      style={`width: ${width}px; height: ${height}px;`}
    >
      <span>?</span>
    </div>
  )
}

<style>
  .notes-image {
    border-radius: 8px;
    object-fit: contain;
  }

  .notes-image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--ss-bg-tertiary, #1a1a2e);
    border: 1px solid var(--ss-border, #333);
    border-radius: 8px;
    color: var(--ss-text-secondary, #888);
    font-size: var(--text-xs);
  }
</style>
