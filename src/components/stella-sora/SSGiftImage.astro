---
// Stella Sora Gift Image Component
// Served from the gachawiki-images R2 bucket (keeps the Pages deployment under the 20,000-file limit).
const R2 = 'https://img.gachawiki.info/stella-sora';

// Centralized gift image mapping (gift name from data -> R2 path)
const giftImageMap: Record<string, string> = {
  // Photo Capturer category
  'Card Capturer': 'items/card-photo-capturer.png',
  'Reflective Photo Capturer': 'items/reflective-photo-capturer.png',
  'Ultra-Precision Photo Capturer': 'items/ultra-precision-photo-capturer.png',

  // Star category
  'Rising Star': 'items/rising-star.png',
  'Moonlit Companion': 'items/moonlit-companion.png',
  'Cosmic Form': 'items/cosmic-form.png',

  // Candle category
  'Love Candle': 'items/love-candle.png',
  'Blazing Wings': 'items/blazing-wings.png',
  'Fiery Honeypot': 'items/fiery-honeypot.png',

  // Wind Spinner category
  'Whisper Wind Spinner': 'items/whisper-wind-spinner.png',
  'Blazing Wind Spinner': 'items/blazing-wind-spinner.png',
  'Chilling Wind Spinner': 'items/chilling-wind-spinner.png',

  // Blower category
  'Portable Blower': 'items/portable-blower.png',
  'Exquisite Blower': 'items/exquisite-blower.png',
  'Deluxe Blower': 'items/deluxe-blower.png',

  // Shaved Ice category
  'Chill Crushed Ice': 'items/summer-chill-crushed-ice.png',
  'Fragrant Ice Delight': 'items/fragrant-ice-delight.png',
  'Sweet Ice Furry': 'items/sweet-icefurry.png',

  // Ceramic category
  'Gilded Ceramic Bowl': 'items/gilded-ceramic-bowl.png',
  'Porcelain Cup': 'items/blossom-porcelain-cup.png',
  'Mystic Potion Kettle': 'items/mystic-potion-kettle.png',

  // Enchantment category
  'Star Eclipse': 'items/stellanite-enchantment.png',
  'Emerging Talent': 'items/emerging-talent.png',
  'Shining Star': 'items/shining-star.png',
};

export interface Props {
  giftName: string;
  alt?: string;
  class?: string;
  width?: number;
  height?: number;
}

const { giftName, alt, class: className = '', width = 48, height = 48 } = Astro.props;

// Get the image path from the map
const imagePath = giftImageMap[giftName];
---

{imagePath ? (
  <img
    src={`${R2}/${imagePath}`}
    alt={alt || giftName}
    width={width}
    height={height}
    class={`${className} gift-img`}
    loading="lazy"
    decoding="async"
  />
) : (
  <span class={`${className} gift-placeholder`} title={giftName}>{giftName}</span>
)}

<style>
  .gift-img {
    display: inline-block;
    vertical-align: middle;
  }
  .gift-placeholder {
    display: inline-block;
    font-size: var(--text-xs);
    color: #888;
  }
</style>
