---
// Stella Sora generic game image component (hero bg / icon)
// Served from the gachawiki-images R2 bucket (keeps the Pages deployment under the 20,000-file limit).
const R2 = 'https://k2b1c5ab57ed98e51.gachawiki.info/stella-sora';

export interface Props {
  imageName: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: 'eager' | 'lazy';
  format?: 'webp' | 'jpg' | 'png';
  quality?: number;
}

const {
  imageName,
  alt,
  width = 1200,
  height = 400,
  class: className,
  loading = 'eager',
} = Astro.props;

// Map image names to actual game images on R2
const imageMap: Record<string, string> = {
  'BG1.jpg': 'gameimg/BG1.jpg',
  'bg1.jpg': 'gameimg/BG1.jpg',
  'hero.jpg': 'gameimg/BG1.jpg',
  'stella-sora-hero.jpg': 'gameimg/BG1.jpg',
  'stella-sora-bg1.jpg': 'gameimg/BG1.jpg',
  'gameicon.jpg': 'gameimg/Icon.jpg',
  'stella-sora-icon.jpg': 'gameimg/Icon.jpg',
  'Icon.jpg': 'gameimg/Icon.jpg',
  'icon.jpg': 'gameimg/Icon.jpg',
};

// Get the image path based on the imageName
const filename = imageName.split('/').pop() || 'BG1.jpg';
const imagePath = imageMap[imageName] || imageMap[filename] || 'gameimg/BG1.jpg';
---

<img
  src={`${R2}/${imagePath}`}
  alt={alt}
  width={width}
  height={height}
  class={className}
  loading={loading}
  decoding="async"
/>
