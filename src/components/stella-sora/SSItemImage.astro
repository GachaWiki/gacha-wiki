---
/**
 * SS Item Image Component
 * Simple component for displaying item images in Stella Sora exclusive items page
 * Served from the gachawiki-images R2 bucket (keeps the Pages deployment under the 20,000-file limit).
 */
const R2 = 'https://img.gachawiki.info/stella-sora';

interface Props {
  src: string;
  alt: string;
  class?: string;
}

const { src, alt, class: className = '' } = Astro.props;

// Map image paths to R2 paths
const imageMap: Record<string, string> = {
  '/images/games/stella-sora/Exclusive/Summer_sanctuary.jpg': 'Exclusive/Summer_sanctuary.jpg',
  'Summer_sanctuary.jpg': 'Exclusive/Summer_sanctuary.jpg',
  '/images/games/stella-sora/Exclusive/Tipsy_Daydream.jpg': 'Exclusive/Tipsy_Daydream.jpg',
  'Tipsy_Daydream.jpg': 'Exclusive/Tipsy_Daydream.jpg',
};

// Get the image path based on the src
const filename = src.split('/').pop() || 'Summer_sanctuary.jpg';
const imagePath = imageMap[src] || imageMap[filename] || 'Exclusive/Summer_sanctuary.jpg';

// Use consistent high-quality dimensions
const finalWidth = 800;
const finalHeight = 800;
---

<div class={`ss-item-image-container ${className}`}>
  <img
    src={`${R2}/${imagePath}`}
    alt={alt}
    width={finalWidth}
    height={finalHeight}
    class="ss-item-image"
    loading="lazy"
    decoding="async"
  />
</div>

<style>
  .ss-item-image-container {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 200px;
    height: 200px;
    background: var(--ss-bg-tertiary);
    borderNone: 1px solid var(--ss-border);
    border-radius: 8px;
    overflow: hidden;
    position: relative;
    flex-shrink: 0; /* Prevent shrinking in flex layouts */
  }

  .ss-item-image {
    transition: none; /* No hover effects */
    object-fit: cover; /* Fill container consistently */
    width: 100%;
    height: 100%;
    display: block;
  }

  .ss-item-image-container:hover .ss-item-image {
    transform: none; /* No hover transform */
  }

  /* Responsive sizing */
  @media (max-width: 1024px) {
    .ss-item-image-container {
      width: 190px;
      height: 190px;
    }
  }

  @media (max-width: 768px) {
    .ss-item-image-container {
      width: 180px;
      height: 180px;
    }
  }

  @media (max-width: 480px) {
    .ss-item-image-container {
      width: 150px;
      height: 150px;
    }
  }

  @media (max-width: 360px) {
    .ss-item-image-container {
      width: 130px;
      height: 130px;
    }
  }
</style>
