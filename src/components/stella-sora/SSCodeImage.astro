---
// Stella Sora Code Tutorial Image Component
// Served from the gachawiki-images R2 bucket (keeps the Pages deployment under the 20,000-file limit).
const R2 = 'https://k2b1c5ab57ed98e51.gachawiki.info/stella-sora';

// Centralized code image mapping
const codeImageMap: Record<string, string> = {
  '1.jpg': 'code/1.jpg',
  '2.jpg': 'code/2.jpg',
  '3.jpg': 'code/3.jpg',
  '4.jpg': 'code/4.jpg',
};

const {
  imageName, // This is now a string name, not an image object
  alt,
  class: className = '',
  loading = 'lazy',
  width = 400,
  height = 300,
} = Astro.props;

// Get the image path from the map
let imageKey = imageName;

// Add extension if missing
if (!imageKey.includes('.')) {
  imageKey = `${imageKey}.jpg`;
}

const imageSrc = `${R2}/${codeImageMap[imageKey] || codeImageMap['1.jpg']}`;
---

<div class={`code-tutorial-image ${className}`}>
  <img
    src={imageSrc}
    alt={alt}
    width={width}
    height={height}
    class="code-img-fill"
    loading={loading}
    decoding="async"
  />
</div>

<style>
  .code-tutorial-image {
    border-radius: var(--ss-radius-lg);
    overflow: hidden;
    border: 1px solid var(--ss-border);
    box-shadow: var(--ss-shadow-sm);
    background: var(--ss-bg-card);
    transition: var(--ss-transition);
  }

  .code-tutorial-image:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(125, 211, 252, 0.15);
    border-color: var(--ss-border);
  }

  .code-img-fill {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--ss-radius-lg);
  }

  /* Responsive sizing for mobile */
  @media (max-width: 768px) {
    .code-tutorial-image {
      max-width: 100%;
      margin: 0 auto;
    }
  }

  @media (max-width: 480px) {
    .code-tutorial-image {
      border-radius: var(--ss-radius-md);
    }
  }
</style>
