---
// Stella Sora Disc Skill Image Component
// Displays disc skill icons from the disc-skills folder with optional background
// Served from the gachawiki-images R2 bucket (keeps the Pages deployment under the 20,000-file limit).
const R2 = 'https://pub-dd9a9c01bc7a43d0bb977b255815a5c4.r2.dev/stella-sora';

// Files present in disc-skills/ on R2 (frozen listing; extend when new art uploads)
const FILES = new Set([
  'DiscSkill_1', 'DiscSkill_10', 'DiscSkill_11', 'DiscSkill_12', 'DiscSkill_13', 'DiscSkill_14',
  'DiscSkill_214001', 'DiscSkill_214002', 'DiscSkill_214005', 'DiscSkill_214006', 'DiscSkill_214007',
  'DiscSkill_214009', 'DiscSkill_214010', 'DiscSkill_214011', 'DiscSkill_214012', 'DiscSkill_214013',
  'DiscSkill_214014', 'DiscSkill_214015', 'DiscSkill_214017', 'DiscSkill_214018', 'DiscSkill_214019',
  'DiscSkill_214020', 'DiscSkill_214021', 'DiscSkill_214022', 'DiscSkill_214023', 'DiscSkill_214024',
  'DiscSkill_214026', 'DiscSkill_214027', 'DiscSkill_214028', 'DiscSkill_214030', 'DiscSkill_214031',
  'DiscSkill_214032', 'DiscSkill_214033', 'DiscSkill_214036', 'DiscSkill_214037', 'DiscSkill_214038',
  'DiscSkill_214039', 'DiscSkill_214040', 'DiscSkill_214041', 'DiscSkill_3', 'DiscSkill_4',
  'DiscSkill_6', 'DiscSkill_7', 'DiscSkill_8', 'DiscSkill_9',
  'crisp-morning-plate', 'crisp-morning-skill',
  'db_DiscSkill_1', 'db_DiscSkill_2', 'db_DiscSkill_3', 'db_DiscSkill_4', 'db_DiscSkill_5',
  'db_DiscSkill_6',
  'indigo-sunset-plate', 'indigo-sunset-skill',
  'lonely-dunes-plate', 'lonely-dunes-skill',
  'pink-dream-plate', 'pink-dream-skill',
  'sunny-breeze-plate', 'sunny-breeze-skill',
  'DiscSkill_213001', 'DiscSkill_213002', 'DiscSkill_214003', 'DiscSkill_214004', 'DiscSkill_214008', 'DiscSkill_214016', 'DiscSkill_214029', 'DiscSkill_214042', 'DiscSkill_214043', 'DiscSkill_214044', 'DiscSkill_214045', 'DiscSkill_214046', 'DiscSkill_214047', 'DiscSkill_214048', 'DiscSkill_214049', 'DiscSkill_214050', 'DiscSkill_214051', 'DiscSkill_214052', 'DiscSkill_214053', 'DiscSkill_214054', 'DiscSkill_214055', 'DiscSkill_214056', 'DiscSkill_214057', 'DiscSkill_214058', 'DiscSkill_214059', 'DiscSkill_214060', 'DiscSkill_214061', 'DiscSkill_214062',
]);

export interface Props {
  iconName: string;
  iconBackground?: string;
  alt?: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
  class?: string;
  quality?: number;
}

const {
  iconName,
  iconBackground,
  alt,
  width = 48,
  height = 48,
  loading = 'lazy',
  class: className,
} = Astro.props;

// Build the icon image path
let iconKey = iconName;
if (!iconKey.includes('.')) {
  iconKey = `${iconKey}.png`;
}
const iconExists = FILES.has(iconKey.replace(/\.(jpg|jpeg|png|webp)$/i, ''));
const iconSrc = iconExists ? `${R2}/disc-skills/${iconKey}` : '';

let imageAlt = alt || iconName;
if (!iconExists) {
  imageAlt = `Image not found: ${alt || iconName}`;
}

// Build the background image path if provided
let bgSrc: string | null = null;
if (iconBackground) {
  let bgKey = iconBackground;
  if (!bgKey.includes('.')) {
    bgKey = `${bgKey}.png`;
  }
  if (FILES.has(bgKey.replace(/\.(jpg|jpeg|png|webp)$/i, ''))) {
    bgSrc = `${R2}/disc-skills/${bgKey}`;
  }
}

const hasBackground = bgSrc !== null;
---

{
  hasBackground ? (
    <div class={`disc-skill-with-bg ${className || ''}`} style={`width: ${width}px; height: ${height}px;`}>
      <img
        src={bgSrc}
        alt=""
        width={width * 2}
        height={height * 2}
        loading={loading}
        class="disc-skill-bg"
        decoding="async"
      />
      {iconSrc ? (
        <img
          src={iconSrc}
          alt={imageAlt}
          width={width * 2}
          height={height * 2}
          loading={loading}
          class="disc-skill-icon"
          decoding="async"
        />
      ) : (
        <div class="disc-skill-icon-placeholder">
          <span>?</span>
        </div>
      )}
    </div>
  ) : iconSrc ? (
    <img
      src={iconSrc}
      alt={imageAlt}
      width={width * 2}
      height={height * 2}
      loading={loading}
      class={`disc-skill-image ${className || ''}`}
      style={`width: ${width}px; height: ${height}px;`}
      decoding="async"
    />
  ) : (
    <div
      class={`disc-skill-image-placeholder ${className || ''}`}
      style={`width: ${width}px; height: ${height}px;`}
    >
      <span>?</span>
    </div>
  )
}

<style>
  .disc-skill-with-bg {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    overflow: hidden;
  }

  .disc-skill-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .disc-skill-icon {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: contain;
    z-index: 1;
  }

  .disc-skill-icon-placeholder {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ss-text-secondary, #888);
    font-size: var(--text-xs);
    z-index: 1;
  }

  .disc-skill-image {
    border-radius: 6px;
    object-fit: contain;
  }

  .disc-skill-image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--ss-bg-tertiary, #1a1a2e);
    border: 1px solid var(--ss-border, #333);
    border-radius: 6px;
    color: var(--ss-text-secondary, #888);
    font-size: var(--text-xs);
  }
</style>
