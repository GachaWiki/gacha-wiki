---
// Stella Sora Character Skill Icon Component
// Simple component that displays just the character's skill icon (without element plate overlay)
// Served from the gachawiki-images R2 bucket (keeps the Pages deployment under the 20,000-file limit).
const R2 = 'https://img.gachawiki.info/stella-sora';

// Character slugs that have a skills/ folder on R2 (frozen listing; extend when new art uploads).
// Each folder holds all four icons: normal-attack / skill / support-skill / ultimate.
const SKILL_SLUGS = new Set([
  'allie', 'amber', 'ann', 'canace', 'caramel', 'chaton', 'chitose', 'chixia', 'coronis', 'cosette',
  'donna', 'eleanor', 'firefly', 'firenze', 'flora', 'freesia', 'fuyuka', 'gerie', 'iris',
  'jinglin', 'karin', 'kasimira', 'laru', 'minova', 'mistique', 'nanoha', 'nazuka', 'nazuna',
  'noya', 'otoha', 'ridge', 'shia', 'shimiao', 'snowish-laru', 'sparkla', 'springseek-coronis',
  'suntide-willow', 'teresa', 'tilia', 'wraith', 'firstlight-noya',
]);

export interface Props {
  characterSlug: string;
  skillType: 'normal-attack' | 'skill' | 'support-skill' | 'ultimate';
  alt?: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const {
  characterSlug,
  skillType,
  alt,
  width = 80,
  height = 80,
  class: className = '',
  loading = 'lazy',
} = Astro.props;

// Slug mapping for characters with different folder names
const slugFolderMap: Record<string, string> = {
  firstlightnoya: 'firstlight-noya',
  snowishlaru: 'snowish-laru',
  springseekcoronis: 'springseek-coronis',
  suntidewillow: 'suntide-willow',
};

// Get character slug (lowercase)
const rawSlug = characterSlug.toLowerCase();
const slug = slugFolderMap[rawSlug] || rawSlug;

const hasIcons = SKILL_SLUGS.has(slug);
const skillSrc = hasIcons ? `${R2}/characters/${slug}/skills/${skillType}.png` : null;

const imageAlt = alt || `${characterSlug} ${skillType}`;
---

{
  skillSrc ? (
    <img
      src={skillSrc}
      alt={imageAlt}
      width={width}
      height={height}
      class={className}
      loading={loading}
      decoding="async"
    />
  ) : (
    <div
      class={`skill-icon-placeholder ${className}`}
      style={`width: ${width}px; height: ${height}px; display: flex; align-items: center; justify-content: center; background: #333; border-radius: 8px; color: #999; font-size: var(--text-3xs);`}
    >
      {skillType}
    </div>
  )
}
