---
// Stella Sora Character Image Component
// Served from the gachawiki-images R2 bucket (keeps the Pages deployment under the 20,000-file limit).
const R2 = 'https://img.gachawiki.info/stella-sora';

// Files present in gameimg/characters/ on R2 (frozen listing; extend when new art uploads)
const FILES = new Set([
  'Allie', 'Amber', 'Ann', 'Canace', 'Caramel', 'Chaton', 'Chitose', 'Chixia', 'Coronis', 'Cosette',
  'Donna', 'Eleanor', 'Firefly', 'Firenze', 'Flora', 'Freesia', 'Fuyuka', 'Gerie', 'Iris',
  'Jinglin', 'Karin', 'Kasimira', 'Laru', 'Minova', 'Mistique', 'Nanoha', 'Nazuka', 'Nazuna',
  'Noya', 'Otoha', 'Ridge', 'Shia', 'Shimiao', 'Snowish_Laru', 'Sparkla', 'Springseek_Coronis',
  'Suntide_Willow', 'Teresa', 'Tilia', 'Wraith', 'Firstlight_Noya',
]);

export interface Props {
  imageName: string;
  alt?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  format?: 'webp' | 'jpg' | 'png';
  quality?: number;
  width?: number;
  height?: number;
}

const {
  imageName,
  alt,
  class: className = '',
  loading = 'lazy',
  width = 1000,
  height = 1000,
} = Astro.props;

// Normalize: strip extension, spaces to underscores (e.g. "Suntide Willow.jpg" -> "Suntide_Willow")
let key = imageName.split('/').pop() || 'Chitose.jpg';
key = key.replace(/\.(jpg|jpeg|png|webp)$/i, '').replace(/\s+/g, '_');

const imageSrc = FILES.has(key) ? `${R2}/gameimg/characters/${key}.jpg` : `${R2}/gameimg/characters/Chitose.jpg`;
---

<img
  src={imageSrc}
  alt={alt}
  width={width}
  height={height}
  class={`${className} character-img-fill`}
  loading={loading}
  decoding="async"
  sizes="(max-width: 768px) 200px, 300px"
/>
