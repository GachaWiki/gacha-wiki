---
// Stella Sora Element Image Component
// Served from the gachawiki-images R2 bucket (keeps the Pages deployment under the 20,000-file limit).
const R2 = 'https://k2b1c5ab57ed98e51.gachawiki.info/stella-sora';

// Centralized element image mapping (better cut versions)
const elementImageMap: Record<string, string> = {
  Aqua: 'elements/aqua.png',
  Ignis: 'elements/ignis.png',
  Lux: 'elements/lux.png',
  Terra: 'elements/terra.png',
  Umbra: 'elements/umbra.png',
  Ventus: 'elements/ventus.png',
  None: 'elements/none.png',
};

export interface Props {
  elementName: string;
  alt?: string;
  class?: string;
  width?: number;
  height?: number;
}

const { elementName, alt, class: className = '', width = 32, height = 32 } = Astro.props;

// Get the image path from the map
const imageSrc = elementImageMap[elementName] || elementImageMap['Aqua']; // Keep Aqua as fallback for safety
---

<img
  src={`${R2}/${imageSrc}`}
  alt={alt || elementName}
  width={width}
  height={height}
  class={`${className} element-img-fill`}
  loading="lazy"
  decoding="async"
/>
