---
// Stella Sora Element Marker Image Component
// Served from the gachawiki-images R2 bucket (keeps the Pages deployment under the 20,000-file limit).
const R2 = 'https://k2b1c5ab57ed98e51.gachawiki.info/stella-sora';

// Marker images present on R2 (frozen listing; extend when new art uploads)
const markerImageMap: Record<string, string> = {
  ignis: 'markers/ignis_mark.png',
  aqua: 'markers/aqua_mark.png',
  terra: 'markers/terra_mark.png',
  ventus: 'markers/ventus_mark.png',
  lux: 'markers/lux_mark.png',
  umbra: 'markers/umbra_mark.png',
};

export interface Props {
  element: string;
  alt?: string;
  class?: string;
  width?: number;
  height?: number;
}

const { element, alt, class: className = '', width = 18, height = 18 } = Astro.props;

const elementKey = element.toLowerCase();
const markerPath = markerImageMap[elementKey];
const imageSrc = markerPath ? `${R2}/${markerPath}` : null;
---

{imageSrc && (
  <img
    src={imageSrc}
    alt={alt || `${element} Mark`}
    width={width}
    height={height}
    class={`ss-marker-img ${className}`}
    loading="lazy"
    decoding="async"
  />
)}

<style>
  .ss-marker-img {
    display: inline-block;
    vertical-align: middle;
  }
</style>
