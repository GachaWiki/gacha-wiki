---
// Stella Sora Skill Icon Component
// Served from the gachawiki-images R2 bucket (keeps the Pages deployment under the 20,000-file limit).
const R2 = 'https://k2b1c5ab57ed98e51.gachawiki.info/stella-sora';

// Skill type icon paths
const skillTypeMap: Record<string, string> = {
  normal: 'skills/normal.png',
  skill: 'skills/skill.png',
  support: 'skills/support.png',
  ultimate: 'skills/ultimate.png',
};

// Element plate paths for colored backgrounds
const elementPlateMap: Record<string, string> = {
  Ignis: 'skills/ignis_plate.png',
  ignis: 'skills/ignis_plate.png',
  Aqua: 'skills/aqua_plate.png',
  aqua: 'skills/aqua_plate.png',
  Ventus: 'skills/ventus_plate.png',
  ventus: 'skills/ventus_plate.png',
  Terra: 'skills/terra_plate.png',
  terra: 'skills/terra_plate.png',
  Lux: 'skills/lux_plate.png',
  lux: 'skills/lux_plate.png',
  Umbra: 'skills/umbra_plate.png',
  umbra: 'skills/umbra_plate.png',
};

export interface Props {
  skillType: 'normal' | 'skill' | 'support' | 'ultimate';
  element?: string;
  alt?: string;
  class?: string;
  width?: number;
  height?: number;
}

const { skillType, element, alt, class: className = '', width = 40, height = 40 } = Astro.props;

const skillIconPath = skillTypeMap[skillType] || skillTypeMap['skill'];
const platePath = element ? elementPlateMap[element] : null;
---

<div class={`skill-icon-wrapper ${className}`}>
  {platePath && (
    <img
      src={`${R2}/${platePath}`}
      alt=""
      width={width}
      height={height}
      class="skill-plate"
      loading="lazy"
      decoding="async"
    />
  )}
  <img
    src={`${R2}/${skillIconPath}`}
    alt={alt || `${skillType} skill`}
    width={width - 8}
    height={height - 8}
    class="skill-icon"
    loading="lazy"
    decoding="async"
  />
</div>

<style>
  .skill-icon-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--icon-size, 40px);
    height: var(--icon-size, 40px);
  }

  .skill-plate {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .skill-icon {
    position: relative;
    z-index: 1;
    object-fit: contain;
  }
</style>
