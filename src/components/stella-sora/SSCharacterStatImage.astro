---
// Stella Sora Character Stat Image Component
// For character-specific images like q.png (stats portrait with transparency)
// Served from the gachawiki-images R2 bucket (keeps the Pages deployment under the 20,000-file limit).
const R2 = 'https://k2b1c5ab57ed98e51.gachawiki.info/stella-sora';

// Character slugs that have a q.png stats portrait on R2 (frozen listing; extend when new art uploads)
const FILES = new Set(['amber']);

export interface Props {
  characterSlug: string;
  alt?: string;
  class?: string;
  width?: number;
  height?: number;
}

const { characterSlug, alt, class: className = '', width = 400, height = 400 } = Astro.props;

const imageSrc = FILES.has(characterSlug.toLowerCase())
  ? `${R2}/characters/${characterSlug.toLowerCase()}/q.png`
  : null;
---

{imageSrc && (
  <img
    src={imageSrc}
    alt={alt || `${characterSlug} stats portrait`}
    width={width}
    height={height}
    class={`${className} character-stat-img`}
    loading="lazy"
    decoding="async"
  />
)}
