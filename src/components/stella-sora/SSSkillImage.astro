---
// Stella Sora Skill Image Component
// Combines: element plate (background) + skill type icon + character skill icon (overlay)
// Served from the gachawiki-images R2 bucket (keeps the Pages deployment under the 20,000-file limit).
const R2 = 'https://img.gachawiki.info/stella-sora';

// Element plate mapping
const elementPlateMap: Record<string, string> = {
  ignis: 'skills/ignis_plate.png',
  aqua: 'skills/aqua_plate.png',
  terra: 'skills/terra_plate.png',
  ventus: 'skills/ventus_plate.png',
  lux: 'skills/lux_plate.png',
  umbra: 'skills/umbra_plate.png',
};

// Skill type icon mapping
const skillTypeIconMap: Record<string, string> = {
  'normal-attack': 'skills/normal.png',
  skill: 'skills/skill.png',
  'support-skill': 'skills/support.png',
  ultimate: 'skills/ultimate.png',
};

// Character slugs that have a skills/ folder on R2 (frozen listing; extend when new art uploads)
const SKILL_SLUGS = new Set([
  'allie', 'amber', 'ann', 'canace', 'caramel', 'chaton', 'chitose', 'chixia', 'coronis', 'cosette',
  'donna', 'eleanor', 'firefly', 'firenze', 'flora', 'freesia', 'fuyuka', 'gerie', 'iris',
  'jinglin', 'karin', 'kasimira', 'laru', 'minova', 'mistique', 'nanoha', 'nazuka', 'nazuna',
  'noya', 'otoha', 'ridge', 'shia', 'shimiao', 'snowish-laru', 'sparkla', 'springseek-coronis',
  'suntide-willow', 'teresa', 'tilia', 'wraith',
'firstlight-noya',
]);

// Character element mapping (all 39 characters)
const characterElementMap: Record<string, string> = {
  amber: 'ignis',
  ann: 'ventus',
  canace: 'ventus',
  caramel: 'umbra',
  chaton: 'ignis',
  chitose: 'aqua',
  chixia: 'ignis',
  coronis: 'umbra',
  cosette: 'umbra',
  donna: 'aqua',
  eleanor: 'ventus',
  firefly: 'lux',
  firenze: 'umbra',
  'firstlight-noya': 'lux',
  flora: 'ignis',
  freesia: 'aqua',
  fuyuka: 'ignis',
  gerie: 'terra',
  iris: 'aqua',
  jinglin: 'lux',
  karin: 'umbra',
  kasimira: 'ignis',
  laru: 'lux',
  minova: 'lux',
  mistique: 'umbra',
  nanoha: 'ventus',
  nazuka: 'ventus',
  nazuna: 'terra',
  noya: 'ventus',
  otoha: 'umbra',
  ridge: 'terra',
  shia: 'lux',
  shimiao: 'aqua',
  'snowish-laru': 'ignis',
  sparkla: 'terra',
  'springseek-coronis': 'terra',
  'suntide-willow': 'aqua',
  teresa: 'aqua',
  tilia: 'lux',
  wraith: 'ventus',
};

export interface Props {
  characterName: string;
  skillType: 'normal-attack' | 'skill' | 'support-skill' | 'ultimate';
  alt: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const { characterName, skillType, alt, loading = 'lazy', class: className } = Astro.props;

// Get character slug (lowercase, spaces to hyphens)
// Special cases for characters with different folder names
const characterSlugMap: Record<string, string> = {
  'firstlight noya': 'firstlight-noya',
  firstlightnoya: 'firstlight-noya',
  'snowish laru': 'snowish-laru',
  snowishlaru: 'snowish-laru',
  springseekcoronis: 'springseek-coronis',
  suntidewillow: 'suntide-willow',
};
const normalizedName = characterName.toLowerCase().replace(/\s+/g, '-');
const characterSlug = characterSlugMap[normalizedName] || normalizedName;

// Get element plate for this character
const element = characterElementMap[characterSlug] || 'ignis';
const platePath = elementPlateMap[element];

// Get skill type icon
const typeIconPath = skillTypeIconMap[skillType];

// Get character-specific skill image
const hasSkills = SKILL_SLUGS.has(characterSlug);
const skillSrc = hasSkills ? `${R2}/characters/${characterSlug}/skills/${skillType}.png` : null;

const imageAlt = skillSrc ? alt : `Image not found: ${alt}`;
---

<div class={`skill-image-container ${className || ''}`}>
  {
    platePath && skillSrc ? (
      <div class="skill-image-layered">
        {/* Background: Element plate */}
        <img
          src={`${R2}/${platePath}`}
          alt=""
          width={120}
          height={120}
          loading={loading}
          class="skill-bg-plate"
          decoding="async"
        />
        {/* Middle: Skill type icon */}
        {typeIconPath && (
          <img
            src={`${R2}/${typeIconPath}`}
            alt=""
            width={40}
            height={40}
            loading={loading}
            class="skill-type-icon"
            decoding="async"
          />
        )}
        {/* Foreground: Character skill image */}
        <img
          src={skillSrc}
          alt={imageAlt}
          width={80}
          height={80}
          loading={loading}
          class="skill-char-icon"
          decoding="async"
        />
      </div>
    ) : (
      <div class="skill-image-placeholder">
        <span>No Image</span>
      </div>
    )
  }
</div>

<style>
  /* Styles handled by global CSS in ss-character-individual.css */
</style>
