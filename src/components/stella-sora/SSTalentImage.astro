---
// Stella Sora Talent Image Component
// Served from the gachawiki-images R2 bucket (keeps the Pages deployment under the 20,000-file limit).
const R2 = 'https://k2b1c5ab57ed98e51.gachawiki.info/stella-sora';

export interface Props {
  alt?: string;
  class?: string;
  width?: number;
  height?: number;
}

const { alt = 'Talent', class: className = '', width = 48, height = 48 } = Astro.props;
---

<img
  src={`${R2}/Talent/talent.png`}
  alt={alt}
  width={width}
  height={height}
  class={`${className} talent-img`}
  loading="lazy"
  decoding="async"
/>

<style>
  .talent-img {
    display: inline-block;
    vertical-align: middle;
  }
</style>
