---
// Stella Sora Dating Event Image Component
// Served from the gachawiki-images R2 bucket (keeps the Pages deployment under the 20,000-file limit).
const R2 = 'https://k2b1c5ab57ed98e51.gachawiki.info/stella-sora';

// Every character has dating/<slug>-event-0.png and -event-1.png on R2
// (frozen listing; extend when new art uploads)
const DATING_SLUGS = new Set([
  'allie', 'amber', 'ann', 'canace', 'caramel', 'chaton', 'chitose', 'chixia', 'coronis', 'cosette',
  'donna', 'eleanor', 'firefly', 'firenze', 'flora', 'freesia', 'fuyuka', 'gerie', 'iris',
  'jinglin', 'karin', 'kasimira', 'laru', 'minova', 'mistique', 'nanoha', 'nazuka', 'nazuna',
  'noya', 'otoha', 'ridge', 'shia', 'shimiao', 'snowish-laru', 'sparkla', 'springseek-coronis',
  'suntide-willow', 'teresa', 'tilia', 'wraith',
]);

// Hyphenated folders are keyed by their no-hyphen display-name normalization
const ALIASES: Record<string, string> = {
  snowishlaru: 'snowish-laru',
  springseekcoronis: 'springseek-coronis',
  suntidewillow: 'suntide-willow',
};

export interface Props {
  imageName: string; // e.g., 'amber-event-0.png' or 'amber-event-0'
  alt?: string;
  class?: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
  format?: 'webp' | 'png' | 'jpg' | 'avif';
  quality?: number;
}

const {
  imageName,
  alt,
  class: className = '',
  width = 512,
  height = 512,
  loading = 'lazy',
} = Astro.props;

// Normalize image name - add .png if missing
let imageKey = imageName;
if (!imageKey.endsWith('.png')) {
  imageKey = `${imageKey}.png`;
}

// Parse '<slug>-event-<n>.png' and resolve the folder slug
const match = imageKey.match(/^(.+)-event-(\d+)\.png$/);
let imageSrc: string | null = null;
if (match) {
  const raw = match[1].toLowerCase().replace(/\s+/g, '');
  const slug = DATING_SLUGS.has(raw) ? raw : ALIASES[raw];
  if (slug) {
    imageSrc = `${R2}/dating/${slug}-event-${match[2]}.png`;
  }
}
if (!imageSrc) {
  imageSrc = `${R2}/dating/amber-event-0.png`;
}
---

<img
  src={imageSrc}
  alt={alt || `Dating Event`}
  width={width}
  height={height}
  class={`${className} dating-event-img`}
  loading={loading}
  decoding="async"
/>
