---
// Stella Sora Emblem Image Component
// Displays emblem images with proper sizing and fallbacks
// Served from the gachawiki-images R2 bucket (keeps the Pages deployment under the 20,000-file limit).
const R2 = 'https://img.gachawiki.info/stella-sora';

// Centralized emblem image mapping
const emblemImageMap: Record<string, string> = {
  lv70: 'emblem/lv70.jpg',
  lv80: 'emblem/lv80.jpg',
  lv90: 'emblem/lv90.jpg',
};

export interface Props {
  level: 'Lv.70' | 'Lv.80' | 'Lv.90';
  rarity?: 'Green' | 'Blue' | 'Gold' | 'Rainbow';
  size?: 'small' | 'medium' | 'large';
  class?: string;
  alt?: string;
}

const { level, rarity, size = 'medium', class: className = '', alt } = Astro.props;

// Get the correct image based on level
const getImageSrc = () => {
  const levelMap = {
    'Lv.70': 'lv70',
    'Lv.80': 'lv80',
    'Lv.90': 'lv90',
  };

  const levelKey = levelMap[level];
  return emblemImageMap[levelKey];
};

// Size configurations
const sizeConfig = {
  small: { width: 24, height: 24 },
  medium: { width: 32, height: 32 },
  large: { width: 48, height: 48 },
};

const dimensions = sizeConfig[size];
const imagePath = getImageSrc();
const altText = alt || `${level} Emblem`;
---

<div class={`emblem-image emblem-image-${size} ${className}`}>
  <img
    src={`${R2}/${imagePath}`}
    alt={altText}
    width={dimensions.width}
    height={dimensions.height}
    class="emblem-img"
    loading="lazy"
    decoding="async"
  />
</div>

<style>
  .emblem-image {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .emblem-img {
    display: block;
    object-fit: contain;
    border-radius: 4px;
  }
</style>
