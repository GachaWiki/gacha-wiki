  // Level-up materials - Ignis
  20081: 'upgrades/counts-rewards.png',
  20082: 'upgrades/counts-cellaring.png',
  20083: 'upgrades/counts-gift.png',

  // Level-up materials - Umbra
  20091: 'upgrades/faint-wick.png',
  20092: 'upgrades/lumen-essence.png',
