  21063: 'upgrades/tidal-essence.png',

  // Skill materials
  32000: 'upgrades/chess-piece-of-skill.png',
  32001: 'upgrades/tapping-game-cartridge.png',
  32002: 'upgrades/rhythm-game-cartridge.png',
  32003: 'upgrades/magic-sound-game-cartridge.png',
  32011: 'upgrades/shooter-game-cartridge.png',
  32012: 'upgrades/barrage-game-cartridge.png',
  32013: 'upgrades/demon-bee-game-cartridge.png',
  32021: 'upgrades/kung-fu-game-cartridge.png',
  32022: 'upgrades/fighting-game-cartridge.png',
  32023: 'upgrades/phantom-game-cartridge.png',

  // Disc upgrade materials - Eerie
  21071: 'upgrades/item_21071.png',
  21072: 'upgrades/item_21072.png',
  21073: 'upgrades/item_21073.png',

  // Disc upgrade materials - Duloos
  21081: 'upgrades/item_21081.png',
  21082: 'upgrades/item_21082.png',
  21083: 'upgrades/item_21083.png',

  // Disc upgrade materials - Faint Light
  21091: 'upgrades/item_21091.png',
  21092: 'upgrades/item_21092.png',
  21093: 'upgrades/item_21093.png',

  // Currency
  1: 'upgrades/dorra.png',
};

// Mapping by item name (for convenience)
const upgradeImageMapByName: Record<string, string> = {
  // Level-up materials - Ventus
  'Backstage Ragged Hat': 'upgrades/backstage-ragged-hat.png',
  'Spotlight Bowler': 'upgrades/spotlight-bowler.png',
  'Exeunt Bowler': 'upgrades/exeunt-bowler.png',

  // Level-up materials - Ignis
  "Count's Rewards": 'upgrades/counts-rewards.png',
  "Count's Cellaring": 'upgrades/counts-cellaring.png',
  "Count's Gift": 'upgrades/counts-gift.png',

  // Level-up materials - Umbra
  'Faint Wick': 'upgrades/faint-wick.png',
  'Lumen Essence': 'upgrades/lumen-essence.png',
  'Eternal Gloom Core': 'upgrades/eternal-gloom-core.png',

  // Boss materials
  'Forest Elf Fang': 'upgrades/forest-elf-fang.png',
  'Crimson Tempter': 'upgrades/crimson-tempter.png',
  'Colossus Core': 'upgrades/colossus-core.png',
  'Wrath Beauty': 'upgrades/wrath-beauty.png',
  'Radiant Feather Crown': 'upgrades/radiant-feather-crown.png',
  'Nightlit Haven': 'upgrades/nightlit-haven.png',

  // Essence materials
  'Forest Elf Essence': 'upgrades/forest-elf-essence.png',
  'Evil Bloom Essence': 'upgrades/evil-bloom-essence.png',
  'Colossus Essence': 'upgrades/colossus-essence.png',
  'Wind Essence': 'upgrades/wind-essence.png',
  'Radiant Crown Essence': 'upgrades/radiant-crown-essence.png',
  'Tidal Essence': 'upgrades/tidal-essence.png',

  // Skill materials
  'Chess Piece of Skill': 'upgrades/chess-piece-of-skill.png',
  'Tapping Game Cartridge': 'upgrades/tapping-game-cartridge.png',
  'Rhythm Game Cartridge': 'upgrades/rhythm-game-cartridge.png',
  'Magic Sound Game Cartridge': 'upgrades/magic-sound-game-cartridge.png',
  'Shooter Game Cartridge': 'upgrades/shooter-game-cartridge.png',
  'Barrage Game Cartridge': 'upgrades/barrage-game-cartridge.png',
  'Demon Bee Game Cartridge': 'upgrades/demon-bee-game-cartridge.png',
  'Kung Fu Game Cartridge': 'upgrades/kung-fu-game-cartridge.png',
  'Fighting Game Cartridge': 'upgrades/fighting-game-cartridge.png',
  'Phantom Game Cartridge': 'upgrades/phantom-game-cartridge.png',

  // Disc upgrade materials - Eerie
  'Eerie Breath': 'upgrades/item_21071.png',
  'Phantom Step Remnant': 'upgrades/item_21072.png',
  'Frenzied Waltz Essence': 'upgrades/item_21073.png',

  // Disc upgrade materials - Duloos
  'Duloos Breath': 'upgrades/item_21081.png',
  'Duloos Soul Remnant': 'upgrades/item_21082.png',
  'Duloos Essence': 'upgrades/item_21083.png',

  // Disc upgrade materials - Faint Light
  'Faint Light Breath': 'upgrades/item_21091.png',
  'Emberflies Soul': 'upgrades/item_21092.png',
  'Flame Light Essence': 'upgrades/item_21093.png',

  // Currency
  Dorra: 'upgrades/dorra.png',
};

export interface Props {
  itemId?: number;
  itemName?: string;
  alt?: string;
  class?: string;
  width?: number;
  height?: number;
}

const { itemId, itemName, alt, class: className = '', width = 48, height = 48 } = Astro.props;

// Get the image path from the map (by ID or by name)
let imagePath: string | undefined;
let displayName = '';

if (itemId) {
  imagePath = upgradeImageMapById[itemId];
  displayName = alt || `Item ${itemId}`;
} else if (itemName) {
  imagePath = upgradeImageMapByName[itemName];
  displayName = alt || itemName;
}
---

{imagePath ? (
  <img
    src={`${R2}/${imagePath}`}
    alt={displayName}
    width={width}
    height={height}
    class={`${className} upgrade-img`}
    loading="lazy"
    decoding="async"
  />
) : (
  <span class={`${className} upgrade-placeholder`} title={displayName}>{displayName}</span>
)}

<style>
  .upgrade-img {
    display: inline-block;
    vertical-align: middle;
  }
  .upgrade-placeholder {
    display: inline-block;
    font-size: var(--text-xs);
    color: #888;
  }
</style>
