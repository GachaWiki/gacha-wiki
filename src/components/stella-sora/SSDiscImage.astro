---
// Stella Sora Disc Base Image Component
// Served from the gachawiki-images R2 bucket (keeps the Pages deployment under the 20,000-file limit).
const R2 = 'https://k2b1c5ab57ed98e51.gachawiki.info/stella-sora';

// Disc slugs that have a base.png on R2 (frozen listing; extend when new art uploads)
const BASE_SLUGS = new Set([
  'a-gift-for-the-journey', 'a-moment-in-the-afternoon', 'auspicious-glow', 'bam-bam-girl',
  'brave-the-wind', 'bubbles', 'cage-of-roses', 'claw-the-claw', 'colors-pierce-the-grey',
  'crisp-morning', 'dancing-with-the-bones', 'daylight-garden', 'deer-s-song', 'delusion',
  'dream-factory-of-truth', 'eclipse', 'elysium', 'emerald-dream', 'fireworks', 'fist-of-courage',
  'flare-frenzy', 'fortitude', 'good-night', 'grand-feast', 'holiday-bubble', 'homeward-path',
  'indigo-sunset', 'leaf-her-to-me', 'lemon-black-tea', 'lonely-dunes', 'love-river-s-curse',
  'meow-rhythm', 'meowing-cat-god', 'midnight-mayhem', 'miraculous-anthem', 'mystic-brushstrokes',
  'new-star-prelude', 'one-shot-one-down', 'one-two-three-jump', 'pink-dream', 'prayer-beneath-light',
  'pure-white', 'rainy-tune', 'ripples-of-nostalgia', 'rolling-life', 'scorching-night-s-end',
  'sky-flowers-poem', 'snowy-night-surprise', 'soda-shopping', 'sparkling-moment', 'starlit-hope',
  'starry-night-ode', 'steam-syndrome', 'summer-afternoon-rain', 'summer-sanctuary',
  'sunlit-blossom', 'sunny-breeze', 'sweet-creek', 'sweet-invitation', 'sweet-times',
  'sword-against-stream', 'the-clash-of-blade-and-axe', 'the-knight-s-smith', 'the-lost-pilgrim',
  'the-meow', 'the-shining', 'those-with-ambition', 'tranquil-retreat', 'twin-moon-mischief',
  'united-by-fate', 'unknown-fragrance', 'vent-it-out', 'voyage-blueprint', 'whoopla', 'witch-s-swing',
  'all-that-was-beautiful',
  'bedtime-story',
  'chronicles-of-spring',
  'dappled-sunlight',
  'dawn-after-winter',
  'delivered-by-the-breeze',
  'fleeting-glimmers',
  'fly-o-caged-bird',
  'joyful-gathering',
  'little-paradise',
  'moment-of-glory',
  'petals-of-blooming-mirage',
  'phantom-of-the-banquet',
  'ride-the-waves-with-me',
  'seasonal-waves',
  'seed-alike',
  'soaring-blue',
  'stellar-destination',
  'summer-march',
  'the-bud-of-change',
  'the-cat-s-treasure',
  'touch-of-miracle',
  'traces-of-starlight',
  'veiled-dawn-of-spring',
  'wine-warm-lamps-alight',
  'wisteria-dream',
  'zesty-curiosity',
  'my-guiding-star',
  'eternal-brilliance',
]);

export interface Props {
  discSlug: string;
  alt?: string;
  class?: string;
  width?: number;
  height?: number;
}

const { discSlug, alt, class: className = '', width = 128, height = 128 } = Astro.props;

const imageSrc = BASE_SLUGS.has(discSlug) ? `${R2}/discs/${discSlug}/base.png` : null;
---

{
  imageSrc ? (
    <img
      src={imageSrc}
      alt={alt || discSlug}
      width={width}
      height={height}
      class={className}
      loading="eager"
      decoding="async"
    />
  ) : (
    <div class={`disc-placeholder ${className}`} style={`width: ${width}px; height: ${height}px;`}>
      {discSlug}
    </div>
  )
}
