---
// Stella Sora Attack Type Image Component
// Served from the gachawiki-images R2 bucket (keeps the Pages deployment under the 20,000-file limit).
const R2 = 'https://k2b1c5ab57ed98e51.gachawiki.info/stella-sora';

// Centralized attack type image mapping
const attackTypeImageMap: Record<string, string> = {
  Melee: 'attacktype/melee.jpg',
  melee: 'attacktype/melee.jpg',
  Ranged: 'attacktype/range.jpg',
  ranged: 'attacktype/range.jpg',
};

export interface Props {
  attackType: string;
  alt?: string;
  class?: string;
  width?: number;
  height?: number;
}

const { attackType, alt, class: className = '', width = 32, height = 32 } = Astro.props;

// Get the image path from the map
const imageSrc = attackTypeImageMap[attackType] || attackTypeImageMap['Melee'];
---

<img
  src={`${R2}/${imageSrc}`}
  alt={alt || attackType}
  width={width}
  height={height}
  class={`${className} attack-type-img`}
  loading="lazy"
  decoding="async"
/>
