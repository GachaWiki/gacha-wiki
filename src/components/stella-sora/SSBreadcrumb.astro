---
// Stella Sora breadcrumb: shared pill design, SS blue accent with colored
// current crumb, full-width (no 75rem cap), Guides default crumbs,
// stella-sora- legacy class.
import BreadcrumbBase from '../BreadcrumbBase.astro';
const style =
  '--bc-accent:var(--stss-primary, #7c9cf0);--bc-focus:var(--stss-primary, #7c9cf0);--bc-current:var(--stss-primary, #7c9cf0);--bc-sep:var(--stss-text-muted, rgba(184, 197, 246, 0.6));--bc-max-width:none;--bc-margin-x:0';
const defaultItems = [
  { name: 'Guides', href: '/guides' },
  { name: 'Stella Sora', href: '/guides/stella-sora/' },
];
---

<BreadcrumbBase
  {...Astro.props}
  classPrefix="stella-sora"
  ariaLabel="Breadcrumb navigation"
  defaultItems={defaultItems}
  style={style}
/>
