---
// Stella Sora Character Small Image Component
// Served from the gachawiki-images R2 bucket (keeps the Pages deployment under the 20,000-file limit).
// Uses the s.png images from little-char-images folder
const R2 = 'https://k2b1c5ab57ed98e51.gachawiki.info/stella-sora';

// Files present in little-char-images/ on R2 (frozen listing; extend when new art uploads)
const FILES = new Set([
  'allie', 'amber', 'ann', 'canace', 'caramel', 'chaton', 'chitose', 'chixia', 'coronis', 'cosette',
  'donna', 'eleanor', 'firefly', 'firenze', 'flora', 'freesia', 'fuyuka', 'gerie', 'iris',
  'jinglin', 'karin', 'kasimira', 'laru', 'minova', 'mistique', 'nanoha', 'nazuka', 'nazuna',
  'noya', 'otoha', 'ridge', 'shia', 'shimiao', 'snowish-laru', 'sparkla', 'springseek-coronis',
  'suntide-willow', 'teresa', 'tilia', 'wraith', 'firstlight-noya',
]);

// Hyphenated folders are keyed by their no-hyphen display-name normalization
const ALIASES: Record<string, string> = {
  firstlightnoya: 'firstlight-noya',
  snowishlaru: 'snowish-laru',
  springseekcoronis: 'springseek-coronis',
  suntidewillow: 'suntide-willow',
};

export interface Props {
  characterName: string;
  alt?: string;
  class?: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
  format?: 'webp' | 'png' | 'jpg' | 'avif';
  quality?: number;
}

const {
  characterName,
  alt,
  class: className = '',
  width = 60,
  height = 60,
  loading = 'lazy',
} = Astro.props;

// Normalize character name to lowercase for mapping
const normalizedName = characterName.toLowerCase().replace(/\s+/g, '');
const resolved = FILES.has(normalizedName) ? normalizedName : ALIASES[normalizedName];
const imageSrc = resolved ? `${R2}/little-char-images/${resolved}.png` : `${R2}/little-char-images/amber.png`;
---

<img
  src={imageSrc}
  alt={alt || `${characterName}`}
  width={width}
  height={height}
  class={`${className} character-small-img`}
  loading={loading}
  decoding="async"
/>
