---
// Stella Sora Potential Card Image Component
// Each potential has its own full card art on R2, named by the potential's ID
// (potential-icons/<pid>.webp — includes the rarity plate, emblem and name).
const R2 = 'https://img.gachawiki.info/stella-sora';

export interface Props {
  icon: string;
  rarity?: number;
  stype?: number;
  corner?: number | null;
  alt?: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  icon,
  alt,
  width = 120,
  height = 153,
  loading = 'lazy',
  class: className,
} = Astro.props;

const src = `${R2}/potential-icons/${icon}.webp`;
---

<div class={`potential-all-image-wrapper ${className || ''}`}>
  <img
    src={src}
    alt={alt || `Potential ${icon}`}
    width={width}
    height={height}
    loading={loading}
    decoding="async"
    class="potential-card-art"
  />
</div>

<style>
  .potential-all-image-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .potential-card-art {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 8px;
  }
</style>
