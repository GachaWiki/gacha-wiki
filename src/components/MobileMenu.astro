---
import { SITE } from '../consts';
import packageInfo from '../../package.json';
const version = packageInfo.version;
---

<div id="mobileMenu" class="mobile-menu" inert>
  <div class="mobile-menu-overlay"></div>
  <div class="mobile-menu-drawer">
    <div class="drawer-header">
      <h2 class="drawer-title">Menu</h2>
      <button id="closeMenu" class="close-menu-btn" aria-label="Close Menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
          ></path>
        </svg>
      </button>
    </div>

    <div class="drawer-content">
      <nav class="mobile-nav-links">
        <a href="/" class="mobile-nav-link">
          <span>Home</span>
          <svg class="nav-arrow" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"></path>
          </svg>
        </a>
        <a href="/guides/" class="mobile-nav-link">
          <span>Wiki Library</span>
          <svg class="nav-arrow" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"></path>
          </svg>
        </a>
        <a href="/shop" class="mobile-nav-link">
          <span>Shop</span>
          <svg class="nav-arrow" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"></path>
          </svg>
        </a>
        <a href="/weiss-schwarz/cards/" class="mobile-nav-link">
          <span>Cards</span>
          <svg class="nav-arrow" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"></path>
          </svg>
        </a>
        <a href="/apps" class="mobile-nav-link">
          <span>Apps</span>
          <svg class="nav-arrow" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"></path>
          </svg>
        </a>
        <a href="/clock" class="mobile-nav-link">
          <span>Gacha Clock</span>
          <svg class="nav-arrow" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"></path>
          </svg>
        </a>
        <a href="/swap" class="mobile-nav-link">
          <span>Swap</span>
          <svg class="nav-arrow" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"></path>
          </svg>
        </a>
        <a href="/nft" class="mobile-nav-link">
          <span>NFT</span>
          <svg class="nav-arrow" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"></path>
          </svg>
        </a>
        <a href="/about" class="mobile-nav-link">
          <span>About</span>
          <svg class="nav-arrow" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"></path>
          </svg>
        </a>
      </nav>

      <div class="drawer-divider"></div>

      <div class="mobile-social-section">
        <h3 class="social-title">Social</h3>
        <div class="mobile-social-links">
          <a href={SITE.SOCIAL.GITHUB} class="mobile-social-link" aria-label="GitHub" target="_blank" rel="noopener noreferrer">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
              ></path>
            </svg>
            <span>GitHub</span>
          </a>
          <a href={SITE.SOCIAL.X} class="mobile-social-link" aria-label="X (Twitter)" target="_blank" rel="noopener noreferrer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
              ></path>
            </svg>
            <span>X (Twitter)</span>
          </a>
          <a href={SITE.SOCIAL.DISCORD} class="mobile-social-link" aria-label="Discord" target="_blank" rel="noopener noreferrer">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"
              ></path>
            </svg>
            <span>Discord</span>
          </a>
        </div>
      </div>

      <div class="drawer-divider"></div>

      <!-- Version and License Info -->
      <div class="mobile-footer-info">
        <a
          href="https://github.com/boring877/gacha-wiki"
          target="_blank"
          rel="noopener noreferrer"
          class="mobile-version-link"
        >
          <span class="mobile-version-pill">v{version}</span>
        </a>
        <p class="mobile-license-text">
          Open source under <a href="/LICENSE" class="mobile-license-link">MIT License</a>
        </p>
      </div>
    </div>
  </div>
</div>

<style>
  /* Mobile Menu - Slide-in Drawer Style */
  .mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    z-index: var(--z-modal);
    opacity: 0;
    visibility: hidden;
    overscroll-behavior: contain;
    /* Remove blue highlights and selections */
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none;
  }

  .mobile-menu.active {
    opacity: 1;
    visibility: visible;
  }

  .mobile-menu-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(8px);
    cursor: pointer;
    z-index: var(--z-modal);
  }

  .mobile-menu-drawer {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    background: rgba(28, 28, 28, 0.98);
    backdrop-filter: blur(30px);
    border: none;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    z-index: var(--z-modal);
    /* Hide scrollbar */
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE and Edge */
    /* Keep smooth momentum scrolling on touch devices */
    -webkit-overflow-scrolling: touch;
    scroll-behavior: smooth; /* Smooth scrolling for all modern browsers */
    overscroll-behavior: contain; /* Prevent scroll chaining on all devices */
  }

  /* Hide scrollbar for WebKit browsers */
  .mobile-menu-drawer::-webkit-scrollbar {
    display: none;
  }

  .mobile-menu.active .mobile-menu-drawer {
    /* No transform needed - appears instantly */
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2rem 2rem 1.5rem 2rem;
    border-bottom: 1px solid rgba(255, 183, 77, 0.1);
    min-height: 90px;
  }

  .drawer-title {
    font-family: var(--font-display), sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--amber-glow);
    margin: 0;
  }

  .close-menu-btn {
    background: rgba(255, 183, 77, 0.1);
    border: 1px solid rgba(255, 183, 77, 0.3);
    border-radius: 8px;
    color: var(--amber-glow);
    cursor: pointer;
    padding: 0.5rem;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    touch-action: manipulation;
    /* Remove blue highlights */
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none;
    outline: none;
  }

  .drawer-content {
    flex: 1;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center; /* Center content for full-screen experience */
  }

  .mobile-nav-links {
    display: grid;
    grid-template-columns: 1fr; /* Default: single column for mobile portrait */
    gap: 1rem;
    margin-bottom: 3rem;
    max-width: 800px; /* Larger max width for better tablet experience */
    margin-left: auto;
    margin-right: auto;
    width: 100%;
    padding: 0 1rem; /* Add horizontal padding */
  }

  .mobile-nav-link {
    color: var(--text-inverse);
    text-decoration: none;
    font-size: 1rem; /* More reasonable font size */
    font-weight: 500;
    padding: 0.8rem 1.2rem; /* More compact padding */
    border-radius: 12px; /* Smaller border radius */
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    gap: 0.8rem; /* Less gap between icon and text */
    touch-action: manipulation;
    position: relative;
    min-height: 48px; /* Smaller but still touch-friendly */
    /* Remove blue highlights */
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none;
    outline: none;
  }

  .mobile-nav-link span {
    flex: 1;
  }

  .nav-arrow {
    width: 16px;
    height: 16px;
    opacity: 0.4;
    margin-left: auto;
  }

  .mobile-nav-link svg:first-child {
    width: 20px;
    height: 20px;
    opacity: 0.7;
  }

  .drawer-divider {
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(255, 183, 77, 0.2), transparent);
    margin: 1rem 0 1.5rem 0;
  }

  .mobile-social-section {
    margin-top: auto;
    max-width: 800px; /* Match navigation section */
    margin-left: auto;
    margin-right: auto;
    width: 100%;
    padding: 0 1rem; /* Match navigation section padding */
  }

  .social-title {
    font-family: var(--font-display), sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.6);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 1rem 0;
  }

  .mobile-social-links {
    display: grid;
    grid-template-columns: 1fr; /* Default: single column */
    gap: 0.5rem;
  }

  .mobile-social-link {
    color: var(--text-inverse);
    text-decoration: none;
    padding: 0.875rem 1rem;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9rem;
    font-weight: 500;
    touch-action: manipulation;
    /* Remove blue highlights */
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none;
    outline: none;
  }

  .mobile-social-link svg {
    width: 18px;
    height: 18px;
    opacity: 0.7;
  }

  /* Mobile Footer Info */
  .mobile-footer-info {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.5rem;
  }

  .mobile-version-link {
    text-decoration: none;
  }

  .mobile-version-pill {
    background: var(--amber-glow);
    padding: 0.3rem 0.6rem;
    border-radius: 6px;
    font-family: var(--font-display), sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--bg-dark);
    display: inline-block;
  }

  .mobile-license-text {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.65rem;
    text-align: center;
    margin: 0;
    line-height: 1.3;
  }

  .mobile-license-link {
    color: var(--amber-glow);
    text-decoration: none;
  }

  /* Mobile Landscape - 2 columns for better use of horizontal space */
  @media screen and (max-height: 768px) and (orientation: landscape) {
    .mobile-nav-links {
      grid-template-columns: 1fr 1fr; /* 2 columns in landscape */
      gap: 1rem;
      max-width: 700px;
      padding: 0 1.5rem;
    }

    .drawer-content {
      padding: 1rem 1.5rem;
    }

    .mobile-nav-link {
      padding: 0.7rem 1rem;
      font-size: 0.95rem;
      min-height: 44px;
    }

    .mobile-social-section {
      padding: 0 1.5rem; /* Match navigation padding in landscape */
    }

    .mobile-social-links {
      grid-template-columns: 1fr 1fr; /* 2 columns in landscape */
      gap: 0.5rem;
    }
  }

  /* Tablet Portrait - 2 columns */
  @media screen and (min-width: 768px) and (max-width: 1024px) and (orientation: portrait) {
    .mobile-nav-links {
      grid-template-columns: 1fr 1fr; /* 2 columns on tablet portrait */
      gap: 1.2rem;
      max-width: 600px;
      padding: 0 1.5rem;
    }

    .mobile-nav-link {
      padding: 0.9rem 1.3rem;
      font-size: 1rem;
      min-height: 48px;
    }
  }

  /* Tablet Landscape - 2 columns with more spacing */
  @media screen and (min-width: 768px) and (max-width: 1024px) and (orientation: landscape) {
    .mobile-nav-links {
      grid-template-columns: 1fr 1fr; /* 2 columns on tablet landscape */
      gap: 1.5rem;
      max-width: 700px;
      padding: 0 2rem;
    }

    .drawer-content {
      padding: 1.5rem 2rem;
    }

    .mobile-nav-link {
      padding: 0.8rem 1.2rem;
      font-size: 1rem;
      min-height: 46px;
    }

    .mobile-social-section {
      padding: 0 2rem; /* Match navigation padding in tablet landscape */
    }

    .mobile-social-links {
      grid-template-columns: 1fr 1fr; /* 2 columns in tablet landscape */
      gap: 0.75rem;
    }
  }

  /* Small Mobile adjustments */
  @media screen and (max-width: 480px) {
    .mobile-nav-links {
      grid-template-columns: 1fr; /* Single column on small screens */
      padding: 0 1rem;
      gap: 0.8rem;
    }

    .drawer-header {
      padding: 1.5rem 1.5rem 1rem 1.5rem;
    }

    .drawer-title {
      font-size: 1.3rem;
    }

    .drawer-content {
      padding: 1.5rem;
    }

    .mobile-nav-link {
      padding: 1.2rem 1.5rem;
      font-size: 1rem;
      min-height: 50px;
    }

    .mobile-social-link {
      padding: 0.8rem 1rem;
      font-size: 0.9rem;
    }
  }

  /* Short screens */
  @media screen and (max-height: 600px) {
    .drawer-header {
      min-height: 60px;
      padding: 1rem 1.5rem 0.75rem 1.5rem;
    }

    .drawer-title {
      font-size: 1.3rem;
    }

    .drawer-content {
      padding: 1rem 1.5rem 1.5rem 1.5rem;
    }

    .mobile-nav-links {
      gap: 0.4rem;
      margin-bottom: 1.5rem;
    }

    .mobile-nav-link {
      padding: 0.75rem 1rem;
    }

    .mobile-social-links {
      gap: 0.4rem;
    }

    .mobile-social-link {
      padding: 0.6rem 0.875rem;
    }
  }

  /* Very short screens (landscape phones) */
  @media screen and (max-height: 450px) {
    .drawer-header {
      min-height: 50px;
      padding: 0.75rem 1.25rem 0.5rem 1.25rem;
    }

    .drawer-title {
      font-size: 1.2rem;
    }

    .drawer-content {
      padding: 0.75rem 1.25rem 1.25rem 1.25rem;
    }

    .mobile-nav-links {
      gap: 0.3rem;
      margin-bottom: 1rem;
    }

    .mobile-nav-link {
      padding: 0.6rem 0.875rem;
      font-size: 0.9rem;
    }

    .mobile-social-links {
      gap: 0.3rem;
    }

    .mobile-social-link {
      padding: 0.5rem 0.75rem;
      font-size: 0.8rem;
    }

    .drawer-divider {
      margin: 0.75rem 0 1rem 0;
    }
  }
</style>
