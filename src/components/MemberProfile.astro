---
// Member account pill for the shared header right slot: shows name + email + Sign out
// for signed-in wiki members (via /whoami). Hidden entirely for anonymous visitors.
// In dev (no gate), import.meta.env.DEV shows a mock member for previewing.
---

<span id="gw-member-root" style="display:none" class="gw-member-root">
  <button type="button" id="gw-member-btn" class="gw-member-btn" aria-label="Account menu">
    <span id="gw-member-avatar" class="gw-member-avatar">M</span>
    <span id="gw-member-name" class="gw-member-name">member</span>
    <span class="gw-member-caret" aria-hidden="true">&#9662;</span>
  </button>
  <div id="gw-member-menu" class="gw-member-menu" style="display:none">
    <div class="gw-member-head">
      <span id="gw-member-avatar2" class="gw-member-avatar gw-member-avatar-lg">M</span>
      <span class="gw-member-headtext">
        <span id="gw-member-mname" class="gw-member-mname">member</span>
        <span id="gw-member-memail" class="gw-member-memail">member@example.com</span>
      </span>
    </div>
    <a id="gw-member-out" class="gw-member-out" href="/logout">Sign out</a>
  </div>
</span>

<style>
  .gw-member-root { position: relative; display: inline-flex; margin-left: 10px; }
  .gw-member-btn {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 3px 12px 3px 4px;
    background: rgba(17, 20, 26, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    cursor: pointer;
  }
  .gw-member-avatar {
    width: 26px; height: 26px; border-radius: 50%;
    background: linear-gradient(135deg, #e91e63, #ad1457);
    color: #fff; font-size: var(--text-3xs); font-weight: 700;
    display: flex; align-items: center; justify-content: center;
    letter-spacing: 0.5px;
  }
  .gw-member-avatar-lg { width: 34px; height: 34px; font-size: var(--text-2xs); }
  .gw-member-name {
    font-size: var(--text-sm); font-weight: 600; color: #fff;
    max-width: 130px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .gw-member-caret { font-size: var(--text-3xs); color: #8a97a3; }
  .gw-member-menu {
    position: fixed; width: 250px;
    background: #161a20; border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 12px; overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    z-index: 1000;
  }
  .gw-member-head {
    display: flex; align-items: center; gap: 11px; padding: 13px 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .gw-member-headtext { display: flex; flex-direction: column; min-width: 0; }
  .gw-member-mname { font-size: var(--text-base); font-weight: 700; color: #fff; }
  .gw-member-memail { font-size: var(--text-xs); color: #8a97a3; word-break: break-all; margin-top: 1px; }
  .gw-member-out {
    display: flex; align-items: center; gap: 9px; padding: 11px 14px;
    font-size: var(--text-sm); font-weight: 600; color: #e91e63;
    text-decoration: none; border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .gw-member-out-ico {
    width: 14px; height: 14px; border: 1.6px solid #e91e63; border-radius: 3px;
    position: relative; flex: none;
  }
  .gw-member-out-ico::after {
    content: ""; position: absolute; right: 2px; top: -4px; width: 7px; height: 1.6px;
    background: #e35c75; transform: rotate(-45deg);
  }
  @media (max-width: 640px) { .gw-member-name { display: none; } .gw-member-btn { padding-right: 6px; } }
</style>

<script>
  (function () {
    var root = document.getElementById('gw-member-root');
    if (!root) return;
    function activate(email) {
      var name = email.split('@')[0];
      var initial = name.charAt(0).toUpperCase() || 'M';
      document.getElementById('gw-member-name').textContent = name;
      document.getElementById('gw-member-mname').textContent = name;
      document.getElementById('gw-member-memail').textContent = email;
      document.getElementById('gw-member-avatar').textContent = initial;
      document.getElementById('gw-member-avatar2').textContent = initial;
      root.style.display = 'inline-flex';
    }
    if (import.meta.env.DEV) {
      activate('devpreview@localhost');
    } else {
      fetch('/whoami')
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) { if (d && d.member) activate(d.member); })
        .catch(function () {});
    }
    var DEV_PREVIEW = false; /* replaced at build for dev */
    var btn = document.getElementById('gw-member-btn');
    var menu = document.getElementById('gw-member-menu');
    // Portal the menu to the page root so no header overflow/stacking context
    // can clip or cover it; anchor it to the button's live position.
    function place() {
      var r = btn.getBoundingClientRect();
      menu.style.top = r.bottom + 8 + 'px';
      menu.style.left = Math.max(8, r.right - 250) + 'px';
    }
    function open() {
      document.body.appendChild(menu);
      place();
      menu.style.display = 'block';
    }
    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      if (menu.style.display === 'block') { menu.style.display = 'none'; } else { open(); }
    });
    window.addEventListener('scroll', function () { if (menu.style.display === 'block') place(); }, true);
    window.addEventListener('resize', function () { if (menu.style.display === 'block') place(); });
    document.addEventListener('click', function () { menu.style.display = 'none'; });
  })();
</script>
