---
// Shared layout for Star Lusts pages (R18 bullet hell shmup by PINKCORE)
import GameSEO from '../../components/GameSEO.astro';
import Analytics from '../../components/Analytics.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import GameNavigationHeader from '../../components/GameNavigationHeader.astro';
import MobileMenu from '../../components/MobileMenu.astro';
import CustomScrollbar from '../../components/CustomScrollbar.astro';
import DecorativeLines from '../../components/DecorativeLines.astro';

import '../../styles/games/star-lusts/sl-common.css';
import '../../styles/global.css';
import '../../styles/typography.css';

export interface Props {
  title: string;
  description?: string;
  gameTitle?: string;
}

const { title, description, gameTitle } = Astro.props;
const seoTitle = `${title} | Star Lusts`;
const seoDescription = description || 'Star Lusts wiki: character database for the R18 bullet hell shmup by PINKCORE. Stats, skills and profiles from game data.';
---

<html lang="en">
  <head>
    <GameSEO gameKey="star-lusts" title={seoTitle} description={seoDescription} />
    <Analytics />
  </head>
  <body class="sl-body">
    <CustomScrollbar />
    <div class="bg-layer sl-bg-primary"></div>
    <div class="bg-layer sl-bg-accent-1"></div>
    <div class="bg-layer sl-bg-accent-2"></div>

    <div class="sl-content">
      <Header />
      <GameNavigationHeader currentPath={Astro.url.pathname} gameKey="star-lusts" />
      <MobileMenu />

      <div class="sl-container">
        <main class="sl-main" id="main-content">
          {gameTitle && (
            <section class="sl-title-section">
              <h1 class="sl-page-title">{gameTitle}</h1>
              <DecorativeLines />
            </section>
          )}

          <div class="content-area">
            <slot />
          </div>
        </main>
      </div>

      <Footer />
    </div>
  </body>
</html>
