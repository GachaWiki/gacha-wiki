---
// Landing layout for Gene-Sys: Adam (mirrors the majo/desire-immortal-realm landing layout).
import GameSEO from '../../components/GameSEO.astro';
import Analytics from '../../components/Analytics.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import GameNavigationHeader from '../../components/GameNavigationHeader.astro';
import MobileMenu from '../../components/MobileMenu.astro';
import CustomScrollbar from '../../components/CustomScrollbar.astro';
import DecorativeLines from '../../components/DecorativeLines.astro';
import GSABreadcrumb from '../../components/gene-sys-adam/GSABreadcrumb.astro';

import '../../styles/global.css';
import '../../styles/typography.css';
import '../../styles/games/gene-sys-adam/gsa-common.css';

export interface Props {
  title: string;
  description?: string;
  gameTitle?: string;
  heroImage?: string;
  crumbName?: string;
  seoKeywords?: readonly string[];
  ambientVideo?: boolean;
}

const { title, description, gameTitle, heroImage, crumbName, seoKeywords, ambientVideo = false } = Astro.props;
const seoTitle = `${title} | Gene-Sys: Adam Wiki`;
const seoDescription =
  description ||
  'Gene-Sys: Adam wiki: Sin City revenge RPG. Character database, skills, gacha rates, items and game systems.';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/webp" href="https://k2b1c5ab57ed98e51.gachawiki.info/gene-sys-adam/gameimg_icon_a.webp" />
    <meta name="generator" content={Astro.generator} />
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <GameSEO
      gameKey="gene-sys-adam"
      title={seoTitle}
      description={seoDescription}
      additionalKeywords={seoKeywords}
    />
    <Analytics />
  </head>
  <body class="gsa-body">
    <CustomScrollbar />
    <div class="bg-layer gsa-bg"></div>

    <div class="gsa-content">
      <Header />
      <GameNavigationHeader currentPath={Astro.url.pathname} gameKey="gene-sys-adam" />
      <MobileMenu />

      <div class="gsa-container">
        <main class="gsa-main" id="main-content">
          {/* Ambient landing video lives HERE, not in the page slot: it is
              position:absolute with top:0, and .gsa-content-area is
              position:relative, so slot placement would anchor it below the
              hero instead of at the page top. */}
          {ambientVideo && (
            <div class="gsa-bg-video-wrap" aria-hidden="true">
              <video class="gsa-bg-video" autoplay muted loop playsinline preload="auto">
                <source src="/videos/gsa-hero.mp4" type="video/mp4" />
              </video>
            </div>
          )}
          {heroImage && gameTitle && (
            <section class="gsa-hero-section">
              <div class="gsa-hero-image-container">
                <img src={heroImage} alt={gameTitle} class="gsa-hero-image" width={1920} height={1080} loading="eager" decoding="async" />
                <div class="gsa-hero-overlay" />
              </div>
              <h1 class="gsa-title-only-heading">{gameTitle}</h1>
              <DecorativeLines />
            </section>
          )}

          {!heroImage && gameTitle && (
            <section class="gsa-title-only-section">
              <h1 class="gsa-title-only-heading">{gameTitle}</h1>
              <DecorativeLines />
            </section>
          )}

          <GSABreadcrumb autoGenerate gameKey="gene-sys-adam" showBackButton={true} currentPageName={crumbName} />

          <div class="gsa-content-area">
            <slot />
          </div>
        </main>
      </div>
      <Footer />
    </div>
  </body>
</html>
