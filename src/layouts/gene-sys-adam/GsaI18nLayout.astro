---
// Shared layout for the Gene-Sys: Adam non-EN language sections (ja/ko/th/
// vi/zh-cn): the same skeleton and CSS as the EN LandingLayout with html
// lang, the localized game navigation (navOverride) and manual localized
// breadcrumbs, all driven by the per-language ui module passed in `ui`.
import GameSEO from '../../components/GameSEO.astro';
import Analytics from '../../components/Analytics.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import GameNavigationHeader from '../../components/GameNavigationHeader.astro';
import MobileMenu from '../../components/MobileMenu.astro';
import CustomScrollbar from '../../components/CustomScrollbar.astro';
import DecorativeLines from '../../components/DecorativeLines.astro';
import GSABreadcrumb from '../../components/gene-sys-adam/GSABreadcrumb.astro';
import '../../styles/global.css';
import '../../styles/typography.css';
import '../../styles/games/gene-sys-adam/gsa-common.css';

export interface Props {
  ui: any;
  title: string;
  description?: string;
  gameTitle?: string;
  heroImage?: string;
  crumbName?: string;
  breadcrumbItems?: { name: string; href?: string }[];
  seoKeywords?: readonly string[];
  ambientVideo?: boolean;
}

const { ui, title, description, gameTitle, heroImage, crumbName, breadcrumbItems, seoKeywords, ambientVideo = false } =
  Astro.props;
const seoTitle = `${title} | ${ui.gameName} ${ui.langLabel}`;
const seoDescription = description || ui.seoDesc;

const langNav = {
  name: ui.gameName,
  gameUrl: ui.baseUrl,
  sections: ui.nav,
};
---

<html lang={ui.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/webp" href="https://img.gachawiki.info/gene-sys-adam/gameimg_icon_a.webp" />
    <meta name="generator" content={Astro.generator} />
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <GameSEO
      gameKey="gene-sys-adam"
      title={seoTitle}
      description={seoDescription}
      additionalKeywords={[...(seoKeywords || []), ui.gameName, 'Gene-Sys Adam', ui.langLabel]}
    />
    <Analytics />
  </head>
  <body class="gsa-body">
    <CustomScrollbar />
    <div class="bg-layer gsa-bg"></div>

    <div class="gsa-content">
      <Header />
      <GameNavigationHeader currentPath={Astro.url.pathname} gameKey="gene-sys-adam" navOverride={langNav} />
      <MobileMenu />

      <div class="gsa-container">
        <main class="gsa-main" id="main-content">
          {ambientVideo && (
            <div class="gsa-bg-video-wrap" aria-hidden="true">
              <video class="gsa-bg-video" autoplay muted loop playsinline preload="auto">
                <source src="/videos/gsa-hero.mp4" type="video/mp4" />
              </video>
            </div>
          )}
          {!heroImage && gameTitle && (
            <section class="gsa-title-only-section">
              <h1 class="gsa-title-only-heading">{gameTitle}</h1>
              <DecorativeLines />
            </section>
          )}

          {
            breadcrumbItems && breadcrumbItems.length > 0 ? (
              <GSABreadcrumb
                items={breadcrumbItems.map(c => ({ name: c.name, href: c.href || '#' }))}
                showBackButton={true}
              />
            ) : (
              <GSABreadcrumb autoGenerate gameKey="gene-sys-adam" showBackButton={true} currentPageName={crumbName} />
            )
          }

          <div class="gsa-content-area">
            <slot />
          </div>
        </main>
      </div>
      <Footer />
    </div>
  </body>
</html>
