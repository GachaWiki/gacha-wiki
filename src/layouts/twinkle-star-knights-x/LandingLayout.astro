---
import TSKXBaseHead from '../../components/twinkle-star-knights-x/TSKXBaseHead.astro';
import GameSEO from '../../components/GameSEO.astro';
import Analytics from '../../components/Analytics.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import GameNavigationHeader from '../../components/GameNavigationHeader.astro';
import MobileMenu from '../../components/MobileMenu.astro';
import CustomScrollbar from '../../components/CustomScrollbar.astro';
import DecorativeLines from '../../components/DecorativeLines.astro';
import Breadcrumb from '../../components/twinkle-star-knights-x/Breadcrumb.astro';
import { Image } from 'astro:assets';

import '../../styles/games/twinkle-star-knights-x/tskx-colors.css';
import '../../styles/global.css';
import '../../styles/typography.css';
import '../../styles/games/twinkle-star-knights-x/tskx-layout.css';
import '../../styles/games/twinkle-star-knights-x/tskx-landing.css';

export interface Props {
  title: string;
  description?: string;
  gameTitle?: string;
  heroImage?: any;
}

const { title, description, gameTitle, heroImage } = Astro.props;
const seoTitle = `${title} | Twinkle Star Knights X`;
const seoDescription = description || 'Twinkle Star Knights X pre-registration wiki. Revealed character profiles, story, rewards and event info.';
---

<html lang="en">
  <head>
    <TSKXBaseHead title={seoTitle} description={seoDescription} />
    <GameSEO gameKey="twinkle-star-knights-x" title={seoTitle} description={seoDescription} />
    <Analytics />
  </head>
  <body class="tskx-body">
    <CustomScrollbar />
    <div class="bg-layer tskx-bg-primary"></div>
    <div class="bg-layer tskx-bg-accent-1"></div>
    <div class="bg-layer tskx-bg-accent-2"></div>
    <div class="bg-layer tskx-bg-accent-3"></div>

    <div class="tskx-content">
      <Header />
      <GameNavigationHeader currentPath={Astro.url.pathname} gameKey="twinkle-star-knights-x" />
      <MobileMenu />

      <div class="tskx-container">
        <main class="tskx-main" id="main-content">
          {
            heroImage && gameTitle && (
              <section class="hero-section">
                <div class="hero-image-wrapper">
                  <div class="hero-image-container">
                    <Image
                      src={heroImage}
                      alt={gameTitle}
                      class="hero-image"
                      width={1200}
                      height={400}
                      loading="eager"
                      decoding="async"
                    />
                    <div class="hero-overlay" />
                  </div>
                </div>
                <h1 class="hero-title">{gameTitle}</h1>
                <DecorativeLines />
              </section>
            )
          }

          {!heroImage && gameTitle && (
            <section class="tskx-title-only-section">
              <h1 class="tskx-title-only-heading">{gameTitle}</h1>
              <DecorativeLines />
            </section>
          )}

          <Breadcrumb autoGenerate={true} gameKey="twinkle-star-knights-x" showBackButton={true} />

          <div class="content-area">
            <slot />
          </div>
        </main>
      </div>

      <Footer />
    </div>
  </body>
</html>
