---
// Japanese banner timeline: /ja/guides/horizon-walker/banners/
// Same banner-timeline.js data as the EN page (order, grouping, images).
// Banner/search titles stay in English (official proper nouns without an
// official JA); character and weapon names use the game's official JA via
// game-text.js maps. Periods use the numeric 2026.01.01 ~ 2026.01.15 format.
import HwLangLayout from '../../../../layouts/lang/HwLangLayout.astro';
import DecorativeLines from '../../../../components/DecorativeLines.astro';
import '../../../../styles/games/horizon-walker/hw-guide.css';
import { bannerRuns, focusedSearches, characterReleases } from '../../../../data/horizon-walker/banner-timeline.js';
import { HORIZON_WALKER_CHARACTERS } from '../../../../data/horizon-walker/characters.js';
import { HW_ZH_NAMES, HW_ZH_INHERITANCE } from '../../../../data/horizon-walker/ja/game-text.js';
import { HW_ZH } from '../../../../data/horizon-walker/ja/ui.js';
import { r2Url } from '../../../../data/r2-config.js';
import { CharacterImage, WeaponImage, HWRarityIcon } from '../../../../components/horizon-walker/index.astro';

export const prerender = true;

const charBySlug = {};
for (const c of HORIZON_WALKER_CHARACTERS) {
  charBySlug[c.slug] = c;
}

// official JA name of a roster character, by EN name or slug
const jaCharName = (c) => (c ? HW_ZH_NAMES[c.id] || null : null);
const jaBySlug = (slug) => jaCharName(charBySlug[slug]);
// official JA name of an EX/inheritance weapon (EN loc name keyed)
const jaWeaponName = (name) => HW_ZH_INHERITANCE[name]?.name || null;

// numeric period format, kept identical in spirit to the EN dates
const fmt = (iso) => `${iso.slice(0, 4)}.${iso.slice(5, 7)}.${iso.slice(8, 10)}`;
const fmtShort = (iso) => `${iso.slice(5, 7)}.${iso.slice(8, 10)}`;
const windowLabel = (r) =>
  r.start.slice(0, 4) === r.end.slice(0, 4)
    ? `${fmtShort(r.start)} ~ ${fmt(r.end)}`
    : `${fmt(r.start)} ~ ${fmt(r.end)}`;

const days = (r) =>
  Math.round((Date.parse(r.end + 'T12:00:00Z') - Date.parse(r.start + 'T12:00:00Z')) / 86400000);

const isNew = (r) => r.type === 'debut';
const isActive = (r) =>
  Date.parse(r.start + 'T00:00:00Z') <= Date.now() && Date.now() <= Date.parse(r.end + 'T23:59:59Z');

// group runs by year, newest first (same as EN)
const yearGroups = [];
for (const r of bannerRuns) {
  const year = r.start.slice(0, 4);
  const last = yearGroups[yearGroups.length - 1];
  if (last && last.year === year) last.runs.push(r);
  else yearGroups.push({ year, runs: [r] });
}

// search index: EN names + official JA names so both work
const searchOf = (r) =>
  r.entries
    .map((e) => [e.name, jaBySlug(e.charSlug), jaWeaponName(e.name)].filter(Boolean).join(' '))
    .join(' ')
    .toLowerCase();

const kindJa = (kind) => (kind === 'vanguard' ? '親衛' : kind === 'weapon' ? '武器' : 'ガチャ');
---

<HwLangLayout lang="ja" ui={HW_ZH}
  title="ガチャ履歴 - ホライゾン・ウォーカー日本語ウィキ - GachaWiki"
  description="ホライゾン・ウォーカーの全 Special Search 限定ガチャの履歴：新規親衛・専用武器ガチャと復刻ガチャの開始・終了日を、公式更新情報をもとに整理しています。"
  keywords={['ホライゾン・ウォーカー', 'ガチャ', 'ガチャ履歴', '復刻', 'Special Search']}
  breadcrumbItems={[
    { name: 'ホーム', href: '/' },
    { name: 'ホライゾン・ウォーカー', href: HW_ZH.baseUrl },
    { name: 'ガチャ履歴' },
  ]}
>
  <section class="hw-guide-hero">
    <h1 class="hw-guide-title">ガチャ履歴</h1>
    <p class="hw-guide-subtitle">サービス開始から現在までのすべての Special Search ガチャ。日付は公式更新情報をもとに整理しています。</p>
    <DecorativeLines />
  </section>

  <div class="hw-guide-content">
  <div class="bt-page">
    <div class="bt-intro">
      <p>
        『ホライゾン・ウォーカー』のガチャシステムは FairyNet Special Search です。新規親衛と専用武器のガチャは通常 2 週間開催され、その後復刻ガチャとして再登場します。当ページは
        <a href={`${HW_ZH.baseUrl}updates/`}>公式更新情報</a>の Special Search セクションをもとに整理しています。日時が明記されているガチャは正確な期間で、それ以外はメンテナンス日と後日の終了告知から推定しています（近似と表示）。日付は韓国サーバーのスケジュールに従い、毎日 10:00（KST）にリセットされます。ガチャタイトルは公式英語名で、公式日本語訳はまだありません。
      </p>
    </div>

    <div class="bt-controls">
      <div class="bt-filters" role="group" aria-label="ガチャの絞り込み">
        <button class="bt-filter active" data-filter="all">すべて</button>
        <button class="bt-filter" data-filter="debut">新規</button>
        <button class="bt-filter" data-filter="rerun">復刻</button>
        <button class="bt-filter" data-filter="active">開催中</button>
      </div>
      <input type="text" id="zhBtSearch" class="bt-search" placeholder="ガチャを検索（日本語名・英語名可。例：ベラ、Doomstar）" autocomplete="off" />
      <span class="bt-count" id="zhBtCount">{bannerRuns.length} 件のガチャ</span>
    </div>

    {
      yearGroups.map((g) => (
        <section class="bt-year" data-year={g.year}>
          <h2 class="bt-year-title">{g.year}</h2>
          <div class="bt-cards">
            {g.runs.map((r) => (
              <article
                class={`bt-card ${isNew(r) ? 'bt-new' : 'bt-rerun'} ${r.bannerImage ? 'bt-has-art' : ''}`}
                data-type={r.type}
                data-active={isActive(r) ? '1' : '0'}
                data-start={r.start}
                data-end={r.end}
                data-search={searchOf(r)}
              >
                <div class="bt-card-body">
                  {r.bannerImage && (
                    <a class="bt-art" href={r2Url('horizon-walker', r.bannerImage)} target="_blank" rel="noopener">
                      <img
                        src={r2Url('horizon-walker', r.bannerImage)}
                        alt={`公式ガチャのキービジュアル：${r.entries.map((e) => e.name).join('、')}`}
                        loading="lazy"
                        width="700"
                        height="650"
                      />
                    </a>
                  )}
                  <div class="bt-card-info">
                    <header class="bt-card-head">
                      <div class="bt-card-when">
                        <span class="bt-dates">{windowLabel(r)}</span>
                        <span class="bt-len">{days(r)} 日間</span>
                        {isActive(r) && <span class="bt-badge bt-live">開催中</span>}
                        <span class={`bt-badge ${isNew(r) ? 'bt-badge-new' : 'bt-badge-rerun'}`}>
                          {isNew(r) ? '新規' : '復刻'}
                        </span>
                      </div>
                      <a class="bt-src" href={`${HW_ZH.baseUrl}updates/${r.sourceNote}/`}>更新情報</a>
                    </header>
                    {(r.approximate || r.reconstructed) && (
                      <p class="bt-flag">
                        {r.reconstructed
                          ? '期間は推定です。このガチャは後日の終了告知でのみ言及されています。'
                          : '近似した期間です。公式更新情報に正確な終了日が記載されていません。'}
                      </p>
                    )}
                    <div class={r.bannerImage ? 'bt-chips' : 'bt-entries'}>
                      {r.entries.map((e) => {
                        const ch = e.charSlug ? charBySlug[e.charSlug] : undefined;
                        const icon = e.noteImage ? (
                          <img src={r2Url('horizon-walker', e.noteImage)} alt={e.name} loading="lazy" width="44" height="44" />
                        ) : ch ? (
                          <CharacterImage imageName={ch.image || ch.name} alt={jaCharName(ch) || e.name} width={44} height={44} />
                        ) : e.weaponImage ? (
                          <WeaponImage imageName={e.weaponImage} alt={e.name} width={44} height={44} />
                        ) : null;
                        const kindLine = [kindJa(e.kind), e.kind === 'vanguard' ? jaBySlug(e.charSlug) : jaWeaponName(e.name)]
                          .filter(Boolean)
                          .join(' · ');
                        const inner = (
                          <>
                            {icon && <span class="bt-chip-img">{icon}</span>}
                            <span class="bt-chip-meta">
                              <span class="bt-kind">{kindLine}</span>
                              <span class="bt-name">{e.name}</span>
                            </span>
                          </>
                        );
                        return ch ? (
                          <a class="bt-chip" href={`${HW_ZH.baseUrl}characters/${ch.slug}/`}>{inner}</a>
                        ) : (
                          <span class="bt-chip">{inner}</span>
                        );
                      })}
                    </div>
                  </div>
                </div>
                {r.bannerImage && <p class="bt-art-note">公式更新情報のガチャキービジュアル</p>}
              </article>
            ))}
          </div>
        </section>
      ))
    }

    {
      focusedSearches.length > 0 && (
        <section class="bt-focused">
          <h2 class="bt-year-title">Focused Search の開催期間</h2>
          <p class="bt-focused-note">
            公式更新情報で発表された限定選択式ガチャ（Focused Search）の開催期間です。未使用の Focused Search チケットは期間終了後に失効します。
          </p>
          <div class="bt-focused-list">
            {focusedSearches.map((f) => (
              <span class="bt-focused-chip">{fmt(f.start)} ~ {fmt(f.end)}</span>
            ))}
          </div>
        </section>
      )
    }

    <section class="bt-releases" id="releases">
      <h2 class="bt-year-title">キャラ実装日</h2>
      <p class="bt-focused-note">
        各親衛キャラが入手可能になった時期を、公式更新情報からそのまま掲載しています：サービス開始時の初期ロースター、ガチャ初登場、直接実装の 3 種類です。専用武器ガチャは上のカードをご確認ください。
      </p>
      <div class="bt-controls bt-rel-controls">
        <input type="text" id="zhBtRelSearch" class="bt-search" placeholder="キャラを検索（日本語名・英語名可。例：アラハ、Araha）" autocomplete="off" />
        <div class="bt-filters" role="group" aria-label="並び替え">
          <button class="bt-filter active" data-rsort="new">新しい順</button>
          <button class="bt-filter" data-rsort="old">古い順</button>
          <button class="bt-filter" data-rsort="az">名前順</button>
        </div>
        <span class="bt-count" id="zhBtRelCount">{characterReleases.length} 名のキャラ</span>
      </div>
      <div class="bt-rel-wrap">
        <table class="bt-rel-table">
          <thead>
            <tr>
              <th>キャラ</th>
              <th>レアリティ</th>
              <th>実装日</th>
              <th>入手方法</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="zhBtRelBody">
            {characterReleases.map((c) => {
              const ch = c.slug ? charBySlug[c.slug] : undefined;
              const zh = jaBySlug(c.slug);
              return (
                <tr
                  data-date={c.date}
                  data-name={(zh || c.name).toLowerCase()}
                  data-search={`${c.name} ${zh || ''} ${c.bannerName ?? ''} ${c.via}`.toLowerCase()}
                >
                  <td class="bt-rel-char">
                    <span class="bt-chip-img">
                      {ch ? (
                        <CharacterImage imageName={ch.image || ch.name} alt={zh || c.name} width={40} height={40} />
                      ) : (
                        <span class="bt-noimg-sm" aria-hidden="true">{c.name.slice(0, 1)}</span>
                      )}
                    </span>
                    {c.slug ? (
                      <a class="bt-rel-name" href={`${HW_ZH.baseUrl}characters/${c.slug}/`}>
                        {zh || c.name}
                        <span class="bt-rel-en">{zh ? c.name : ''}</span>
                      </a>
                    ) : (
                      <span class="bt-rel-name">{zh || c.name}</span>
                    )}
                  </td>
                  <td>{c.rarity ? <HWRarityIcon rarity={c.rarity} width={48} height={24} /> : ''}</td>
                  <td class="bt-rel-date">{fmt(c.date)}</td>
                  <td class="bt-rel-how">
                    {c.via === 'launch' ? (
                      <span class="bt-how bt-how-launch">サービス開始時</span>
                    ) : c.via === 'banner' ? (
                      <span class="bt-how bt-how-banner">ガチャ：{c.bannerName}</span>
                    ) : (
                      <span class="bt-how bt-how-direct">直接実装</span>
                    )}
                  </td>
                  <td>{c.sourceNote && <a class="bt-src" href={`${HW_ZH.baseUrl}updates/${c.sourceNote}/`}>更新情報</a>}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  </div>
  </div>
</HwLangLayout>

<script is:inline>
  // graceful fallback: a broken icon tile becomes the character's initial
  function handleBrokenIcon(img) {
    var wrap = img.closest('.bt-chip-img');
    if (!wrap || wrap.classList.contains('bt-noicon')) return;
    var row = img.closest('tr');
    var name = row ? row.querySelector('.bt-rel-name') : null;
    var label = name ? name.textContent.trim().charAt(0).toUpperCase() : '';
    img.remove();
    wrap.classList.add('bt-noicon');
    wrap.dataset.letter = label || '?';
  }
  document.addEventListener('error', function (ev) {
    var img = ev.target;
    if (!img || img.tagName !== 'IMG') return;
    if (img.closest('.bt-chip-img')) handleBrokenIcon(img);
  }, true);
  document.querySelectorAll('.bt-chip-img img').forEach(function (img) {
    if (img.complete && img.naturalWidth === 0) handleBrokenIcon(img);
  });

  var input = document.getElementById('zhBtSearch');
  var cards = document.querySelectorAll('.bt-card');
  var years = document.querySelectorAll('.bt-year');
  var count = document.getElementById('zhBtCount');
  var total = cards.length;
  var filter = 'all';

  // Recompute the Active state client-side: the static markup reflects build time
  cards.forEach(function (c) {
    var s = Date.parse((c.dataset.start || '') + 'T00:00:00Z');
    var e = Date.parse((c.dataset.end || '') + 'T23:59:59Z');
    if (Number.isNaN(s) || Number.isNaN(e)) return;
    var now = Date.now();
    var live = now >= s && now <= e;
    if ((c.dataset.active || '0') === (live ? '1' : '0')) return;
    c.dataset.active = live ? '1' : '0';
    var when = c.querySelector('.bt-card-when');
    if (!when) return;
    var badge = when.querySelector('.bt-live');
    if (live && !badge) {
      var created = document.createElement('span');
      created.className = 'bt-badge bt-live';
      created.textContent = '開催中';
      var typeBadge = when.querySelector('.bt-badge-new, .bt-badge-rerun');
      when.insertBefore(created, typeBadge);
    } else if (!live && badge) {
      badge.remove();
    }
  });

  function apply() {
    var q = input.value.trim().toLowerCase();
    var visible = 0;
    cards.forEach(function (c) {
      var okType =
        filter === 'all' ||
        (filter === 'active' ? c.dataset.active === '1' : c.dataset.type === filter);
      var okText = !q || (c.dataset.search || '').includes(q);
      var show = okType && okText;
      c.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    years.forEach(function (y) {
      var any = Array.prototype.some.call(y.querySelectorAll('.bt-card'), function (c) {
        return c.style.display !== 'none';
      });
      y.style.display = any ? '' : 'none';
    });
    count.textContent = q || filter !== 'all' ? visible + ' / ' + total + ' 件のガチャ' : total + ' 件のガチャ';
  }
  input.addEventListener('input', apply);
  document.querySelectorAll('.bt-filter[data-filter]').forEach(function (b) {
    b.addEventListener('click', function () {
      document.querySelectorAll('.bt-filter[data-filter]').forEach(function (x) {
        x.classList.remove('active');
      });
      b.classList.add('active');
      filter = b.dataset.filter;
      apply();
    });
  });

  // release table: filter + sort
  var relBody = document.getElementById('zhBtRelBody');
  if (relBody) {
    var relSearch = document.getElementById('zhBtRelSearch');
    var relCount = document.getElementById('zhBtRelCount');
    var rows = Array.prototype.slice.call(relBody.querySelectorAll('tr'));
    var rsort = 'new';
    function applyRel() {
      var q = relSearch.value.trim().toLowerCase();
      var visible = 0;
      rows.forEach(function (r) {
        var show = !q || (r.dataset.search || '').includes(q);
        r.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      relCount.textContent = q ? visible + ' / ' + rows.length + ' 名のキャラ' : rows.length + ' 名のキャラ';
    }
    function sortRel() {
      var sorted = rows.slice().sort(function (a, b) {
        if (rsort === 'az') return a.dataset.name.localeCompare(b.dataset.name, 'ja');
        var da = a.dataset.date, db = b.dataset.date;
        return rsort === 'new' ? db.localeCompare(da) : da.localeCompare(db);
      });
      sorted.forEach(function (r) {
        relBody.appendChild(r);
      });
    }
    relSearch.addEventListener('input', applyRel);
    document.querySelectorAll('[data-rsort]').forEach(function (b) {
      b.addEventListener('click', function () {
        document.querySelectorAll('[data-rsort]').forEach(function (x) {
          x.classList.remove('active');
        });
        b.classList.add('active');
        rsort = b.dataset.rsort;
        sortRel();
      });
    });
  }
</script>

<style>
  .bt-page {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }
  .bt-intro {
    background: var(--hw-white-05);
    border: 1px solid var(--hw-border-muted);
    border-radius: 10px;
    padding: 1rem 1.2rem;
  }
  .bt-intro p {
    color: var(--hw-text-muted);
    font-size: var(--text-md);
    line-height: 1.7;
    margin: 0;
  }
  .bt-intro a {
    color: var(--hw-primary-warm);
  }
  .bt-controls {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
  }
  .bt-filters {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .bt-filter {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    color: var(--hw-text-muted);
    font-size: var(--text-md);
    font-weight: 600;
    padding: 0.45rem 0.9rem;
    cursor: pointer;
  }
  .bt-filter.active {
    background: var(--hw-primary-warm-20);
    border-color: var(--hw-primary-warm);
    color: var(--hw-primary-warm);
  }
  .bt-search {
    flex: 1;
    min-width: 200px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    color: var(--hw-text-light);
    font-size: var(--text-body);
    padding: 0.55rem 0.9rem;
    outline: none;
  }
  .bt-search::placeholder {
    color: var(--hw-text-very-muted);
  }
  .bt-count {
    color: var(--hw-text-very-muted);
    font-size: var(--text-md);
    white-space: nowrap;
  }
  .bt-year {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .bt-year-title {
    color: var(--hw-primary-warm);
    font-size: var(--text-lg);
    font-weight: 700;
    margin: 0.4rem 0 0;
    border-bottom: 1px solid var(--hw-border-accent);
    padding-bottom: 0.4rem;
  }
  .bt-cards {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .bt-card {
    background: var(--hw-white-05);
    border: 1px solid var(--hw-border-light);
    border-radius: 10px;
    padding: 0.95rem 1.05rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .bt-card.bt-new {
    border-color: rgba(232, 165, 71, 0.35);
  }
  .bt-card-body {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .bt-card:not(.bt-has-art) .bt-card-body {
    flex-direction: column;
  }
  .bt-art {
    flex: 0 0 440px;
    max-width: 440px;
    display: block;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .bt-art img {
    width: 100%;
    height: auto;
    max-height: 560px;
    object-fit: contain;
    background: rgba(255, 255, 255, 0.02);
    display: block;
  }
  .bt-art-note {
    color: var(--hw-text-very-muted);
    font-size: var(--text-xs);
    margin: -0.3rem 0 0;
    text-align: center;
  }
  .bt-card-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .bt-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
  .bt-card-when {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
  }
  .bt-dates {
    color: var(--hw-accent-mint);
    font-weight: 700;
    font-size: var(--text-body);
  }
  .bt-len {
    color: var(--hw-text-very-muted);
    font-size: var(--text-xs);
  }
  .bt-badge {
    border-radius: 5px;
    padding: 0.12rem 0.55rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .bt-badge-new {
    background: var(--hw-primary-warm);
    color: #1c1a16;
  }
  .bt-badge-rerun {
    background: #3a3a3a;
    color: #cccccc;
  }
  .bt-live {
    background: rgba(96, 197, 166, 0.16);
    color: var(--hw-accent-mint);
    border: 1px solid rgba(96, 197, 166, 0.5);
  }
  .bt-src {
    color: var(--hw-primary-warm);
    font-size: var(--text-sm);
