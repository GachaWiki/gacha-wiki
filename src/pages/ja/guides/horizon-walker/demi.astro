---
// Japanese Demi-Ascension database: /ja/guides/horizon-walker/demi/
// Demigod names AND Authority/Might skill names+descriptions use the game's
// official JA from game-text.js (keyed by gameKey / EN skill name); EN is only
// the fallback where the game ships no Japanese. Intro copy is ja wiki's own.
import HwLangLayout from '../../../../layouts/lang/HwLangLayout.astro';
import DecorativeLines from '../../../../components/DecorativeLines.astro';
import { r2Url } from '../../../../data/r2-config.js';
import { DEMI_CHARACTERS, getMightSkillList, TIER_PROBABILITIES } from '../../../../data/horizon-walker/demiskills.js';
import { demiReleases } from '../../../../data/horizon-walker/banner-timeline.js';
import { HW_ZH_NAMES, HW_ZH_SKILLS, HW_ZH_SKILL_BY_NAME } from '../../../../data/horizon-walker/ja/game-text.js';
import { HW_ZH } from '../../../../data/horizon-walker/ja/ui.js';
import '../../../../styles/games/horizon-walker/hw-guide.css';

export const prerender = true;

const demigods = Object.values(DEMI_CHARACTERS);

// official JA first, EN fallback when the game ships no Japanese
const authorityOf = d => {
  const zh = d.authoritySkill?.gameKey ? HW_ZH_SKILLS[d.authoritySkill.gameKey] : null;
  return {
    name: (zh && zh.name) || d.authoritySkill.name,
    desc: (zh && zh.desc) || d.authoritySkill.description,
  };
};
const mightOf = m => {
  const zh = HW_ZH_SKILL_BY_NAME[m.name] || null;
  return { name: (zh && zh.name) || m.name, desc: (zh && zh.desc) || null };
};

const fmtDate = iso =>
  new Date(iso + 'T12:00:00Z').toLocaleDateString('ja-JP', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });

const demiBySlug = {};
for (const d of demiReleases) {
  if (d.slug) demiBySlug[d.slug] = d;
}

const nameJa = d => HW_ZH_NAMES[d.heroId] || d.name;

// Substitute {v1,v2,...} per-stage arrays, stage 1-7, same as the EN page
const substitute = (desc, stage) =>
  String(desc ?? '').replace(/\{\s*([-0-9.][-0-9.,%\s]*?)\s*\}/g, (_m, list) => {
    const vals = list.replace(/\s+/g, '').split(',');
    return `<span class="demi-arr" data-vals="${list.replace(/\s+/g, '')}">${vals[Math.min(stage, vals.length) - 1] ?? list}</span>`;
  });

// might pool with JA name/desc merged in (tier descs substitute the JA arrays)
const mightList = getMightSkillList().map(m => {
  const zh = mightOf(m);
  return {
    ...m,
    zhName: zh.name,
    tierDesc: t => (zh.desc ? substitute(zh.desc, t.tier) : t.description),
  };
});
---

<HwLangLayout lang="ja" ui={HW_ZH}
  title="半神昇格 - ホライゾン・ウォーカー日本語ウィキ - GachaWiki"
  description={`ホライゾン・ウォーカーの半神昇格データベース：全 ${demigods.length} 体の半神の神位スキル（段階別数値）、編成消費 DP、10 種の Might スキルと等級ごとの出現確率を掲載。`}
  keywords={['ホライゾン・ウォーカー', '半神昇格', '神位スキル', '半神', '攻略']}
  breadcrumbItems={[
    { name: 'ホーム', href: '/' },
    { name: 'ホライゾン・ウォーカー', href: HW_ZH.baseUrl },
    { name: '半神昇格' },
  ]}
>
  <section class="hw-guide-hero">
    <h1 class="hw-guide-title">半神昇格</h1>
    <p class="hw-guide-subtitle">全半神の神位スキル、段階別数値、編成消費と共有の Might スキルプール</p>
    <DecorativeLines />
  </section>

  <div class="hw-guide-content">
  <div class="demi-db">
    <section class="demi-db-intro">
      <div class="demi-db-intro-card">
        <h3>半神昇格とは？</h3>
        <p>
          EX キャラは半神昇格が可能です。昇格したキャラは主人公に代わって部隊の Executor を務め、部隊全体にオブリビアへの免疫を与えます。
          編成時には DP（神力）を消費します。また、どの半神も固有の<strong>神位スキル</strong>を 1 つ持ち、7 つの昇格段階に合わせて成長していきます。
        </p>
      </div>
      <div class="demi-db-intro-card">
        <h3>Might スキル</h3>
        <p>
          半神昇格を完了すると、キャラはさらに 10 種の <strong>Might スキル</strong>のうち 1 つをランダムで獲得します。等級は 1 から 5 で、等級が高いほど希少です：
        </p>
        <div class="demi-db-probs">
          {TIER_PROBABILITIES.map(tp => (
            <span class={`demi-db-prob demi-db-prob-${tp.tier}`}>T{tp.tier}：{tp.probability}</span>
          ))}
        </div>
      </div>
    </section>

    <h2 class="demi-db-heading">半神（{demigods.length} 体）</h2>
    <div class="demi-db-grid">
      {demigods.map(d => (
        <article class="demi-db-card">
          <div class="demi-db-card-head">
            {d.faceIcon && (
              <img class="demi-db-face" src={r2Url('horizon-walker', `heroes/${d.faceIcon}`)} alt={nameJa(d)} width={64} height={64} loading="lazy" />
            )}
            <div class="demi-db-id">
              <h3 class="demi-db-name">{nameJa(d)}</h3>
              <div class="demi-db-meta">
                <span class="demi-db-cost" title="編成消費">DP {d.deploymentCost}</span>
                {d.slug && demiBySlug[d.slug] && (
                  <span
                    class="demi-db-rel"
                    title={demiBySlug[d.slug].batch ? '半神システムの実装と同時期に登場' : '公式更新情報を出典とする'}
                  >
                    半神化：{fmtDate(demiBySlug[d.slug].date)}
                  </span>
                )}
                {d.slug && (
                  <a class="demi-db-link" href={`${HW_ZH.baseUrl}characters/${d.slug}/`}>キャラを見る</a>
                )}
              </div>
              {d.slug && demiBySlug[d.slug]?.url && (
                <a class="demi-db-note" href={demiBySlug[d.slug].url}>更新情報</a>
              )}
            </div>
          </div>

          <div class="demi-db-authority">
            <div class="demi-db-auth-head">
              <h4 class="demi-db-auth-name">{authorityOf(d).name}</h4>
              <span class="demi-db-badge">Authority</span>
            </div>
            <div class="demi-db-tierbar">
              <div class="demi-db-chips">
                {[1, 2, 3, 4, 5, 6, 7].map(lv => (
                  <button type="button" class={`demi-db-chip${lv === 7 ? ' active' : ''}`} data-demi-tier={lv} aria-label={`段階 ${lv}`}>{lv}</button>
                ))}
              </div>
              <span class="demi-db-view" data-demi-view>段階 7</span>
            </div>
            <div class="demi-db-auth-body">
              {authorityOf(d).desc.split('\n\n').map(paragraph => (
                <p set:html={substitute(paragraph, 7)} />
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>

    <h2 class="demi-db-heading">Might スキルプール（10 種）</h2>
    <p class="demi-db-note-p">
      半神昇格時にはこのうち 1 つをランダムで獲得します。数値は等級ごとに記載されており、等級は上記の確率でランダムに決まります。
      神位スキルと Might スキルのテキストはゲーム公式の日本語から引用しています。ゲームに日本語が存在しない項目は英語のまま表示されます。
    </p>
    <div class="demi-db-might-grid">
      {mightList.map(might => (
        <article class="demi-db-might-card">
          <div class="demi-db-might-head">
            {might.icon && (
              <img class="demi-db-might-icon" src={r2Url('horizon-walker', `skills/${might.icon.includes('.') ? might.icon : might.icon + '.png'}`)} alt={might.zhName} width={40} height={40} loading="lazy" />
            )}
            <h3 class="demi-db-might-name">{might.zhName}</h3>
          </div>
          <div class="demi-db-might-tiers">
            {might.tiers.map(t => (
              <div class={`demi-db-tier-row demi-db-tier-${t.tier}`}>
                <span class="demi-db-tier-label">T{t.tier}</span>
                <span class="demi-db-tier-desc" set:html={might.tierDesc(t)} />
              </div>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
  </div>
</HwLangLayout>

<style>
  .demi-db {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .demi-db-intro {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1rem;
  }
  .demi-db-intro-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 10px;
    padding: 1rem 1.1rem;
  }
  .demi-db-intro-card h3 {
    color: var(--hw-primary-warm);
    margin: 0 0 0.5rem;
    font-size: var(--text-base);
  }
  .demi-db-intro-card p {
    color: var(--hw-text-light);
    font-size: var(--text-body);
    line-height: 1.6;
    margin: 0;
  }
  .demi-db-probs {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 0.6rem;
  }
  .demi-db-prob {
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 6px;
    padding: 0.2rem 0.55rem;
    font-size: var(--text-sm);
    color: var(--hw-text-light);
  }
  .demi-db-prob-4, .demi-db-prob-5 { color: var(--hw-primary-warm); border-color: rgba(232, 165, 71, 0.5); }
  .demi-db-heading {
    color: var(--hw-primary-warm);
    font-size: var(--text-xl);
    margin: 1rem 0 0;
  }
  .demi-db-note-p { color: var(--hw-text-muted); font-size: var(--text-md); margin: 0.35rem 0 0; }
  .demi-db-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(420px, 1fr));
    gap: 1rem;
  }
  .demi-db-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 10px;
    padding: 1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .demi-db-card-head {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  .demi-db-face {
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    object-fit: cover;
  }
  .demi-db-name {
    color: var(--hw-text-light);
    margin: 0;
    font-size: var(--text-lg);
  }
  .demi-db-meta {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 0.25rem;
    flex-wrap: wrap;
  }
  .demi-db-cost {
    background: rgba(232, 165, 71, 0.14);
    border: 1px solid rgba(232, 165, 71, 0.4);
    color: var(--hw-primary-warm);
    border-radius: 6px;
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 0.15rem 0.5rem;
  }
  .demi-db-rel {
    background: var(--hw-accent-mint-20);
    border: 1px solid var(--hw-accent-mint-50);
    color: var(--hw-accent-mint);
    border-radius: 6px;
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    white-space: nowrap;
  }
  .demi-db-note {
    color: #9ecbff;
    font-size: var(--text-xs);
    text-decoration: none;
    width: fit-content;
    display: inline-block;
    margin-top: 0.3rem;
  }
  .demi-db-link {
    color: #9ecbff;
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .demi-db-authority {
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 8px;
    padding: 0.85rem 0.95rem;
  }
  .demi-db-auth-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    margin-bottom: 0.6rem;
  }
  .demi-db-auth-name {
    color: var(--hw-primary-warm);
    margin: 0;
    font-size: var(--text-base);
  }
  .demi-db-badge {
    font-size: var(--text-2xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border: 1px solid rgba(232, 165, 71, 0.4);
    color: var(--hw-primary-warm);
    border-radius: 6px;
    padding: 0.12rem 0.45rem;
    white-space: nowrap;
  }
  .demi-db-tierbar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.6rem;
    flex-wrap: wrap;
  }
  .demi-db-chips { display: flex; gap: 0.3rem; }
  .demi-db-chip {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 6px;
    color: var(--hw-text-light);
    font-size: var(--text-sm);
    font-weight: 600;
    padding: 0.18rem 0.55rem;
    cursor: pointer;
    opacity: 0.55;
  }
  .demi-db-chip.active {
    opacity: 1;
    border-color: var(--hw-primary-warm);
    color: var(--hw-primary-warm);
  }
  .demi-db-view {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--hw-primary-warm);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .demi-db-auth-body p {
    color: var(--hw-text-light);
    font-size: var(--text-md);
    line-height: 1.6;
    margin: 0 0 0.5rem;
  }
  .demi-db-auth-body p:last-child { margin-bottom: 0; }
  :global(.demi-db .demi-arr) {
    color: var(--hw-primary-warm);
    font-weight: 600;
  }
  .demi-db-might-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1rem;
  }
  .demi-db-might-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 10px;
    padding: 0.9rem 1rem;
  }
  .demi-db-might-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.6rem;
  }
  .demi-db-might-icon {
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.3);
  }
  .demi-db-might-name {
    color: var(--hw-text-light);
    margin: 0;
    font-size: var(--text-base);
  }
  .demi-db-tier-row {
    display: flex;
    gap: 0.6rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    font-size: var(--text-md);
    line-height: 1.5;
  }
  .demi-db-tier-row:last-child { border-bottom: none; }
  .demi-db-tier-label {
    color: var(--hw-primary-warm);
    font-weight: 600;
    min-width: 1.6rem;
  }
  .demi-db-tier-desc { color: var(--hw-text-light); }
  @media (max-width: 640px) {
    .demi-db-grid { grid-template-columns: 1fr; }
  }
</style>

<script is:inline>
  (function() {
    document.querySelectorAll('.demi-db-chips').forEach(function(chips) {
      var card = chips.closest('.demi-db-card');
      if (!card) return;
      chips.querySelectorAll('.demi-db-chip').forEach(function(chip) {
        chip.addEventListener('click', function() {
          chips.querySelectorAll('.demi-db-chip').forEach(function(c) { c.classList.remove('active'); });
          chip.classList.add('active');
          var lv = parseInt(chip.getAttribute('data-demi-tier')) || 7;
          card.querySelectorAll('.demi-arr').forEach(function(el) {
            var vals = (el.getAttribute('data-vals') || '').split(',');
            if (vals.length) el.textContent = vals[Math.min(lv, vals.length) - 1];
          });
          var view = card.querySelector('[data-demi-view]');
          if (view) view.textContent = '段階 ' + lv;
        });
      });
    });
  })();
</script>
