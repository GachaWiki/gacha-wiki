const zhSuffixes = (s) =>
  s
    .replace(/\s*[–-]\s*Part\.?\s*(\d+)\s*$/i, '（第 $1 部）')
    .replace(/\s*[–-]\s*Prologue\s*$/i, '（序章）')
    .replace(/\s*\(Part\.?(\d+)\)\s*$/i, '（第 $1 部）');

function highlightJa(raw) {
  const h = raw.trim();
  if (EXACT_ZH[h]) return EXACT_ZH[h];
  let m;
  if ((m = h.match(/^Vanguard\/Weapon Rework\s*:\s*(.+)$/i)))
    return `親衛・武器リワーク：${nameListZh(m[1])}`;
  if ((m = h.match(/^Vanguard Rework\s*:\s*(.+)$/i))) return `親衛リワーク：${nameListZh(m[1])}`;
  if ((m = h.match(/^New Vanguard\s*:\s*(.+)$/i))) return `新規親衛：${charDisplay(m[1].trim())}`;
  if ((m = h.match(/^New Weapon\s*:\s*(.+)$/i))) return `新規武器：${weaponDisplay(m[1].trim())}`;
  if ((m = h.match(/^New Feature\s*[-–:]\s*(.+)$/))) {
    const feat = m[1].trim();
    return `新機能：${FEATURE_ZH[feat] || feat}`;
  }
  if ((m = h.match(/^New Event Pass\s*:\s*(.+)$/))) return `新規イベントパス：${m[1].trim()}`;
  if ((m = h.match(/^New Pass\s*:\s*(.+)$/))) return `新規パス：${m[1].trim()}`;
  if ((m = h.match(/^New Stigma Set\s*:\s*(.+)$/i))) return `新規聖痕セット：${m[1].trim()}`;
  if ((m = h.match(/^New Stigma\s*\((.+)\)\s*$/i))) return `新規聖痕：${m[1].trim()}`;
  if ((m = h.match(/^New Stigma\s*:\s*(.+)$/i))) return `新規聖痕：${m[1].trim()}`;
  if ((m = h.match(/^New Event\s*:\s*(.+)$/i))) return `新規イベント：${zhSuffixes(m[1].trim())}`;
  if ((m = h.match(/^Event Update\s*:\s*(.+)$/i))) return `イベント更新：${zhSuffixes(m[1].trim())}`;
  if ((m = h.match(/^Event\s*:\s*(.+)$/i))) return `イベント：${zhSuffixes(m[1].trim())}`;
  return h;
}

const MONTHS = {
  January: 1, February: 2, March: 3, April: 4, May: 5, June: 6, July: 7,
  August: 8, September: 9, October: 10, November: 11, December: 12,
  Jan: 1, Feb: 2, Mar: 3, Apr: 4, Jun: 6, Jul: 7, Aug: 8, Sep: 9, Sept: 9, Oct: 10, Nov: 11, Dec: 12,
};

function titleJa(t) {
  const m = t.match(/^Patch Note\s*-\s*(.+)$/);
  if (!m) return t;
  let inner = m[1];
  let suffix = '';
  if (inner.includes('(+ Update)')) {
    suffix = '（追記あり）';
    inner = inner.replace(/\s*\(\+ Update\)/, '');
  }
  const mm = inner.match(/^([A-Za-z]+)\.?\s+(\d{1,2})/);
  if (!mm || !MONTHS[mm[1]]) return `更新情報：${inner}`;
  const isMaint = /maintenance/i.test(inner);
  return `更新情報：${MONTHS[mm[1]]} 月 ${parseInt(mm[2], 10)} 日${isMaint ? 'メンテナンス' : ''}${suffix}`;
}

export function getStaticPaths() {
  return patchNotes.map((n) => ({
    params: { slug: n.slug },
  }));
}

const { slug } = Astro.params;
const noteModules = import.meta.glob('/src/data/horizon-walker/patch-notes/*.js');
const loader = noteModules[`/src/data/horizon-walker/patch-notes/${slug}.js`];
if (!loader) {
  return Astro.redirect(`${HW_ZH.baseUrl}updates/`);
}
const { note } = await loader();

const meta = patchNotes.find((n) => n.slug === slug) || note;
const zhTitle = titleJa(note.title);
const posted = `${parseInt(note.date.slice(0, 4), 10)} 年 ${parseInt(note.date.slice(5, 7), 10)} 月 ${parseInt(
  note.date.slice(8, 10),
  10
)} 日`;
const zhTags = note.highlights.map((h) => highlightJa(h));
const firstImage = note.blocks.find((b) => b.k === 'img');
const enPageUrl = `/guides/horizon-walker/updates/${slug}/`;
---

<HwLangLayout lang="ja" ui={HW_ZH}
  title={`${zhTitle} - ホライゾン・ウォーカー日本語ウィキ - GachaWiki`}
  description={`${zhTitle}（${posted} 公開）の要点を日本語で整理：${zhTags.join('、')}。完全な内容は対応する公式英語の更新情報をご確認ください。`}
  keywords={['ホライゾン・ウォーカー', '更新情報', note.date]}
  breadcrumbItems={[
    { name: 'ホーム', href: '/' },
    { name: 'ホライゾン・ウォーカー', href: HW_ZH.baseUrl },
    { name: '更新情報', href: `${HW_ZH.baseUrl}updates/` },
    { name: zhTitle },
  ]}
>
  <section class="hw-guide-hero">
    <h1 class="hw-guide-title">{zhTitle}</h1>
    <p class="hw-guide-subtitle">{posted} 公開の公式更新情報を、日本語で要点整理。</p>
    <DecorativeLines />
  </section>

  <div class="hw-guide-content">
  <div class="pn-page">
    <div class="pn-meta-card">
      <div class="pn-meta-row">
        <span class="pn-meta-label">公開日</span>
        <span class="pn-meta-value">{posted}</span>
      </div>
      <div class="pn-meta-row">
        <span class="pn-meta-label">原文タイトル</span>
        <span class="pn-meta-value">{note.title}</span>
      </div>
      <div class="pn-meta-row">
        <span class="pn-meta-label">出典</span>
        <a class="pn-meta-link" href={note.sourceUrl} target="_blank" rel="noopener">
          Naver Lounge の公式投稿
        </a>
      </div>
      <div class="pn-meta-row">
        <span class="pn-meta-label">言語</span>
        <span class="pn-meta-value">公式英語の更新情報を、日本語で要点整理したページです</span>
      </div>
    </div>

    <p class="pn-schedule-note">
      更新情報は韓国サーバーのスケジュールに従っており、韓国サーバーはグローバルサーバーより数週間先行しています。公式原文の具体的なスキル数値は N のプレースホルダーで表記されます。イベントやガチャなどの固有名詞は公式日本語がまだ無いため、英語のまま掲載しています。
    </p>

    {
      firstImage && (
        <div class="pn-banner">
          <img
            src={r2Url('horizon-walker', `patch-notes/${firstImage.src}`)}
            alt={`${zhTitle} ヘッダー画像`}
            width={firstImage.w || 960}
            height={firstImage.h || 200}
            loading="eager"
          />
        </div>
      )
    }

    <article class="pn-body">
      <h2 class="pn-sec">今回の更新の要点</h2>
      <ul class="pn-points">
        {
          zhTags.map((t) => (
            <li class="pn-point">{t}</li>
          ))
        }
      </ul>
      <p class="pn-note">
        以上はこの更新情報の要点を日本語で整理したものです。完全な内容（全セクション、スキル表、画像）は
        <a href={enPageUrl}>対応する英語の更新情報ページ</a>でご確認ください。
      </p>
    </article>

    <div class="pn-footer-nav">
      <a class="pn-back" href={`${HW_ZH.baseUrl}updates/`}>更新情報一覧へ</a>
      <a class="pn-back" href={enPageUrl}>完全な英語の更新情報を見る</a>
      <a class="pn-back" href={note.sourceUrl} target="_blank" rel="noopener">
        Naver Lounge で原文を見る
      </a>
    </div>
  </div>
  </div>
</HwLangLayout>

