// suffixes like "– Part 2" / "(Part.2)" / "– Prologue" become Japanese
const zhSuffixes = (s) =>
  s
    .replace(/\s*[–-]\s*Part\.?\s*(\d+)\s*$/i, '（第 $1 部）')
    .replace(/\s*[–-]\s*Prologue\s*$/i, '（序章）')
    .replace(/\s*\(Part\.?(\d+)\)\s*$/i, '（第 $1 部）');

function highlightJa(raw) {
  const h = raw.trim();
  if (EXACT_ZH[h]) return EXACT_ZH[h];
  let m;
  if ((m = h.match(/^Vanguard\/Weapon Rework\s*:\s*(.+)$/i)))
    return `親衛・武器リワーク：${nameListZh(m[1])}`;
  if ((m = h.match(/^Vanguard Rework\s*:\s*(.+)$/i))) return `親衛リワーク：${nameListZh(m[1])}`;
  if ((m = h.match(/^New Vanguard\s*:\s*(.+)$/i))) return `新規親衛：${charDisplay(m[1].trim())}`;
  if ((m = h.match(/^New Weapon\s*:\s*(.+)$/i))) return `新規武器：${weaponDisplay(m[1].trim())}`;
  if ((m = h.match(/^New Feature\s*[-–:]\s*(.+)$/))) {
    const feat = m[1].trim();
    return `新機能：${FEATURE_ZH[feat] || feat}`;
  }
  if ((m = h.match(/^New Event Pass\s*:\s*(.+)$/))) return `新規イベントパス：${m[1].trim()}`;
  if ((m = h.match(/^New Pass\s*:\s*(.+)$/))) return `新規パス：${m[1].trim()}`;
  if ((m = h.match(/^New Stigma Set\s*:\s*(.+)$/i))) return `新規聖痕セット：${m[1].trim()}`;
  if ((m = h.match(/^New Stigma\s*\((.+)\)\s*$/i))) return `新規聖痕：${m[1].trim()}`;
  if ((m = h.match(/^New Stigma\s*:\s*(.+)$/i))) return `新規聖痕：${m[1].trim()}`;
  if ((m = h.match(/^New Event\s*:\s*(.+)$/i))) return `新規イベント：${zhSuffixes(m[1].trim())}`;
  if ((m = h.match(/^Event Update\s*:\s*(.+)$/i))) return `イベント更新：${zhSuffixes(m[1].trim())}`;
  if ((m = h.match(/^Event\s*:\s*(.+)$/i))) return `イベント：${zhSuffixes(m[1].trim())}`;
  return h;
}

const MONTHS = {
  January: 1, February: 2, March: 3, April: 4, May: 5, June: 6, July: 7,
  August: 8, September: 9, October: 10, November: 11, December: 12,
  Jan: 1, Feb: 2, Mar: 3, Apr: 4, Jun: 6, Jul: 7, Aug: 8, Sep: 9, Sept: 9, Oct: 10, Nov: 11, Dec: 12,
};

function titleJa(t) {
  const m = t.match(/^Patch Note\s*-\s*(.+)$/);
  if (!m) return t;
  let inner = m[1];
  let suffix = '';
  if (inner.includes('(+ Update)')) {
    suffix = '（追記あり）';
    inner = inner.replace(/\s*\(\+ Update\)/, '');
  }
  const mm = inner.match(/^([A-Za-z]+)\.?\s+(\d{1,2})/);
  if (!mm || !MONTHS[mm[1]]) return `更新情報：${inner}`;
  const isMaint = /maintenance/i.test(inner);
  return `更新情報：${MONTHS[mm[1]]} 月 ${parseInt(mm[2], 10)} 日${isMaint ? 'メンテナンス' : ''}${suffix}`;
}

const fmt = (iso) => `${iso.slice(0, 4)}.${iso.slice(5, 7)}.${iso.slice(8, 10)}`;

// group by month like the EN index
const groups = [];
for (const n of patchNotes) {
  const month = n.date.slice(0, 7);
  const label = `${month.slice(0, 4)} 年 ${parseInt(month.slice(5, 7), 10)} 月`;
  const last = groups[groups.length - 1];
  if (last && last.month === month) last.notes.push(n);
  else groups.push({ month, label, notes: [n] });
}
const newest = patchNotes[0];
const oldest = patchNotes[patchNotes.length - 1];
---

<HwLangLayout lang="ja" ui={HW_ZH}
  title="更新情報 - ホライゾン・ウォーカー日本語ウィキ - GachaWiki"
  description={`ホライゾン・ウォーカーの公式更新情報を日本語で整理。全 ${patchNotes.length} 件：新規親衛、新規武器、イベント、バランス調整、不具合修正を ${fmt(oldest.date)} から ${fmt(newest.date)} まで掲載しています。`}
  keywords={['ホライゾン・ウォーカー', '更新情報', 'メンテナンス', 'バージョンアップ']}
  breadcrumbItems={[
    { name: 'ホーム', href: '/' },
    { name: 'ホライゾン・ウォーカー', href: HW_ZH.baseUrl },
    { name: '更新情報' },
  ]}
>
  <section class="hw-guide-hero">
    <h1 class="hw-guide-title">更新情報</h1>
    <p class="hw-guide-subtitle">公式の英語更新情報をすべて日本語に整理、{fmt(oldest.date)} から {fmt(newest.date)} まで。</p>
    <DecorativeLines />
  </section>

  <div class="hw-guide-content">
  <div class="pn-index">
    <div class="pn-index-intro">
      <p>
        『ホライゾン・ウォーカー』運営は毎回のメンテナンス時に、公式 Naver Lounge で英語の更新情報を公開しています。当ページは全
        {patchNotes.length} 件の更新情報を日本語に整理したものです（タイトルと要点は手動翻訳）。完全な原文（全表と細部）はそれぞれの英語の更新情報ページでご確認ください。更新は韓国サーバーのスケジュールに従っており、韓国サーバーはグローバルサーバーより数週間先行しています。公式原文の具体的なスキル数値は N のプレースホルダーで表記されます。イベントやガチャなどの固有名詞は公式日本語がまだ無いため、英語のまま掲載しています。
      </p>
    </div>

    <div class="pn-index-controls">
      <input
        type="text"
        id="pn-search-input"
        class="pn-search"
        placeholder="更新情報を検索（日本語・英語可。例：コラ、Doomstar、イベント）"
        autocomplete="off"
      />
      <span class="pn-count" id="pn-count-el">{patchNotes.length} 件の更新情報</span>
    </div>

    {
      groups.map((g) => (
        <section class="pn-month" data-month={g.month}>
          <h2 class="pn-month-title">{g.label}</h2>
          <div class="pn-cards">
            {g.notes.map((n) => {
              const zhTitle = titleJa(n.title);
              const zhTags = n.highlights.map((h) => highlightJa(h));
              const search = [n.title, zhTitle, ...n.highlights, ...zhTags].join(' ').toLowerCase();
              return (
                <a class="pn-card" href={`${HW_ZH.baseUrl}updates/${n.slug}/`} data-search={search}>
                  <div class="pn-card-date">{fmt(n.date)}</div>
                  <h3 class="pn-card-title">{zhTitle}</h3>
                  {zhTags.length > 0 && (
                    <div class="pn-card-tags">
                      {zhTags.map((t) => (
                        <span class="pn-card-tag">{t}</span>
                      ))}
                    </div>
                  )}
                </a>
              );
            })}
          </div>
        </section>
      ))
    }
  </div>
  </div>
</HwLangLayout>

<script is:inline>
  var input = document.getElementById('pn-search-input');
  var cards = document.querySelectorAll('.pn-card');
  var months = document.querySelectorAll('.pn-month');
  var count = document.getElementById('pn-count-el');
  var total = cards.length;
  input.addEventListener('input', function () {
    var q = input.value.trim().toLowerCase();
    var visible = 0;
    cards.forEach(function (c) {
      var show = !q || c.dataset.search.includes(q);
      c.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    months.forEach(function (m) {
      var any = Array.prototype.some.call(m.querySelectorAll('.pn-card'), function (c) {
        return c.style.display !== 'none';
      });
      m.style.display = any ? '' : 'none';
    });
    count.textContent = q ? visible + ' / ' + total + ' 件の更新情報' : total + ' 件の更新情報';
  });
</script>

