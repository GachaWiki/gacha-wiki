---
// Japanese Trait System page: /ja/guides/horizon-walker/traits/
// Trait names, stat lines and EX passives use the game's official Japanese;
// intro and section labels are wiki editorial text.
import HwLangLayout from '../../../../layouts/lang/HwLangLayout.astro';
import TraitsDb from '../../../../components/horizon-walker/TraitsDb.astro';
import { GENERAL_TRAITS, TRAIT_GRADES, EX_SKILLS } from '../../../../data/horizon-walker/traits.js';
import { TRAIT_NAMES_LOC, STAT_LABELS_LOC, EX_SKILLS_LOC } from '../../../../data/horizon-walker/ja/traits-loc.js';
import { HW_ZH } from '../../../../data/horizon-walker/ja/ui.js';

export const prerender = true;

const keyByPassiveName = {};
for (const [k, v] of Object.entries(EX_SKILLS)) keyByPassiveName[v.name] = k;

const effectJa = (line) => {
  const idx = Math.max(line.lastIndexOf(' +'), line.lastIndexOf(' -'));
  if (idx <= 0) return line;
  const label = line.slice(0, idx).trim();
  return `${STAT_LABELS_LOC[label] || label}${line.slice(idx)}`;
};

const rows = GENERAL_TRAITS.map((t) => ({
  id: t.id,
  name: TRAIT_NAMES_LOC[t.id] || t.name,
  grade: t.grade,
  effects: t.effects.map(effectJa),
  passiveKey: t.passive ? (keyByPassiveName[t.passive] || null) : null,
}));

const NOTES = {
  1: '最下位のステータス特性。',
  2: '下位のステータス特性。',
  3: '中位のステータス特性。',
  4: '魂の錬成で作成可能（魂の鋏が必要）。',
  5: '魂の錬成で作成可能（魂の鋏が必要）。',
  6: '魂の錬成で作成可能（魂の鋏が必要）。',
  7: 'EXパッシブの系統ごとに複数の選択肢あり。EXランクの傭兵が所持。',
};
const grades = TRAIT_GRADES.map((g) => ({ grade: g.grade, label: `グレード${g.grade}`, note: NOTES[g.grade] || '' }));
---

<HwLangLayout lang="ja" ui={HW_ZH}
  title={`特性システム - 汎用特性・グレード・EXパッシブ - ホライゾン・ウォーカー日本語ウィキ - GachaWiki`}
  description={`ホライゾン・ウォーカーの特性システム完全リファレンス：全 ${GENERAL_TRAITS.length} 種の汎用特性をグレード1～7別に効果付きで掲載、グレード7のEXパッシブ、ソウルヴォールト、魂の泉（魂の注入・錬成）と復旧作戦の特性報酬を解説。特性名とステータスはゲーム公式の日本語です。`}
  keywords={['ホライゾン・ウォーカー', '特性', '汎用特性', '特性システム', '攻略']}
  pageTitle="特性システム"
  breadcrumbItems={[
    { name: 'ホーム', href: '/' },
    { name: 'ホライゾン・ウォーカー', href: HW_ZH.baseUrl },
    { name: '特性システム' },
  ]}
>
  <div class="traits-db">
    <section class="traits-intro">
      <h2 class="traits-intro-heading">特性システムの仕組み</h2>
      <p class="traits-intro-text">
        汎用特性はグレード1～7に分かれます。アイコンと名前の色はグレードごとに異なり、グレード1～3は同じ色です。グレードが高いほど強力なステータスボーナスを持ち、グレード7の特性はさらにEXパッシブスキルを付与します。
      </p>
      <h3 class="traits-intro-sub">ソウルヴォールト</h3>
      <p class="traits-intro-text">
        汎用特性を保管する新しいインベントリタブです。各特性は最大50,000個まで保管でき、未所持の特性も図鑑のようにグレードで絞り込んで閲覧できます。保管した特性は無料でキャラクターに装備でき、特性フィルターでは提供ステータスによる並べ替えにも対応します。
      </p>
      <h3 class="traits-intro-sub">魂の泉：魂の注入と錬成</h3>
      <p class="traits-intro-text">
        魂の注入は汎用特性を魂に変換します（一度に最大20種類、グレードが高いほど多くの魂を獲得）。魂の錬成は魂を消費して選んだグレードの汎用特性をランダムで作成します（一度に最大20個）。グレード4以上の錬成には魂の鋏が必要です。
      </p>
      <h3 class="traits-intro-sub">復旧作戦の報酬</h3>
      <p class="traits-intro-text">
        復旧作戦（本編第4章ステージ6-1クリアで解放）では、地域防衛の任務で汎用特性が報酬として支給されます。緊急出撃に勝利すると、グレード4～6の特性が3個追加でもらえます。FairyNet検索で登場するEXランクの傭兵は必ずグレード7の特性を1つ以上所持しています。
      </p>
    </section>

    <TraitsDb
      rows={rows}
      exByPassive={EX_SKILLS_LOC}
      grades={grades}
      strings={{
        all: 'すべて',
        searchPlaceholder: '特性名・ステータス・パッシブを検索…',
        empty: '現在のフィルターに一致する特性はありません。',
        hint: '各EXパッシブには、同一パッシブで攻撃タイプの異なる（近接・遠距離・魔法）特性オプションが最大3種類用意されています。キャラクターのダメージタイプに合うオプションを選んでください。最後のグループはパッシブを持たない純ステータス枠です。',
        optionsLabel: '選択肢：',
        pureLabel: '純ステータス特性',
        pureDesc: 'EXパッシブなし：純ステータスライン。',
      }}
    />
  </div>
</HwLangLayout>
