---
// Japanese character detail pages: /ja/guides/horizon-walker/
// characters/<slug>/. Renders the EN CharacterPageTemplate with a labels
// override and a shallow-cloned character record whose game text (name, story,
// profile, traits, weapon, skins, skill names) is swapped for the official
// Japanese from src/data/horizon-walker/ja/game-text.js. Stats,
// per-level values and image references are the wiki's own data, unchanged.
import HwLangLayout from '../../../../../layouts/lang/HwLangLayout.astro';
import CharacterPageTemplate from '../../../../../templates/horizon-walker/CharacterPageTemplate.astro';
import { HORIZON_WALKER_CHARACTERS } from '../../../../../data/horizon-walker/characters.js';
import {
  HW_ZH_NAMES,
  HW_ZH_SKILLS,
  HW_ZH_TRAITS,
  HW_ZH_HERO_TRAITS,
  HW_ZH_HERO_STORY,
  HW_ZH_HERO_EPITHET,
  HW_ZH_PROFILE,
  HW_ZH_STAT_TYPES,
  HW_ZH_INHERITANCE,
  HW_ZH_WEAPON_SKILLS,
  HW_ZH_SKILL_BY_NAME,
  HW_ZH_SKINS,
  HW_ZH_ITEMS,
} from '../../../../../data/horizon-walker/ja/game-text.js';
import { HW_ZH } from '../../../../../data/horizon-walker/ja/ui.js';

// Same CSS set as the EN CharacterIndividualLayout so the page is pixel-identical
import '../../../../../styles/global.css';
import '../../../../../styles/typography.css';
import '../../../../../styles/games/horizon-walker/hw-colors.css';
import '../../../../../styles/games/horizon-walker/hw-layout.css';
import '../../../../../styles/games/horizon-walker/hw-character-page.css';
import '../../../../../styles/games/horizon-walker/hw-badges.css';
import '../../../../../styles/games/horizon-walker/hw-community-build.css';

export const prerender = true;

// Per-character detail modules: each file exports one *Data
const modules = import.meta.glob('/src/data/horizon-walker/characters/*.js', {
  eager: true,
});
const dataBySlug = {};
for (const [path, mod] of Object.entries(modules)) {
  const slug = path.split('/').pop().replace('.js', '');
  // most modules export <name>Data; nari/samarika export the bare name
  const keys = Object.keys(mod);
  const exportKey =
    keys.find(k => k.endsWith('Data')) ||
    keys.find(k => !k.endsWith('SEO') && !k.endsWith('Highlighting'));
  if (exportKey) dataBySlug[slug] = mod[exportKey];
}

// weapon stat label: translate EN StatType names, keep suffixes like (weapon)
const weaponStatLabel = k => {
  if (HW_ZH_STAT_TYPES[k]) return HW_ZH_STAT_TYPES[k];
  const m = k.match(/^(.+?)\s*\((.+)\)$/);
  if (m && HW_ZH_STAT_TYPES[m[1]]) return `${HW_ZH_STAT_TYPES[m[1]]}（${m[2]}）`;
  return k;
};

// EN item name -> official JA name (gifts and gift boxes)
const jaItemNames = Object.fromEntries(
  Object.entries(HW_ZH_ITEMS).map(([en, v]) => [en, v.name])
);

// Only roster heroes that have an official JA name get a Japanese page
export function getStaticPaths() {
  return HORIZON_WALKER_CHARACTERS.filter(c => HW_ZH_NAMES[c.id] && c.slug).map(c => ({
    params: { slug: c.slug },
    props: { id: c.id },
  }));
}

const { id } = Astro.props;
const char = HORIZON_WALKER_CHARACTERS.find(c => c.id === id);
const detail = dataBySlug[char.slug] || {};
const jaName = HW_ZH_NAMES[id];
const epithet = HW_ZH_HERO_EPITHET[id];
const jaStory = HW_ZH_HERO_STORY[id];
const jaProfile = HW_ZH_PROFILE[id] || {};
const jaTraitIds = HW_ZH_HERO_TRAITS[id] || [];

// Shallow clone + swap: structure, stats, levels and image refs stay EN/wiki;
// every official game string that has a JA localization is replaced.
const jaData = { ...detail };
jaData.name = jaName;
jaData.nameEn = detail.name || char.name; // used by the template for EN-keyed lookups
jaData.description = epithet || detail.description;
jaData.shortDescription = epithet
  ? `${jaName}、${epithet}。`
  : String(detail.description || '').split('.')[0] + '.';
jaData.story = jaStory || detail.story;

// Profile values from the official JA game profile (EN fallback per field)
if (detail.profile) {
  jaData.profile = {
    ...detail.profile,
    age: jaProfile.age || detail.profile.age,
    birthday: jaProfile.birthday || detail.profile.birthday,
    racial: jaProfile.tribe || detail.profile.racial,
    homeland: jaProfile.hometown || detail.profile.homeland,
    height: jaProfile.height || detail.profile.height,
    bwhRatio: jaProfile.threeSize || detail.profile.bwhRatio,
  };
}

// Skill names from the game's JA skill table (keyed by gameKey); the wiki's EN
// descriptions stay when the JA table has no description text
if (detail.skills) {
  jaData.skills = Object.fromEntries(
    Object.entries(detail.skills).map(([k, sk]) => {
      const ja = sk.gameKey ? HW_ZH_SKILLS[sk.gameKey] : null;
      return [
        k,
        {
          ...sk,
          name: (ja && ja.name) || sk.name,
          description: (ja && ja.desc) || sk.description,
        },
      ];
    })
  );
}

// Traits: JA trait ids map positionally onto the EN trait object order; the
// gift-level-5 trait (Interested / 興味) keeps its special structure
if (detail.uniqueTraits) {
  const enTraitValues = Object.values(detail.uniqueTraits);
  jaData.uniqueTraits = Object.fromEntries(
    Object.entries(detail.uniqueTraits).map(([k, t], i) => {
      let ja = jaTraitIds.length === enTraitValues.length ? HW_ZH_TRAITS[jaTraitIds[i]] : null;
      if (!ja && t.name === 'Interested') ja = HW_ZH_TRAITS[55001]; // 興味
      if (!ja) return [k, t];
      return [k, { ...t, name: ja.name, description: ja.desc || t.description }];
    })
  );
}

// EX weapon: official JA name + flavor via the Inheritance (stigma/weapon) loc;
// stat-label keys translated, unique-skill names via EN-name JA tables
if (detail.weapon) {
  const w = detail.weapon;
  const weaponJa = HW_ZH_INHERITANCE[w.name];
  jaData.weapon = {
    ...w,
    name: weaponJa?.name || w.name,
    flavor: weaponJa?.desc || w.flavor,
    stats: w.stats
      ? Object.fromEntries(Object.entries(w.stats).map(([k, v]) => [weaponStatLabel(k), v]))
      : w.stats,
    levelStats: w.levelStats
      ? Object.fromEntries(Object.entries(w.levelStats).map(([k, v]) => [weaponStatLabel(k), v]))
      : w.levelStats,
    uniqueSkills: w.uniqueSkills
      ? Object.fromEntries(
          Object.entries(w.uniqueSkills).map(([k, us]) => {
            const ja = HW_ZH_WEAPON_SKILLS[us.name] || HW_ZH_SKILL_BY_NAME[us.name];
            return [
              k,
              {
                ...us,
                name: (ja && ja.name) || us.name,
                description: (ja && ja.desc) || us.description,
              },
            ];
          })
        )
      : w.uniqueSkills,
  };
}

