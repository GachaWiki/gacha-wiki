    },
    {
      "name": "アースコア",
      "members": [
        "belle-clumsy-cowgirl",
        "hijikata-chizuru",
        "ruo-lan"
      ],
      "note": "千鶴が耐久と石化、若蘭が大地属性攻撃バフ、ベルが状態異常対象を粉砕します。"
    },
    {
      "name": "風クリティカルコア",
      "members": [
        "li-mu",
        "amelie"
      ],
      "note": "李沐と愛蜜莉でクリティカルダメージとクリティカル系バフを担います。"
    },
    {
      "name": "万能枠",
      "members": [
        "jessica",
        "kurosawa-shion"
      ],
      "note": "潔西卡と黒澤詩音は大半の編成で機能しますが、今後さらに属性特化の適任が登場する可能性があります。",
      "universal": true
    }
  ]
};
// localized tier notes [shortTitle?, title, text]; EN fallback at render
