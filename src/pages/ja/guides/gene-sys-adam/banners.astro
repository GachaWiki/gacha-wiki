---
// <localized> banner history page, generated by gen_bu_locales.py from the
// decrypted draw tables (GSA_BANNERS) plus the localized overlay. Card layout
// mirrors the EN/zh-tw pages (gsa-banners.css); names use the game's own text.
import GsaI18nLayout from '../../../../layouts/gene-sys-adam/GsaI18nLayout.astro';
