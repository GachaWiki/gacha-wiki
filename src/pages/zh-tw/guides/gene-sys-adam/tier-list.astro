---
// 黑色基因排行榜（中文）：依職業戰鬥風格分區、SSR 與 SR 分頁，結構與英文版
// 相同（gsa-tier.css）。角色卡與名稱改由官方繁中角色資料解析，前期培養
// 說明與挑選理由為本維基繁中撰寫。
import GsaZhLayout from '../../../../layouts/gene-sys-adam/GsaZhLayout.astro';
import { GSA_TIERS, GSA_JOB_SECTIONS, GSA_TIER_PLACEMENTS, gsaRarityBadge, GSA_TIER_NOTES } from '../../../../data/gene-sys-adam/tier-list.js';
import { gsaCharactersZh } from '../../../../data/gene-sys-adam/zh-tw/characters.js';
import { gsaPursuitRole } from '../../../../data/gene-sys-adam/pursuit-roles.js';
import { GSA_ZH } from '../../../../data/gene-sys-adam/zh-tw/ui.js';
import GSAElementCard from '../../../../components/gene-sys-adam/GSAElementCard.astro';
import '../../../../styles/games/gene-sys-adam/gsa-common.css';
import '../../../../styles/games/gene-sys-adam/gsa-tier.css';

// 追擊體系角色標籤（pursuit-roles.js；角色頁的追擊體系區塊使用同一份資料）
const TIER_ROLE_ZH = {
  trigger: '終結技',
  enabler: '啟動技',
  both: '啟動＋終結',
  none: '無追擊參與',
};

const base = GSA_ZH.baseUrl;
const bySlugZhFull = Object.fromEntries(gsaCharactersZh.map(c => [c.slug, c]));

// 同名角色（貝兒 SR／迷糊乳牛 貝兒 SSR）加上稱號顯示全名，避免只寫「貝兒」。
const zhNameCount = {};
for (const c of gsaCharactersZh) zhNameCount[c.name] = (zhNameCount[c.name] || 0) + 1;
const fullZhName = c => (c && c.title && (zhNameCount[c.name] || 0) > 1 ? `${c.name}（${c.title}）` : c.name);

// 前期培養說明：排行榜評的是終盤戰力，此框解釋低排名角色前期為何仍值得練。
const BEGINNER_NOTE = {
  title: '前期培養重點',
  intro:
    '排行榜評估的是後期戰力，但遊戲進度仰賴重複角色：階級系統與重複取得次數綁定，角色無法升階到超過自己持有的重複數量。SR 角色更容易抽到、也更容易疊出重複，是升階與練滿成本最低的選擇，因此投資得當的 SR 反而能撐起你前中期的帳號。',
  picks: [
    { slug: 'theodore', note: '武器可取得，SR 重複角色累積快' },
    { slug: 'adele', note: '武器可取得，SR 重複角色累積快' },
    { slug: 'belle', note: '武器可取得，SR 重複角色累積快' },
    { slug: 'ruby', note: 'SSR：任務可獲得重複角色，武器可取得' },
  ],
  lastSlot: {
    name: '最後一個位置',
    note: '選擇重複數最高的 SSR，或從任務中取得大量重複的 SR，以輸出角色優先。',
  },
};

// 推薦組合（用戶編選）：與前期培養重點相同的卡片結構，渲染在其下方。
const PAIRS_NOTE = {
  title: '推薦組合',
  intro: '互相搭配的角色組合：先決定組合，再圍繞它補齊隊伍。',
  pairs: [
    { name: '冰破組合', members: ['andou-kana', 'komachi-sayaka'], note: '加奈施加凍結，咲香將每個凍結目標轉為冰破追擊傷害。' },
    { name: '大地核心', members: ['belle-clumsy-cowgirl', 'hijikata-chizuru', 'ruo-lan'], note: '千鶴坦住前線並施加石化，若蘭提升大地屬性攻擊，牛仔貝兒粉碎帶狀態的目標。' },
    { name: '風屬性暴擊核心', members: ['li-mu', 'amelie'], note: '李沐與愛蜜莉提供暴擊傷害與暴擊團隊增益。' },
    { name: '通用百搭', members: ['jessica', 'kurosawa-shion'], note: '潔西卡與黑澤詩音適合大多數隊伍，但遊戲之後可能推出更適合其他屬性類型的角色。', universal: true },
  ],
};

const isReleased = c => Boolean(c.icon);
const placementOf = slug => GSA_TIER_PLACEMENTS[slug] || { tier: 'C', rarity: null };

// 依稀有度分頁的職業分區（與 gsaTierTabs 同邏輯，但角色名稱使用官方繁中）。
const tierTabs = ['SSR', 'SR'].map(rarity => ({
  rarity,
  jobs: GSA_JOB_SECTIONS.concat([{ job: 'Unclassified', zh: '未分類' }]).map(section => ({
    job: section.job,
    zh: section.zh,
    en: section.job,
    icon: section.icon,
    noteZh: section.noteZh,
    tiers: GSA_TIERS.map(({ tier, color }) => ({
      tier,
      color,
      characters: gsaCharactersZh
        .filter(c => isReleased(c)
          && (c.job ? c.job.name === section.zh : section.zh === '未分類')
          && (placementOf(c.slug).rarity || 'SSR') === rarity
          && placementOf(c.slug).tier === tier)
        .map(c => ({ ...c, placement: placementOf(c.slug) }))
        .sort((a, b) => a.name.localeCompare(b.name, 'zh-Hant')),
    })).filter(t => t.characters.length > 0),
  })).filter(g => g.tiers.length > 0),
}));

const tabCount = rarity =>
  gsaCharactersZh.filter(c => isReleased(c) && (placementOf(c.slug).rarity || 'SSR') === rarity).length;

const total = tierTabs.reduce((n, t) => n + tabCount(t.rarity), 0);
---

<GsaZhLayout
  title="排行榜"
  description={`黑色基因排行榜（2026年9月22日更新）：依職業戰鬥風格評比全部 ${total} 名已實裝角色，評分依據來自解密資料表的技能數據。`}
  gameTitle="排行榜"
  breadcrumbItems={[{ name: GSA_ZH.gameName, href: base }, { name: '排行榜' }]}
>
  <section>
    <div class="gsa-beginner-box">
      <div class="gsa-beginner-head">
        <div class="gsa-beginner-head-copy">
          <h2 class="gsa-beginner-title">{BEGINNER_NOTE.title}</h2>
          <p class="gsa-beginner-intro">{BEGINNER_NOTE.intro}</p>
        </div>
        <div class="gsa-elem-side">
          <GSAElementCard />
        </div>
      </div>
      <div class="gsa-beginner-team">
        {BEGINNER_NOTE.picks.map(pick => {
          const c = gsaCharactersZh.find(x => x.slug === pick.slug);
          const rarity = (GSA_TIER_PLACEMENTS[pick.slug]?.rarity || 'sr').toLowerCase();
          return (
            <a class="gsa-beginner-card" href={`${base}characters/${pick.slug}/`}>
              {c?.icon
                ? <img class="gsa-beginner-thumb" src={c.icon} alt={c.name} width="64" height="64" loading="lazy" />
                : <span class="gsa-beginner-thumb gsa-monogram">{c?.name?.[0]}</span>}
              <span class="gsa-beginner-name">{c?.name ?? pick.slug}</span>
              {gsaRarityBadge(GSA_TIER_PLACEMENTS[pick.slug]?.rarity) ? (
                <img class="gsa-rarity-badge" src={gsaRarityBadge(GSA_TIER_PLACEMENTS[pick.slug].rarity)} alt={GSA_TIER_PLACEMENTS[pick.slug].rarity} width="50" height="32" loading="lazy" />
              ) : (
                <span class={`gsa-tier-rarity gsa-tier-rarity-${rarity}`}>{GSA_TIER_PLACEMENTS[pick.slug]?.rarity ?? 'SR'}</span>
              )}
              <span class="gsa-beginner-note">{pick.note}</span>
            </a>
          );
        })}
        <div class="gsa-beginner-card gsa-beginner-card-last">
          <span class="gsa-beginner-thumb gsa-monogram">?</span>
          <span class="gsa-beginner-name">{BEGINNER_NOTE.lastSlot.name}</span>
          <span class="gsa-beginner-note">{BEGINNER_NOTE.lastSlot.note}</span>
        </div>
      </div>
    </div>

    <div class="gsa-beginner-box gsa-pairs-box">
      <h2 class="gsa-beginner-title">{PAIRS_NOTE.title}</h2>
      <p class="gsa-beginner-intro">{PAIRS_NOTE.intro}</p>
      <div class="gsa-pairs-grid">
        {PAIRS_NOTE.pairs.map(pair => (
          <div class={`gsa-pairs-card${pair.universal ? ' gsa-pairs-card-universal' : ''}`}>
            <span class="gsa-pairs-name">{pair.name}</span>
            <div class="gsa-pairs-members">
              {pair.members.map(slug => {
                const c = gsaCharactersZh.find(x => x.slug === slug);
                return (
                  <a class="gsa-pairs-member" href={`/zh-tw/guides/gene-sys-adam/characters/${slug}/`}>
                    {c?.icon
                      ? <img class="gsa-pairs-thumb" src={c.icon} alt={c.name} width="48" height="48" loading="lazy" />
                      : <span class="gsa-pairs-thumb gsa-monogram">{c?.name?.[0]}</span>}
                    <span class="gsa-pairs-member-name">{c?.name ?? slug}</span>
                  </a>
                );
              })}
            </div>
            <span class="gsa-pairs-note">{pair.note}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="gsa-tier-tabs" role="tablist" aria-label="稀有度">
      {tierTabs.map((tab, i) => (
        <button
          class={`gsa-tier-tab${i === 0 ? ' active' : ''}`}
          data-rarity-tab={tab.rarity}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
        >
          {tab.rarity}
          <span class="gsa-tier-tab-count">{tabCount(tab.rarity)}</span>
        </button>
      ))}
    </div>

    {tierTabs.map((tab, i) => (
      <div class="gsa-tier-tabpanel" data-rarity-panel={tab.rarity} style={i > 0 ? 'display:none' : undefined}>
        {tab.jobs.map(group => (
          <div class="gsa-tier-job-section">
            <div class="gsa-tier-job-header">
              {group.icon && <img class="gsa-tier-job-icon" src={group.icon} alt="" width="40" height="40" loading="lazy" />}
              <h2 class="gsa-tier-job-title">{group.zh}<span class="gsa-tier-job-zh">{group.en === 'Unclassified' ? 'Unclassified' : group.en}</span></h2>
              <span class="gsa-tier-job-count">
                {group.tiers.reduce((n, t) => n + t.characters.length, 0)} 名角色
              </span>
            </div>
            {group.noteZh && <p class="gsa-tier-section-note">{group.noteZh}</p>}
            <div class="gsa-tier-grid">
              {group.tiers.map(row => (
                <div class="gsa-tier-row">
                  <div class="gsa-tier-label">
                    <span class="gsa-tier-name" style={`color:${row.color}`}>{row.tier}</span>
                  </div>
                  <div class="gsa-tier-characters">
                    {row.characters.map(c => (
                      <a class="gsa-tier-card" href={`${base}characters/${c.slug}/`}>
                        {c.icon ? (
                          <img class="gsa-tier-thumb" src={c.icon} alt={fullZhName(c)} loading="lazy" />
                        ) : (
                          <span class="gsa-tier-thumb gsa-monogram">{c.name?.[0]}</span>
                        )}
                        <span class="gsa-tier-badges">
                          {gsaRarityBadge(c.placement.rarity) ? (
                            <img class="gsa-rarity-badge gsa-tier-thumb-badge" src={gsaRarityBadge(c.placement.rarity)} alt={c.placement.rarity} width="50" height="32" loading="lazy" />
                          ) : (
                            <span class={`gsa-tier-rarity gsa-tier-rarity-${(c.placement.rarity || 'sr').toLowerCase()}`}>{c.placement.rarity}</span>
                          )}
                          {c.element && (
                            <img class="gsa-tier-elem" src={c.element.icon} alt={c.element.name} title={c.element.name} width="18" height="18" loading="lazy" />
                          )}
                        </span>
                        <span class="gsa-tier-name-label">{fullZhName(c)}</span>
                        {(() => { const pr = gsaPursuitRole(c.slug); return (
                          <span class={`gsa-tier-role gsa-tier-role-${pr.role}`}>{TIER_ROLE_ZH[pr.role]}</span>
                        ); })()}
                        {GSA_TIER_NOTES[c.slug] && (() => { const n = GSA_TIER_NOTES[c.slug]; return (
                          <span class={`gsa-tier-note-badge gsa-tier-note-${n.type}${n.variant ? ` gsa-note-variant-${n.variant}` : ''}`} tabindex="0" aria-label={n.title}>
                            <span class="gsa-tier-note-icon">{n.variant ? '★' : '!'}</span>
                            <span class="gsa-tier-note-tooltip" role="tooltip">
                              <span class="gsa-tier-note-tooltip-title">{n.title}</span>
                              <span class="gsa-tier-note-tooltip-text">{n.text}</span>
                            </span>
                          </span>
                        ); })()}
                        {GSA_TIER_NOTES[c.slug]?.variant && (
                          <span class={`gsa-tier-card-highlight gsa-note-variant-${GSA_TIER_NOTES[c.slug].variant}`}>{GSA_TIER_NOTES[c.slug].shortTitle}</span>
                        )}
                      </a>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    ))}


  </section>
</GsaZhLayout>

<script is:inline>
  // 稀有度分頁：SSR 與 SR 各自獨立評比。
  (function () {
    var tabs = document.querySelectorAll('.gsa-tier-tab');
    var panels = document.querySelectorAll('.gsa-tier-tabpanel');
    tabs.forEach(function (btn) {
      btn.addEventListener('click', function () {
        tabs.forEach(function (b) { b.classList.remove('active'); b.setAttribute('aria-selected', 'false'); });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        var rarity = btn.getAttribute('data-rarity-tab');
        panels.forEach(function (p) {
          p.style.display = p.getAttribute('data-rarity-panel') === rarity ? '' : 'none';
        });
      });
    });
  })();
</script>
