---
// 黑色基因更新公告詳細頁（中文）：單一更新條目，附該資料波次的卡池圖、完整
// 重點列表與前後篇導覽。版面與英文版相同（gsa-banners.css），條目重點為
// 本維基繁中撰寫，版本號、日期與角色名使用官方資訊。
import GsaZhLayout from '../../../../../layouts/gene-sys-adam/GsaZhLayout.astro';
import { GSA_UPDATES } from '../../../../../data/gene-sys-adam/updates.js';
import { GSA_ZH } from '../../../../../data/gene-sys-adam/zh-tw/ui.js';
import '../../../../../styles/games/gene-sys-adam/gsa-common.css';
import '../../../../../styles/games/gene-sys-adam/gsa-banners.css';

export function getStaticPaths() {
  return GSA_UPDATES.map(u => ({ params: { slug: u.slug } }));
}

const base = GSA_ZH.baseUrl;

const TAG_ZH = { Update: '更新', Launch: '正式營運', Notice: '官方公告', Datamine: '資料探勘' };

