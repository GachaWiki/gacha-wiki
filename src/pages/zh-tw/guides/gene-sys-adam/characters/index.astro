---
// 黑色基因角色資料庫（中文）：全部建檔角色的卡片格，依屬性與職業戰鬥風格分類，
// 排序沿用遊戲圖鑑順序（RoleInfoData.battlePosition）。與英文版同構
// （gsa-common.css / gsa-characters.css），搜尋同時比對中文名與英文名。
import GsaZhLayout from '../../../../../layouts/gene-sys-adam/GsaZhLayout.astro';
import { gsaCharactersZh } from '../../../../../data/gene-sys-adam/zh-tw/characters.js';
import { GSA_ZH } from '../../../../../data/gene-sys-adam/zh-tw/ui.js';
import '../../../../../styles/games/gene-sys-adam/gsa-common.css';
import '../../../../../styles/games/gene-sys-adam/gsa-characters.css';

const characters = [...gsaCharactersZh].sort((a, b) => (a.sortOrder ?? 9999) - (b.sortOrder ?? 9999));
const ELEMENT_ORDER = ['火', '土', '風', '水', '光', '闇'];
const JOB_ORDER = ['防護', '突擊', '狙擊', '支援', '破壞'];
const elements = ELEMENT_ORDER
  .map(n => characters.find(c => c.element?.name === n)?.element)
  .filter(Boolean);
const elByName = new Map(elements.map(e => [e.name, e]));
const jobs = JOB_ORDER.filter(j => characters.some(c => c.job?.name === j));
const base = GSA_ZH.baseUrl;
const L = GSA_ZH.labels;
---

<GsaZhLayout
  title="角色資料庫"
  description={`黑色基因角色資料庫：瀏覽全部 ${characters.length} 名角色，包含屬性、職業戰鬥風格、召募資訊、檔案、素質與技能。`}
  gameTitle="角色"
  breadcrumbItems={[{ name: GSA_ZH.gameName, href: base }, { name: '角色資料庫' }]}
>
  <div class="gsa-content-section">
    <div class="gsa-toolbar">
      <input type="text" class="gsa-search" placeholder="搜尋名稱、稱號或銘句..." id="gsa-search" />
      <span class="gsa-count" id="gsa-count">{characters.length} 名角色</span>
    </div>
    <div class="gsa-toolbar gsa-toolbar-filters">
      <button class="gsa-filter-btn active" data-filter="all">全部</button>
      <button class="gsa-filter-btn" data-filter="gacha">可召募</button>
      {ELEMENT_ORDER.map(n => elByName.get(n) && (
        <button class="gsa-filter-btn" data-filter={n}>
          <img src={elByName.get(n).icon} alt="" width="14" height="14" loading="lazy" /> {n}
        </button>
      ))}
      <span class="gsa-filter-sep" aria-hidden="true"></span>
      {jobs.map(j => (
        <button class="gsa-filter-btn" data-filter={j}>{j}</button>
      ))}
    </div>

    <div class="gsa-grid-cards" id="gsa-grid">
      {characters.map(c => (
        <a class="gsa-card" href={`${base}characters/${c.slug}/`} data-search={`${c.name} ${c.nameEn} ${c.title} ${c.epithet} ${c.attackType?.name || ''}`.toLowerCase()} data-tags={[c.inGacha ? 'gacha' : '', (c.element?.name || '').toLowerCase(), (c.job?.name || '').toLowerCase()].filter(Boolean).join(' ')}>
          <div class="gsa-icon-frame">
            {c.icon ? <img src={c.icon} alt={c.name} loading="lazy" /> : <span class="gsa-monogram">{c.name?.[0]}</span>}
          </div>
          <p class="gsa-card-title">{c.name}</p>
          {c.title && <p class="gsa-card-sub">{c.title}</p>}
          <div class="gsa-card-types">
            {c.attackType && (
              <span class="gsa-type-tile" title={`${L.attackType}：${c.attackType.name}`}>
                <img src={c.attackType.icon} alt={c.attackType.name} width="24" height="24" loading="lazy" />
              </span>
            )}
            {c.element && (
              <span class="gsa-type-tile" title={`${L.element}：${c.element.name}`}>
                <img src={c.element.icon} alt={c.element.name} width="24" height="24" loading="lazy" />
              </span>
            )}
            {c.job && (
              <span class="gsa-type-tile" title={`${L.job}：${c.job.name}`}>
                <img src={c.job.icon} alt={c.job.name} width="24" height="24" loading="lazy" />
              </span>
            )}
          </div>
        </a>
      ))}
    </div>
    <p class="gsa-no-results" id="gsa-no-results">沒有符合搜尋條件的角色。</p>
  </div>
</GsaZhLayout>

<script is:inline>
  // 角色卡片格的用戶端搜尋與屬性、職業、召募篩選。
  (function () {
    var search = document.getElementById('gsa-search');
    var grid = document.getElementById('gsa-grid');
    var cards = grid.querySelectorAll('.gsa-card');
    var noResults = document.getElementById('gsa-no-results');
    var count = document.getElementById('gsa-count');
    var total = cards.length;
    var activeFilter = 'all';
    function apply() {
      var q = (search.value || '').trim().toLowerCase();
      var visible = 0;
      cards.forEach(function (card) {
        var text = card.getAttribute('data-search') || '';
        var tags = card.getAttribute('data-tags') || '';
        var ok = (!q || text.indexOf(q) !== -1) &&
          (activeFilter === 'all' || tags.indexOf(activeFilter) !== -1);
        card.style.display = ok ? '' : 'none';
        if (ok) visible++;
      });
      noResults.style.display = visible === 0 ? 'block' : 'none';
      count.textContent = visible === total ? total + ' 名角色' : visible + ' / ' + total + ' 名角色';
    }
    search.addEventListener('input', apply);
    document.querySelectorAll('.gsa-filter-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        document.querySelectorAll('.gsa-filter-btn').forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');
        activeFilter = btn.getAttribute('data-filter');
        apply();
      });
    });
  })();
</script>

<style>
  .gsa-count {
    color: var(--gsa-text-dim);
    font-size: 0.82rem;
    font-weight: 700;
    margin-left: auto;
    white-space: nowrap;
  }
  .gsa-toolbar-filters {
    margin-bottom: 16px;
  }
  .gsa-filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .gsa-filter-btn img {
    display: block;
  }
  .gsa-filter-sep {
    width: 1px;
    height: 22px;
    background: var(--gsa-border);
    margin: 0 4px;
  }
  .gsa-icon-frame {
    position: relative;
  }
  .gsa-card-title {
    margin-top: 10px;
  }
  .gsa-card-types {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-top: auto;
    padding-top: 12px;
  }
  .gsa-type-tile {
    display: block;
    line-height: 0;
  }
  .gsa-type-tile img {
    width: 24px;
    height: 24px;
    display: block;
    border-radius: 6px;
    background: #171114;
    border: 1px solid var(--gsa-border);
  }
  a.gsa-card,
  a.gsa-card .gsa-card-title {
    text-decoration: none;
  }
  @media (max-width: 640px) {
    .gsa-count {
      margin-left: 0;
    }
  }
</style>
