---
// 黑色基因卡池紀錄（中文）：進行中、不刪檔測試期間與排程中的活動卡池，
// 來自解密的召募資料表與官方公告。卡池名稱使用官方繁中（banners.js 的
// nameZh 欄），其餘說明為本維基繁中撰寫，版面與英文版相同（gsa-banners.css）。
import GsaZhLayout from '../../../../layouts/gene-sys-adam/GsaZhLayout.astro';
import { GSA_BANNERS } from '../../../../data/gene-sys-adam/banners.js';
import { gsaCharactersZh } from '../../../../data/gene-sys-adam/zh-tw/characters.js';
import { GSA_ZH } from '../../../../data/gene-sys-adam/zh-tw/ui.js';
import '../../../../styles/games/gene-sys-adam/gsa-common.css';
import '../../../../styles/games/gene-sys-adam/gsa-banners.css';

const base = GSA_ZH.baseUrl;

const STATUS_ZH = { live: '進行中', ended: '已結束', beta: '測試期間', scheduled: '即將開放' };
const KIND_ZH = {
  'Solo Rate-Up': '指定召募',
  'Dual Rate-Up': '雙角色限定召募',
  'Event Ticket Recruit': '活動票券召募',
  'Ticket Recruit': '票券召募',
  'Limited Recruit': '限定召募',
  'Special Recruit': '特別召募',
};
// 活動代幣：官方繁中優先，查無官方譯文者為本維基譯文。
const TOKEN_ZH = {
  'Moonflower Crest': '月華徽記',
  'Phantom Emblem': '魅影徽記',
  'Gagaku Emblem': '雅樂徽記',
  "Heaven's Door summon letters": '天堂之門召募信',
  'Warrant Gems and Gold Bars': '通緝令寶石與金條',
  '[1.5M Downloads] Celebration Certificate': '【150萬下載】紀念憑證',
};
// 每張卡池的檔期與說明（繁中）。卡池名（nameZh）已是官方文字。
const BANNER_ZH = {
  'ogino-rui-rate-up': {
    since: '2026年9月29日至10月13日',
    note: '自 9 月 29 日維護起運行的單角色池，至 10 月 13 日「黑金獵人」復刻接手召喚介面為止（面板為純背景圖，因此卡片改顯示當期角色列）。SSR 機率 2 倍、每抽附一張指定印章（Designated Seal），100 抽保底取得當期角色。',
  },
  'sugimoto-arina-rate-up': {
    since: '2026年9月29日至10月13日',
    note: '與荻野瑠衣池同時運行兩週的單角色池。條件與所有單角色池相同：SSR 機率 2 倍、每抽附指定印章、100 抽保底取得當期角色。',
  },
  'lunar-splendor': {
    since: '正式營運：2026年9月22日至11月3日',
    note: '正式營運的限定池：120 抽保底當期角色、ECoin 票券通道，兌換商店備有土方千鶴的月華薙刀與足部裝備零件。卡片圖為 genesys-adam.com 的官方活動公告；遊戲內美術面板為 R18 內容，不放在維基上。日期出自同一份官方公告。',
  },
  'black-gold-hunter': {
    since: '2026年10月13日07:00復刻，至11月3日06:59（UTC+8）',
    note: '「黑金獵人」活動於 10 月 13 日復刻（官方日程出自 @GeneSysAdamJP）：活動關卡掉落通緝令寶石開啟 8 個黑市金庫，每庫以均一機率支付獎勵；付費與免費金條投入活動鍛鍊加成。票券通道涵蓋迷糊乳牛-貝兒與新手女僕-杉本有菜，寶石機保底 120 抽。用戶端於 10 月 13 日拉取其美術面板（Draw_Bg_23）；面板本身為 R18 內容不放在維基上，卡片改用官方活動圖。另有活動登入禮。',
  },
  'heavens-door-jessica': {
    since: '2026年10月27日波次開放（首部機於9月17日不刪檔測試登場）',
    note: '「天堂之門」特別任務隨 10 月 27 日波次回歸，用戶端同日拉取潔西卡的美術面板（Draw_Bg_36），確認限定機已開放，保底 120 抽。9 月 17 日的官方公告最初在不刪檔測試中介紹此票券召募。昆妮階段排在本次之後。',
  },
  'milena-rate-up': {
    since: '2026年10月27日波次觀測到開放',
    note: '單角色輪替池接續至米蓮娜：用戶端於 10 月 27 日波次拉取其美術面板（Draw_Bg_30）與頁籤圖。面板為 R18 內容不放在維基上，卡片改顯示當期角色列。條件與所有單角色池相同：SSR 機率 2 倍、每抽附指定印章、100 抽保底取得當期角色。',
  },
  'downloads-celebration': {
    since: '設定於 2026年10月27日資料表',
    note: '150 萬下載慶祝隨 10 月 27 日波次推出：兩部特別機共用 12 名 SSR 卡池（若蘭、米蓮娜、荻野瑠衣、鈴鈴、杉本有菜、莉茲、艾米莉、李沐、黑澤紫音、克蘿伊、夏洛特、安娜貝爾），第 10 抽保證 SSR，活動結束後回收【150萬下載】紀念憑證，另有慶祝登入禮。卡池列表即整體卡池，非當期 UP 組合。',
  },
  'heavens-door-connie': {
    since: '已設定於用戶端資料表，尚未觀測到開放',
    note: '第二個「天堂之門」召募（美術 Draw_Bg_46），在活動管線中排在潔西卡之後。昆妮的技能資料直到 9 月 22 日的資料表才完整，維基上的評分也於當日重新計分。',
  },
  'war-and-music': {
    since: '已設定於用戶端資料表，尚未觀測到開放',
    note: '伊蓮娜與維多莉亞的雙角色限定池（美術面板 Draw_Bg_34_1 與 _34_2），附帶「收集魅影徽記」活動。10 月 27 日波次預載了其卡池文字並將伊蓮娜的立繪送至用戶端，是明確的下一波；兩名當期角色的技能組在等待期間於 10 月 2 日的資料表中改版。',
  },
  'lingering-echoes': {
    since: '已設定於用戶端資料表，尚未觀測到開放',
    note: '下一波新角色：清音與冷鴆的雙角色限定池（美術面板 Draw_Bg_40_1 與 _40_2），附帶「收集雅樂徽記」活動。10 月 27 日波次預載了其卡池文字；兩人的技能組已在資料表中完整齊備。',
  },
  'solo-rotation-queue': {
    since: '已設定於用戶端資料表，尚未觀測到開放',
    note: '活動輪替之後另有三部單角色機待命：鈴鈴、安娜貝爾（其頁籤圖已先行下載至用戶端）與 10 月 27 日波次新增的李沐機，同樣是 100 抽保底。精英召募池的提示也在 10 月 27 日資料表中由常駐改為限定。',
  },
};

const SECTIONS = [
  { key: 'live', title: '進行中' },
  { key: 'ended', title: '近期卡池' },
  { key: 'beta', title: '不刪檔測試期間（2026年9月17日至22日）' },
  { key: 'scheduled', title: '用戶端資料中的預定卡池' },
];

const charBySlug = Object.fromEntries(gsaCharactersZh.map(c => [c.slug, c]));
const charZhName = Object.fromEntries(gsaCharactersZh.map(c => [c.nameEn, c.name]));

function charCard(slug) {
  const c = charBySlug[slug];
  if (!c) return { name: slug, meta: '', icon: null, slug };
  const bits = [c.title, c.element?.name, c.job?.name].filter(Boolean);
  return { name: c.name, meta: bits.join('、'), icon: c.icon, slug };
}
const trainingZh = names => names.map(n => charZhName[n] || n).join('、');
---

<GsaZhLayout
  title="卡池紀錄"
  description={`黑色基因卡池紀錄（2026年10月27日更新）：進行中、測試期間與排程中的活動卡池，包含當期角色與保底資訊，來自解密資料表與官方公告。`}
  gameTitle="卡池紀錄"
  breadcrumbItems={[{ name: GSA_ZH.gameName, href: base }, { name: '卡池紀錄' }]}
>
  <section>
    <p class="gsa-banner-intro">
      所有已開跑或已載入待跑的活動卡池，讀取自遊戲自身的召募資料表，並與官方公告及 X
      帳號（@GeneSysAdamEN）交叉核對。檔期由伺服器端控制，因此條目標注的是其出現的資料波次，而非確切時刻。常駐池（一般、精英、新人、無限與鏡像召募）不列入本頁。更新於
      2026年10月27日。
    </p>

    {SECTIONS.map(sec => {
      const cards = GSA_BANNERS.filter(b => b.status === sec.key);
      return cards.length > 0 && (
        <fragment>
          <h2 class="gsa-banner-section-title">{sec.title}</h2>
          <div class="gsa-bn-list">
            {cards.map(b => {
              const zh = BANNER_ZH[b.slug] || {};
              return (
              <article class={`gsa-bn-card${b.status === 'live' ? ' gsa-bn-card-live' : ''}`}>
                <div class="gsa-bn-art">
                  {b.image
                    ? (
                      <div class="gsa-bn-art-imgs">
                        <img src={b.image} alt={`${b.nameZh || b.name} 卡池圖`} width="1920" height="1080" loading="lazy" decoding="async" />
                        {b.image2 && <img src={b.image2} alt={`${b.nameZh || b.name} 第二圖`} width="1920" height="1080" loading="lazy" decoding="async" />}
                      </div>
                    )
                    : (
                      <div class="gsa-bn-art-none">
                        {b.featured.length > 0 && b.featured.every(slug => charCard(slug).icon)
                          ? b.featured.map(slug => {
                              const c = charCard(slug);
                              return <img class="gsa-bn-art-icon" src={c.icon} alt={c.name} width="110" height="110" loading="lazy" />;
                            })
                          : <span>尚無卡池圖</span>}
                      </div>
                    )}
                </div>
                <div class="gsa-bn-body">
                  <div class="gsa-bn-top">
                    <span class="gsa-bn-kind">{KIND_ZH[b.kind] || b.kind}</span>
                    <span class={`gsa-bn-status gsa-bn-status-${b.status}`}>{STATUS_ZH[b.status] || b.status}</span>
                    <span class="gsa-bn-since">{zh.since || b.since}</span>
                  </div>
                  <h3 class="gsa-bn-title">{b.nameZh || b.name}</h3>
                  <p class="gsa-bn-sub">{b.nameZh ? b.name : b.nameZh}</p>
                  <div class="gsa-banner-featured">
                    {b.featured.map(slug => {
                      const c = charCard(slug);
                      return (
                        <a class="gsa-banner-char" href={`${base}characters/${slug}/`}>
                          {c.icon
                            ? <img class="gsa-banner-char-thumb" src={c.icon} alt={c.name} width="44" height="44" loading="lazy" />
                            : <span class="gsa-banner-char-thumb gsa-monogram">{c.name?.[0]}</span>}
                          <span>
                            <span class="gsa-banner-char-name">{c.name}</span>
                            <span class="gsa-banner-char-meta">{c.meta}</span>
                          </span>
                        </a>
                      );
                    })}
                  </div>
                  <div class="gsa-banner-facts">
                    {b.pity && <span class="gsa-banner-fact"><b>保底：</b>{b.pity} 抽</span>}
                    {b.eventToken && <span class="gsa-banner-fact"><b>活動代幣：</b>{TOKEN_ZH[b.eventToken] || b.eventToken}</span>}
                    {b.training.length > 0 && <span class="gsa-banner-fact"><b>訓練任務：</b>{trainingZh(b.training)}</span>}
                  </div>
                  <p class="gsa-bn-note">{zh.note || b.note}</p>
                </div>
              </article>
              );
            })}
          </div>
        </fragment>
      );
    })}
  </section>
</GsaZhLayout>
