// suffixes like "– Part 2" / "(Part.2)" / "– Prologue" become Chinese
const zhSuffixes = (s) =>
  s
    .replace(/\s*[–-]\s*Part\.?\s*(\d+)\s*$/i, '（第 $1 部分）')
    .replace(/\s*[–-]\s*Prologue\s*$/i, '（序章）')
    .replace(/\s*\(Part\.?(\d+)\)\s*$/i, '（第 $1 部分）');

function highlightZh(raw) {
  const h = raw.trim();
  if (EXACT_ZH[h]) return EXACT_ZH[h];
  let m;
  if ((m = h.match(/^Vanguard\/Weapon Rework\s*:\s*(.+)$/i)))
    return `先鋒/武器重做：${nameListZh(m[1])}`;
  if ((m = h.match(/^Vanguard Rework\s*:\s*(.+)$/i))) return `先鋒重做：${nameListZh(m[1])}`;
  if ((m = h.match(/^New Vanguard\s*:\s*(.+)$/i))) return `新先鋒：${charDisplay(m[1].trim())}`;
  if ((m = h.match(/^New Weapon\s*:\s*(.+)$/i))) return `新武器：${weaponDisplay(m[1].trim())}`;
  if ((m = h.match(/^New Feature\s*[-–:]\s*(.+)$/))) {
    const feat = m[1].trim();
    return `新功能：${FEATURE_ZH[feat] || feat}`;
  }
  if ((m = h.match(/^New Event Pass\s*:\s*(.+)$/))) return `新活動通行證：${m[1].trim()}`;
  if ((m = h.match(/^New Pass\s*:\s*(.+)$/))) return `新通行證：${m[1].trim()}`;
  if ((m = h.match(/^New Stigma Set\s*:\s*(.+)$/i))) return `新聖痕套裝：${m[1].trim()}`;
  if ((m = h.match(/^New Stigma\s*\((.+)\)\s*$/i))) return `新聖痕：${m[1].trim()}`;
  if ((m = h.match(/^New Stigma\s*:\s*(.+)$/i))) return `新聖痕：${m[1].trim()}`;
  if ((m = h.match(/^New Event\s*:\s*(.+)$/i))) return `新活動：${zhSuffixes(m[1].trim())}`;
  if ((m = h.match(/^Event Update\s*:\s*(.+)$/i))) return `活動更新：${zhSuffixes(m[1].trim())}`;
  if ((m = h.match(/^Event\s*:\s*(.+)$/i))) return `活動：${zhSuffixes(m[1].trim())}`;
  return h;
}

const MONTHS = {
  January: 1, February: 2, March: 3, April: 4, May: 5, June: 6, July: 7,
  August: 8, September: 9, October: 10, November: 11, December: 12,
  Jan: 1, Feb: 2, Mar: 3, Apr: 4, Jun: 6, Jul: 7, Aug: 8, Sep: 9, Sept: 9, Oct: 10, Nov: 11, Dec: 12,
};

function titleZh(t) {
  const m = t.match(/^Patch Note\s*-\s*(.+)$/);
  if (!m) return t;
  let inner = m[1];
  let suffix = '';
  if (inner.includes('(+ Update)')) {
    suffix = '（含追加更新）';
    inner = inner.replace(/\s*\(\+ Update\)/, '');
  }
  const mm = inner.match(/^([A-Za-z]+)\.?\s+(\d{1,2})/);
  if (!mm || !MONTHS[mm[1]]) return `更新公告：${inner}`;
  const isMaint = /maintenance/i.test(inner);
  return `更新公告：${MONTHS[mm[1]]} 月 ${parseInt(mm[2], 10)} 日${isMaint ? '維護' : ''}${suffix}`;
}

const fmt = (iso) => `${iso.slice(0, 4)}.${iso.slice(5, 7)}.${iso.slice(8, 10)}`;

// group by month like the EN index
const groups = [];
for (const n of patchNotes) {
  const month = n.date.slice(0, 7);
  const label = `${month.slice(0, 4)} 年 ${parseInt(month.slice(5, 7), 10)} 月`;
  const last = groups[groups.length - 1];
  if (last && last.month === month) last.notes.push(n);
  else groups.push({ month, label, notes: [n] });
}
const newest = patchNotes[0];
const oldest = patchNotes[patchNotes.length - 1];
---

<HwLangLayout lang="zh-tw" ui={HW_ZH}
  title="更新公告 - 地平線行者繁體中文維基 - GachaWiki"
  description={`地平線行者官方更新公告繁體中文整理，共 ${patchNotes.length} 篇：新先鋒、新武器、活動、平衡調整與問題修復，時間跨度 ${fmt(oldest.date)} 至 ${fmt(newest.date)}。`}
  keywords={['地平線行者', '更新公告', '維護', '版本更新']}
  breadcrumbItems={[
    { name: '首頁', href: '/' },
    { name: '地平線行者', href: HW_ZH.baseUrl },
    { name: '更新公告' },
  ]}
>
  <section class="hw-guide-hero">
    <h1 class="hw-guide-title">更新公告</h1>
    <p class="hw-guide-subtitle">全部官方英文更新公告的繁體中文整理，{fmt(oldest.date)} 至 {fmt(newest.date)}。</p>
    <DecorativeLines />
  </section>

  <div class="hw-guide-content">
  <div class="pn-index">
    <div class="pn-index-intro">
      <p>
        《地平線行者》團隊每次維護都會在官方 Naver Lounge 發布英文更新公告。本頁為全部
        {patchNotes.length} 篇公告的繁體中文整理（標題與要點均為人工翻譯），完整原文（全部表格與細節）請查看對應的英文公告頁。更新跟隨韓服日程，韓服進度領先全球服數週；官方原文中的具體技能數值以 N 佔位符表示。活動與卡池等專有名稱暫無官方中文，保留英文原文。
      </p>
    </div>

    <div class="pn-index-controls">
      <input
        type="text"
        id="pn-search-input"
        class="pn-search"
        placeholder="搜尋更新公告（中英文皆可，如 科拉比、Doomstar、活動）"
        autocomplete="off"
      />
      <span class="pn-count" id="pn-count-el">{patchNotes.length} 篇公告</span>
    </div>

    {
      groups.map((g) => (
        <section class="pn-month" data-month={g.month}>
          <h2 class="pn-month-title">{g.label}</h2>
          <div class="pn-cards">
            {g.notes.map((n) => {
              const zhTitle = titleZh(n.title);
              const zhTags = n.highlights.map((h) => highlightZh(h));
              const search = [n.title, zhTitle, ...n.highlights, ...zhTags].join(' ').toLowerCase();
              return (
                <a class="pn-card" href={`${HW_ZH.baseUrl}updates/${n.slug}/`} data-search={search}>
                  <div class="pn-card-date">{fmt(n.date)}</div>
                  <h3 class="pn-card-title">{zhTitle}</h3>
                  {zhTags.length > 0 && (
                    <div class="pn-card-tags">
                      {zhTags.map((t) => (
                        <span class="pn-card-tag">{t}</span>
                      ))}
                    </div>
                  )}
                </a>
              );
            })}
          </div>
        </section>
      ))
    }
  </div>
  </div>
</HwLangLayout>

<script is:inline>
  var input = document.getElementById('pn-search-input');
  var cards = document.querySelectorAll('.pn-card');
  var months = document.querySelectorAll('.pn-month');
  var count = document.getElementById('pn-count-el');
  var total = cards.length;
  input.addEventListener('input', function () {
    var q = input.value.trim().toLowerCase();
    var visible = 0;
    cards.forEach(function (c) {
      var show = !q || c.dataset.search.includes(q);
      c.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    months.forEach(function (m) {
      var any = Array.prototype.some.call(m.querySelectorAll('.pn-card'), function (c) {
        return c.style.display !== 'none';
      });
      m.style.display = any ? '' : 'none';
    });
    count.textContent = q ? visible + ' / ' + total + ' 篇公告' : total + ' 篇公告';
  });
</script>

