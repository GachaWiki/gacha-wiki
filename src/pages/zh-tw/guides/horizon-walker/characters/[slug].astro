---

<HwLangLayout lang="zh-tw" ui={HW_ZH}
  title={`${zhName}（${char.name}）- 地平線行者 角色資料 - GachaWiki`}
  description={`地平線行者角色 ${zhName}（${char.name}）的繁體中文資料：官方技能說明、固有特性、檔案、屬性、EX 武器與禮物偏好。全部遊戲文字取自遊戲官方繁體中文。`}
  keywords={[zhName, char.name, '地平線行者', '技能', '屬性', '攻略']}
  breadcrumbItems={[
    { name: '首頁', href: '/' },
    { name: '地平線行者', href: HW_ZH.baseUrl },
    { name: '角色資料庫', href: `${HW_ZH.baseUrl}characters/` },
    { name: zhName },
  ]}
>
  <CharacterPageTemplate characterData={zhData} labels={ZH_LABELS} />
</HwLangLayout>
