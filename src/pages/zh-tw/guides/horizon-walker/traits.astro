---
// Chinese (Traditional) Trait System page: /zh-tw/guides/horizon-walker/traits/
// Trait names, stat lines and EX passives use the game's official Traditional
// Chinese; intro and section labels are wiki editorial text.
import HwLangLayout from '../../../../layouts/lang/HwLangLayout.astro';
import TraitsDb from '../../../../components/horizon-walker/TraitsDb.astro';
import { GENERAL_TRAITS, TRAIT_GRADES, EX_SKILLS } from '../../../../data/horizon-walker/traits.js';
import { TRAIT_NAMES_LOC, STAT_LABELS_LOC, EX_SKILLS_LOC } from '../../../../data/horizon-walker/zh-tw/traits-loc.js';
import { HW_ZH } from '../../../../data/horizon-walker/zh-tw/ui.js';

export const prerender = true;

const keyByPassiveName = {};
for (const [k, v] of Object.entries(EX_SKILLS)) keyByPassiveName[v.name] = k;

const effectZhTw = (line) => {
  const idx = Math.max(line.lastIndexOf(' +'), line.lastIndexOf(' -'));
  if (idx <= 0) return line;
  const label = line.slice(0, idx).trim();
  return `${STAT_LABELS_LOC[label] || label}${line.slice(idx)}`;
};

const rows = GENERAL_TRAITS.map((t) => ({
  id: t.id,
  name: TRAIT_NAMES_LOC[t.id] || t.name,
  grade: t.grade,
  effects: t.effects.map(effectZhTw),
  passiveKey: t.passive ? (keyByPassiveName[t.passive] || null) : null,
}));

const NOTES = {
  1: '最低階的屬性特性。',
  2: '低階屬性特性。',
  3: '中階屬性特性。',
  4: '可在鑄魂中製作（需要魂之剪）。',
  5: '可在鑄魂中製作（需要魂之剪）。',
  6: '可在鑄魂中製作（需要魂之剪）。',
  7: 'EX被動系列，每個系列包含不同選項。由EX級傭兵攜帶。',
};
const grades = TRAIT_GRADES.map((g) => ({ grade: g.grade, label: `${g.grade}級`, note: NOTES[g.grade] || '' }));
---

<HwLangLayout lang="zh-tw" ui={HW_ZH}
  title={`特性系統 - 通用特性品級與EX被動 - 地平線行者繁體中文維基 - GachaWiki`}
  description={`地平線行者特性系統完整資料：全部 ${GENERAL_TRAITS.length} 條通用特性按品級1至7分類及效果、7級EX被動技能、魂匣、魂泉鑄魂與復原作戰特性獎勵，特性名稱與屬性均為遊戲官方繁體中文。`}
  keywords={['地平線行者', '特性', '通用特性', '特性系統', '攻略']}
  pageTitle="特性系統"
  breadcrumbItems={[
    { name: '首頁', href: '/' },
    { name: '地平線行者', href: HW_ZH.baseUrl },
    { name: '特性系統' },
  ]}
>
  <div class="traits-db">
    <section class="traits-intro">
      <h2 class="traits-intro-heading">特性系統的運作方式</h2>
      <p class="traits-intro-text">
        通用特性分為1至7級。圖示與名稱顏色隨品級變化，1至3級共用同一顏色。品級越高屬性加成越強，7級特性還會額外賦予EX被動技能。
      </p>
      <h3 class="traits-intro-sub">魂匣</h3>
      <p class="traits-intro-text">
        新增的背包分頁，用於存放通用特性。每種特性最多可存放50000份，未持有的特性也可像圖鑑一樣按品級篩選瀏覽，並可免費為先鋒裝備已存放的特性。特性篩選還支援按提供的屬性排序。
      </p>
      <h3 class="traits-intro-sub">魂泉：注入魂與鑄魂</h3>
      <p class="traits-intro-text">
        注入魂將通用特性轉化為魂（每次最多20種特性，品級越高產出的魂越多）。鑄魂消耗魂來隨機製作所選品級的通用特性，每次最多20個。製作4級或更高品級需要魂之剪。
      </p>
      <h3 class="traits-intro-sub">復原作戰獎勵</h3>
      <p class="traits-intro-text">
        復原作戰模式（通關主線第四章關卡6-1後解鎖）會透過地域防衛任務發放通用特性。緊急出擊獲勝可獲得3個額外的4至6級特性。FairyNet搜尋中出現的EX級傭兵必定攜帶至少一個7級特性。
      </p>
    </section>

    <TraitsDb
      rows={rows}
      exByPassive={EX_SKILLS_LOC}
      grades={grades}
      strings={{
        all: '全部',
        searchPlaceholder: '搜尋特性名稱、屬性或被動…',
        empty: '沒有符合目前篩選條件的特性。',
        hint: '每個EX被動最多有三種特性選項，被動效果相同但攻擊類型屬性不同（近戰、遠程或魔法）。請選擇與角色傷害類型匹配的選項。最後一組是無被動的純屬性選項。',
        optionsLabel: '選項：',
        pureLabel: '純屬性特性',
        pureDesc: '無EX被動：純屬性條。',
      }}
    />
  </div>
</HwLangLayout>
