const zhSuffixes = (s) =>
  s
    .replace(/\s*[–-]\s*Part\.?\s*(\d+)\s*$/i, '（第 $1 部分）')
    .replace(/\s*[–-]\s*Prologue\s*$/i, '（序章）')
    .replace(/\s*\(Part\.?(\d+)\)\s*$/i, '（第 $1 部分）');

function highlightZh(raw) {
  const h = raw.trim();
  if (EXACT_ZH[h]) return EXACT_ZH[h];
  let m;
  if ((m = h.match(/^Vanguard\/Weapon Rework\s*:\s*(.+)$/i)))
    return `先鋒/武器重做：${nameListZh(m[1])}`;
  if ((m = h.match(/^Vanguard Rework\s*:\s*(.+)$/i))) return `先鋒重做：${nameListZh(m[1])}`;
  if ((m = h.match(/^New Vanguard\s*:\s*(.+)$/i))) return `新先鋒：${charDisplay(m[1].trim())}`;
  if ((m = h.match(/^New Weapon\s*:\s*(.+)$/i))) return `新武器：${weaponDisplay(m[1].trim())}`;
  if ((m = h.match(/^New Feature\s*[-–:]\s*(.+)$/))) {
    const feat = m[1].trim();
    return `新功能：${FEATURE_ZH[feat] || feat}`;
  }
  if ((m = h.match(/^New Event Pass\s*:\s*(.+)$/))) return `新活動通行證：${m[1].trim()}`;
  if ((m = h.match(/^New Pass\s*:\s*(.+)$/))) return `新通行證：${m[1].trim()}`;
  if ((m = h.match(/^New Stigma Set\s*:\s*(.+)$/i))) return `新聖痕套裝：${m[1].trim()}`;
  if ((m = h.match(/^New Stigma\s*\((.+)\)\s*$/i))) return `新聖痕：${m[1].trim()}`;
  if ((m = h.match(/^New Stigma\s*:\s*(.+)$/i))) return `新聖痕：${m[1].trim()}`;
  if ((m = h.match(/^New Event\s*:\s*(.+)$/i))) return `新活動：${zhSuffixes(m[1].trim())}`;
  if ((m = h.match(/^Event Update\s*:\s*(.+)$/i))) return `活動更新：${zhSuffixes(m[1].trim())}`;
  if ((m = h.match(/^Event\s*:\s*(.+)$/i))) return `活動：${zhSuffixes(m[1].trim())}`;
  return h;
}

const MONTHS = {
  January: 1, February: 2, March: 3, April: 4, May: 5, June: 6, July: 7,
  August: 8, September: 9, October: 10, November: 11, December: 12,
  Jan: 1, Feb: 2, Mar: 3, Apr: 4, Jun: 6, Jul: 7, Aug: 8, Sep: 9, Sept: 9, Oct: 10, Nov: 11, Dec: 12,
};

function titleZh(t) {
  const m = t.match(/^Patch Note\s*-\s*(.+)$/);
  if (!m) return t;
  let inner = m[1];
  let suffix = '';
  if (inner.includes('(+ Update)')) {
    suffix = '（含追加更新）';
    inner = inner.replace(/\s*\(\+ Update\)/, '');
  }
  const mm = inner.match(/^([A-Za-z]+)\.?\s+(\d{1,2})/);
  if (!mm || !MONTHS[mm[1]]) return `更新公告：${inner}`;
  const isMaint = /maintenance/i.test(inner);
  return `更新公告：${MONTHS[mm[1]]} 月 ${parseInt(mm[2], 10)} 日${isMaint ? '維護' : ''}${suffix}`;
}

export function getStaticPaths() {
  return patchNotes.map((n) => ({
    params: { slug: n.slug },
  }));
}

const { slug } = Astro.params;
const noteModules = import.meta.glob('/src/data/horizon-walker/patch-notes/*.js');
const loader = noteModules[`/src/data/horizon-walker/patch-notes/${slug}.js`];
if (!loader) {
  return Astro.redirect(`${HW_ZH.baseUrl}updates/`);
}
const { note } = await loader();

const meta = patchNotes.find((n) => n.slug === slug) || note;
const zhTitle = titleZh(note.title);
const posted = `${parseInt(note.date.slice(0, 4), 10)} 年 ${parseInt(note.date.slice(5, 7), 10)} 月 ${parseInt(
  note.date.slice(8, 10),
  10
)} 日`;
const zhTags = note.highlights.map((h) => highlightZh(h));
const firstImage = note.blocks.find((b) => b.k === 'img');
const enPageUrl = `/guides/horizon-walker/updates/${slug}/`;
---

<HwLangLayout lang="zh-tw" ui={HW_ZH}
  title={`${zhTitle} - 地平線行者繁體中文維基 - GachaWiki`}
  description={`${zhTitle}（${posted}發布）要點繁體中文整理：${zhTags.join('、')}。完整內容請查看對應的官方英文公告。`}
  keywords={['地平線行者', '更新公告', note.date]}
  breadcrumbItems={[
    { name: '首頁', href: '/' },
    { name: '地平線行者', href: HW_ZH.baseUrl },
    { name: '更新公告', href: `${HW_ZH.baseUrl}updates/` },
    { name: zhTitle },
  ]}
>
  <section class="hw-guide-hero">
    <h1 class="hw-guide-title">{zhTitle}</h1>
    <p class="hw-guide-subtitle">{posted}發布的官方更新公告，繁體中文要點整理。</p>
    <DecorativeLines />
  </section>

  <div class="hw-guide-content">
  <div class="pn-page">
    <div class="pn-meta-card">
      <div class="pn-meta-row">
        <span class="pn-meta-label">發布日期</span>
        <span class="pn-meta-value">{posted}</span>
      </div>
      <div class="pn-meta-row">
        <span class="pn-meta-label">原文標題</span>
        <span class="pn-meta-value">{note.title}</span>
      </div>
      <div class="pn-meta-row">
        <span class="pn-meta-label">來源</span>
        <a class="pn-meta-link" href={note.sourceUrl} target="_blank" rel="noopener">
          Naver Lounge 官方貼文
        </a>
      </div>
      <div class="pn-meta-row">
        <span class="pn-meta-label">語言</span>
        <span class="pn-meta-value">官方英文公告，本頁為繁體中文要點整理</span>
      </div>
    </div>

    <p class="pn-schedule-note">
      更新公告跟隨韓服日程，韓服進度領先全球服數週。官方原文中的具體技能數值以 N 佔位符表示。活動、卡池等專有名稱暫無官方中文，保留英文原文。
    </p>

    {
      firstImage && (
        <div class="pn-banner">
          <img
            src={r2Url('horizon-walker', `patch-notes/${firstImage.src}`)}
            alt={`${zhTitle} 頭圖`}
            width={firstImage.w || 960}
            height={firstImage.h || 200}
            loading="eager"
          />
        </div>
      )
    }

    <article class="pn-body">
      <h2 class="pn-sec">本次更新要點</h2>
      <ul class="pn-points">
        {
          zhTags.map((t) => (
            <li class="pn-point">{t}</li>
          ))
        }
      </ul>
      <p class="pn-note">
        以上為該公告的要點繁體中文整理。完整內容（全部章節、技能表格與圖片）請查看
        <a href={enPageUrl}>對應的英文公告頁</a>。
      </p>
    </article>

    <div class="pn-footer-nav">
      <a class="pn-back" href={`${HW_ZH.baseUrl}updates/`}>全部更新公告</a>
      <a class="pn-back" href={enPageUrl}>查看完整英文公告</a>
      <a class="pn-back" href={note.sourceUrl} target="_blank" rel="noopener">
        在 Naver Lounge 查看原貼
      </a>
    </div>
  </div>
  </div>
</HwLangLayout>

