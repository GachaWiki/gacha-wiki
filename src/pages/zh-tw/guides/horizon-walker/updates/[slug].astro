---
// Traditional-Chinese (zh-tw) single patch note page: /zh-tw/guides/horizon-walker/updates/<slug>/
// Same slug set as the EN page (getStaticPaths from patch-notes.js). The EN
// note bodies are the full official English text; this zh-tw page renders the
// note's summary points (title, date, highlights) in natural Traditional
// Chinese and links to the EN page for the complete original note.
import HwLangLayout from '../../../../../layouts/lang/HwLangLayout.astro';
import DecorativeLines from '../../../../../components/DecorativeLines.astro';
import '../../../../../styles/games/horizon-walker/hw-guide.css';
import { patchNotes } from '../../../../../data/horizon-walker/patch-notes.js';
import { HORIZON_WALKER_CHARACTERS } from '../../../../../data/horizon-walker/characters.js';
import { HW_ZH_NAMES, HW_ZH_INHERITANCE } from '../../../../../data/horizon-walker/zh-tw/game-text.js';
import { HW_ZH } from '../../../../../data/horizon-walker/zh-tw/ui.js';
import { r2Url } from '../../../../../data/r2-config.js';

export const prerender = true;

// ---------- shared ZH rendering of patch note titles & highlight tags --------
const zhByEnChar = {};
for (const c of HORIZON_WALKER_CHARACTERS) {
  const z = HW_ZH_NAMES[c.id];
  if (z) zhByEnChar[c.name] = z;
}
const charDisplay = (en) => {
  const zh = zhByEnChar[en];
  return zh ? `${zh}（${en}）` : en;
};
const weaponZh = (en) => {
  if (en === 'Watcher of the Night') return HW_ZH_INHERITANCE['Nocturnal Watcher']?.name || null;
  return HW_ZH_INHERITANCE[en]?.name || null;
};
const weaponDisplay = (en) => {
  const zh = weaponZh(en);
  if (!zh) return en;
  const gloss = en.includes('–') ? en.split('–').map((p) => p.trim()).join(' ') : en;
  return `${zh}（${gloss}）`;
};
const nameListZh = (rest) =>
  rest
    .split('/')
    .map((seg) => seg.trim())
    .filter(Boolean)
    .map((seg) => (zhByEnChar[seg] ? charDisplay(seg) : weaponZh(seg) ? weaponDisplay(seg) : seg))
    .join(' / ');

const FEATURE_ZH = {
