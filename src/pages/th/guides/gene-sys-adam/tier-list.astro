const noteOf = slug => NOTES[slug] || null;

const bySlug = Object.fromEntries(gsaCharactersTh.map(c => [c.slug, c]));
const isReleased = c => Boolean(c.icon);
const placementOf = slug => GSA_TIER_PLACEMENTS[slug] || { tier: 'C', rarity: null };
const elemPlacementOf = slug => GSA_ELEMENT_PLACEMENTS[slug] || GSA_TIER_PLACEMENTS[slug] || { tier: 'C', rarity: null };

const nameCount = {};
for (const c of gsaCharactersTh) nameCount[c.name] = (nameCount[c.name] || 0) + 1;
const fullName = c => (c && c.title && nameCount[c.name] > 1 ? `${c.name} (${c.title})` : c.name);

// game-official localized job + element names by id, from the roster itself
const JOB_ID = { Guardian: 1, Striker: 2, Sniper: 3, Support: 4, Breaker: 5 };
const ELEM_ID = { Fire: 1, Earth: 2, Wind: 3, Water: 4, Light: 5, Dark: 6 };
const jobName = {}; const elemName = {};
for (const c of gsaCharactersTh) {
  if (c.job?.id && !jobName[c.job.id]) jobName[c.job.id] = c.job.name;
  if (c.element?.id && !elemName[c.element.id]) elemName[c.element.id] = c.element.name;
}

const tierTabs = ['SSR', 'SR'].map(rarity => ({
  rarity,
  jobs: GSA_JOB_SECTIONS.map(section => ({
    job: section.job,
    local: jobName[JOB_ID[section.job]] || section.job,
    icon: section.icon,
    tiers: GSA_TIERS.map(({ tier, color }) => ({
      tier,
      color,
      characters: gsaCharactersTh
        .filter(c => isReleased(c)
          && c.job && c.job.id === JOB_ID[section.job]
          && (placementOf(c.slug).rarity || 'SSR') === rarity
          && placementOf(c.slug).tier === tier)
        .map(c => ({ ...c, placement: placementOf(c.slug) }))
        .sort((a, b) => a.name.localeCompare(b.name)),
    })).filter(t => t.characters.length > 0),
  })).filter(g => g.tiers.length > 0),
}));

const elemSections = GSA_ELEMENT_SECTIONS.map(section => ({
  ...section,
  local: elemName[ELEM_ID[section.element]] || section.element,
  tiers: GSA_TIERS.map(({ tier, color }) => ({
    tier,
    color,
    characters: gsaCharactersTh
      .filter(c => isReleased(c)
        && c.element && c.element.id === ELEM_ID[section.element]
        && (elemPlacementOf(c.slug).rarity || 'SSR') === 'SSR'
        && elemPlacementOf(c.slug).tier === tier)
      .map(c => ({ ...c, placement: elemPlacementOf(c.slug) }))
      .sort((a, b) => a.name.localeCompare(b.name)),
  })).filter(t => t.characters.length > 0),
})).filter(s => s.tiers.length);

const tabCount = rarity =>
  gsaCharactersTh.filter(c => isReleased(c) && (placementOf(c.slug).rarity || 'SSR') === rarity).length;
const total = tierTabs.reduce((n, t) => n + tabCount(t.rarity), 0);
