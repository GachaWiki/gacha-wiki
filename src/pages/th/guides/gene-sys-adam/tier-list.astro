<GsaI18nLayout ui={ui} title="จัดอันดับ" gameTitle="จัดอันดับ" breadcrumbItems={[{ name: ui.gameName, href: ui.baseUrl }, { name: 'จัดอันดับ' }]}>
  <section>
    <div class="gsa-beginner-box">
      <div class="gsa-beginner-head">
