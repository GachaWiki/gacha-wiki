          const c = bySlug[pick.slug];
          const rarity = (GSA_TIER_PLACEMENTS[pick.slug]?.rarity || 'sr').toLowerCase();
          return (
            <a class="gsa-beginner-card" href={`${base}characters/${pick.slug}/`}>
              {c?.icon
                ? <img class="gsa-beginner-thumb" src={c.icon} alt={c.name} width="64" height="64" loading="lazy" />
                : <span class="gsa-beginner-thumb gsa-monogram">{c?.name?.[0]}</span>}
              <span class="gsa-beginner-name">{c?.name ?? pick.slug}</span>
              {gsaRarityBadge(GSA_TIER_PLACEMENTS[pick.slug]?.rarity) ? (
                <img class="gsa-rarity-badge" src={gsaRarityBadge(GSA_TIER_PLACEMENTS[pick.slug].rarity)} alt={GSA_TIER_PLACEMENTS[pick.slug].rarity} width="50" height="32" loading="lazy" />
              ) : (
                <span class={`gsa-tier-rarity gsa-tier-rarity-${rarity}`}>{GSA_TIER_PLACEMENTS[pick.slug]?.rarity ?? 'SSR'}</span>
              )}
              <span class="gsa-beginner-note">{pick.note}</span>
            </a>
          );
        })}
        <div class="gsa-beginner-card gsa-beginner-card-last">
          <span class="gsa-beginner-thumb gsa-monogram">?</span>
          <span class="gsa-beginner-name">{BEGINNER_NOTE.lastSlot.name}</span>
          <span class="gsa-beginner-note">{BEGINNER_NOTE.lastSlot.note}</span>
        </div>
      </div>
    </div>

    <div class="gsa-beginner-box gsa-pairs-box">
