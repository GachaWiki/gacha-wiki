---
// Gene-Sys: Adam th character database: shared i18n template.
import GsaI18nLayout from '../../../../../layouts/gene-sys-adam/GsaI18nLayout.astro';
import I18nCharactersIndex from '../../../../../components/gene-sys-adam/i18n/I18nCharactersIndex.astro';
import { GSA_TH } from '../../../../../data/gene-sys-adam/th/ui.js';
import { gsaCharactersTh } from '../../../../../data/gene-sys-adam/th/characters.js';
import '../../../../../styles/games/gene-sys-adam/gsa-characters.css';
const ui = GSA_TH;
const characters = gsaCharactersTh;
---

<GsaI18nLayout
  ui={ui}
  title={ui.labels.charactersDb}
  gameTitle={ui.labels.characters}
  breadcrumbItems={[{ name: ui.gameName, href: ui.baseUrl }, { name: ui.labels.charactersDb }]}
>
  <I18nCharactersIndex ui={ui} characters={characters} />
</GsaI18nLayout>
