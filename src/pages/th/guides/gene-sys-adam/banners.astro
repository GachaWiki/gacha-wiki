// featured units without a wiki page yet: game-official localized names
const UNRELEASED_NAMES = {
  "qing-yin": "ชิงยิน",
  "leng-zhen": "Leng Zhen",
  "elena": "Yelena",
  "victoria": "วิคตอเรีย",
  "connie": "คอนนี่"
};
// training lists localized per banner (source lists use EN names)
const TRAINING_LOC = {
  "black-gold-hunter": [
    "เบลล์"
  ],
  "ogino-rui-rate-up": [],
  "sugimoto-arina-rate-up": [],
  "lunar-splendor": [
    "โคมาจิ ซายากะ",
    "ฮิจิคาตะ จิซึรุ"
  ],
  "heavens-door-jessica": [
    "เจสสิก้า"
  ],
  "heavens-door-connie": [
    "คอนนี่"
  ],
  "war-and-music": [
    "Yelena",
    "วิคตอเรีย"
  ],
  "lingering-echoes": [
    "ชิงยิน",
    "Leng Zhen"
  ],
  "solo-rotation-queue": []
};

const STATUS_LABEL = {
  live: L.ui.statusLive,
  ended: L.ui.statusEnded,
  beta: L.ui.statusBeta,
  scheduled: L.ui.statusScheduled,
};

const SECTIONS = [
  { key: 'live', title: L.ui.secLive },
  { key: 'ended', title: L.ui.secEnded },
  { key: 'beta', title: L.ui.secBeta },
  { key: 'scheduled', title: L.ui.secScheduled },
];

const bySlug = Object.fromEntries(gsaCharactersTh.map(c => [c.slug, c]));

function charCard(slug) {
  const c = bySlug[slug];
  if (!c) {
    return { name: UNRELEASED_NAMES[slug] || slug, meta: L.ui.unreleased, icon: null, slug, unreleased: true };
  }
  const bits = [c.title, c.element?.name, c.job?.name].filter(Boolean);
  return { name: c.name, meta: bits.join(', '), icon: c.icon, slug, unreleased: false };
}
---

<GsaI18nLayout
  ui={ui}
  title="ประวัติแบนเนอร์"
  description="แบนเนอร์อีเวนต์ทุกชุดที่เคยเปิดหรือโหลดไว้รอเปิด พร้อมหน่วยตัวหลักและค่าพิตี้ จัดทำจากตารางข้อมูลเกมที่ถอดรหัสแล้ว"
  gameTitle="ประวัติแบนเนอร์"
  breadcrumbItems={[{ name: ui.gameName, href: base }, { name: 'ประวัติแบนเนอร์' }]}
>
  <section>
    <p class="gsa-banner-intro">{L.ui.intro}</p>

    {SECTIONS.map(sec => {
      const cards = GSA_BANNERS.filter(b => b.status === sec.key);
      return cards.length > 0 && (
        <fragment>
          <h2 class="gsa-banner-section-title">{sec.title}</h2>
          <div class="gsa-bn-list">
            {cards.map(b => {
              const loc = L.banners[b.slug] || {};
              return (
              <article class={`gsa-bn-card${b.status === 'live' ? ' gsa-bn-card-live' : ''}`}>
                <div class="gsa-bn-art">
                  {b.image
                    ? (
                      <div class="gsa-bn-art-imgs">
                        <img src={b.image} alt={`${loc.name} ${L.ui.bannerArtAlt}`} width="1920" height="1080" loading="lazy" decoding="async" />
                        {b.image2 && <img src={b.image2} alt={`${loc.name} ${L.ui.secondPanelAlt}`} width="1920" height="1080" loading="lazy" decoding="async" />}
                      </div>
                    )
                    : (
                      <div class="gsa-bn-art-none">
                        {b.featured.length > 0 && b.featured.every(slug => charCard(slug)?.icon)
                          ? b.featured.map(slug => {
                              const c = charCard(slug);
                              return <img class="gsa-bn-art-icon" src={c.icon} alt={c.name} width="110" height="110" loading="lazy" />;
                            })
                          : <span>{L.ui.noArt}</span>}
                      </div>
                    )}
                </div>
                <div class="gsa-bn-body">
                  <div class="gsa-bn-top">
                    <span class="gsa-bn-kind">{loc.kind}</span>
                    <span class={`gsa-bn-status gsa-bn-status-${b.status}`}>{STATUS_LABEL[b.status]}</span>
                    <span class="gsa-bn-since">{loc.since}</span>
                  </div>
                  <h3 class="gsa-bn-title">{loc.name}</h3>
                  <p class="gsa-bn-sub">{b.name}</p>
                  <div class="gsa-banner-featured">
                    {b.featured.map(slug => {
                      const c = charCard(slug);
                      if (!c || c.unreleased) {
                        return (
                          <span class="gsa-banner-char">
                            <span class="gsa-banner-char-thumb gsa-monogram">?</span>
                            <span>
                              <span class="gsa-banner-char-name">{c?.name ?? slug}</span>
                              <span class="gsa-banner-char-meta">{L.ui.unreleased}</span>
                            </span>
                          </span>
                        );
                      }
                      return (
                        <a class="gsa-banner-char" href={`${base}characters/${slug}/`}>
                          {c.icon
                            ? <img class="gsa-banner-char-thumb" src={c.icon} alt={c.name} width="44" height="44" loading="lazy" />
                            : <span class="gsa-banner-char-thumb gsa-monogram">{c.name?.[0]}</span>}
                          <span>
                            <span class="gsa-banner-char-name">{c.name}</span>
                            <span class="gsa-banner-char-meta">{c.meta}</span>
                          </span>
                        </a>
                      );
                    })}
                  </div>
                  <div class="gsa-banner-facts">
                    {b.pity && <span class="gsa-banner-fact"><b>{L.ui.pityLabel}</b> {b.pity}</span>}
                    {loc.eventToken && <span class="gsa-banner-fact"><b>{L.ui.eventTokenLabel}</b> {loc.eventToken}</span>}
                    {(TRAINING_LOC[b.slug] || []).length > 0 && <span class="gsa-banner-fact"><b>{L.ui.trainingLabel}</b> {TRAINING_LOC[b.slug].join(', ')}</span>}
                  </div>
                  <p class="gsa-bn-note">{loc.note}</p>
                </div>
              </article>
              );
            })}
          </div>
        </fragment>
      );
    })}
  </section>
</GsaI18nLayout>
