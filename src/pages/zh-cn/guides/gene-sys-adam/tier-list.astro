// zh-cn tier list: standalone page (old-system pattern, sibling of the
// zh-TW/EN pages; no shared component). Ladder, element-view overrides and
// pair structure come from tier-list.js; shell strings and the 19 tier
// notes are localized inline. Job/element grouping matches by ID and shows
// the game's own localized names from the roster. Generated by
// D:/GeneSysAdam/tools/gen_tierlist_locales.py 2026-10-18: manual edits win
// until the next run.
import GsaI18nLayout from '../../../../layouts/gene-sys-adam/GsaI18nLayout.astro';
import { GSA_TIERS, GSA_JOB_SECTIONS, GSA_TIER_PLACEMENTS, GSA_ELEMENT_PLACEMENTS, GSA_ELEMENT_SECTIONS, gsaRarityBadge, GSA_TIER_NOTES } from '../../../../data/gene-sys-adam/tier-list.js';
import { gsaCharactersZhCn } from '../../../../data/gene-sys-adam/zh-cn/characters.js';
import { GSA_ZHCN } from '../../../../data/gene-sys-adam/zh-cn/ui.js';
import { gsaPursuitRole } from '../../../../data/gene-sys-adam/pursuit-roles.js';
import '../../../../styles/games/gene-sys-adam/gsa-common.css';
import '../../../../styles/games/gene-sys-adam/gsa-tier.css';

const ui = GSA_ZHCN;
const base = '/zh-cn/guides/gene-sys-adam/';

const TIER_ROLE = {"trigger": "终结技", "enabler": "启动技", "both": "启动＋终结", "none": "无追击参与"};

const BEGINNER_NOTE = {
