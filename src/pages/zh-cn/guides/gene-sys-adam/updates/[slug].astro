const { slug } = Astro.params;
const entry = GSA_UPDATES.find(u => u.slug === slug);
const loc = (L.entries[slug] || {});
const title = loc.title || entry.title;
const date = loc.date || entry.date;
---

<GsaI18nLayout
  ui={ui}
  title={title}
  description="每次游戏更新，依据解密客户端表格重建，最新在前。"
  gameTitle="更新"
  breadcrumbItems={[{ name: ui.gameName, href: base }, { name: '更新', href: `${base}updates/` }, { name: title }]}
>
  <section>
    <a class="gsa-update-back" href={`${base}updates/`}>{L.ui.backAll}</a>

    <article class="gsa-update-card gsa-update-detail">
      <div class="gsa-update-artwrap">
        {entry.image
          ? (
            <div class="gsa-banner-art-pair">
              <img class="gsa-update-art" src={entry.image} alt={loc.imageCaption || title} width={entry.imageW || 1280} height={entry.imageH || 720} />
              {entry.image2 && <img class="gsa-update-art" src={entry.image2} alt={loc.imageCaption || title} width={entry.imageW || 1280} height={entry.imageH || 720} />}
            </div>
          )
          : <div class="gsa-update-art-band">{date}</div>}
        <span class="gsa-update-tag">{L.ui.tags[entry.tag] || entry.tag}</span>
      </div>
      <div class="gsa-update-head">
        <h1 class="gsa-update-detail-title">{title}</h1>
        <span class="gsa-update-date">{date}</span>
      </div>
      <ul class="gsa-update-points">
        {(loc.points || entry.points).map(p => <li>{p}</li>)}
      </ul>
      {loc.imageCaption && <p class="gsa-update-caption">{loc.imageCaption}</p>}
      <p class="gsa-update-source">{L.ui.sourcePrefix} {loc.source || entry.source}</p>
    </article>

  </section>
</GsaI18nLayout>
