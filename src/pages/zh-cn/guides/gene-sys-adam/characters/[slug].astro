---
// Gene-Sys: Adam zh-cn character detail: shared i18n template.
import GsaI18nLayout from '../../../../../layouts/gene-sys-adam/GsaI18nLayout.astro';
import I18nCharacterDetail from '../../../../../components/gene-sys-adam/i18n/I18nCharacterDetail.astro';
import { GSA_ZHCN } from '../../../../../data/gene-sys-adam/zh-cn/ui.js';
import { gsaCharactersZhCn } from '../../../../../data/gene-sys-adam/zh-cn/characters.js';
import { gsaStatLabelsZhCn } from '../../../../../data/gene-sys-adam/zh-cn/stat-labels.js';
import '../../../../../styles/games/gene-sys-adam/gsa-characters.css';

export function getStaticPaths() {
  return gsaCharactersZhCn.map(c => ({ params: { slug: c.slug } }));
}

const ui = GSA_ZHCN;
const characters = gsaCharactersZhCn;
const { slug } = Astro.params;
const current = characters.find(c => c.slug === slug);
// full name when two units share a name (title appended)
const dupCount = characters.reduce((n, x) => n + (x.name === current.name ? 1 : 0), 0);
const displayName = current.title && dupCount > 1 ? `${current.name} (${current.title})` : current.name;
---

{current && (
<GsaI18nLayout
  ui={ui}
  title={displayName}
  gameTitle={displayName}
  breadcrumbItems={[{ name: ui.gameName, href: ui.baseUrl }, { name: ui.labels.charactersDb, href: ui.baseUrl + 'characters/' }, { name: displayName }]}
>
  <I18nCharacterDetail ui={ui} characters={characters} slug={slug} statLabels={gsaStatLabelsZhCn} />
</GsaI18nLayout>
)}
