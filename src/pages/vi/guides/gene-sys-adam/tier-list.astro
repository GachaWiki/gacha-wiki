const noteOf = slug => NOTES[slug] || null;

const bySlug = Object.fromEntries(gsaCharactersVi.map(c => [c.slug, c]));
const isReleased = c => Boolean(c.icon);
const placementOf = slug => GSA_TIER_PLACEMENTS[slug] || { tier: 'C', rarity: null };
const elemPlacementOf = slug => GSA_ELEMENT_PLACEMENTS[slug] || GSA_TIER_PLACEMENTS[slug] || { tier: 'C', rarity: null };

const nameCount = {};
for (const c of gsaCharactersVi) nameCount[c.name] = (nameCount[c.name] || 0) + 1;
const fullName = c => (c && c.title && nameCount[c.name] > 1 ? `${c.name} (${c.title})` : c.name);

// game-official localized job + element names by id, from the roster itself
const JOB_ID = { Guardian: 1, Striker: 2, Sniper: 3, Support: 4, Breaker: 5 };
const ELEM_ID = { Fire: 1, Earth: 2, Wind: 3, Water: 4, Light: 5, Dark: 6 };
const jobName = {}; const elemName = {};
for (const c of gsaCharactersVi) {
  if (c.job?.id && !jobName[c.job.id]) jobName[c.job.id] = c.job.name;
  if (c.element?.id && !elemName[c.element.id]) elemName[c.element.id] = c.element.name;
}

const tierTabs = ['SSR', 'SR'].map(rarity => ({
  rarity,
  jobs: GSA_JOB_SECTIONS.map(section => ({
    job: section.job,
    local: jobName[JOB_ID[section.job]] || section.job,
    icon: section.icon,
    tiers: GSA_TIERS.map(({ tier, color }) => ({
      tier,
      color,
      characters: gsaCharactersVi
        .filter(c => isReleased(c)
          && c.job && c.job.id === JOB_ID[section.job]
          && (placementOf(c.slug).rarity || 'SSR') === rarity
          && placementOf(c.slug).tier === tier)
        .map(c => ({ ...c, placement: placementOf(c.slug) }))
        .sort((a, b) => a.name.localeCompare(b.name)),
    })).filter(t => t.characters.length > 0),
  })).filter(g => g.tiers.length > 0),
}));

const elemSections = GSA_ELEMENT_SECTIONS.map(section => ({
  ...section,
  local: elemName[ELEM_ID[section.element]] || section.element,
  tiers: GSA_TIERS.map(({ tier, color }) => ({
    tier,
    color,
    characters: gsaCharactersVi
      .filter(c => isReleased(c)
        && c.element && c.element.id === ELEM_ID[section.element]
        && (elemPlacementOf(c.slug).rarity || 'SSR') === 'SSR'
        && elemPlacementOf(c.slug).tier === tier)
      .map(c => ({ ...c, placement: elemPlacementOf(c.slug) }))
      .sort((a, b) => a.name.localeCompare(b.name)),
  })).filter(t => t.characters.length > 0),
})).filter(s => s.tiers.length);

const tabCount = rarity =>
  gsaCharactersVi.filter(c => isReleased(c) && (placementOf(c.slug).rarity || 'SSR') === rarity).length;
const total = tierTabs.reduce((n, t) => n + tabCount(t.rarity), 0);
---

<GsaI18nLayout ui={ui} title="Bảng Xếp Hạng" gameTitle="Bảng Xếp Hạng" breadcrumbItems={[{ name: ui.gameName, href: ui.baseUrl }, { name: 'Bảng Xếp Hạng' }]}>
  <section>
    <div class="gsa-beginner-box">
      <div class="gsa-beginner-head">
        <div class="gsa-beginner-head-copy">
          <h2 class="gsa-beginner-title">{BEGINNER_NOTE.title}</h2>
          <p class="gsa-beginner-intro">{BEGINNER_NOTE.intro}</p>
        </div>
      </div>
      <div class="gsa-beginner-team">
        {BEGINNER_NOTE.picks.map(pick => {
          const c = bySlug[pick.slug];
          const rarity = (GSA_TIER_PLACEMENTS[pick.slug]?.rarity || 'sr').toLowerCase();
          return (
            <a class="gsa-beginner-card" href={`${base}characters/${pick.slug}/`}>
              {c?.icon
                ? <img class="gsa-beginner-thumb" src={c.icon} alt={c.name} width="64" height="64" loading="lazy" />
                : <span class="gsa-beginner-thumb gsa-monogram">{c?.name?.[0]}</span>}
              <span class="gsa-beginner-name">{c?.name ?? pick.slug}</span>
              {gsaRarityBadge(GSA_TIER_PLACEMENTS[pick.slug]?.rarity) ? (
                <img class="gsa-rarity-badge" src={gsaRarityBadge(GSA_TIER_PLACEMENTS[pick.slug].rarity)} alt={GSA_TIER_PLACEMENTS[pick.slug].rarity} width="50" height="32" loading="lazy" />
              ) : (
                <span class={`gsa-tier-rarity gsa-tier-rarity-${rarity}`}>{GSA_TIER_PLACEMENTS[pick.slug]?.rarity ?? 'SSR'}</span>
              )}
              <span class="gsa-beginner-note">{pick.note}</span>
            </a>
          );
        })}
        <div class="gsa-beginner-card gsa-beginner-card-last">
          <span class="gsa-beginner-thumb gsa-monogram">?</span>
          <span class="gsa-beginner-name">{BEGINNER_NOTE.lastSlot.name}</span>
          <span class="gsa-beginner-note">{BEGINNER_NOTE.lastSlot.note}</span>
        </div>
      </div>
    </div>

    <div class="gsa-beginner-box gsa-pairs-box">
      <h2 class="gsa-beginner-title">{PAIRS_NOTE.title}</h2>
      <p class="gsa-beginner-intro">{PAIRS_NOTE.intro}</p>
      <div class="gsa-pairs-grid">
        {PAIRS_NOTE.pairs.map(pair => (
          <div class={`gsa-pairs-card${pair.universal ? ' gsa-pairs-card-universal' : ''}`}>
            <span class="gsa-pairs-name">{pair.name}</span>
            <div class="gsa-pairs-members">
              {pair.members.map(slug => {
                const c = bySlug[slug];
                return (
                  <a class="gsa-pairs-member" href={`${base}characters/${slug}/`}>
                    {c?.icon
                      ? <img class="gsa-pairs-thumb" src={c.icon} alt={c.name} width="48" height="48" loading="lazy" />
                      : <span class="gsa-pairs-thumb gsa-monogram">{c?.name?.[0]}</span>}
                    <span class="gsa-pairs-member-name">{c?.name ?? slug}</span>
                  </a>
                );
              })}
            </div>
            <span class="gsa-pairs-note">{pair.note}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="gsa-tier-tabs" role="tablist" aria-label="tier">
      {tierTabs.map((tab, i) => (
        <button
          class={`gsa-tier-tab${i === 0 ? ' active' : ''}`}
          data-rarity-tab={tab.rarity}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
        >
          {tab.rarity}
          <span class="gsa-tier-tab-count">{tabCount(tab.rarity)}</span>
        </button>
      ))}
      <button class="gsa-tier-tab" data-rarity-tab="element" role="tab" aria-selected="false">
        Theo nguyên tố
      </button>
    </div>

    {tierTabs.map((tab, i) => (
      <div class="gsa-tier-tabpanel" data-rarity-panel={tab.rarity} style={i > 0 ? 'display:none' : undefined}>
        {tab.jobs.map(group => (
          <div class="gsa-tier-job-section">
            <div class="gsa-tier-job-header">
              {group.icon && <img class="gsa-tier-job-icon" src={group.icon} alt="" width="40" height="40" loading="lazy" />}
              <h2 class="gsa-tier-job-title">{group.local}<span class="gsa-tier-job-zh">{group.job}</span></h2>
              <span class="gsa-tier-job-count">
                {group.tiers.reduce((n, t) => n + t.characters.length, 0)} nhân vật
              </span>
            </div>
            <div class="gsa-tier-grid">
              {group.tiers.map(row => (
                <div class="gsa-tier-row">
                  <div class="gsa-tier-label">
                    <span class="gsa-tier-name" style={`color:${row.color}`}>{row.tier}</span>
                  </div>
                  <div class="gsa-tier-characters">
                    {row.characters.map(c => (
                      <a class="gsa-tier-card" href={`${base}characters/${c.slug}/`}>
                        {c.icon ? (
                          <img class="gsa-tier-thumb" src={c.icon} alt={fullName(c)} loading="lazy" />
                        ) : (
                          <span class="gsa-tier-thumb gsa-monogram">{c.name?.[0]}</span>
                        )}
                        <span class="gsa-tier-badges">
                          {gsaRarityBadge(c.placement.rarity) ? (
                            <img class="gsa-rarity-badge gsa-tier-thumb-badge" src={gsaRarityBadge(c.placement.rarity)} alt={c.placement.rarity} width="50" height="32" loading="lazy" />
                          ) : (
                            <span class={`gsa-tier-rarity gsa-tier-rarity-${(c.placement.rarity || 'sr').toLowerCase()}`}>{c.placement.rarity}</span>
                          )}
                          {c.element && (
                            <img class="gsa-tier-elem" src={c.element.icon} alt={c.element.name} title={c.element.name} width="18" height="18" loading="lazy" />
                          )}
                        </span>
                        <span class="gsa-tier-name-label">{fullName(c)}</span>
                        {(() => { const pr = gsaPursuitRole(c.slug); return (
                          <span class={`gsa-tier-role gsa-tier-role-${pr.role}`}>{TIER_ROLE[pr.role]}</span>
                        ); })()}
                        {(() => { const b = GSA_TIER_NOTES[c.slug]; const l = noteOf(c.slug); if (!b) return null; const t = l ? l[1] : b.title; const x = l ? l[2] : b.text; return (
                          <span class={`gsa-tier-note-badge gsa-tier-note-${b.type}${b.variant ? ` gsa-note-variant-${b.variant}` : ''}`} tabindex="0" aria-label={t}>
                            <span class="gsa-tier-note-icon">{b.variant ? '★' : '!'}</span>
                            <span class="gsa-tier-note-tooltip" role="tooltip">
                              <span class="gsa-tier-note-tooltip-title">{t}</span>
                              <span class="gsa-tier-note-tooltip-text">{x}</span>
                            </span>
                          </span>
                        ); })()}
                        {(() => { const b = GSA_TIER_NOTES[c.slug]; const l = noteOf(c.slug); return (b?.variant && l && l[0]) ? (
                          <span class={`gsa-tier-card-highlight gsa-note-variant-${b.variant}`}>{l[0]}</span>
                        ) : null; })()}
                      </a>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    ))}

    <div class="gsa-tier-tabpanel" data-rarity-panel="element" style="display:none">
      {elemSections.map(section => (
        <div class="gsa-tier-job-section">
          <div class="gsa-tier-job-header">
            {section.icon && <img class="gsa-tier-job-icon" src={section.icon} alt="" width="40" height="40" loading="lazy" />}
            <h2 class="gsa-tier-job-title">{section.local}<span class="gsa-tier-job-zh">{section.element}</span></h2>
            <span class="gsa-tier-job-count">
              {section.tiers.reduce((n, t) => n + t.characters.length, 0)} nhân vật
            </span>
          </div>
          <div class="gsa-tier-grid">
            {section.tiers.map(row => (
              <div class="gsa-tier-row">
                <div class="gsa-tier-label">
                  <span class="gsa-tier-name" style={`color:${row.color}`}>{row.tier}</span>
                </div>
                <div class="gsa-tier-characters">
                  {row.characters.map(c => (
                    <a class="gsa-tier-card" href={`${base}characters/${c.slug}/`}>
                      {c.icon ? (
                        <img class="gsa-tier-thumb" src={c.icon} alt={fullName(c)} loading="lazy" />
                      ) : (
                        <span class="gsa-tier-thumb gsa-monogram">{c.name?.[0]}</span>
                      )}
                      <span class="gsa-tier-badges">
                        {gsaRarityBadge(c.placement.rarity) ? (
                          <img class="gsa-rarity-badge gsa-tier-thumb-badge" src={gsaRarityBadge(c.placement.rarity)} alt={c.placement.rarity} width="50" height="32" loading="lazy" />
                        ) : (
                          <span class={`gsa-tier-rarity gsa-tier-rarity-${(c.placement.rarity || 'sr').toLowerCase()}`}>{c.placement.rarity}</span>
                        )}
                        {c.element && (
                          <img class="gsa-tier-elem" src={c.element.icon} alt={c.element.name} title={c.element.name} width="18" height="18" loading="lazy" />
                        )}
                      </span>
                      <span class="gsa-tier-name-label">{fullName(c)}</span>
                      {(() => { const pr = gsaPursuitRole(c.slug); return (
                        <span class={`gsa-tier-role gsa-tier-role-${pr.role}`}>{TIER_ROLE[pr.role]}</span>
                      ); })()}
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</GsaI18nLayout>

<script is:inline>
  // Rarity + element view tabs.
  (function () {
    var tabs = document.querySelectorAll('.gsa-tier-tab');
    var panels = document.querySelectorAll('.gsa-tier-tabpanel');
    tabs.forEach(function (btn) {
      btn.addEventListener('click', function () {
        tabs.forEach(function (b) { b.classList.remove('active'); b.setAttribute('aria-selected', 'false'); });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        var rarity = btn.getAttribute('data-rarity-tab');
        panels.forEach(function (p) {
          p.style.display = p.getAttribute('data-rarity-panel') === rarity ? '' : 'none';
        });
      });
    });
  })();
</script>
