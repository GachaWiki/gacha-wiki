const ui = GSA_VI;
const base = '/vi/guides/gene-sys-adam/';

const TIER_ROLE = {"trigger": "Kết thúc", "enabler": "Khởi mở", "both": "Mở + kết thúc", "none": "Không vai truy kích"};

