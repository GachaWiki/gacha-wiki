  ],
  "fujiwara-arisa": [
    null,
    "DPS đơn thể thân thiện F2P nhưng mất thời gian max.",
    "Lấy cô bất cứ lúc nào ở trang sự kiện. Ultimate đơn thể rất mạnh, chỉ cần thời gian để max."
  ],
