---
// Gene-Sys: Adam vi character detail: shared i18n template.
import GsaI18nLayout from '../../../../../layouts/gene-sys-adam/GsaI18nLayout.astro';
import I18nCharacterDetail from '../../../../../components/gene-sys-adam/i18n/I18nCharacterDetail.astro';
import { GSA_VI } from '../../../../../data/gene-sys-adam/vi/ui.js';
import { gsaCharactersVi } from '../../../../../data/gene-sys-adam/vi/characters.js';
import { gsaStatLabelsVi } from '../../../../../data/gene-sys-adam/vi/stat-labels.js';
import '../../../../../styles/games/gene-sys-adam/gsa-characters.css';

export function getStaticPaths() {
  return gsaCharactersVi.map(c => ({ params: { slug: c.slug } }));
}

const ui = GSA_VI;
const characters = gsaCharactersVi;
const { slug } = Astro.params;
const current = characters.find(c => c.slug === slug);
---

{current && (
<GsaI18nLayout
  ui={ui}
  title={current.name}
  gameTitle={current.name}
  breadcrumbItems={[{ name: ui.gameName, href: ui.baseUrl }, { name: ui.labels.charactersDb, href: ui.baseUrl + 'characters/' }, { name: current.name }]}
>
  <I18nCharacterDetail ui={ui} characters={characters} slug={slug} statLabels={gsaStatLabelsVi} />
</GsaI18nLayout>
)}
