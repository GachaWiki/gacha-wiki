---
// <localized> update detail page, generated by gen_bu_locales.py: one entry
// with the wave's art and the full localized point list.
import GsaI18nLayout from '../../../../../layouts/gene-sys-adam/GsaI18nLayout.astro';
import { GSA_UPDATES } from '../../../../../data/gene-sys-adam/updates.js';
import { GSA_VI } from '../../../../../data/gene-sys-adam/vi/ui.js';
import '../../../../../styles/games/gene-sys-adam/gsa-common.css';
import '../../../../../styles/games/gene-sys-adam/gsa-banners.css';

export function getStaticPaths() {
  return GSA_UPDATES.map(u => ({ params: { slug: u.slug } }));
}

const ui = GSA_VI;
const base = ui.baseUrl;

const L = {
  "ui": {
    "intro": "Các bài đăng chính thức và hình ảnh đi kèm lấy từ bản tin của chính game tại genesys-adam.com. Những đợt cập nhật mà nhà phát triển chưa từng đăng tin sẽ được dựng lại bằng cách so sánh khác biệt giữa các bản bảng dữ liệu đã giải mã và gắn thẻ Datamine, nên danh sách nội dung của chúng vẫn chính xác dù mốc thời gian chỉ mang tính tương đối. Mỗi mục có trang riêng với đầy đủ chi tiết.",
