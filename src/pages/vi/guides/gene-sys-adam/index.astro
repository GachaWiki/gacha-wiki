---
// Gene-Sys: Adam vi section landing: shared i18n template + per-language ui.
import GsaI18nLayout from '../../../../layouts/gene-sys-adam/GsaI18nLayout.astro';
import I18nLanding from '../../../../components/gene-sys-adam/i18n/I18nLanding.astro';
import { GSA_VI } from '../../../../data/gene-sys-adam/vi/ui.js';
import { gsaCharactersVi } from '../../../../data/gene-sys-adam/vi/characters.js';
import '../../../../styles/games/gene-sys-adam/gsa-landing.css';
const ui = GSA_VI;
const charCount = gsaCharactersVi.length;
---

<GsaI18nLayout ui={ui} title={ui.labels.home} gameTitle={ui.gameName} ambientVideo breadcrumbItems={[{ name: ui.gameName, href: ui.baseUrl }]}>
  <I18nLanding ui={ui} charCount={charCount} />
</GsaI18nLayout>
