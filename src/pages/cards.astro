---
// Weiss Schwarz card database index: one overview card per set, linking to
// each set's own card database page (/cards/<set>/).
import AboutLayout from '../layouts/AboutLayout.astro';
import { SITE_TITLE } from '../consts';
import { WS_CARD_SETS, getCardSetCount } from '../data/ws-cards/index.js';
import { SHOP_ITEMS } from '../data/shop-items.js';
import '../styles/pages/ws-cards.css';

const title = `${SITE_TITLE} Weiss Schwarz Card Database`;
const description =
  'The complete Weiss Schwarz English card database: every set from NIKKE, Blue Archive and Re:Zero to DANDADAN, SPY x FAMILY and Chainsaw Man. Each card with image, rarity, color, level, cost, power and full ability text, imported from the official cardlist.';
const keywords = [
  'weiss schwarz card list',
  'weiss schwarz card database',
  'nikke weiss schwarz cards',
  'blue archive weiss schwarz cards',
  'ws tcg cards',
];

const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const shopImage = new Map(SHOP_ITEMS.map((i) => [i.id, i]));
const totalCards = getCardSetCount();
const enSets = WS_CARD_SETS.filter((s) => s.lang !== 'jp');
const jpSets = WS_CARD_SETS.filter((s) => s.lang === 'jp');
---

<AboutLayout title={title} description={description} keywords={keywords}>
  <div class="main-content">
    <header class="page-header">
      <h1 class="page-title">Weiss Schwarz Card Database</h1>
    </header>

    <p class="wsc-intro">
      Every Weiss Schwarz set, English and Japanese: {totalCards} cards across {WS_CARD_SETS.length}
      sets ({enSets.length} English, {jpSets.length} Japanese), each with images, rarities, stats
      and full ability text, imported from the official cardlists. Every set shows its official
      product art where one exists, otherwise a card from the set. Pick a set to browse its cards.
    </p>

    <div class="wsc-toolbar wsc-sets-toolbar">
      <select id="wsc-set-lang" class="wsc-select" aria-label="Filter sets by language">
        <option value="">All sets</option>
        <option value="en">English ({enSets.length})</option>
        <option value="jp">Japanese ({jpSets.length})</option>
      </select>
      <input
        id="wsc-set-search"
        class="wsc-input"
        type="search"
        placeholder="Filter sets by name..."
        aria-label="Filter sets by name"
      />
      <span id="wsc-set-count" class="wsc-count" aria-live="polite"></span>
    </div>

    <div class="wsc-sets" id="wsc-sets">
      {
        WS_CARD_SETS.map((set) => {
          const shop = shopImage.get(set.shopItem ?? undefined);
          return (
            <a
              class="wsc-setcard"
              href={`/cards/${set.id}/`}
              aria-label={`${set.name} card database`}
              data-search={set.name.toLowerCase()}
              data-lang={set.lang ?? 'en'}
            >
              {shop ? (
                <span class="wsc-setcard-media">
                  <img
                    src={shop.image}
                    alt={shop.imageAlt}
                    width={shop.imageWidth}
                    height={shop.imageHeight}
                    loading="lazy"
                    draggable="false"
                  />
                </span>
              ) : set.box ? (
                <span class="wsc-setcard-media">
                  <img
                    src={set.box}
                    alt={`${set.name} product image`}
                    loading="lazy"
                    draggable="false"
                  />
                </span>
              ) : set.sample ? (
                <span class="wsc-setcard-media">
                  <img
                    src={set.sample}
                    alt={`${set.name} sample card`}
                    width="173"
                    height="242"
                    loading="lazy"
                    draggable="false"
                  />
                </span>
              ) : null}
              <span class="wsc-setcard-name">{set.name}</span>
              <span class="wsc-setcard-meta">
                <span class="wsc-chip">{`${set.count} cards`}</span>
                {set.release && <span class="wsc-setcard-date">{fmtDate(set.release)}</span>}
              </span>
            </a>
          );
        })
      }
    </div>

    <p class="wsc-no-results" id="wsc-set-no-results" hidden>No sets match that name.</p>

    <p class="wsc-fineprint">
      Card data and images: official Weiss Schwarz English cardlist (en.ws-tcg.com), Bushiroad.
      Imported for reference; buy the sets in our <a href="/shop/">shop</a>.
    </p>
  </div>
</AboutLayout>

<script>
  // Client-side set filter (site convention: server-rendered tiles, visibility
  // toggled by data attributes).
  const search = document.getElementById('wsc-set-search') as HTMLInputElement;
  const lang = document.getElementById('wsc-set-lang') as HTMLSelectElement;
  const count = document.getElementById('wsc-set-count');
  const noResults = document.getElementById('wsc-set-no-results');
  const tiles = Array.from(document.querySelectorAll<HTMLElement>('.wsc-setcard'));

  function apply(): void {
    const q = search.value.trim().toLowerCase();
    const l = lang.value;
    let visible = 0;
    for (const el of tiles) {
      const show = (!l || el.dataset.lang === l) && (!q || el.dataset.search?.includes(q));
      el.style.display = show ? '' : 'none';
      if (show) visible++;
    }
    if (count) count.textContent = `${visible} of ${tiles.length} sets`;
    if (noResults) noResults.hidden = visible > 0;
  }

  search.addEventListener('input', apply);
  lang.addEventListener('change', apply);
  apply();
</script>

