---

<HwZhLayout
  title={`${zhName}（${char.name}）- 地平线行者 角色资料 - GachaWiki`}
  description={`地平线行者角色 ${zhName}（${char.name}）的中文资料：官方技能说明、固有特性、档案、属性、EX 武器与礼物偏好。全部游戏文本取自游戏官方简体中文。`}
  keywords={[zhName, char.name, '地平线行者', '技能', '属性', '攻略']}
  breadcrumbItems={[
    { name: '首页', href: '/' },
    { name: '地平线行者', href: HW_ZH.baseUrl },
    { name: '角色资料库', href: `${HW_ZH.baseUrl}characters/` },
    { name: zhName },
  ]}
>
  <CharacterPageTemplate characterData={zhData} labels={ZH_LABELS} />
</HwZhLayout>
