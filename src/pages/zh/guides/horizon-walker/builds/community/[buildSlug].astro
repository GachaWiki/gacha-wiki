---
// Chinese community build detail: /zh/guides/horizon-walker/builds/community/
// <slug>/. Same data and slug set as the EN page (community-builds.js,
// credits: Envy, Liauw & Gamekee). Character, weapon, skill and trait names
// use the game's official ZH via game-text.js; the spreadsheet's own values
// (stigma set names, stat lines, effect text) are kept verbatim in English.
import HwZhLayout from '../../../../../../layouts/zh/HwZhLayout.astro';
import '../../../../../../styles/games/horizon-walker/hw-character-build.css';
import '../../../../../../styles/games/horizon-walker/hw-community-build.css';
import { COMMUNITY_BUILDS } from '../../../../../../data/horizon-walker/community-builds.js';
import { HORIZON_WALKER_CHARACTERS } from '../../../../../../data/horizon-walker/characters.js';
import { characterBuildConfigs } from '../../../../../../data/horizon-walker/builds/character-build-configs.js';
import {
  HW_ZH_NAMES,
  HW_ZH_SKILLS,
  HW_ZH_INHERITANCE,
  HW_ZH_TRAIT_NAMES,
} from '../../../../../../data/horizon-walker/zh/game-text.js';
import { HW_ZH } from '../../../../../../data/horizon-walker/zh/ui.js';
import {
  CharacterImage,
  WeaponImage,
  StigmaImage,
  HWRarityIcon,
} from '../../../../../../components/horizon-walker/index.astro';
import SkillIcon from '../../../../../../components/horizon-walker/SkillIcon.astro';

export const prerender = true;

const SHEET_URL =
  'https://docs.google.com/spreadsheets/d/e/2PACX-1vQkHJLorAevtaAd3nEcXTZKD4L_8HfGEHmEOPKoUztaDujZxTLhR3-wBnL2UBJ9CgbxIRXsPl2a0SoT/pubhtml';

export function getStaticPaths() {
  return Object.keys(COMMUNITY_BUILDS).map((slug) => ({
    params: { buildSlug: slug },
  }));
}

const { buildSlug } = Astro.params;
const communityBuild = COMMUNITY_BUILDS[buildSlug];
const character = HORIZON_WALKER_CHARACTERS.find((c) => c.slug === buildSlug);

if (!communityBuild || !character) {
  return Astro.redirect(`${HW_ZH.baseUrl}builds/community/`);
}

// Full per-character data (weapon art, skill icons) lives in the individual
// data modules; the characters.js index record does not carry them.
const charDataModules = import.meta.glob('/src/data/horizon-walker/characters/*.js', {
  eager: true,
});
let characterDetail = null;
for (const [path, mod] of Object.entries(charDataModules)) {
  if (path.split('/').pop()?.replace('.js', '') !== buildSlug) continue;
  characterDetail = Object.values(mod).find((v) => v && typeof v === 'object' && v.name && v.skills);
  break;
}

const zhName = HW_ZH_NAMES[character.id] || character.name;
const weaponNameZh = HW_ZH_INHERITANCE[communityBuild.weaponName]?.name || null;
const hasHandBuild = Boolean(characterBuildConfigs[buildSlug]);

// community skill names ("Skill 2: Theater Control") -> character skill record
const decodeEntities = (s) =>
  String(s ?? '')
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>');
const norm = (s) =>
  decodeEntities(s)
    .toLowerCase()
    .replace(/[^a-z0-9]/g, '');
const skillsByName = new Map();
for (const skill of Object.values(characterDetail?.skills ?? {})) {
  if (skill?.name) skillsByName.set(norm(skill.name), skill);
}
const skillForPriority = (label) => {
  const bare = decodeEntities(label).replace(/^(Skill \d+|Passive(?: \d+)?|Basic Attack):\s*/i, '');
  return skillsByName.get(norm(bare)) || null;
};
// "Skill 2: Theater Control" -> 技能 2：剧场支配 (official ZH when known)
const skillLineZh = (label) => {
  const m = decodeEntities(label).match(/^(Skill \d+|Passive(?: \d+)?|Basic Attack):\s*(.+)$/i);
  const kindZh = (kind) =>
    kind.startsWith('Skill')
      ? `技能 ${kind.replace(/\D/g, '')}`
      : kind.startsWith('Passive')
        ? `被动${kind.replace(/\D/g, '') ? ` ${kind.replace(/\D/g, '')}` : ''}`
        : '普通攻击';
  if (!m) return { text: decodeEntities(label), en: decodeEntities(label) };
  const skill = skillForPriority(label);
  const zhSkillName = skill?.gameKey ? HW_ZH_SKILLS[skill.gameKey]?.name : null;
  const name = zhSkillName || m[2];
  return { text: `${kindZh(m[1])}：${name}`, en: zhSkillName ? m[2] : null };
};

// Stigma set art: only some sets have art on R2 (mirrors the EN component map)
const STIGMA_ALIASES = {
  thethousandmileweaver: 'The Thousand Mile Weave',
  thebrilianttouchofearth: 'The Brilliant Touch of Earth',
  thethornyheart: 'Thorned Heart',
  theblacksmithgodsblessing: 'The Blacksmith Blessing',
  theknightofsevenpetals: 'The Knight of the Seven Petals',
  thefourhorseman: 'The Four Horsemen',
};
const STIGMA_ART = {
  jestersmask: 'JesterEX.jpg',
  reckoningofsin: 'Reckoning_of_SinEX.jpg',
  jupiter: 'JupiterEX.jpg',
  harmony: 'HarmonyEX.jpg',
  phantombanquet: 'Phantom_BanquetEX.jpg',
  theeternalbattle: 'The_Eternal_BattleEX.jpg',
  thewindthatwanderstheworld: 'The_Wind_that_Wanders_the_WorldEX.jpg',
  thethousandmileweave: 'The_Thousand_Mile_WeaveEX.jpg',
  thenoblestactics: "The_Noble's_TacticsSS.jpg",
  theshipoftheseus: 'The_Ship_of_TheseusSS.jpg',
  thornedheart: 'Thorned_HeartSS.jpg',
  theblacksmithblessing: 'The_BlackSmith_BlessingSS.jpg',
  thebrillianttouchofearth: 'The_Brilliant_Touch_of_EarthEX.jpg',
};
const stigmaArtFor = (name) => {
  const cleaned = decodeEntities(name)
    .replace(/\([^)]*\)/g, '')
    .replace(/\[[^\]]*\]/g, '');
  const key = norm(cleaned);
  if (key.startsWith('mix')) return null;
  const canonical = STIGMA_ALIASES[key] || cleaned;
  return STIGMA_ART[norm(canonical)] || null;
};

// community set labels ("Late Game 1", "Early-Mid Game") in Chinese
const setLabelZh = (label) =>
  label
    .replace(/Late Game/g, '后期')
    .replace(/Early-Mid Game/g, '前中期')
    .replace(/Late Build/g, '后期');

const traitZh = (name) => HW_ZH_TRAIT_NAMES[name] || name;

const coreStats = [
  { label: '力量', value: character.stats?.strength },
  { label: '技巧', value: character.stats?.technic },
  { label: '智力', value: character.stats?.intelligence },
  { label: '体质', value: character.stats?.vitality },
  { label: '敏捷', value: character.stats?.agility },
];
---

<HwZhLayout
  title={`${zhName} 社区配装 - 地平线行者中文维基 - GachaWiki`}
  description={`地平线行者 ${zhName}（${character.name}）的社区配装：推荐武器、圣痕套装、副属性优先级、特性选择与技能升级顺序，整理自社区配装表格。`}
  keywords={[zhName, character.name, '地平线行者', '社区配装', '配装']}
  pageTitle={`${zhName} 社区配装`}
  breadcrumbItems={[
    { name: '首页', href: '/' },
    { name: '地平线行者', href: HW_ZH.baseUrl },
    { name: '配装推荐', href: `${HW_ZH.baseUrl}builds/` },
    { name: '社区配装', href: `${HW_ZH.baseUrl}builds/community/` },
    { name: zhName },
  ]}
>
  <div class="character-build-header">
    <div class="character-build-image">
      <CharacterImage
        imageName={character.image || character.name}
        alt={zhName}
        width={120}
        height={120}
        class="character-build-portrait"
        loading="eager"
      />
    </div>
    <div class="character-build-info">
      <h2 class="character-build-name">{zhName} 社区配装</h2>
      <p class="zh-cbu-en">{character.name} Community Build</p>
      <div class="character-build-badges">
        <span class="hw-badge" data-type="Cost">费用 {character.cost}</span>
        <HWRarityIcon rarity={character.rarity} width={44} height={22} />
        <span class="character-tag damage-scaling">社区配装</span>
      </div>
      <div class="character-build-links">
        <a href={`${HW_ZH.baseUrl}characters/${character.slug}/`}>角色页面</a>
        {hasHandBuild && <a href={`${HW_ZH.baseUrl}builds/${character.slug}/`}>手动精选配装</a>}
      </div>
    </div>
  </div>

  <section class="content-section community-build-section">
    <h3 class="section-title">社区配装</h3>
    <p class="community-build-credit">
      以下推荐整理自 Envy、Liauw 与 Gamekee 的社区配装表格，
      <a href={SHEET_URL} target="_blank" rel="noopener noreferrer">查看完整表格</a>。表格中的圣痕套装名称与数值保留英文原文。
    </p>

    <div class="community-build-grid">
      {
        (communityBuild.weaponName || communityBuild.weaponStats || communityBuild.subStats) && (
          <div class="community-build-card">
            <h4 class="community-build-card-title">武器</h4>
            <div class="community-weapon-row">
              {characterDetail?.weapon?.image && (
                <div class="community-weapon-image-box">
                  <WeaponImage
                    imageName={characterDetail.weapon.image}
                    alt={communityBuild.weaponName}
                    width={72}
                    height={72}
                    class="community-weapon-image"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="community-weapon-info">
                {communityBuild.weaponName && (
                  <p class="community-weapon-name">
                    {weaponNameZh || communityBuild.weaponName}
                    {weaponNameZh && <span class="zh-cbu-weapon-en">{communityBuild.weaponName}</span>}
                  </p>
                )}
                {communityBuild.weaponStats && <p class="community-stat-line">{communityBuild.weaponStats}</p>}
                {communityBuild.subStats && <p class="community-stat-line">{communityBuild.subStats}</p>}
              </div>
            </div>
          </div>
        )
      }

      {
        communityBuild.substatsPriority && (
          <div class="community-build-card">
            <h4 class="community-build-card-title">副属性优先级</h4>
            <ol class="community-substats-list">
              {communityBuild.substatsPriority
                .split('\n')
                .map((line) => line.trim())
                .filter(Boolean)
                .map((line) => (
                  <li>{line.replace(/^\d+\.\s*/, '')}</li>
                ))}
            </ol>
          </div>
        )
      }

      {
        communityBuild.stigmaSets?.length > 0 && (
          <div class="community-build-card community-build-card-wide">
            <h4 class="community-build-card-title">圣痕</h4>
            <div class="community-stigma-sets">
              {communityBuild.stigmaSets.map((set) => {
                const art = stigmaArtFor(set.name);
                return (
                  <div class="community-stigma-set">
                    <div class="community-stigma-header">
                      {art && (
                        <StigmaImage imageName={art} alt={`${set.name} 圣痕图`} width={44} height={44} class="community-stigma-image" loading="lazy" />
                      )}
                      <span class="community-set-label">{setLabelZh(set.label)}</span>
                      <span class="community-stigma-name">{set.name}</span>
                    </div>
                    {set.effects && (
                      <div class="community-stigma-effects">
                        {set.effects
                          .split('\n')
                          .map((line) => line.trim())
                          .filter(Boolean)
                          .map((line) =>
                            line.startsWith('- ') ? (
                              <p class="community-effect-line community-effect-sub">{line.slice(2)}</p>
                            ) : (
                              <p class="community-effect-line">{line}</p>
                            )
                          )}
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
          </div>
        )
      }

      {
        communityBuild.traitsToGet?.length > 0 && (
          <div class="community-build-card">
            <h4 class="community-build-card-title">推荐特性</h4>
            <ul class="community-traits-list">
              {communityBuild.traitsToGet.map((trait) => (
                <li class="community-trait-item">
                  <span class="community-trait-name">
                    {traitZh(trait.name)}
                    {traitZh(trait.name) !== trait.name && <span class="zh-cbu-trait-en">{trait.name}</span>}
                  </span>
                  <span class="community-trait-effect">{trait.effect}</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        communityBuild.skillPriority?.length > 0 && (
          <div class="community-build-card">
            <h4 class="community-build-card-title">技能升级顺序</h4>
            <ol class="community-skill-priority">
              {communityBuild.skillPriority.map((p) => {
                const skill = skillForPriority(p.name);
                const line = skillLineZh(p.name);
                return (
                  <li class="community-priority-item">
                    <span class="community-priority-rank">{p.priority}</span>
                    {skill?.icon && <SkillIcon iconName={skill.icon} />}
                    <span class="community-priority-name">
                      {line.text}
                      {line.en && <span class="zh-cbu-skill-en">{line.en}</span>}
                    </span>
                  </li>
                );
              })}
            </ol>
          </div>
        )
      }
    </div>
  </section>

  <section class="character-build-section">
    <h3 class="character-build-section-title">核心属性</h3>
    <div class="core-stats-explanation">
      <div class="stat-explanation-grid">
        <span><span class="stat-name">力量：</span><span class="stat-description">提升近战攻击力</span></span>
        <span><span class="stat-name">技巧：</span><span class="stat-description">提升射击攻击力</span></span>
        <span><span class="stat-name">智力：</span><span class="stat-description">提升魔法攻击力</span></span>
        <span><span class="stat-name">体质：</span><span class="stat-description">提升最大生命值</span></span>
        <span><span class="stat-name">敏捷：</span><span class="stat-description">提升回避与行动恢复力</span></span>
      </div>
    </div>
    <div class="core-stats-grid">
      {
        coreStats.map((s) => (
          <div class="core-stat-card">
            <div class="core-stat-title">{s.label}</div>
            <div class="core-stat-value">{s.value ?? '无数据'}</div>
          </div>
        ))
      }
    </div>
  </section>
</HwZhLayout>

<style>
  /* ZH-only gloss lines without an EN equivalent */
  .zh-cbu-en {
    color: var(--hw-text-very-muted);
    font-size: var(--text-md);
    margin: 0.1rem 0 0.6rem 0;
  }

  .zh-cbu-weapon-en {
    color: var(--hw-text-very-muted);
    font-size: var(--text-xs);
    font-weight: 400;
    margin-left: 0.4rem;
  }

  .zh-cbu-trait-en {
    color: var(--hw-text-very-muted);
    font-size: var(--text-xs);
    font-weight: 400;
    margin-left: 0.35rem;
  }

  .zh-cbu-skill-en {
    color: var(--hw-text-very-muted);
    font-size: var(--text-xs);
    font-weight: 400;
    margin-left: 0.35rem;
  }
</style>
