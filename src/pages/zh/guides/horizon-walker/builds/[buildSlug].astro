        <div class="stigma-container">
          <div class="recommended-substats">
            <h5>副属性推荐</h5>
            {
              buildConfig.substatBuilds ? (
                <div class="substat-builds">
                  {substatBuildsZh.map((b) => (
                    <div class="substat-build-card">
                      <div class="substat-build-name">{b.name}</div>
                      {b.note && <div class="substat-build-note">{b.note}</div>}
                      <div class="substats-list">
                        {b.stats.map((stat) => (
                          <div class="substat-item">
                            <div class="substat-info">
                              <div class="substat-name">{statZh(stat.stat)}</div>
                              <span
                                class="hw-badge"
                                data-type={stat.priority === 'Highest' ? 'Main' : 'Alt'}
                              >
                                {PRIORITY_ZH[stat.priority] || stat.priority}
                              </span>
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              ) : (
                <div class="substats-list">
                  {buildConfig.recommendedSubstats.map((substat, index) => (
                    <div
                      class={`substat-item ${index < 3 ? 'priority-best' : index === 3 ? 'priority-alternative' : 'priority-optional'}`}
                    >
                      <div class="substat-info">
                        <div class="substat-name">{statZh(substat.stat)}</div>
                        <div class="substat-priority">{PRIORITY_ZH[substat.priority] || substat.priority}</div>
                      </div>
                      <div class="substat-scale">{substat.scale}</div>
                    </div>
                  ))}
                </div>
              )
            }
            <div class="substats-note">
              <strong>优先级：</strong>{prose.substatsPriority}
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- Alternative Build Strategies Section -->
  {
    altBuildsZh.length > 0 && (
      <section class="character-build-section">
        <h3 class="character-build-section-title">备选配装思路</h3>
        <div class="alternative-builds-container">
          <div class="alternative-builds-grid">
            {altBuildsZh.map((b) => (
              <div class="alternative-build-card">
                <div class="alternative-build-header">
                  <h4 class="alternative-build-title">{b.title}</h4>
                  {b.recommendedStigma && (
                    <div class="alternative-build-stigma">
                      <div class="stigma-image-container">
                        <StigmaImage imageName={b.recommendedStigma} alt={`${b.recommendedStigma} 圣痕`} width={64} height={64} class="stigma-portrait-medium" loading="eager" />
                      </div>
                      <div class="stigma-info">
                        <div class="stigma-label">推荐圣痕</div>
                        <div class="stigma-name">{b.recommendedStigma}</div>
                      </div>
                    </div>
                  )}
                </div>
                <div class="alternative-build-content">
                  <p class="alternative-build-description">{b.description}</p>

                  {b.playstyle && (
                    <div class="alternative-build-playstyle">
                      <h5>玩法思路</h5>
                      <p>{b.playstyle}</p>
                    </div>
                  )}

                  {b.substatsFocus && (
                    <div class="alternative-build-substats">
                      <h5>副属性优先级</h5>
                      <p>{b.substatsFocus}</p>
                    </div>
                  )}

                  {b.note && (
                    <div class="alternative-build-note">
                      <h5>特性配装说明</h5>
                      <p>{b.note}</p>
                    </div>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Recommended Traits Section -->
  <section class="character-build-section">
    <h3 class="character-build-section-title">推荐特性</h3>
    <div class="recommended-traits">
      {buildConfig.traitBuilds ? (
        <div class="trait-builds">
          {buildConfig.traitBuilds.map((tb) => (
            <div class="trait-build-block">
              <h5 class="trait-build-title">{prose.traitBuildNames?.[tb.name] || tb.name}</h5>
              <div class="traits-list">
                {tb.traits.map((trait) => (
                  <div class="trait-item">
                    <div class="trait-info">
                      <div class="trait-name">
                        {traitZh(trait.name)}
                        <span class="zh-cb-trait-en">{trait.name}</span>
                      </div>
                    </div>
                    <div class="trait-effects">
                      {trait.effects.map((effect) => (
                        <div class="trait-effect">{effectZh(effect)}</div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <>
          <h5>{traitsTypeZh} 的最佳特性（最多 {buildConfig.traitsMax || 5} 条）</h5>
          <div class="traits-list">
            {buildConfig.recommendedTraits.map((trait) => (
              <div class={`trait-item ${trait.priority === 'Best' ? 'priority-best' : 'priority-alternative'}`}>
                <div class="trait-info">
                  <div class="trait-name">
                    {traitZh(trait.name)}
                    <span class="zh-cb-trait-en">{trait.name}</span>
                    <span
                      class="hw-badge"
                      data-type={trait.priority === 'Best' ? 'Main' : 'Alt'}
                    >
                      {trait.priority === 'Best' ? '主推' : '备选'}
                    </span>
                  </div>
                </div>
                <div class="trait-effects">
                  {trait.effects.map((effect) => (
                    <div class="trait-effect">{effectZh(effect)}</div>
                  ))}
                </div>
              </div>
            ))}
          </div>
          {buildConfig.traitRecommendation && (
            <div class="traits-note">
              <strong>推荐选择：</strong>{prose.traitRecommendation || buildConfig.traitRecommendation}
            </div>
          )}
        </>
      )}
    </div>
  </section>
</HwZhLayout>

<style>
  /* ZH-only elements without an EN equivalent: the EN gloss line + quick links */
  .zh-cb-en {
    color: var(--hw-text-very-muted);
    font-size: var(--text-md);
    margin: 0.1rem 0 0.6rem 0;
  }

  .zh-cb-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.7rem;
  }

  .zh-cb-links a {
    color: var(--hw-primary-warm);
    font-size: var(--text-md);
    font-weight: 600;
    text-decoration: none;
    border: 1px solid rgba(232, 165, 71, 0.35);
    border-radius: 8px;
    padding: 0.35rem 0.8rem;
  }

  .zh-cb-trait-en {
    color: var(--hw-text-very-muted);
    font-size: var(--text-xs);
    font-weight: 400;
    margin-left: 0.35rem;
  }
</style>
