---
// Chinese landing page for the Horizon Walker wiki: /zh/guides/horizon-walker/
// Reuses the EN landing's classes (hw-about-section / hw-resources-section from
// hw-landing-page.css) so the look is identical; labels are Chinese and the
// resource grid mirrors the EN categoryGroups with /zh/ URLs. Intro copy is
// written for this wiki; game terms (人神/护卫/次元裂缝/圣痕/特性) are the
// game's own official Simplified Chinese wording.
import HwZhLayout from '../../../layouts/zh/HwZhLayout.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import DiscordPromo from '../../../components/DiscordPromo.astro';
import GameLanguageLinks from '../../../components/GameLanguageLinks.astro';
import HWGuideIcon from '../../../components/horizon-walker/HWGuideIcon.astro';
import { horizonWalkerConfig } from '../../../data/horizon-walker/horizon-walker.js';
import { HW_ZH } from '../../../data/horizon-walker/zh/ui.js';

const { gameInfo } = horizonWalkerConfig;
const hasPlatforms = gameInfo.platforms && gameInfo.platforms.length > 0;

// Chinese titles for the EN guide ids (icons resolve by id, links go to /zh/)
const GUIDE_ZH = {
  characters: '角色资料库',
  'tier-list': '排行榜',
  builds: '配装推荐',
  'community-builds': '社区配装',
  mercenaries: '佣兵',
  weapons: '武器',
  stigmas: '圣痕',
  'ap-guide': '行动力指南',
  traits: '特性',
  demi: '半神晋升',
  'stigma-sub-stats': '圣痕副属性',
  'story-gallery': '剧情画廊',
  gifts: '礼物',
  'character-gifts': '角色礼物偏好',
  clock: '时钟',
  'redeem-codes': '兑换码',
  banners: '卡池时间线',
  'patch-notes': '更新公告',
};

const GROUP_ZH = {
  characters: { title: '角色', description: '角色资料库、配装、武器与圣痕' },
  'game-mechanics': { title: '游戏机制', description: '行动力、特性、半神晋升与圣痕副属性' },
  resources: { title: '资源', description: '剧情画廊、礼物、时钟、兑换码与更新公告' },
};

const zhUrl = (id, enUrl) =>
  id === 'clock' ? enUrl : enUrl.replace('/guides/horizon-walker/', HW_ZH.baseUrl);

const categoryGroups = horizonWalkerConfig.categoryGroups.map(g => ({
  ...g,
  title: GROUP_ZH[g.id]?.title || g.title,
  description: GROUP_ZH[g.id]?.description || g.description,
  guides: g.guides.map(gd => ({
    ...gd,
    title: GUIDE_ZH[gd.id] || gd.title,
    url: zhUrl(gd.id, gd.url),
  })),
}));
---

<HwZhLayout
  title="地平线行者（Horizon Walker）中文维基 - 角色资料、技能、排行榜 - GachaWiki"
  description="地平线行者中文维基：全部角色官方中文技能与属性、武器、圣痕、排行榜、卡池时间线与更新公告。游戏文本均取自游戏官方简体中文。"
  keywords={['地平线行者', 'Horizon Walker', '中文', 'wiki', '攻略', '角色', '技能', '排行榜']}
  heroTitle={HW_ZH.gameName}
  ambientVideo="/videos/horizon-walker-hero.mp4"
  breadcrumbItems={[{ name: '首页', href: '/' }, { name: '地平线行者' }]}
>
  <!-- Game Overview Section (EN classes, Chinese labels) -->
  <section class="content-section hw-about-section">
    <h2 class="section-title">游戏简介</h2>
    <div class="hw-about-content">
      <div class="hw-about-text">
        <div class="game-description">
          <p>
            《地平线行者》是一款末世题材的收集型 RPG。次元裂缝涌现的怪物终结了人类的黄金时代，跨越死亡、获得神之权能的人神与护卫们，在裂缝之上为夺回世界而战。
          </p>
          <p>
            玩家将扮演人神，招募护卫编成队伍，挑战回合制战斗：利用地形、行动力与技能连锁击败强敌，并通过礼物提升好感度、收集皮肤与剧情 CG。
          </p>
          <p>{HW_ZH.labels.dataFromGame}</p>
        </div>

        <!-- Play Game Platforms -->
        {
          hasPlatforms && (
            <div class="platforms-container">
              <h3>游玩平台：</h3>
              <div class="platform-notes">
                <ul>
                  <li>• Google Play：和谐版</li>
                  <li>• One Store：无和谐（将迁移至 Steam）</li>
                  <li>• Ero-Labs：无和谐（不迁移至 Steam）</li>
                  <li>• Steam：无和谐版</li>
                </ul>
              </div>
              <div class="platforms-grid">
                {gameInfo.platforms.map(platform => (
                  <a
                    href={platform.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="platform-button"
                    aria-label={`在 ${platform.name} 游玩地平线行者`}
                  >
                    {platform.name}
                  </a>
                ))}
              </div>
            </div>
          )
        }

        <!-- Social Links -->
        {
          gameInfo.socialLinks && (
            <div class="hw-social-links-container">
              <h4>官方社区：</h4>
              <div class="hw-social-links">
                {gameInfo.socialLinks.twitter && (
                  <a
                    href={gameInfo.socialLinks.twitter}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hw-social-link"
                    aria-label="地平线行者官方 X/Twitter"
                  >
                    X/Twitter
                  </a>
                )}
                {gameInfo.socialLinks.discord && (
                  <a
                    href={gameInfo.socialLinks.discord}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hw-social-link"
                    aria-label="地平线行者官方 Discord"
                  >
                    Discord
                  </a>
                )}
                {gameInfo.socialLinks.youtube && (
                  <a
                    href={gameInfo.socialLinks.youtube}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hw-social-link"
                    aria-label="地平线行者官方 YouTube 频道"
                  >
                    YouTube
                  </a>
                )}
              </div>
            </div>
          )
        }

        <DiscordPromo accent="#e8a547" />

        <p class="last-updated">
          最后更新：<FormattedDate date={gameInfo.lastUpdated} />
        </p>
      </div>
    </div>
  </section>

  <!-- Resources Section (same grid/cards as EN, Chinese labels) -->
  <section class="hw-resources-section">
    <h2 class="hw-resources-title">内容导航</h2>

    <div class="hw-resources-grid">
      {
        categoryGroups.map(category => {
          return (
            <div class={`hw-resource-category hw-category-${category.size}`}>
              <div class="hw-category-header">
                <h3>{category.title}</h3>
                <p class="hw-category-description">{category.description}</p>
              </div>
              <div class="hw-buttons-grid">
                {category.guides.map(guide => (
                  <a
                    href={guide.url}
                    class="hw-resource-button"
                    aria-label={`前往${guide.title}`}
                  >
                    <HWGuideIcon guideId={guide.id} alt={guide.title} class="hw-guide-icon" />
                    <span class="hw-guide-label">{guide.title}</span>
                  </a>
                ))}
              </div>
            </div>
          );
        })
      }
    </div>
  </section>

  <!-- Other language wikis -->
  <GameLanguageLinks gameKey="horizon-walker" currentHref={HW_ZH.baseUrl} />
</HwZhLayout>
