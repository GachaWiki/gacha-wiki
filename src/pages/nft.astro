---
// GachaWiki OGs — NFT collection page with an embedded mint widget
// (mint directly on this page via Robinhood Wallet / MetaMask on Robinhood Chain;
// art + metadata are served from Cloudflare Pages and show instantly — no reveal phase)
import HomeLayout from '../layouts/HomeLayout.astro';
import { SITE_TITLE } from '../consts';

const gallery = ['nft-001','nft-042','nft-077','nft-100','nft-150','nft-200','nft-256','nft-500','nft-777'];

const stats = [
  { k: '1,000', v: 'Total supply' },
  { k: '≈$2', v: 'Mint price · ETH or $GW' },
  { k: 'Robinhood', v: 'Chain (L2)' },
  { k: 'ERC-721', v: 'Standard' },
];
---

<HomeLayout
  title={`${SITE_TITLE} OGs — NFT Collection`}
  description="GachaWiki OGs — a 1,000-piece generative NFT collection on Robinhood Chain. Each OG is a unique hand-drawn mascot with a motivational verse (EN + 日本語) and kaomoji. Mint directly on this page."
  keywords={['GachaWiki', 'NFT', 'Robinhood Chain', 'mint', 'collectibles', 'gacha']}
>
  <div class="nft-page">
    <!-- Ambient background video (Seven Mortal Sins NCED) — full-bleed top, fades out by mid-page -->
    <div class="bg-video-wrap" aria-hidden="true">
      <video class="bg-video" autoplay muted loop playsinline preload="auto">
        <source src="/videos/sins-nced.mp4" type="video/mp4" />
      </video>
    </div>

    <!-- HERO -->
    <section class="hero">
      <div class="hero-copy">
        <span class="eyebrow">◆ NFT Collection</span>
        <h1 class="hero-title">GachaWiki <span class="accent">OGs</span></h1>
        <p class="hero-sub">
          1,000 unique collectibles on <strong>Robinhood Chain</strong>. Each OG is the hand-drawn
          GachaWiki mascot carrying its own motivational verse in English &amp; 日本語 — plus a kaomoji.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href="#mint">Mint an OG — ~$2</a>
          <a class="btn btn-ghost" href="#gallery">See the collection</a>
          <a class="btn btn-ghost" href="https://opensea.io/collection/gachawiki-ogs" target="_blank" rel="noopener noreferrer">View on OpenSea ↗</a>
        </div>
        <p class="contract-line">
          Contract:
          <a href="https://robinhoodchain.blockscout.com/address/0x9C0f41ce4F8e72F866CC79Acd80386472c53B40B" target="_blank" rel="noopener noreferrer">0x9C0f…B40B</a>
          (ERC-721 · verified on Blockscout · art on Cloudflare)
        </p>
      </div>
      <div class="hero-art">
        <img src="/images/nft/hero.png" alt="GachaWiki OGs sample NFT" width="512" height="512" loading="eager" />
      </div>
    </section>

    <!-- MINT (directly on this page — pay with ETH or $GW, same wallet as the header) -->
    <section class="mint" id="mint">
      <div class="mint-card">
        <p class="mint-label">◆ Mint an OG</p>

        <div class="pay-cards" id="payCards">
          <button type="button" class="pay-card active" data-pay="eth">
            <span class="pay-name">ETH</span>
            <span class="pay-unit" id="unitEth">… ETH</span>
            <span class="pay-note">per OG</span>
          </button>
          <button type="button" class="pay-card" data-pay="gw">
            <span class="pay-name">$GW</span>
            <span class="pay-unit" id="unitGw">… GW</span>
            <span class="pay-note">per OG · burned</span>
          </button>
        </div>

        <div class="mint-row">
          <div class="qty" id="qtyBox">
            <button type="button" id="qtyMinus" aria-label="Mint one fewer">−</button>
            <span id="qtyVal">1</span>
            <button type="button" id="qtyPlus" aria-label="Mint one more">+</button>
          </div>
          <button type="button" class="btn btn-primary btn-mint" id="mintBtn">Connect Wallet</button>
        </div>

        <p class="mint-total" id="mintTotal">…</p>
        <p class="mint-balance" id="mintBalance" hidden></p>
        <p class="mint-left" id="mintLeft" hidden></p>
        <p class="mint-status">5 per wallet · $GW spent on minting is burned forever</p>
        <p class="mint-marketplace">Collection on <a href="https://opensea.io/collection/gachawiki-ogs" target="_blank" rel="noopener noreferrer">OpenSea ↗</a></p>
        <p class="minted-count" id="mintedCount">…</p>
        <p class="mint-msg" id="mintMsg" hidden></p>
      </div>
    </section>

    <script>
      // Embedded mint widget — mints GWOG on Robinhood Chain through the SAME
      // Reown AppKit wallet stack the header button uses (src/scripts/wallet.ts):
      // one session, one wallet-picker modal, synced across the page. Pays in
      // ETH or $GW; $GW payments are burned (sent to 0x…dEaD by the contract).
      const CONTRACT = '0x9C0f41ce4F8e72F866CC79Acd80386472c53B40B';
      const GW_TOKEN = '0x50bE7832849EFEdB15611799074FcC409522f27A';
      const RPC_URL = 'https://rpc.mainnet.chain.robinhood.com';
      const EXPLORER = 'https://robinhoodchain.blockscout.com';
      const OPENSEA = 'https://opensea.io/collection/gachawiki-ogs';
      // function selectors (keccak of the signatures)
      const SEL = {
        mint: '0xa0712d68', // mint(uint256)
        gwMint: '0x4329f368', // gwMint(uint256)
        mintPrice: '0x6817c76c',
        gwMintPrice: '0xacc14738',
        maxPerWallet: '0x453c2310',
        mintedPerWallet: '0x3a602b4d', // mintedPerWallet(address)
        totalSupply: '0x18160ddd',
        paused: '0x5c975abb',
        ownerOf: '0x6352211e', // ownerOf(uint256) — for the "your collection" scan
        approve: '0x095ea7b3', // approve(address,uint256) — called on GW_TOKEN
        allowance: '0xdd62ed3e', // allowance(address,address) — called on GW_TOKEN
        gwBalance: '0x70a08231', // balanceOf(address) — called on GW_TOKEN
      };
      const MAX_SUPPLY = 1000;

      const $ = (id) => document.getElementById(id);
      const btn = $('mintBtn');
      const msg = $('mintMsg');
      const qtyVal = $('qtyVal');

      let account = null;
      let payMode = 'eth'; // 'eth' | 'gw'
      let priceWei = 1065000000000000n; // on-chain value replaces this at load
      let gwPriceWei = 360000n * 10n ** 18n; // on-chain value replaces this at load
      let maxPerWallet = 5;
      let minted = 0; // this wallet's minted count
      let qty = 1;
      let busy = false;
      let usdPerEth = 0; // fetched once for the total's USD hint (0 = unknown)
      let ethBalWei = null; // connected wallet's balances (null = not loaded yet)
      let gwBalWei = null;

      const say = (text, isError = false) => {
        msg.hidden = !text;
        msg.textContent = text || '';
        msg.classList.toggle('mint-err', isError);
      };
      const link = (url, label) => {
        msg.hidden = false;
        msg.appendChild(document.createElement('br'));
        const a = document.createElement('a');
        a.href = url; a.target = '_blank'; a.rel = 'noopener noreferrer'; a.textContent = label;
        msg.appendChild(a);
      };
      const fmtEth = (wei) => Number(wei) / 1e18;
      const fmtGw = (wei) => (Number(wei) / 1e18).toLocaleString();
      const word = (n) => BigInt(n).toString(16).padStart(64, '0');
      const addrArg = (a) => a.toLowerCase().replace('0x', '').padStart(64, '0');

      // ── shared wallet stack (lazy — same policy as the header button) ──
      let walletMod = null;
      let kit = null;
      async function loadWallet() {
        if (!walletMod) {
          walletMod = await import('../scripts/wallet');
          kit = await walletMod.getAppKit();
          // stay in sync with the header button's connect/disconnect/switch
          walletMod.onWalletChange((s) => {
            const next = s.isConnected ? s.address : null;
            if (next !== account) {
              account = next;
              minted = 0;
              if (account) void onAccount(); else onDisconnect();
            }
          });
        }
        return walletMod;
      }
      const getProvider = () => kit && kit.getProvider ? kit.getProvider('eip155') : null;

      // ── read-only chain calls via public RPC ─────────────────────────
      const call = async (data, to = CONTRACT) => {
        const r = await fetch(RPC_URL, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ jsonrpc: '2.0', id: 1, method: 'eth_call', params: [{ to, data }, 'latest'] }),
        }).then((x) => x.json());
        if (r.error) throw new Error(r.error.message);
        return r.result;
      };
      const hexToBig = (hex) => (hex && hex !== '0x' ? BigInt(hex) : 0n);

      async function refreshSupply() {
        try {
          const n = hexToBig(await call(SEL.totalSupply));
          $('mintedCount').textContent = `${n.toLocaleString()} / 1,000 minted`;
          if (n >= MAX_SUPPLY) {
            btn.disabled = true;
            btn.textContent = 'Sold out';
          }
          return n;
        } catch { $('mintedCount').textContent = ''; }
      }

      // ── price cards + qty-aware total ────────────────────────────────
      function updatePrices() {
        $('unitEth').textContent = `${fmtEth(priceWei)} ETH`;
        $('unitGw').textContent = `${fmtGw(gwPriceWei)} $GW`;
        updateTotal();
      }
      function updateTotal() {
        const times = qty > 1 ? ` (${qty} × ${payMode === 'eth' ? fmtEth(priceWei) : fmtGw(gwPriceWei)})` : '';
        if (payMode === 'eth') {
          const t = fmtEth(priceWei * BigInt(qty));
          const usdTxt = usdPerEth > 0 ? ` ≈ $${(t * usdPerEth).toFixed(2)}` : '';
          $('mintTotal').textContent = `Total — ${t} ETH${usdTxt}${times}`;
        } else {
          $('mintTotal').textContent = `Total — ${fmtGw(gwPriceWei * BigInt(qty))} $GW${times}`;
        }
        refreshButton();
      }
      const label = () => {
        if (!account) { btn.textContent = 'Connect Wallet'; return; }
        const n = `Mint ${qty} OG${qty > 1 ? 's' : ''} · `;
        btn.textContent = payMode === 'eth'
          ? n + `${fmtEth(priceWei * BigInt(qty))} ETH`
          : n + `${fmtGw(gwPriceWei * BigInt(qty))} $GW`;
      };

      async function loadConfig() {
        try {
          const [p, g, w, pausedHex] = await Promise.all([
            call(SEL.mintPrice), call(SEL.gwMintPrice), call(SEL.maxPerWallet), call(SEL.paused),
          ]);
          if (hexToBig(p) > 0n) priceWei = hexToBig(p);
          if (hexToBig(g) > 0n) gwPriceWei = hexToBig(g);
          maxPerWallet = Number(hexToBig(w));
          updatePrices();
          if (hexToBig(pausedHex) === 1n) {
            btn.disabled = true;
            btn.textContent = 'Minting paused';
            say('Minting is temporarily paused by the team. Check back soon.', true);
          }
        } catch { /* keep defaults */ }
        // USD hint for the ETH total (best-effort)
        fetch('https://api.coinbase.com/v2/prices/ETH-USD/spot')
          .then((x) => x.json())
          .then((j) => { usdPerEth = parseFloat(j.data.amount) || 0; updateTotal(); })
          .catch(() => {});
      }

      async function loadWalletCount() {
        if (!account) return;
        try {
          minted = Number(hexToBig(await call(SEL.mintedPerWallet + addrArg(account))));
          clampQty();
        } catch { /* ignore */ }
      }

      async function loadBalances() {
        if (!account) return;
        try {
          const [ethRes, gwHex] = await Promise.all([
            fetch(RPC_URL, {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ jsonrpc: '2.0', id: 1, method: 'eth_getBalance', params: [account, 'latest'] }),
            }).then((x) => x.json()),
            call(SEL.gwBalance + addrArg(account), GW_TOKEN),
          ]);
          ethBalWei = hexToBig(ethRes.result);
          gwBalWei = hexToBig(gwHex);
          const bal = $('mintBalance');
          bal.hidden = false;
          bal.textContent = `Your balance — ${(Number(ethBalWei) / 1e18).toFixed(4)} ETH · ${(Number(gwBalWei) / 1e18).toLocaleString()} $GW`;
          clampQty(); // affordability may have changed
        } catch { /* keep hidden */ }
      }

      // how many more the wallet can actually pay for in the selected currency
      // (ETH side keeps ~5% headroom for gas; Infinity while balances are unknown)
      const affordable = () => {
        if (!account) return Infinity;
        if (payMode === 'eth') return ethBalWei === null ? Infinity : Number((ethBalWei * 95n) / 100n / priceWei);
        return gwBalWei === null ? Infinity : Number(gwBalWei / gwPriceWei);
      };

      function clampQty() {
        const room = Math.max(0, maxPerWallet - minted);
        const aff = affordable();
        const cap = Math.max(1, Math.min(room, Number.isFinite(aff) ? aff : room));
        qty = Math.min(Math.max(1, qty), cap);
        qtyVal.textContent = String(qty);
        updateTotal();
        updateMintedLine();
      }

      function updateMintedLine() {
        const el = $('mintLeft');
        if (!account) { el.hidden = true; return; }
        const room = Math.max(0, maxPerWallet - minted);
        const aff = affordable();
        let t = `Minted ${minted}/${maxPerWallet} — ${room} left this wallet`;
        if (Number.isFinite(aff) && aff < room) {
          t += aff > 0 ? ` · balance covers ${aff}` : ' · balance too low';
        }
        if (payMode === 'gw' && ethBalWei === 0n) t += ' · needs a little ETH for gas';
        el.hidden = false;
        el.textContent = t;
      }

      // single source of truth for the mint button's enabled/label state
      function refreshButton() {
        if (btn.textContent === 'Sold out' || btn.textContent === 'Minting paused') return;
        if (!account) { btn.disabled = false; btn.textContent = 'Connect Wallet'; return; }
        if (minted >= maxPerWallet) {
          btn.disabled = true;
          btn.textContent = `You minted ${minted}/${maxPerWallet}`;
          return;
        }
        const aff = affordable();
        if (aff === 0) {
          btn.disabled = true;
          btn.textContent = payMode === 'eth' ? 'Not enough ETH' : 'Not enough $GW';
          return;
        }
        btn.disabled = false;
        label();
      }

      async function onAccount() {
        btn.disabled = false;
        await Promise.all([loadWalletCount(), loadBalances(), loadYourOgs()]);
      }
      function onDisconnect() {
        btn.disabled = false;
        ethBalWei = null;
        gwBalWei = null;
        $('mintBalance').hidden = true;
        $('mintLeft').hidden = true;
        $('yourSub').textContent = 'Connect your wallet to see your OGs.';
        $('yourGrid').innerHTML = '';
        clampQty();
      }

      // ── your collection — tokens owned by the connected wallet ───────
      async function loadYourOgs() {
        const sub = $('yourSub');
        const grid = $('yourGrid');
        if (!account) return;
        sub.textContent = 'Scanning for your OGs…';
        grid.innerHTML = '';
        try {
          const supply = Number(hexToBig(await call(SEL.totalSupply)));
          if (supply === 0) {
            sub.textContent = 'No OGs minted yet — yours could be #000.';
            return;
          }
          // batch ownerOf calls (50 per JSON-RPC batch) instead of N requests
          const owned = [];
          const CHUNK = 50;
          for (let i = 0; i < supply; i += CHUNK) {
            const chunk = Array.from({ length: Math.min(CHUNK, supply - i) }, (_, j) => i + j);
            const res = await fetch(RPC_URL, {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify(chunk.map((id, j) => ({
                jsonrpc: '2.0', id: j, method: 'eth_call',
                params: [{ to: CONTRACT, data: SEL.ownerOf + word(id) }, 'latest'],
              }))),
            }).then((x) => x.json());
            if (!Array.isArray(res)) throw new Error('batch rpc unsupported');
            for (const r of res) {
              if (r.result && r.result.length >= 66) {
                const a = '0x' + r.result.slice(26).toLowerCase();
                if (a === account.toLowerCase()) owned.push(chunk[r.id]);
              }
            }
          }
          owned.sort((a, b) => a - b);
          sub.textContent = owned.length > 0
            ? `You hold ${owned.length} OG${owned.length > 1 ? 's' : ''}`
            : 'You do not hold any OGs yet — mint one above.';
          for (const id of owned) {
            const a = document.createElement('a');
            a.className = 'your-tile';
            a.href = `https://gachawiki-ogs.pages.dev/images/${id}.png`;
            a.target = '_blank';
            a.rel = 'noopener noreferrer';
            const img = document.createElement('img');
            img.src = `https://gachawiki-ogs.pages.dev/images/${id}.png`;
            img.alt = `OG #${String(id).padStart(3, '0')}`;
            img.loading = 'lazy';
            img.width = 512; img.height = 512;
            const cap = document.createElement('span');
            cap.textContent = `#${String(id).padStart(3, '0')}`;
            a.appendChild(img);
            a.appendChild(cap);
            grid.appendChild(a);
          }
        } catch {
          sub.textContent = 'Could not load your collection right now.';
        }
      }

      // ── mint ─────────────────────────────────────────────────────────
      async function connectFlow() {
        const m = await loadWallet();
        let addr = m.getConnectedAddress();
        if (!addr) {
          // A restored session can lag a beat behind AppKit init on a fresh
          // page load. Wait briefly before deciding the user isn't connected —
          // otherwise we pop a modal right as the session restores and AppKit
          // shows the account view (fund/swap/send) instead of the wallet picker.
          addr = await new Promise((resolve) => {
            const t0 = Date.now();
            const check = () => {
              const a = m.getConnectedAddress();
              if (a || Date.now() - t0 > 1500) resolve(a);
              else setTimeout(check, 100);
            };
            check();
          });
        }
        if (!addr) await m.openConnectModal();
        // if the user was already connected, or picks a wallet, the shared
        // onWalletChange subscription sets `account` and refreshes the card
        addr = m.getConnectedAddress();
        await m.ensureRobinhoodChain().catch(() => {});
        if (addr) { account = addr; await onAccount(); }
      }

      function mapError(e) {
        const m = (e && (e.message || e.data && e.data.message)) || '';
        if (e && e.code === 4001) return 'Transaction rejected in your wallet.';
        if (/Wrong network/i.test(m)) return m;
        if (/Mint not started/i.test(m)) return 'Mint is not open yet.';
        if (/Sold out/i.test(m)) return 'Sold out!';
        if (/Per-wallet limit/i.test(m)) return `Limit reached — ${maxPerWallet} per wallet.`;
        if (/Wrong ETH value/i.test(m)) return 'Wrong amount sent — reload the page and try again.';
        if (/GW mint disabled/i.test(m)) return '$GW minting is disabled right now.';
        if (/insufficient allowance/i.test(m)) return '$GW approval missing — try again.';
        if (/transfer amount exceeds balance/i.test(m)) return 'Not enough $GW in your wallet.';
        if (/insufficient funds/i.test(m)) return 'Not enough ETH in your wallet for this mint (or for gas).';
        if (/enforced paus/i.test(m)) return 'Minting is paused right now.';
        return m ? `Mint failed: ${m}` : 'Mint failed — please try again.';
      }

      async function waitForTx(hash) {
        for (let i = 0; i < 90; i++) {
          const r = await fetch(RPC_URL, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ jsonrpc: '2.0', id: 1, method: 'eth_getTransactionReceipt', params: [hash] }),
          }).then((x) => x.json());
          if (r.result && r.result.status !== null) return r.result.status === '0x1';
          await new Promise((res) => setTimeout(res, 4000));
        }
        return null;
      }

      async function doMint() {
        if (busy) return;
        if (!account) {
          busy = true;
          try { await connectFlow(); }
          finally { busy = false; }
          // Connected → continue straight into the mint. The guard must be
          // released first: the old code recursed while `busy` was still true,
          // so the very first click after connecting silently did nothing.
          if (account) return doMint();
          return;
        }
        const m = await loadWallet();
        busy = true;
        btn.disabled = true;
        say('');
        try {
          await m.ensureRobinhoodChain().catch(() => {});
          const provider = getProvider();
          if (!provider) throw new Error('Wallet is not connected.');
          // Network guard (fail-open): a tx signed on the wrong chain never
          // shows up here and waitForTx polls as "pending" forever — so bail
          // ONLY on a definitive non-Robinhood chain id. An inconclusive check
          // (request failed / exotic provider shape — seen with WalletConnect
          // relays) must never block a connected user; getActiveChainId
          // returns null for that and we proceed.
          const netId = await m.getActiveChainId();
          if (netId !== null && netId !== 4663) {
            throw new Error('Wrong network — switch your wallet to Robinhood Chain and try again.');
          }
          const sendTx = (params) => provider.request({ method: 'eth_sendTransaction', params: [params] });
          let txHash;
          if (payMode === 'eth') {
            btn.textContent = 'Confirm in wallet…';
            txHash = await sendTx({
              from: account,
              to: CONTRACT,
              value: '0x' + (priceWei * BigInt(qty)).toString(16),
              data: SEL.mint + word(qty),
            });
          } else {
            // $GW: approve the exact amount if the allowance is short, then mint
            const need = gwPriceWei * BigInt(qty);
            const allowed = hexToBig(await call(SEL.allowance + addrArg(account) + addrArg(CONTRACT), GW_TOKEN));
            if (allowed < need) {
              btn.textContent = 'Approve $GW…';
              const ah = await sendTx({ from: account, to: GW_TOKEN, data: SEL.approve + addrArg(CONTRACT) + word(need) });
              say('Approval sent — the mint follows automatically once it confirms…');
              link(`${EXPLORER}/tx/${ah}`, 'View approval ↗');
              const aok = await waitForTx(ah);
              if (aok !== true) throw new Error('Approval did not confirm — nothing was minted.');
            }
            btn.textContent = 'Confirm in wallet…';
            txHash = await sendTx({ from: account, to: CONTRACT, data: SEL.gwMint + word(qty) });
          }
          btn.textContent = 'Confirming…';
          say('Transaction sent — confirming on chain…');
          link(`${EXPLORER}/tx/${txHash}`, 'View transaction ↗');
          const ok = await waitForTx(txHash);
          if (ok === true) {
            btn.textContent = 'Minted!';
            say(payMode === 'gw'
              ? `Minted ${qty} OG${qty > 1 ? 's' : ''} — ${fmtGw(gwPriceWei * BigInt(qty))} $GW burned`
              : `Minted ${qty} OG${qty > 1 ? 's' : ''} — your art is live now`);
            link(`${EXPLORER}/tx/${txHash}`, 'View transaction ↗');
            link(OPENSEA, 'View collection on OpenSea ↗');
            link('https://discord.gg/YdWFddQKR8', 'Unlock holder perks on Discord ↗');
            await Promise.all([refreshSupply(), loadWalletCount(), loadBalances(), loadYourOgs()]);
          } else if (ok === false) {
            say('Transaction reverted on chain. Nothing was minted.', true);
          } else {
            say('Still confirming… check your wallet or the transaction link above.');
          }
        } catch (e) {
          say(mapError(e), true);
        } finally {
          busy = false;
          refreshButton();
        }
      }

      // ── wire up ───────────────────────────────────────────────────────
      btn.addEventListener('click', doMint);
      $('qtyMinus').addEventListener('click', () => { qty--; clampQty(); });
      $('qtyPlus').addEventListener('click', () => { qty++; clampQty(); });
      document.querySelectorAll('#payCards .pay-card').forEach((el) => {
        el.addEventListener('click', () => {
          payMode = el.dataset.pay;
          document.querySelectorAll('#payCards .pay-card').forEach((x) => x.classList.toggle('active', x === el));
          clampQty(); // affordability differs between ETH and $GW
        });
      });

      // Restore an existing wallet session on first interaction — same
      // lazy-load policy as the header WalletButton, so the two never disagree
      // and the heavy wallet bundle never loads for people who just look.
      let warmed = false;
      const warm = () => {
        if (warmed) return;
        warmed = true;
        loadWallet().then((m) => {
          const a = m.getConnectedAddress();
          if (a) { account = a; void onAccount(); }
        }).catch(() => {});
      };
      ['pointerdown', 'keydown', 'touchstart'].forEach((e) =>
        document.addEventListener(e, warm, { capture: true, once: true }));

      clampQty();
      updatePrices();
      loadConfig();
      refreshSupply();
      setInterval(refreshSupply, 15000);
    </script>

