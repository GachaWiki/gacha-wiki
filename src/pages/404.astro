---
// Global 404 page: Cloudflare Pages serves this file with HTTP 404 for any unmatched route.
import { SITE_TITLE } from '../consts';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Page Not Found | {SITE_TITLE}</title>
    <meta
      name="description"
      content="The page you are looking for does not exist on GachaWiki. Browse our gacha game guides, character databases, tier lists, and server reset clocks instead."
    />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  </head>
  <body>
    <main class="nf-wrap">
      <p class="nf-code">404</p>
      <h1 class="nf-title">Page not found</h1>
      <p class="nf-text">The page you are looking for does not exist or has moved.</p>
      <div class="nf-links">
        <a class="nf-btn nf-btn-solid" href="/">Home</a>
        <a class="nf-btn nf-btn-ghost" href="/guides/">Game Guides</a>
        <a class="nf-btn nf-btn-ghost" href="/clock/">Reset Clocks</a>
      </div>
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    min-height: 100vh;
    background-color: #1a1a1a;
    color: #ffffff;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
    line-height: 1.6;
  }

  .nf-wrap {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem 1.25rem;
    box-sizing: border-box;
  }

  .nf-code {
    margin: 0;
    font-size: clamp(4.5rem, 16vw, 7.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.14);
    user-select: none;
  }

  .nf-title {
    margin: 0.75rem 0 0;
    font-size: clamp(var(--text-2xl), 5vw, var(--text-4xl));
    font-weight: 700;
  }

  .nf-text {
    margin: 0.5rem 0 0;
    max-width: 34rem;
    color: rgba(255, 255, 255, 0.65);
  }

  .nf-links {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  .nf-btn {
    display: inline-block;
    padding: 0.625rem 1.25rem;
    border-radius: 10px;
    font-weight: 600;
    font-size: var(--text-body);
    text-decoration: none;
  }

  .nf-btn-solid {
    background-color: #ffffff;
    color: #1a1a1a;
  }

  .nf-btn-ghost {
    background-color: rgba(255, 255, 255, 0.04);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.09);
  }

  .nf-btn:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
  }
</style>
