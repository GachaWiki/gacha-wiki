---
// TCG Shop page: the full Weiss Schwarz catalog (English + Japanese) as one
// uniform tile grid, with English/Japanese tabs like the card database.
// Curated shop items keep their direct Amazon product buttons; every other
// set gets a tagged Amazon search button.
import AboutLayout from '../layouts/AboutLayout.astro';
import { SITE_TITLE } from '../consts';
import { SHOP_ITEMS } from '../data/shop-items.js';
import { shopLink } from '../data/shop.js';
import { WS_CARD_SETS } from '../data/ws-cards/index.js';
import '../styles/pages/shop.css';

const title = `${SITE_TITLE} Shop: Weiss Schwarz Sets for Gacha Games`;
const description =
  'Where to buy Weiss Schwarz booster boxes, trial decks and special sets for gacha games like NIKKE and Blue Archive. Buying through our Amazon links supports the wiki at no extra cost to you.';
const keywords = [
  'weiss schwarz shop',
  'gacha tcg',
  'weiss schwarz booster box',
  'weiss schwarz nikke',
  'weiss schwarz blue archive',
  'tcg shop',
];

const metaByShopItem = new Map(WS_CARD_SETS.map((s) => [s.shopItem, s]));

function setBuy(s: (typeof WS_CARD_SETS)[number]) {
  const jp = s.lang === 'jp';
  const base = jp ? 'https://www.amazon.co.jp/s?k=' : 'https://www.amazon.com/s?k=';
  return {
    url: shopLink({ url: `${base}${encodeURIComponent(`weiss schwarz ${s.name}`)}` }),
    store: jp ? 'Search on Amazon Japan' : 'Search on Amazon',
    note: jp ? 'Amazon.co.jp search results' : 'Amazon.com search results',
  };
}

// One uniform tile list: curated shop items first (direct Amazon product
// buttons, curated art), then every remaining set from the registry.
const shopItemIds = new Set(SHOP_ITEMS.map((i) => i.id));
const tiles = [
  ...SHOP_ITEMS.map((item) => {
    const meta = metaByShopItem.get(item.id);
    const link = item.links.find((l) => l.store.toLowerCase().includes('amazon'));
    return {
      id: item.id,
      name: item.name,
      lang: 'en',
      image: item.image,
      count: meta?.count ?? 0,
      search: `${item.name} ${item.franchise}`.toLowerCase(),
      buy: link
        ? { url: shopLink(link), store: 'View on Amazon', note: link.note || 'Amazon product page' }
        : setBuy({ ...meta, name: item.name, lang: 'en' }),
      extraLink: item.wikiGame ? { label: 'Wiki guide', href: `/guides/${item.wikiGame}/` } : null,
    };
  }),
  ...WS_CARD_SETS.filter((s) => !shopItemIds.has(s.id)).map((s) => ({
    id: s.id,
    name: s.name,
    lang: s.lang ?? 'en',
    image: s.box || s.sample || '',
    count: s.count,
    search: s.name.toLowerCase(),
    buy: setBuy(s),
    extraLink: null,
  })),
];
---

<AboutLayout title={title} description={description} keywords={keywords}>
  <div class="main-content">
    <header class="page-header">
      <h1 class="page-title">TCG Shop</h1>
    </header>

    <p class="shop-intro">
      Weiss Schwarz sets for the games and franchises our community loves. Buying through our
      Amazon links costs you nothing extra: Amazon pays the wiki a small commission instead.
    </p>

    <section class="shop-info" aria-label="About Weiss Schwarz">
      <h2 class="shop-info-title">New to Weiss Schwarz?</h2>
      <p>
        Weiss Schwarz is a Japanese trading card game from Bushiroad built around anime, manga and
        mobile game franchises. You build a deck using cards from a single title, then duel against
        decks from other titles, so your favorite characters can face off across franchises.
        Booster boxes are the collecting side, while Trial Decks are prebuilt and ready to play
        right out of the box.
      </p>
      <div class="shop-info-links">
        <a
          class="shop-info-link"
          href="https://en.ws-tcg.com/"
          target="_blank"
          rel="noopener noreferrer nofollow"
        >
          Weiss Schwarz official site (English)
        </a>
        <a
          class="shop-info-link"
          href="https://ws-tcg.com/"
          target="_blank"
          rel="noopener noreferrer nofollow"
        >
          Official site (Japanese)
        </a>
      </div>
    </section>

    <div class="shop-lang-tabs" role="tablist" aria-label="Shop language">
      <button class="shop-lang-tab is-active" role="tab" aria-selected="true" data-lang="en" type="button">
        English
      </button>
      <button class="shop-lang-tab" role="tab" aria-selected="false" data-lang="jp" type="button">
        Japanese
      </button>
    </div>

    <div class="shop-toolbar">
      <input
        id="shop-search"
        class="shop-input"
        type="search"
        placeholder="Search sets..."
        aria-label="Search sets"
      />
      <button id="shop-clear" class="shop-clear" type="button">Clear</button>
      <span id="shop-count" class="shop-count" aria-live="polite"></span>
    </div>

    <div class="shop-more-grid" id="shop-list">
      {
        tiles.map((t) => (
          <div class="shop-tile" id={t.id} aria-label={t.name} data-lang={t.lang} data-search={t.search}>
            <div class="shop-tile-media">
              {t.image && <img src={t.image} alt={t.name} loading="lazy" draggable="false" />}
            </div>
            <span class="shop-tile-name">{t.name}</span>
            <span class="shop-tile-meta">
              {t.count > 0 && <span class="shop-chip">{`${t.count} cards`}</span>}
            </span>
            <a
              class="shop-btn shop-btn-primary shop-tile-btn"
              href={t.buy.url}
              target="_blank"
              rel="noopener noreferrer nofollow sponsored"
            >
              <span class="shop-btn-store">{t.buy.store}</span>
              <span class="shop-btn-note">{t.buy.note}</span>
            </a>
            <div class="shop-tile-links">
              <a class="shop-set-official" href={`/cards/${t.id}/`}>
                Card database
              </a>
              {t.extraLink && (
                <a class="shop-set-official" href={t.extraLink.href}>
                  {t.extraLink.label}
                </a>
              )}
            </div>
          </div>
        ))
      }
    </div>

    <p class="shop-no-results" id="shop-no-results" hidden>No sets match those filters.</p>

    <p class="shop-fineprint">As an Amazon Associate, GachaWiki earns from qualifying purchases.</p>
  </div>
</AboutLayout>

<script>
  // Client-side filtering for the shop tile grid (site convention: everything
  // is server-rendered, visibility toggles via data attributes) plus the
  // English/Japanese tabs.
  const search = document.getElementById('shop-search') as HTMLInputElement;
  const clear = document.getElementById('shop-clear') as HTMLButtonElement;
  const count = document.getElementById('shop-count');
  const noResults = document.getElementById('shop-no-results');
  const items = Array.from(document.querySelectorAll<HTMLElement>('#shop-list .shop-tile'));
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.shop-lang-tab'));
  let lang = 'en';

  function apply(): void {
    const q = search.value.trim().toLowerCase();
    let visible = 0;
    for (const el of items) {
      const show = el.dataset.lang === lang && (!q || el.dataset.search?.includes(q));
      el.style.display = show ? '' : 'none';
      if (show) visible++;
    }
    if (count) count.textContent = `${visible} sets`;
    if (noResults) noResults.hidden = visible > 0;
  }

  search.addEventListener('input', apply);
  for (const tab of tabs) {
    tab.addEventListener('click', () => {
      lang = tab.dataset.lang || 'en';
      for (const t2 of tabs) {
        t2.classList.toggle('is-active', t2 === tab);
        t2.setAttribute('aria-selected', t2 === tab ? 'true' : 'false');
      }
      apply();
    });
  }
  clear.addEventListener('click', () => {
    search.value = '';
    apply();
  });
  apply();
</script>



