---
// Per-agent detail page for Agent X.
import AgentXLayout from '../../../../layouts/agent-x/LandingLayout.astro';
import AgentXCharacterImage from '../../../../components/agent-x/AgentXCharacterImage.astro';
import AgentXAssetImage from '../../../../components/agent-x/AgentXAssetImage.astro';
import { agentXCharacters } from '../../../../data/agent-x/characters.js';
import { axBuffs } from '../../../../data/agent-x/buffs.js';
import '../../../../styles/games/agent-x/agentx-common.css';
import '../../../../styles/games/agent-x/agentx-characters.css';

// Every agent ships a skill cut-in head on the R2 bucket (skills/<id>_H.webp).
const skillFiles = new Set(agentXCharacters.map(c => `${c.id}_H.png`));

export function getStaticPaths() {
  return agentXCharacters.map(char => ({
    params: { slug: char.slug },
    props: { character: char },
  }));
}

const { character: char } = Astro.props;
const roleCss = (char.role || '').toLowerCase();
const elemCss = (char.element || '').toLowerCase();

// Game icon assets (extracted from the FairyGUI CommonPackage atlases).
const ELEM_ICON = { Fire: 'elem_fire.png', Wood: 'elem_wood.png', Water: 'elem_water.png', Light: 'elem_light.png', Dark: 'elem_dark.png' };
const ELEM_LORE = { Fire: 'Inferno', Wood: 'Gale', Water: 'Glacier', Light: 'Sanction', Dark: 'Void' };
const ROLE_ICON = { Defender: 'role_defender.png', Fighter: 'role_fighter.png', Caster: 'role_caster.png', Support: 'role_support.png', Ranger: 'role_ranger.png' };
const RARITY_BADGE = { SSR: 'rarity_ssr.png', SR: 'rarity_sr.png' };
const SKILL_ICON = { Normal: 'skill_type_atk.png', Ultimate: 'skill_type_anger.png', Active: 'skill_type_active.png', Passive: 'skill_type_passive.png' };
const BUFF_BY_NAME = Object.fromEntries(axBuffs.map(b => [b.name, b]));

const cutinHead = `${char.id}_H.png`;
const hasSkillArt = skillFiles.has(cutinHead);
---

<AgentXLayout
  title={`${char.name} - Agent X Agent`}
  description={`${char.name} (${char.title}) agent guide for Agent X. ${char.rarity} ${char.element} ${char.role} with verified base stats, skills, profile and lore.`}
  gameTitle={char.name}
>
  <section class="ax-content-section">
    <div class="ax-detail-header">
      <div class="ax-detail-art-wrap">
        <AgentXCharacterImage
          filename={char.art || char.icon}
          alt={char.name}
          class="ax-detail-art"
          loading="eager"
        />
        <AgentXCharacterImage
          filename={char.icon}
          alt={`${char.name} icon`}
          class="ax-detail-icon"
        />
      </div>
      <div class="ax-detail-info">
        <h1>{char.name}</h1>
        {char.title && <p class="ax-detail-title">"{char.title}"</p>}
        <div class="ax-icon-row">
          {RARITY_BADGE[char.rarity] && (
            <AgentXAssetImage filename={RARITY_BADGE[char.rarity]} alt={char.rarity} title={char.rarity} class="ax-icon-rarity-lg" />
          )}
          {ELEM_ICON[char.element] && (
            <AgentXAssetImage filename={ELEM_ICON[char.element]} alt={char.element} title={`${ELEM_LORE[char.element] || char.element} (${char.element})`} class="ax-icon-lg" />
          )}
          {ROLE_ICON[char.role] && (
            <AgentXAssetImage filename={ROLE_ICON[char.role]} alt={char.role} title={char.role} class="ax-icon-lg" />
          )}
          <span class="ax-icon-caption">{ELEM_LORE[char.element] || char.element} · {char.role}{!char.playable && ' · Upcoming'}</span>
        </div>
        <div class="ax-id-line">ID {char.id}</div>
        <div class="ax-profile">
          {char.affiliation && (
            <div class="ax-profile-item"><strong>Affiliation</strong>{char.affiliation}</div>
          )}
          {char.birthday && (
            <div class="ax-profile-item"><strong>Birthday</strong>{char.birthday}</div>
          )}
          {char.measurements && (
            <div class="ax-profile-item"><strong>B/W/H</strong>{char.measurements}</div>
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="ax-content-section">
    <div class="ax-detail-section">
      <h2>Stats</h2>
      <table class="ax-stat-table">
        <thead>
          <tr><th></th><th>ATK</th><th>DEF</th><th>HP</th><th>SPD</th></tr>
        </thead>
        <tbody>
          <tr>
            <td>Lv 1</td>
            <td>{char.lv1Stats.atk.toLocaleString()}</td>
            <td>{char.lv1Stats.def.toLocaleString()}</td>
            <td>{char.lv1Stats.hp.toLocaleString()}</td>
            <td>{char.lv1Stats.spd}</td>
          </tr>
          <tr>
            <td>Max (Lv 360)</td>
            <td>{char.maxStats.atk.toLocaleString()}</td>
            <td>{char.maxStats.def.toLocaleString()}</td>
            <td>{char.maxStats.hp.toLocaleString()}</td>
            <td>{char.maxStats.spd}</td>
          </tr>
          <tr>
            <td>Growth /1000·Lv</td>
            <td>{char.growthStats.atk.toLocaleString()}</td>
            <td>{char.growthStats.def.toLocaleString()}</td>
            <td>{char.growthStats.hp.toLocaleString()}</td>
            <td>Fixed</td>
          </tr>
        </tbody>
      </table>
      <p class="ax-stat-note">
        Stat = (Growth/1000) × (rarity × rank × star × 50·Lv × class weight/100 + Base + star flats),
        verified against the game's own display (Ilya Lv 300 matches exactly). Max assumes Lv 360 with
        max rank/star. SPD never scales.
      </p>
    </div>
  </section>

  {hasSkillArt && (
    <section class="ax-content-section">
      <div class="ax-detail-section">
        <h2>Skill Cut-in</h2>
        <div class="ax-skill-art-grid">
          {skillFiles.has(cutinHead) && (
            <figure class="ax-skill-art-figure">
              <AgentXAssetImage filename={cutinHead} alt={`${char.name} skill cut-in`} class="ax-skill-art-img head" />
              <figcaption>Skill cut-in</figcaption>
            </figure>
          )}
        </div>
      </div>
    </section>
  )}

  {char.skills.length > 0 && (
    <section class="ax-content-section">
      <div class="ax-detail-section">
        <h2>Skills</h2>
        {char.skills.map(skill => (
          <div class="ax-skill">
            <div class="ax-skill-header">
              {SKILL_ICON[skill.kind] && <AgentXAssetImage filename={SKILL_ICON[skill.kind]} alt="" class="ax-icon" />}
              <p class="ax-skill-name">{skill.name}</p>
              <span class="ax-skill-kind">{skill.kind}</span>
              <span class="ax-skill-id">#{skill.id}</span>
            </div>
            {skill.desc && <p class="ax-skill-desc">{skill.desc}</p>}
            {skill.buffs && skill.buffs.length > 0 && (
              <div class="ax-buff-chips">
                {skill.buffs.map(name => {
                  const b = BUFF_BY_NAME[name];
                  return (
                    <a class="ax-buff-chip" href="/guides/agent-x/stats/#buffs" title={b ? b.desc : name}>
                      {b && b.icon && <AgentXAssetImage filename={b.icon} alt="" class="ax-buff-chip-icon" />}
                      <span class={`ax-buff-dot ax-buff-${b ? b.kind.toLowerCase() : 'special'}`}></span>
                      {name}
                    </a>
                  );
                })}
              </div>
            )}
          </div>
        ))}
      </div>
    </section>
  )}

  {char.description && (
    <section class="ax-content-section">
      <div class="ax-detail-section">
        <h2>Lore</h2>
        <p class="ax-lore">{char.description}</p>
      </div>
    </section>
  )}
</AgentXLayout>
