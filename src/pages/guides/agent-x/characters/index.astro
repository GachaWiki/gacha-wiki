---
// Agent X agent database (grid of all registered agents).
import AgentXLayout from '../../../../layouts/agent-x/LandingLayout.astro';
import AgentXCharacterImage from '../../../../components/agent-x/AgentXCharacterImage.astro';
import AgentXAssetImage from '../../../../components/agent-x/AgentXAssetImage.astro';
import { agentXCharacters } from '../../../../data/agent-x/characters.js';
import '../../../../styles/games/agent-x/agentx-common.css';
import '../../../../styles/games/agent-x/agentx-characters.css';

// Game icon assets (extracted from the FairyGUI CommonPackage atlases).
const ELEM_ICON = { Fire: 'elem_fire.png', Wood: 'elem_wood.png', Water: 'elem_water.png', Light: 'elem_light.png', Dark: 'elem_dark.png' };
const ROLE_ICON = { Defender: 'role_defender.png', Fighter: 'role_fighter.png', Caster: 'role_caster.png', Support: 'role_support.png', Ranger: 'role_ranger.png' };
const RARITY_BADGE = { SSR: 'rarity_ssr.png', SR: 'rarity_sr.png' };

const characters = agentXCharacters;
const roles = ['Defender', 'Fighter', 'Caster', 'Support', 'Ranger'];
const elements = ['Fire', 'Wood', 'Water', 'Light', 'Dark'];
---

<AgentXLayout
  title="Agent Database"
  description={`Complete agent database for Agent X. Browse all ${characters.length} agents (SSR/SR) with element, role, verified stats, skills and lore.`}
  gameTitle="Agent Database"
>
  <section class="ax-content-section">
    <div class="ax-toolbar">
      <input type="text" class="ax-search" placeholder="Search agent name or title..." id="ax-search" />
      <button class="ax-filter-btn active" data-role="all" data-elem="all">All</button>
      {roles.map(r => (
        <button class="ax-filter-btn" data-role={r} data-elem="all">{r}</button>
      ))}
      {elements.map(e => (
        <button class="ax-filter-btn" data-role="all" data-elem={e}>{e}</button>
      ))}
      <span class="ax-count" id="ax-count">{characters.length} agents</span>
    </div>

    <div class="ax-char-grid" id="ax-char-grid">
      {characters.map(char => (
        <a
          href={`/guides/agent-x/characters/${char.slug}/`}
          class="ax-char-card"
          data-role={char.role}
          data-elem={char.element}
          data-name={char.name.toLowerCase()}
          data-title={(char.title || '').toLowerCase()}
        >
          <AgentXCharacterImage
            filename={char.art || char.icon}
            alt={char.name}
            class="ax-char-art"
          />
          <div class="ax-char-card-body">
            <p class="ax-char-name">{char.name}</p>
            {char.title && <p class="ax-char-title">{char.title}</p>}
            <div class="ax-char-meta">
              {RARITY_BADGE[char.rarity] && (
                <AgentXAssetImage filename={RARITY_BADGE[char.rarity]} alt={char.rarity} title={char.rarity} class="ax-icon-rarity" />
              )}
              {ELEM_ICON[char.element] && (
                <AgentXAssetImage filename={ELEM_ICON[char.element]} alt={char.element} title={char.element} class="ax-icon" />
              )}
              {ROLE_ICON[char.role] && (
                <AgentXAssetImage filename={ROLE_ICON[char.role]} alt={char.role} title={char.role} class="ax-icon" />
              )}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
</AgentXLayout>

<script>
  const search = document.getElementById('ax-search') as HTMLInputElement;
  const grid = document.getElementById('ax-char-grid');
  const countEl = document.getElementById('ax-count');
  const filterBtns = document.querySelectorAll('.ax-filter-btn');

  function updateDisplay() {
    if (!search || !grid) return;
    const query = search.value.toLowerCase();
    // Role and element pills stay active independently; read one of each.
    let activeRole = 'all';
    let activeElem = 'all';
    filterBtns.forEach(btn => {
      if (!btn.classList.contains('active')) return;
      if (btn.dataset.role !== 'all') activeRole = btn.dataset.role;
      if (btn.dataset.elem !== 'all') activeElem = btn.dataset.elem;
    });
    const cards = grid?.querySelectorAll('.ax-char-card') as NodeListOf<HTMLElement>;
    let visible = 0;

    cards?.forEach(card => {
      const name = card.dataset.name || '';
      const title = card.dataset.title || '';
      const role = card.dataset.role || '';
      const elem = card.dataset.elem || '';
      const matchesSearch = name.includes(query) || title.includes(query);
      const matchesRole = activeRole === 'all' || role === activeRole;
      const matchesElem = activeElem === 'all' || elem === activeElem;
      const show = matchesSearch && matchesRole && matchesElem;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    if (countEl) countEl.textContent = `${visible} agent${visible !== 1 ? 's' : ''}`;
  }

  search?.addEventListener('input', updateDisplay);

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const isReset = btn.dataset.role === 'all' && btn.dataset.elem === 'all';
      if (isReset) {
        // "All" resets both groups
        filterBtns.forEach(b => b.classList.toggle('active', b === btn));
      } else if (btn.dataset.role !== 'all') {
        // Role pill: clear other role pills + "All", keep any element pill
        filterBtns.forEach(b => {
          if (b.dataset.elem === 'all') b.classList.toggle('active', b === btn);
        });
      } else {
        // Element pill: clear other element pills + "All", keep any role pill
        filterBtns.forEach(b => {
          if (b.dataset.role === 'all') b.classList.toggle('active', b === btn);
        });
      }
      updateDisplay();
    });
  });
</script>
