---
// Agent X game overview landing page (standard wiki landing: hero banner, description,
// video, download row, resources, mirrors majo/star-savior structure).
import AgentXLayout from '../../../layouts/agent-x/LandingLayout.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import DiscordPromo from '../../../components/DiscordPromo.astro';
import { agentXCharacters } from '../../../data/agent-x/characters.js';
import { axMemoria } from '../../../data/agent-x/memoria.js';
import '../../../styles/games/agent-x/agentx-landing.css';


const R2 = 'https://pub-dd9a9c01bc7a43d0bb977b255815a5c4.r2.dev/agent-x/gameimg';
const R2_BANNER = `${R2}/gacha_standard.webp`;
const agents = agentXCharacters.length;
const memoriaCount = axMemoria.length;
---

<AgentXLayout
  title="Home"
  description="Agent X wiki, R18 spy-agency gacha RPG on EROLABS. Agent database, skills, gacha rates, and lore. Recruit P.R.I.S.M. agents and fight The Fallen."
  gameTitle="Agent X"
>
  <!-- Ambient background video (46s montage of 9 agent cut-ins, crossfaded), full-bleed top, fades out by mid-page -->
  <div class="ax-bg-video-wrap" aria-hidden="true">
    <video class="ax-bg-video" autoplay muted loop playsinline preload="auto">
      <source src="/videos/agent-x-cutin.mp4" type="video/mp4" />
    </video>
  </div>

  <section class="ax-content-section">
    <div class="ax-story">
      <p>
        Ten years after the Zero Point resonance birthed The Fallen, the intelligence agency
        <strong>P.R.I.S.M.</strong> makes its last stand in a city under martial law. You are the
        Commander, the rare Syncher whose resonance can drive an agent's power to 100%.
        Recruit agents from P.R.I.S.M. and The Fallen alike, raise bonds through their personal
        stories, and uncover what really happened at Ground Zero.
      </p>
      <p>
        <strong>Agent X</strong> is an R18 spy-agency gacha RPG on the EROLABS platform with a
        launch roster of {agents} agents across five elements and five combat roles, in
        turn-based squad combat.
      </p>
    </div>

    <div class="ax-download-row">
      <a
        class="ax-download-btn"
        href="https://game.erolabsshare.live/app/f302f717/Agent_X"
        target="_blank"
        rel="noopener noreferrer"
      >
        Download &amp; Play Agent X
        <span class="ax-download-arrow">→</span>
      </a>
    </div>

    <DiscordPromo accent="#d4a017" />

    <p class="ax-last-updated">
      Last Updated: <FormattedDate date={new Date('2026-08-17')} />
    </p>
  </section>

  <section class="ax-resources-section">
    <h2 class="ax-resources-title">Guides &amp; Resources</h2>

    <div class="ax-resources-grid">
      <div class="ax-resource-category">
        <div class="ax-category-header">
          <h3>Agents</h3>
          <p class="ax-category-description">
            All {agents} agents with rarity, element, role, verified stats, skills and lore, plus {memoriaCount} Memoria files.
          </p>
        </div>
        <div class="ax-buttons-grid">
          <a href="/guides/agent-x/characters/" class="ax-resource-button">Agent Database</a>
          <a href="/guides/agent-x/tier-list/" class="ax-resource-button">Tier List</a>
          <a href="/guides/agent-x/memories/" class="ax-resource-button">Memoria Database</a>
        </div>
      </div>

      <div class="ax-resource-category">
        <div class="ax-category-header">
          <h3>Gacha</h3>
          <p class="ax-category-description">
            Every recruitment pool with verified drop rates, pity rules and cost.
          </p>
        </div>
        <div class="ax-buttons-grid">
          <a href="/guides/agent-x/gacha/" class="ax-resource-button">Recruitment Rates</a>
        </div>
      </div>

      <div class="ax-resource-category">
        <div class="ax-category-header">
          <h3>Mechanics</h3>
          <p class="ax-category-description">
            Verified damage formula, element chart, stat growth, star-up and formation tables.
          </p>
        </div>
        <div class="ax-buttons-grid">
          <a href="/guides/agent-x/stats/" class="ax-resource-button">Stats &amp; Formulas</a>
        </div>
      </div>
    </div>
  </section>
</AgentXLayout>
