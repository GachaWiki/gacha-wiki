---
// Taimanin Squad art gallery: standing portraits for every released unit
// plus expression variants. Art is served from the R2 image CDN; the
// manifest supplies dimensions so bucketing works without local files.
import LandingLayout from '../../../layouts/taimanin-squad/LandingLayout.astro';
import { TAIMANIN_SQUAD_CHARACTERS } from '../../../data/taimanin-squad/characters.js';
import { RELEASED_UNIT_IDS } from '../../../data/taimanin-squad/released-units.js';
import { TS_EVENTS, getEventTypeLabel } from '../../../data/taimanin-squad/events.js';
import { TS_IMAGE_MANIFEST } from '../../../data/taimanin-squad/image-manifest.js';
import { r2Url } from '../../../data/r2-config.js';

import '../../../styles/games/taimanin-squad/ts-gallery.css';

const title = 'Gallery - Taimanin Squad | GachaWiki';
const description =
  'Taimanin Squad character art gallery: standing portraits and expression variants for every released character, extracted from the game.';
const gameTitle = 'Gallery';

const img = (rel) => r2Url('taimanin-squad', 'characterimage/' + rel);
const ALL = TS_IMAGE_MANIFEST.characterimage;

// story / event CGs and game banners live under their own R2 prefixes
const cgUrl = (key) => r2Url('taimanin-squad', 'storycg/' + key);
const bannerUrl = (key) => r2Url('taimanin-squad', 'banners/' + key);
const CGS = TS_IMAGE_MANIFEST.storycg || {};
const GAME_BANNERS = TS_IMAGE_MANIFEST.banners || {};
const natural = (a, b) => a.localeCompare(b, undefined, { numeric: true });
const cgName = (k) => k.replace(/\.webp$/, '');
const cgAll = Object.keys(CGS).sort(natural);
const eventCGs = cgAll.filter((k) => /^E\d/.test(cgName(k)));
const storyStills = cgAll.filter((k) => /^S\d/.test(cgName(k)));

const bannerKeys = Object.keys(GAME_BANNERS).sort(natural);
const bannerLabel = (k) => {
  const n = k.replace(/\.webp$/, '');
  if (n.startsWith('BN_Lo_')) {
    const parts = n.split('_'); // BN Lo S/L <id> <LOC>
    return `Login Bonus ${parts[3]} (${parts[4]})`;
  }
  if (n.startsWith('BN_St_')) {
    const parts = n.split('_'); // BN St S/L <id> <LOC>
    return `Store ${parts[3]} (${parts[4]})`;
  }
  if (n.startsWith('LobbyBanner_Portal')) return `Lobby Portal (${n.split('_').pop()})`;
  if (n.startsWith('Portal_Banner_L_Pickup_2_')) return `Portal Pickup 2 L (${n.split('_').pop()})`;
  if (n.startsWith('Portal_Banner_L_Pickup_')) return `Portal Pickup L (${n.split('_').pop()})`;
  if (n.startsWith('Portal_Banner_Pickup_2_')) return `Portal Pickup 2 (${n.split('_').pop()})`;
  if (n.startsWith('Portal_Banner_Pickup_')) return `Portal Pickup (${n.split('_').pop()})`;
  if (n.startsWith('BN_Evb')) return `Event Banner B ${n.split('_').pop()}`;
  if (n.startsWith('BN_Evc')) return `Event Banner C ${n.split('_').pop()}`;
  if (n.startsWith('BN_Evs')) return `Event Banner S ${n.split('_').pop()}`;
  if (n.startsWith('BN_Evtb_S_1')) return 'Event Tab 1';
  if (n.startsWith('BN_Evtb_S_2')) return 'Event Tab 2';
  if (n.startsWith('Banner_Action_L')) return 'Action Banner L';
  if (n.startsWith('Banner_Action_S')) return 'Action Banner S';
  return n.replace(/_/g, ' ');
};
// the wiki is English: for per-locale banners show the ENG and JPN art only
// (every locale variant is stored on R2 regardless)
const wantLocale = (k) => /(ENG|JPN)\.webp$/.test(k) || !/[A-Z]{3}\.webp$/.test(k);
const bannerGroups = [
  { title: 'In-Game Event Banners', keys: bannerKeys.filter((k) => /^BN_Ev|^Banner_Action/.test(k)) },
  { title: 'Login Bonus Banners', keys: bannerKeys.filter((k) => /^BN_Lo_L_/.test(k) && wantLocale(k)) },
  { title: 'Portal / Gacha Banners', keys: bannerKeys.filter((k) => /^(Portal_|LobbyBanner_Portal)/.test(k) && wantLocale(k)) },
  { title: 'Store Banners', keys: bannerKeys.filter((k) => /^BN_St_|^Shop_/.test(k) && wantLocale(k)) },
];

// group files by unit icon prefix ("259_Hebiko" catches "259_Hebiko.png" and
// hashed variants alike), bucketed by texture dimensions
const byUnit = {};
for (const rel of Object.keys(ALL)) {
  const file = rel.split('/')[1];
  const m = file.replace(/\.png$/, '').match(/^(\d+_[A-Za-z0-9]+)(?:_(.+))?$/);
  if (!m) continue;
  const unitKey = m[1];
  const [w, h] = ALL[rel];
  const entry = (byUnit[unitKey] ??= { big: [], expressions: [] });
  if ((w === 256 && (h === 512 || h === 256)) || (w === 512 && h === 2048)) {
    entry.big.push(rel);
  } else if (w === 128 && h === 128 && m[2]) {
    entry.expressions.push(rel);
  }
}

// art priority: bright 256x512 standing cut > full-body loading
// illustration (darker background) > 256x256 square crop
const artPriority = (rel) => {
  const [w, h] = ALL[rel];
  return h === 512 ? 3 : w === 512 && h === 2048 ? 2 : 1;
};
for (const entry of Object.values(byUnit)) {
  entry.big.sort((a, b) => artPriority(b) - artPriority(a));
}

const released = TAIMANIN_SQUAD_CHARACTERS.filter((c) => RELEASED_UNIT_IDS.has(c.id));

const standing = released
  .map((c) => ({ char: c, art: byUnit[c.icon]?.big[0] }))
  .filter((e) => e.art)
  .sort((a, b) => a.char.names?.english.localeCompare(b.char.names?.english));

const variants = released
  .map((c) => ({ char: c, imgs: byUnit[c.icon]?.expressions ?? [] }))
  .filter((e) => e.imgs.length > 0)
  .sort((a, b) => a.char.names?.english.localeCompare(b.char.names?.english));

// story/collab event banners, newest first; art from official news or the
// official X account (credited) where the news post predates images
const eventBanners = TS_EVENTS
  .filter((e) => (e.type === 'story' || e.type === 'collab') && e.image)
  .sort((a, b) => b.start.localeCompare(a.start));
---

<LandingLayout title={title} description={description} gameTitle={gameTitle}>
  <div class="ts-gal-container">
    <p class="ts-gal-intro">
      Character art extracted directly from the game client: standing portraits for every released unit,
      plus the expression variants shipped for selected characters. Click a portrait to open the character page.
      New units receive their standing art in a following patch, so the newest additions may appear as square crops at first.
    </p>

    <h2 class="ts-gal-section-title">Standing Art ({standing.length})</h2>
    <div class="ts-gal-grid">
      {
        standing.map(({ char, art }) => (
          <a class="ts-gal-cell" href={`/guides/taimanin-squad/characters/${char.slug}/`}>
            <div class="ts-gal-cell-img">
              <img src={img(art)} alt={char.names?.english || char.name} width="180" height="320" loading="lazy" decoding="async" />
            </div>
            <span class="ts-gal-cell-name">{char.names?.english || char.name}</span>
            <span class="ts-gal-cell-meta">
              {char.rarity_name}, {char.element}
            </span>
          </a>
        ))
      }
    </div>

    <h2 class="ts-gal-section-title">Event Banners ({eventBanners.length})</h2>
    <div class="ts-gal-events">
      {
        eventBanners.map((e) => (
          <a class="ts-gal-event-card" href="/guides/taimanin-squad/events/">
            <img src={e.image} alt={`${e.name} event banner`} loading="lazy" decoding="async" width={820} height={460} />
            <div class="ts-gal-event-info">
              <span class="ts-gal-event-name">{e.name}</span>
              <span class="ts-gal-event-meta">
                {getEventTypeLabel(e.type)} · {e.start}{e.end && ' - ' + e.end}{!e.end && ' onward'}
              </span>
              {e.imageSource && <span class="ts-gal-event-src">{e.imageSource.label}</span>}
            </div>
          </a>
        ))
      }
    </div>

    <h2 class="ts-gal-section-title">Story &amp; Event CGs ({cgAll.length})</h2>
    <p class="ts-gal-group-note">
      Scene stills from the in-game story player. E-numbered CGs are from the current event story; S-numbered stills are from the main story.
      Click to view the full-size image.
    </p>
    {eventCGs.length > 0 && (
      <>
        <h3 class="ts-gal-group-title">Event CGs ({eventCGs.length})</h3>
        <div class="ts-gal-cg-grid">
          {eventCGs.map((k) => {
            const [w, h] = CGS[k];
            return (
              <a class="ts-gal-cg-cell" href={cgUrl(k)} target="_blank" rel="noopener noreferrer">
                <div class="ts-gal-cg-img">
                  <img src={cgUrl(k)} alt={`Event CG ${cgName(k)}`} width={w} height={h} loading="lazy" decoding="async" />
                </div>
                <span class="ts-gal-cg-name">{cgName(k)}</span>
              </a>
            );
          })}
        </div>
      </>
    )}
    {storyStills.length > 0 && (
      <>
        <h3 class="ts-gal-group-title">Main Story Stills ({storyStills.length})</h3>
        <div class="ts-gal-cg-grid">
          {storyStills.map((k) => {
            const [w, h] = CGS[k];
            return (
              <a class="ts-gal-cg-cell" href={cgUrl(k)} target="_blank" rel="noopener noreferrer">
                <div class="ts-gal-cg-img">
                  <img src={cgUrl(k)} alt={`Story still ${cgName(k)}`} width={w} height={h} loading="lazy" decoding="async" />
                </div>
                <span class="ts-gal-cg-name">{cgName(k)}</span>
              </a>
            );
          })}
        </div>
      </>
    )}

    <h2 class="ts-gal-section-title">Game Banners ({bannerKeys.length})</h2>
    <p class="ts-gal-group-note">
      In-game event, login bonus, and gacha banners extracted from the client (all five language variants are stored;
      English and Japanese art is shown here). Click to view the full-size image.
    </p>
    {bannerGroups.map((g) => (
      <>
        {g.keys.length > 0 && (
          <>
            <h3 class="ts-gal-group-title">{g.title} ({g.keys.length})</h3>
            <div class="ts-gal-banner-grid">
              {g.keys.map((k) => {
                const [w, h] = GAME_BANNERS[k];
                return (
                  <a class="ts-gal-banner-cell" href={bannerUrl(k)} target="_blank" rel="noopener noreferrer">
                    <div class="ts-gal-banner-img">
                      <img src={bannerUrl(k)} alt={bannerLabel(k)} width={w} height={h} loading="lazy" decoding="async" />
                    </div>
                    <span class="ts-gal-cg-name">{bannerLabel(k)}</span>
                  </a>
                );
              })}
            </div>
          </>
        )}
      </>
    ))}

    <h2 class="ts-gal-section-title">Expression Variants</h2>
    <div class="ts-gal-grid">
      {
        variants.map(({ char, imgs }) => (
          <div class="ts-gal-variant-group">
            <span class="ts-gal-variant-head">{char.names?.english || char.name}</span>
            <div class="ts-gal-variant-row">
              {imgs.map((k) => (
                <img class="ts-gal-variant-img" src={img(k)} alt={`${char.names?.english || char.name} expression`} width="72" height="72" loading="lazy" decoding="async" />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</LandingLayout>
