---
// Import the dedicated rift teams layout
import RiftTeamsLayout from '../../../layouts/zone-nova/RiftTeamsLayout.astro';
import Breadcrumb from '../../../components/zone-nova/Breadcrumb.astro';
import { ZONE_NOVA_RIFT_TEAMS } from '../../../data/zone-nova/rift-teams.js';
import '../../../styles/games/zone-nova/zn-rift-teams.css';
import '../../../styles/games/zone-nova/zn-character.css';
---

<RiftTeamsLayout
  title="Zone Nova Rift Teams Database - GachaWiki"
  description="Specialized rift team compositions for Space-Time Rifts in Zone Nova - optimized teams for different rift levels and difficulties"
  gameTitle="Rift Teams Database"
>
  <!-- Breadcrumb Navigation -->
  <Breadcrumb
    items={[
      { name: 'Home', href: '/' },
      { name: 'Zone Nova', href: '/guides/zone-nova/' },
      { name: 'Rift Teams' },
    ]}
  />

  <section class="page-flex">
    <div class="main-content-container">
      <div class="content-wrapper">
        <!-- Community Contribution Notice -->
        <div
          style="text-align: center; margin: 1.5rem 0; padding: 1rem; background: linear-gradient(135deg, #e3f2fd 60%, #bbdefb 100%); border-radius: 12px; border: 1px solid #2196f3;"
        >
          <p style="color: #1565c0; margin: 0; font-size: var(--text-base); font-weight: 600;">
            Help Us Expand the Database!
          </p>
          <p style="color: #1976d2; margin: 0.5rem 0 0 0; font-size: var(--text-md); line-height: 1.4;">
            Please help us add more teams by joining our Discord and sending a message, or reach out
            via YouTube - either is fine! Your team compositions help other players succeed in
            rifts.
          </p>
        </div>

        <!-- Rift team database toolbar (zn-db card) -->
        <div class="zn-db-toolbar">
          <div class="zn-db-filter-row">
            <select class="zn-db-select" id="riftTypeFilter" aria-label="Filter by rift type">
              <option value="">All Rift Types</option>
              <option value="rift-xi">Rift XI</option>
              <option value="rift-x">Rift X</option>
              <option value="rift-ix">Rift IX</option>
              <option value="rift-viii">Rift VIII</option>
              <option value="rift-vii">Rift VII</option>
              <option value="rift-general">General Rift</option>
              <option value="rift-speedrun">Speedrun</option>
            </select>
            <select class="zn-db-select" id="riftTierFilter" aria-label="Filter by tier">
              <option value="">All Tiers</option>
              <option value="sss">SSS Teams</option>
              <option value="ss">SS Teams</option>
              <option value="s">S Teams</option>
              <option value="a">A Teams</option>
              <option value="situational">Situational Teams</option>
            </select>
          </div>
          <div class="zn-db-sort-row">
            <span class="zn-db-sort-label">Sort by:</span>
            <button type="button" class="zn-db-sort-btn active" data-sort="">Default</button>
            <button type="button" class="zn-db-sort-btn" data-sort="name">Name</button>
            <button type="button" class="zn-db-sort-btn" data-sort="type">Type</button>
            <button type="button" class="zn-db-sort-btn" data-sort="tier">Tier</button>
            <button type="button" class="zn-db-reset-btn" id="resetRiftFilters">Reset</button>
          </div>
          <div class="zn-db-search-row">
            <input
              type="text"
              id="riftSearch"
              placeholder="Search teams, characters, notes..."
              class="zn-db-search-input"
              aria-label="Search rift teams"
            />
            <span class="zn-db-count" id="rift-team-count">
              {ZONE_NOVA_RIFT_TEAMS.length} teams
            </span>
          </div>
        </div>

        <!-- Team sections (one per team, rendered by JavaScript) -->
        <div class="rift-team-list" id="riftTeamList"></div>
      </div>
    </div>
  </section>

  <!-- Import the rift team database utilities -->
  <script>
    import { initializeRiftTeamDatabase } from '../../../scripts/rift-teams/zone-nova-rift-teams.js';

    document.addEventListener('DOMContentLoaded', function () {
      initializeRiftTeamDatabase();
    });
  </script>
</RiftTeamsLayout>
