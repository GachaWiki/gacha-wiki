---
import CharacterIndividualLayout from '../../../../layouts/zone-nova/CharacterIndividualLayout.astro';
import CharacterPageTemplate from '../../../../templates/zone-nova/CharacterPageTemplate.astro';
import { milaData, milaSEO } from '../../../../data/zone-nova/characters/mila.js';

export const prerender = true;
---

<CharacterIndividualLayout
  title={milaSEO.title}
  description={milaSEO.description}
  gameTitle={milaData.name}
  character={milaData}
>
  <CharacterPageTemplate characterData={milaData} />
</CharacterIndividualLayout>
