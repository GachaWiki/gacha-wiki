---
import ZoneNovaLayout from '../../../layouts/zone-nova/LandingLayout.astro';
import { Image } from 'astro:assets';
import {
  RUNE_SET_LIST,
  MAIN_STATS_BY_POSITION,
} from '../../../data/zone-nova/runes.js';
import '../../../styles/games/zone-nova/zn-runes.css';

const R2 = 'https://img.gachawiki.info/zone-nova/runes';

const SUB_STATS = [
  { stat: 'Attack', forms: 'Flat number, percentage (%)' },
  { stat: 'HP', forms: 'Flat number, percentage (%)' },
  { stat: 'Defense', forms: 'Flat number, percentage (%)' },
  { stat: 'Critical Rate', forms: 'Percentage (%) only' },
  { stat: 'Critical Damage', forms: 'Percentage (%) only' },
  { stat: 'Penetration', forms: 'Flat number only' },
];
---

<ZoneNovaLayout
  title="Zone Nova Rune Guides - GachaWiki"
  description="Complete guide to all 14 rune sets, main stats by position, and sub stats for Zone Nova"
  gameTitle="Rune System Guide"
>
  <!-- Rune Sets -->
  <section class="zn-runes-section">
    <h2 class="section-title">Rune Sets</h2>
    <p class="section-description">
      All {RUNE_SET_LIST.length} rune sets with their 2-piece and 4-piece bonuses, straight from the game
      data.
    </p>

    <div class="rune-grid">
      {RUNE_SET_LIST.map(set => (
        <article class="rune-card">
          <div class="rune-head">
            <div class="rune-image-container">
              <Image
                src={`${R2}/${set.image}`}
                alt={`${set.name} Rune`}
                width={64}
                height={64}
                class="rune-image"
                loading="lazy"
              />
            </div>
            <div class="rune-head-text">
              <h3 class="rune-name">{set.name}</h3>
              <span class="rune-cn">{set.chineseName}</span>
              <span class="rune-tag">{set.tag}</span>
            </div>
          </div>
          <p class="rune-bonus"><strong>2-Piece:</strong> {set.twoPiece}</p>
          <p class="rune-bonus"><strong>4-Piece:</strong> {set.fourPiece}</p>
          {set.classRestriction && (
            <p class="rune-note class-restriction">Class restriction: {set.classRestriction}</p>
          )}
          {set.note && <p class="rune-note">{set.note}</p>}
        </article>
      ))}
    </div>
  </section>

  <!-- Main Stats by Position -->
  <section class="zn-runes-section">
    <h2 class="section-title">Main Stats by Position</h2>
    <p class="section-description">
      Main stat possibilities for each of the 6 rune positions
    </p>

    <div class="rune-grid positions-grid">
      {Object.entries(MAIN_STATS_BY_POSITION).map(([pos, info]) => (
        <article class="rune-card position-card">
          <h3 class="position-name">{info.name}</h3>
          {info.isFixed ? (
            <>
              <div class="fixed-stat">{info.stat}</div>
              <p class="position-hint">{info.description}</p>
            </>
          ) : (
            <>
              <h4 class="available-title">Available Main Stats:</h4>
              <ul class="stat-list">
                {info.availableStats.map(stat => (
                  <li class={stat === 'Attack Penetration (%)' ? 'highlight-stat' : ''}>{stat}</li>
                ))}
              </ul>
            </>
          )}
        </article>
      ))}

      <article class="rune-card position-card element-card">
        <h3 class="position-name">Position 5 — Element Damage</h3>
        <Image
          src={`${R2}/element.jpg`}
          alt="Element system guide"
          width={400}
          height={300}
          class="element-image"
          loading="eager"
        />
        <p class="element-order">Element Order: Wind → Fire → Ice → Holy → Chaos</p>
        <p class="position-hint">
          Choose elemental damage that matches your character's element for maximum effectiveness
        </p>
      </article>

      <article class="rune-card position-card summary-card">
        <h3 class="position-name">Summary</h3>
        <ul class="stat-list">
          <li><strong>Positions 1-3:</strong> Fixed main stats (HP, ATK, DEF) — flat values</li>
          <li>
            <strong>Position 4:</strong> Most diverse options, including the exclusive Attack Penetration (%)
          </li>
          <li><strong>Position 5:</strong> Core stats plus elemental damage — all percentages</li>
          <li><strong>Position 6:</strong> Core percentage stats only</li>
        </ul>
      </article>
    </div>
  </section>

  <!-- Sub Stats -->
  <section class="zn-runes-section">
    <h2 class="section-title">Sub Stats</h2>
    <p class="section-description">All possible sub stats that can roll on runes</p>

    <div class="substats-wrap">
      <table class="substats-table">
        <thead>
          <tr>
            <th>Stat Type</th>
            <th>Available Forms</th>
          </tr>
        </thead>
        <tbody>
          {SUB_STATS.map((row, i) => (
            <tr class={i % 2 === 0 ? 'row-alt' : ''}>
              <td class="stat-cell">{row.stat}</td>
              <td>{row.forms}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="rune-note">
        All runes can roll any combination of these sub stats. Actual values and the number of sub stats
        depend on rune rarity and upgrade level.
      </p>
    </div>
  </section>
</ZoneNovaLayout>
