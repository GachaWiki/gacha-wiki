---
// Import the dedicated layout
import TeamSynergyLayout from '../../../layouts/zone-nova/TeamSynergyLayout.astro';
import { ZONE_NOVA_TEAMS } from '../../../data/zone-nova/team-synergy.js';
import '../../../styles/games/zone-nova/zn-character.css';
---

<TeamSynergyLayout
  title="Zone Nova Team Synergy Database - Best Team Compositions | GachaWiki"
  description="Complete Zone Nova team synergy database with optimal team compositions, character synergies, Guild Raid teams, Rift strategies, and meta team builds for all content types"
  gameTitle="Team Synergy Database"
>
  <section class="page-flex">
    <div class="main-content-container">
      <div class="content-wrapper">
        <div
          style="text-align: center; margin: 1.5rem 0; padding: 1rem; background: linear-gradient(135deg, var(--bg-primary) 60%, var(--neutral-50) 100%); border-radius: 12px; border: 1px solid var(--amber-glow);"
        >
          <h1 style="color: var(--amber-glow); margin: 0; font-size: var(--text-base); font-weight: 600;">
            Team Synergy Database
          </h1>
          <p
            style="color: var(--text-secondary); margin: 0.5rem 0 0 0; font-size: var(--text-md); font-style: italic;"
          >
            Discover optimal team compositions, character synergies, and meta strategies for Guild
            Raids, Rifts, PvP, and PvE content
          </p>
          <div
            style="display: flex; gap: 1rem; justify-content: center; margin-top: 1rem; flex-wrap: wrap;"
          >
            <a
              href="/guides/zone-nova/characters/"
              style="display: inline-block; padding: 0.75rem 1.5rem; background: linear-gradient(135deg, var(--amber-glow), #FF9800); color: white; text-decoration: none; border-radius: 10px; font-weight: 600; font-size: var(--text-body); box-shadow: 0 4px 12px rgba(255, 183, 77, 0.3); transition: all 0.3s ease;"
            >
              View Character Database
            </a>
            <a
              href="/guides/zone-nova/rifts/"
              style="display: inline-block; padding: 0.75rem 1.5rem; background: linear-gradient(135deg, #64b5f6, #42a5f5); color: white; text-decoration: none; border-radius: 10px; font-weight: 600; font-size: var(--text-body); box-shadow: 0 4px 12px rgba(100, 181, 246, 0.3); transition: all 0.3s ease;"
            >
              Space-Time Rifts
            </a>
          </div>
        </div>

        <!-- Team database toolbar (zn-db card) -->
        <div class="zn-db-toolbar">
          <div class="zn-db-filter-row">
            <select class="zn-db-select" id="teamTypeFilter" aria-label="Filter by team type">
              <option value="">All Team Types</option>
              <option value="guild-raid">Guild Raid Teams</option>
              <option value="general">General PvE</option>
              <option value="extra-attack">Extra Attack</option>
              <option value="dot">DOT</option>
              <option value="pvp">PVP Teams</option>
            </select>
            <select class="zn-db-select" id="teamTierFilter" aria-label="Filter by tier">
              <option value="">All Tiers</option>
              <option value="sss">SSS Teams</option>
              <option value="ss">SS Teams</option>
              <option value="s">S Teams</option>
              <option value="a">A Teams</option>
              <option value="situational">Situational Teams</option>
            </select>
          </div>
          <div class="zn-db-sort-row">
            <span class="zn-db-sort-label">Sort by:</span>
            <button type="button" class="zn-db-sort-btn active asc" data-sort="name">
              Name
            </button>
            <button type="button" class="zn-db-sort-btn" data-sort="type">Type</button>
            <button type="button" class="zn-db-sort-btn" data-sort="tier">Tier</button>
            <button type="button" class="zn-db-reset-btn" id="resetFilters">Reset</button>
          </div>
          <div class="zn-db-search-row">
            <input
              type="text"
              id="teamSearch"
              placeholder="Search teams, characters, notes..."
              class="zn-db-search-input"
              aria-label="Search teams"
            />
            <span class="zn-db-count" id="team-count">{ZONE_NOVA_TEAMS.length} teams</span>
          </div>
        </div>

        <!-- Desktop Table -->
        <div class="team-table-container">
          <table class="team-table">
            <thead>
              <tr>
                <th>Team Name</th>
                <th>Type</th>
                <th>Tier</th>
                <th>Character 1</th>
                <th>Character 2</th>
                <th>Character 3</th>
                <th>Character 4</th>
                <th>Notes</th>
              </tr>
            </thead>
            <tbody id="teamTableBody">
              <!-- Teams will be populated here by JavaScript -->
              <tr class="no-teams-message">
                <td
                  colspan="8"
                  style="text-align: center; padding: 2rem; color: var(--text-secondary); font-style: italic;"
                >
                  Team database is currently being populated. Check back soon for comprehensive team
                  compositions!
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Mobile Cards -->
        <div class="mobile-card-view" id="teamMobileCards">
          <!-- Mobile cards will be populated here by JavaScript -->
          <div
            class="no-teams-message-mobile"
            style="text-align: center; padding: 2rem; color: var(--text-secondary); font-style: italic;"
          >
            Team database is currently being populated. Check back soon for comprehensive team
            compositions!
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Import the database utilities -->
  <script>
    import { initializeTeamDatabase } from '../../../data/zone-nova/team-synergy-utils.js';

    document.addEventListener('DOMContentLoaded', function () {
      initializeTeamDatabase();
    });
  </script>
</TeamSynergyLayout>
