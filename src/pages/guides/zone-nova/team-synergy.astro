---
// Import the dedicated layout
import TeamSynergyLayout from '../../../layouts/zone-nova/TeamSynergyLayout.astro';
import { ZONE_NOVA_TEAMS } from '../../../data/zone-nova/team-synergy.js';
import '../../../styles/games/zone-nova/zn-character.css';
---

<TeamSynergyLayout
  title="Zone Nova Team Synergy Database - Best Team Compositions | GachaWiki"
  description="Complete Zone Nova team synergy database with optimal team compositions, character synergies, Guild Raid teams, Rift strategies, and meta team builds for all content types"
  gameTitle="Team Synergy Database"
>
  <section class="page-flex">
    <div class="main-content-container">
      <div class="content-wrapper">
        <!-- Team database toolbar (zn-db card) -->
        <div class="zn-db-toolbar">
          <div class="zn-db-filter-row">
            <select class="zn-db-select" id="teamTypeFilter" aria-label="Filter by team type">
              <option value="">All Team Types</option>
              <option value="guild-raid">Guild Raid Teams</option>
              <option value="general">General PvE</option>
              <option value="extra-attack">Extra Attack</option>
              <option value="dot">DOT</option>
              <option value="pvp">PVP Teams</option>
            </select>
            <select class="zn-db-select" id="teamTierFilter" aria-label="Filter by tier">
              <option value="">All Tiers</option>
              <option value="sss">SSS Teams</option>
              <option value="ss">SS Teams</option>
              <option value="s">S Teams</option>
              <option value="a">A Teams</option>
              <option value="situational">Situational Teams</option>
            </select>
          </div>
          <div class="zn-db-sort-row">
            <span class="zn-db-sort-label">Sort by:</span>
            <button type="button" class="zn-db-sort-btn active asc" data-sort="name">
              Name
            </button>
            <button type="button" class="zn-db-sort-btn" data-sort="type">Type</button>
            <button type="button" class="zn-db-sort-btn" data-sort="tier">Tier</button>
            <button type="button" class="zn-db-reset-btn" id="resetFilters">Reset</button>
          </div>
          <div class="zn-db-search-row">
            <input
              type="text"
              id="teamSearch"
              placeholder="Search teams, characters, notes..."
              class="zn-db-search-input"
              aria-label="Search teams"
            />
            <span class="zn-db-count" id="team-count">{ZONE_NOVA_TEAMS.length} teams</span>
          </div>
        </div>

        <!-- Team sections (one per team, rendered by JavaScript) -->
        <div class="team-list" id="teamList"></div>
      </div>
    </div>
  </section>

  <!-- Import the database utilities -->
  <script>
    import { initializeTeamDatabase } from '../../../data/zone-nova/team-synergy-utils.js';

    document.addEventListener('DOMContentLoaded', function () {
      initializeTeamDatabase();
    });
  </script>
</TeamSynergyLayout>
