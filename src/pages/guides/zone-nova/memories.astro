---
// Import your layout
import ZoneNovaLayout from '../../../layouts/zone-nova/LandingLayout.astro';
import { Image } from 'astro:assets';
import ZNMemoryImage from '../../../components/zone-nova/ZNMemoryImage.astro';
import ZNClassImage from '../../../components/zone-nova/ZNClassImage.astro';
import '../../../styles/games/zone-nova/zn-badge-colour.css';
import '../../../styles/games/zone-nova/zn-character.css';
import '../../../styles/games/zone-nova/zn-memories-database.css';

// Import memory data and utilities
import {
  ZONE_NOVA_MEMORIES,
  MEMORY_METADATA,
  getMemoriesByCharacter,
  getMemoryClass,
} from '../../../data/zone-nova/memories.js';

// Helper function to extract image filename
const getImageFilename = (imagePath: string): string => {
  if (!imagePath) return '';
  return imagePath.split('/').pop() || '';
};
---

<ZoneNovaLayout
  title="Zone Nova Memory Database - GachaWiki"
  description="Sortable and filterable memory database for Zone Nova"
  gameTitle="Memory Database"
>
  <section class="page-flex">
    <div class="main-content-container">
      <div class="content-wrapper">
        {/* <!-- Toolbar card: filters + sort on top, centered search below (zn-db system) --> */}
        <div class="zn-db-toolbar">
          <div class="zn-db-filter-row">
            <select class="zn-db-select" id="memory-rarity" aria-label="Filter by rarity">
              <option value="">All Rarities</option>
              <option value="SSR">SSR</option>
              <option value="SR">SR</option>
              <option value="R">R</option>
            </select>
            <select class="zn-db-select" id="memory-class" aria-label="Filter by class">
              <option value="">All Classes</option>
              {MEMORY_METADATA.classes.map(className => (
                <option value={className}>{className}</option>
              ))}
            </select>
          </div>
          <div class="zn-db-sort-row">
            <span class="zn-db-sort-label">Sort by:</span>
            <button type="button" class="zn-db-sort-btn active asc" data-sort="name">
              Name
            </button>
            <button type="button" class="zn-db-sort-btn" data-sort="hp">Max HP</button>
            <button type="button" class="zn-db-sort-btn" data-sort="attack">Max ATK</button>
            <button type="button" class="zn-db-sort-btn" data-sort="defense">Max DEF</button>
            <button type="button" class="zn-db-reset-btn" id="reset-table">Reset</button>
          </div>
          <div class="zn-db-search-row">
            <input
              type="text"
              id="memory-search"
              placeholder="Search memory cards..."
              class="zn-db-search-input"
              aria-label="Search memory cards"
            />
            <span class="zn-db-count" id="memory-count">
              {ZONE_NOVA_MEMORIES.length} memories
            </span>
          </div>
          <p class="zn-db-no-results" id="memory-no-results" hidden>
            No memory cards match the current filters. Clear the search or filters to see all
            memories.
          </p>
        </div>

        {/* <!-- Desktop table view --> */}
        <div class="memory-table-container">
          <table class="memory-table">
            <thead>
              <tr>
                <th>#</th>
                <th>Image</th>
                <th>Name</th>
                <th>Rarity</th>
                <th>Class Icon</th>
                <th>Class</th>
                <th>Max HP</th>
                <th>Max Attack</th>
                <th>Max Defense</th>
              </tr>
            </thead>
            <tbody id="memory-table-body">
              {
                ZONE_NOVA_MEMORIES.map((memory, idx) => (
                  <tr
                    data-memory-id={memory.id}
                    data-slug={memory.slug}
                    data-url={memory.detailUrl}
                    data-class={getMemoryClass(memory) || ''}
                    role="button"
                    tabindex="0"
                    style="cursor:pointer;"
                  >
                    <td>{idx + 1}</td>
                    <td>
                      <ZNMemoryImage
                        imageName={getImageFilename(memory.image)}
                        alt={memory.name}
                        class="memory-img"
                        loading="lazy"
                        width={60}
                        height={60}
                      />
                    </td>
                    <td>{memory.name}</td>
                    <td data-sort-key="rarity">{memory.rarity}</td>
                    <td style="text-align: center; vertical-align: middle;">
                      {(() => {
                        const memoryClass = getMemoryClass(memory);
                        return memoryClass ? (
                          <ZNClassImage
                            className={memoryClass}
                            alt={memoryClass}
                            class="class-icon-standalone"
                            width={32}
                            height={32}
                          />
                        ) : (
                          <span style="color: var(--text-secondary); font-size: var(--text-sm);">-</span>
                        );
                      })()}
                    </td>
                    <td data-sort-key="class">{getMemoryClass(memory) || 'Universal'}</td>
                    <td data-sort-key="hp">{memory.stats.hp.toLocaleString()}</td>
                    <td data-sort-key="attack">{memory.stats.attack.toLocaleString()}</td>
                    <td data-sort-key="defense">{memory.stats.defense.toLocaleString()}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        {/* <!-- Mobile card view container --> */}
        <div class="mobile-card-view" id="mobile-cards-container">
          {
            ZONE_NOVA_MEMORIES.map(memory => (
              <div
                class="mobile-memory-card"
                data-memory-id={memory.id}
                data-slug={memory.slug}
                data-url={memory.detailUrl}
                data-class={getMemoryClass(memory) || ''}
                role="button"
                tabindex="0"
                style="cursor:pointer;"
              >
                <div class="mobile-card-header">
                  <ZNMemoryImage
                    imageName={getImageFilename(memory.image)}
                    alt={memory.name}
                    class="memory-img"
                    width={80}
                    height={80}
                  />
                  <div class="mobile-card-title-group">
                    <h3>{memory.name}</h3>
                    {(() => {
                      const memoryClass = getMemoryClass(memory);
                      return (
                        <p class="mobile-card-meta">
                          {memoryClass ? `${memory.rarity}, ${memoryClass}` : memory.rarity}
                        </p>
                      );
                    })()}
                  </div>
                </div>
                <div class="mobile-card-stats">
                  <div>
                    <span class="stat-label">Max HP:</span> {memory.stats.hp.toLocaleString()}
                  </div>
                  <div>
                    <span class="stat-label">Max ATK:</span> {memory.stats.attack.toLocaleString()}
                  </div>
                  <div>
                    <span class="stat-label">Max DEF:</span> {memory.stats.defense.toLocaleString()}
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <script>
    // Memory database functionality (zn-db toolbar: filter selects, sort buttons, search)
    document.addEventListener('DOMContentLoaded', function () {
      const memoryTableBody = document.getElementById('memory-table-body');
      const mobileCardsContainer = document.getElementById('mobile-cards-container');
      const searchInput = document.getElementById('memory-search');
      const raritySelect = document.getElementById('memory-rarity');
      const classSelect = document.getElementById('memory-class');
      const sortButtons = document.querySelectorAll('.zn-db-sort-btn');
      const resetButton = document.getElementById('reset-table');
      const countEl = document.getElementById('memory-count');
      const noResultsEl = document.getElementById('memory-no-results');

      let currentSortKey = 'name';
      let currentSortDirection = 'asc';
      let allMemories: any[] = [];

      function initializeMemories() {
        const tableRows = document.querySelectorAll('#memory-table-body tr');
        const mobileCards = document.querySelectorAll('.mobile-memory-card');

        allMemories = Array.from(tableRows).map((row, index) => {
          const mobileCard = mobileCards[index];
          const tableRow = row as HTMLTableRowElement;
          return {
            element: row,
            mobileElement: mobileCard,
            data: {
              rarity: row.querySelector('[data-sort-key="rarity"]')?.textContent?.trim() || '',
              class: (row as HTMLElement).dataset.class || '',
              name: tableRow.cells[2]?.textContent?.toLowerCase() || '',
              hp: parseInt(
                row.querySelector('[data-sort-key="hp"]')?.textContent?.replace(/,/g, '') || '0'
              ),
              attack: parseInt(
                row.querySelector('[data-sort-key="attack"]')?.textContent?.replace(/,/g, '') || '0'
              ),
              defense: parseInt(
                row.querySelector('[data-sort-key="defense"]')?.textContent?.replace(/,/g, '') ||
                  '0'
              ),
            },
          };
        });
      }

      function updateRowNumbers() {
        let visibleCount = 0;
        const visibleRows = Array.from(memoryTableBody?.children || []).filter(
          row => (row as HTMLElement).style.display !== 'none'
        );
        visibleRows.forEach(row => {
          visibleCount++;
          (row as HTMLTableRowElement).cells[0].textContent = String(visibleCount);
        });
      }

      function updateResultMeta(visibleCount: number) {
        const total = allMemories.length;
        if (countEl) {
          countEl.textContent =
            visibleCount === total
              ? `${total} memories`
              : `${visibleCount} of ${total} memories`;
        }
        if (noResultsEl) {
          noResultsEl.hidden = visibleCount !== 0;
        }
      }

      function filterMemories() {
        const searchValue = (searchInput as HTMLInputElement)?.value.trim().toLowerCase() || '';
        const rarityValue = (raritySelect as HTMLSelectElement)?.value || '';
        const classValue = (classSelect as HTMLSelectElement)?.value || '';

        let visibleCount = 0;
        allMemories.forEach(memory => {
          const matchesSearch = !searchValue || memory.data.name.includes(searchValue);
          const matchesRarity =
            !rarityValue || memory.data.rarity.toUpperCase() === rarityValue.toUpperCase();
          const matchesClass = !classValue || memory.data.class === classValue;
          const isVisible = matchesSearch && matchesRarity && matchesClass;
          memory.element.style.display = isVisible ? '' : 'none';
          if (memory.mobileElement) memory.mobileElement.style.display = isVisible ? '' : 'none';
          if (isVisible) visibleCount++;
        });
        updateRowNumbers();
        updateResultMeta(visibleCount);
      }

      function applySort() {
        const sortedMemories = [...allMemories].sort((a, b) => {
          const aVal = a.data[currentSortKey];
          const bVal = b.data[currentSortKey];
          if (typeof aVal === 'string') {
            return currentSortDirection === 'asc'
              ? aVal.localeCompare(bVal)
              : bVal.localeCompare(aVal);
          }
          return currentSortDirection === 'asc' ? aVal - bVal : bVal - aVal;
        });
        sortedMemories.forEach(memory => {
          memoryTableBody?.appendChild(memory.element);
          if (memory.mobileElement) mobileCardsContainer?.appendChild(memory.mobileElement);
        });
        updateRowNumbers();
      }

      function setActiveSortButton() {
        sortButtons.forEach(btn => btn.classList.remove('active', 'asc', 'desc'));
        const activeBtn = Array.from(sortButtons).find(
          btn => (btn as HTMLElement).dataset.sort === currentSortKey
        );
        if (activeBtn) activeBtn.classList.add('active', currentSortDirection);
      }

      function resetTable() {
        if (searchInput) (searchInput as HTMLInputElement).value = '';
        if (raritySelect) (raritySelect as HTMLSelectElement).value = '';
        if (classSelect) (classSelect as HTMLSelectElement).value = '';
        currentSortKey = 'name';
        currentSortDirection = 'asc';
        setActiveSortButton();
        allMemories.forEach(memory => {
          memory.element.style.display = '';
          if (memory.mobileElement) memory.mobileElement.style.display = '';
        });
        filterMemories();
        applySort();
      }

      function addNavigationHandlers() {
        document.querySelectorAll('[data-url]').forEach(element => {
          element.addEventListener('click', function () {
            const url = this.getAttribute('data-url');
            if (url) window.location.href = url;
          });
          element.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar') {
              e.preventDefault();
              const url = this.getAttribute('data-url');
              if (url) window.location.href = url;
            }
          });
        });
      }

      if (!memoryTableBody || !mobileCardsContainer || !resetButton) {
        console.error('Required elements not found');
        return;
      }

      initializeMemories();
      searchInput?.addEventListener('input', filterMemories);
      raritySelect?.addEventListener('change', filterMemories);
      classSelect?.addEventListener('change', filterMemories);
      sortButtons.forEach(button => {
        button.addEventListener('click', function () {
          const sortKey = (this as HTMLElement).dataset.sort;
          if (!sortKey) return;
          if (currentSortKey === sortKey) {
            currentSortDirection = currentSortDirection === 'asc' ? 'desc' : 'asc';
          } else {
            currentSortKey = sortKey;
            // numeric columns default to descending (highest first), name to A-Z
            currentSortDirection = sortKey === 'name' ? 'asc' : 'desc';
          }
          setActiveSortButton();
          applySort();
        });
      });
      resetButton.addEventListener('click', resetTable);
      addNavigationHandlers();

      // default: name A-Z
      setActiveSortButton();
      filterMemories();
      applySort();
    });
  </script>
</ZoneNovaLayout>
