---
// Star Lusts game info page: element effectiveness from game text, gacha rates
// and the roster structure, each in a boxed section.
import StarLustsLayout from '../../../layouts/star-lusts/StarLustsLayout.astro';
import { STAR_LUSTS_CHARACTERS } from '../../../data/star-lusts/characters.js';

const unitCount = STAR_LUSTS_CHARACTERS.length;

// Element descriptions verbatim from the game's LanguageTable (EN)
const ELEMENT_DESC = {
  Void: 'An attack with a Void attribute will deal 150% damage to enemies with a Physical attribute, and 50% damage to enemies with a Stellergy attribute.',
  Stellergy: 'An attack with a Stellergy attribute will deal 150% damage to enemies with a Void attribute, and 50% damage to enemies with a Physical attribute.',
  Physical: 'An attack with a Physical attribute will deal 150% damage to enemies with a Stellergy attribute, and 50% damage to enemies with a Void attribute.',
  Aether: 'Attacks that possess an Aether attribute inflict 130% more damage against enemies of the Ectoplasm attribute.',
  Ectoplasm: 'Attacks that possess an Ectoplasm attribute inflict 130% more damage against enemies of the Aether attribute.',
};
---

<StarLustsLayout
  title="Game Info"
  description="Star Lusts game info: the element system with game text descriptions, summon rates and pity, and how the roster of base girls and costume variants is structured."
  gameTitle="Game Info"
>
  <div class="sl-info-container">
    <section class="sl-section">
      <h2 class="sl-section-title">Elements</h2>
      <p class="sl-section-sub">Game text descriptions of every attribute</p>
      <dl class="sl-facts-list">
        {Object.entries(ELEMENT_DESC).map(([el, desc]) => (
          <div class="sl-fact-row">
            <dt class="sl-fact-label">{el}</dt>
            <dd class="sl-fact-value">{desc}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="sl-section">
      <h2 class="sl-section-title">Gacha</h2>
      <p class="sl-section-sub">Summon rates and pity, from the game data</p>
      <dl class="sl-facts-list">
        <div class="sl-fact-row">
          <dt class="sl-fact-label">SSR rate</dt>
          <dd class="sl-fact-value">1.5% per pull<span class="sl-fact-sub">Standard pool</span></dd>
        </div>
        <div class="sl-fact-row">
          <dt class="sl-fact-label">SR rate</dt>
          <dd class="sl-fact-value">6% per pull<span class="sl-fact-sub">Standard pool</span></dd>
        </div>
        <div class="sl-fact-row">
          <dt class="sl-fact-label">Pity</dt>
          <dd class="sl-fact-value">Guaranteed SSR within 90 pulls<span class="sl-fact-sub">Character or weapon</span></dd>
        </div>
        <div class="sl-fact-row">
          <dt class="sl-fact-label">Duplicates</dt>
          <dd class="sl-fact-value">Convert to fragments<span class="sl-fact-sub">Characters enhance when enough fragments accumulate</span></dd>
        </div>
        <div class="sl-fact-row">
          <dt class="sl-fact-label">Rate-ups</dt>
          <dd class="sl-fact-value">119 of 205 recorded pools<span class="sl-fact-sub">Featured SSR pickups; an SSR summon on a pickup banner is guaranteed to be the featured character</span></dd>
        </div>
      </dl>
    </section>

    <section class="sl-section">
      <h2 class="sl-section-title">Roster</h2>
      <p class="sl-info-p">
        Each girl exists as a base unit plus costume variants, and every variant is its own
        playable unit with her own name, element, stats and skills, the same costume model
        used by Brown Dust 2. Ids 1 to 29 plus 104 and 108 are the base girls; the 1000,
        2000, 3000, 4000 and 5000 series are their costume lines from seasonal and event
        banners. All SSR units evolve to UR and beyond with duplicate fragments, up to
        UR+5. The database covers all {unitCount} units.
      </p>
    </section>
  </div>
</StarLustsLayout>
