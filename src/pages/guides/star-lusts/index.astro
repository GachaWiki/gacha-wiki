---
// Star Lusts landing (standard wiki landing: hero, story, download, resources).
import StarLustsLayout from '../../../layouts/star-lusts/StarLustsLayout.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import DiscordPromo from '../../../components/DiscordPromo.astro';
import { STAR_LUSTS_CHARACTERS } from '../../../data/star-lusts/characters.js';

const R2 = 'https://k2b1c5ab57ed98e51.gachawiki.info/star-lusts';
const unitCount = STAR_LUSTS_CHARACTERS.length;
const ssrCount = STAR_LUSTS_CHARACTERS.filter(c => c.rarity === 'SSR').length;
---

<StarLustsLayout
  title="Home"
  description="Star Lusts wiki: the R18 bullet hell shoot 'em up by PINKCORE/ICECONE — Adult Only on Steam, 18+ on EROLABS and Nutaku. Character database with stats, skills and profiles, built from extracted game data."
>
  <section class="sl-hero-section sl-hero-over-video">
    <!-- Full key art, contained in the content container so nothing is cropped -->
    <div class="sl-hero-banner-wrap">
      <img
        src={`${R2}/gameimg/title-bg-wide.webp`}
        alt="Star Lusts title screen key art"
        width={1260}
        height={540}
        class="sl-hero-banner"
      />
    </div>
    <h1 class="sl-hero-title">Star Lusts</h1>
    <p class="sl-hero-tag">
      An R18 bullet hell shoot 'em up by PINKCORE. Lead mecha Cadettes through space to
      battle alien threats and capture ancient beauties called Mimics.
    </p>
  </section>

  <section class="sl-content-section">
    <div class="sl-story">
      <p>
        <strong>Star Lusts</strong> is a bullet hell-style shoot 'em up game which fuses
        sci-fi, mecha, and anthropomorphic themes. Players take on the role of Captain of
        an Earth Federation ship and lead a team of mecha-enhanced Cadettes through the
        boundlessness of space on a mission to confront hostile alien forces that
        threaten the human race, and capture ancient beauties awakened from a rift in
        the universe, known as Mimics.
      </p>
      <p>
        When humanity as we know it is facing extermination from hostile alien
        civilizations... The Earth Federation needs a hero like you for a Captain capable
        of saving mankind! The perks of the job include your pick of the cuties riding
        with your spaceship, too?! Grab yourself some beautiful alien babes whenever the
        feeling takes you, and put several millennia of wisdom to use while you
        discipline these monster girls in the profound ways of human sexuality!
      </p>
      <p>
        Face off against a stream of enemy forces and weave through a hail of bullets
        with intuitive and thrilling shoot 'em up gameplay. Deploy your girls' exclusive
        skills to wipe out the competition with a single blow!
      </p>
      <p>
        The roster counts {unitCount} playable units ({ssrCount} SSR): base girls and their
        costume variants across two factions, the Cadettes of the Earth Federation and the
        Mimics, primordial courtesans created by the ancient gods. Each unit is a live
        Spine animated character with her own active skill, passive and five elements to
        build around: Void, Stellergy, Physical, Aether and Ectoplasm.
      </p>
    </div>

    <div class="sl-download-row">
      <a
        class="sl-download-btn"
        href="https://game.erolabsshare.live/app/f302f717/Star_Lusts"
        target="_blank"
        rel="noopener noreferrer"
      >
        Download &amp; Play Star Lusts
        <span class="sl-download-arrow">&rarr;</span>
      </a>
    </div>

    <DiscordPromo />

    <p class="sl-last-updated">
      Last Updated: <FormattedDate date={new Date('2026-11-08')} />
    </p>
  </section>

  <section class="sl-content-section">
    <h2 class="sl-resources-heading">Guides &amp; Resources</h2>
    <div class="sl-resources-grid">
      <div class="sl-resource-category">
        <div class="sl-category-header">
          <h3>Characters</h3>
          <p class="sl-category-description">
            All {unitCount} units with rarity, element, race, base stats, skills and
            profiles, extracted from the game data.
          </p>
        </div>
        <div class="sl-buttons-grid">
          <a href="/guides/star-lusts/characters/" class="sl-resource-button">
            Character Database
          </a>
        </div>
      </div>
    </div>
  </section>
</StarLustsLayout>
