---
// Busty Burst Fantasy - character illustrators page
import BannerTimelineLayout from '../../../layouts/busty-burst/BannerTimelineLayout.astro';
import PaladinImage from '../../../components/busty-burst/PaladinImage.astro';
import { BB_ARTISTS } from '../../../data/busty-burst/artists.js';
import { getCharacterDataBySlug } from '../../../data/busty-burst/character-database.js';
import { BODY_IDS } from '../../../components/busty-burst/bb-r2';

const artists = BB_ARTISTS.map((a) => ({
  ...a,
  characters: a.characters.map((c) => {
    const db = getCharacterDataBySlug(c.slug);
    const characterId = db?.characterId ?? null;
    return { ...c, characterId, hasBody: characterId != null && BODY_IDS.has(characterId) };
  }),
}));
const totalChars = BB_ARTISTS.reduce((s, a) => s + a.characters.length, 0);
---

<BannerTimelineLayout title="Artists - Busty Burst Fantasy" description="Every illustrator credited for the Busty Burst Fantasy paladins, with the characters each artist drew." gameTitle="Artists">
  <section class="content-section">
    <div class="bb-art-intro">
      <h2 class="bb-art-title">Character Illustrators</h2>
      <p class="bb-art-text">
        {totalChars} Paladins illustrated by {artists.length} credited artists. Credits come from the game data itself; each artist card lists every Paladin they drew. External links and other works are included where verified.
      </p>
    </div>

    {artists.map((a) => (
      <div class="bb-art-card">
        <div class="bb-art-head">
          <h3 class="bb-art-name">{a.name}</h3>
          {a.romaji && a.romaji !== a.name && <span class="bb-art-romaji">{a.romaji}</span>}
          <span class="bb-art-count">{a.characters.length} {a.characters.length === 1 ? 'paladin' : 'paladins'}</span>
        </div>
        {(a.pixiv || a.x || a.works) && (
          <div class="bb-art-info">
            {a.pixiv && <a class="bb-art-link" href={a.pixiv} target="_blank" rel="noopener">Pixiv</a>}
            {a.x && <a class="bb-art-link" href={a.x} target="_blank" rel="noopener">X (Twitter)</a>}
            {a.works && <span class="bb-art-works">Also known for: {a.works}</span>}
          </div>
        )}
        <div class="bb-art-chars">
          {a.characters.map((c) => (
            <a class="bb-art-char" href={`/guides/busty-burst/characters/${c.slug}/`}>
              <span class="bb-art-char-img">
                {c.characterId ? (
                  <PaladinImage characterId={c.characterId} alt={c.name} width={150} height={261} imageType={c.hasBody ? 'body' : 'icon'} />
                ) : (
                  <span class="bb-art-char-fallback">{c.name.slice(0, 1)}</span>
                )}
              </span>
              <span class="bb-art-char-name">{c.name}</span>
            </a>
          ))}
        </div>
      </div>
    ))}
    <p class="bb-art-footnote">Illustrator credits from the game's character data. Names without links or works could not be verified against public sources.</p>
  </section>
</BannerTimelineLayout>

<style>
  .content-section {
    max-width: 980px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .bb-art-intro,
  .bb-art-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 10px;
    padding: 20px;
  }
  .bb-art-title {
    font-size: var(--text-xl);
    margin: 0 0 10px;
  }
  .bb-art-text {
    font-size: var(--text-sm);
    line-height: 1.6;
    margin: 0;
    color: rgba(255, 255, 255, 0.82);
  }
  .bb-art-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 10px;
  }
  .bb-art-name {
    font-size: var(--text-lg);
    margin: 0;
  }
  .bb-art-romaji {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.55);
  }
  .bb-art-count {
    margin-left: auto;
    display: inline-block;
    border-radius: 5px;
    padding: 3px 10px;
    font-size: var(--text-2xs);
    font-weight: 700;
    color: #ffffff;
    background: #4878a8;
  }
  .bb-art-info {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px;
    margin: 0 0 12px;
  }
  .bb-art-link {
    font-size: var(--text-xs);
    color: var(--bbc-accent, #6db8d8);
    text-decoration: none;
    border: 1px solid rgba(109, 184, 216, 0.35);
    border-radius: 5px;
    padding: 2px 8px;
  }
  .bb-art-works {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.6);
  }
  .bb-art-chars {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));
    gap: 8px;
  }
  .bb-art-char {
    display: flex;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 8px;
    padding: 6px;
    text-decoration: none;
    min-width: 0;
  }
  .bb-art-char-img {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 300 / 522;
    border-radius: 6px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.03);
    min-width: 0;
  }
  .bb-art-char-img :global(.paladin-image-wrapper) {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .bb-art-char-img :global(img.paladin-image) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .bb-art-char-fallback {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 6px;
    background: rgba(109, 184, 216, 0.18);
    color: var(--bbc-accent, #6db8d8);
    font-size: var(--text-sm);
    font-weight: 700;
  }
  .bb-art-char-name {
    font-size: var(--text-2xs);
    color: rgba(255, 255, 255, 0.85);
    text-align: center;
    margin-top: 6px;
    overflow-wrap: anywhere;
  }
  .bb-art-footnote {
    font-size: var(--text-2xs);
    color: rgba(255, 255, 255, 0.45);
    margin: 0;
  }
  @media (max-width: 640px) {
    .bb-art-card { padding: 14px; }
    .bb-art-count { margin-left: 0; }
  }
</style>
