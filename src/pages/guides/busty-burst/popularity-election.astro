---
// Busty Burst Fantasy - JP anniversary Paladin Popularity Election results page
import BannerTimelineLayout from '../../../layouts/busty-burst/BannerTimelineLayout.astro';
import { ELECTIONS } from '../../../data/busty-burst/election.js';

const fmt = (n) => n.toLocaleString('en-US');
---

<BannerTimelineLayout title="JP Popularity Elections - Busty Burst Fantasy" description="Results of the JP server anniversary Paladin Popularity Elections for Busty Burst Fantasy, with vote counts and reward outcomes." gameTitle="JP Popularity Elections">
  <section class="content-section">
    <div class="bb-elect-intro">
      <h2 class="bb-elect-title">Paladin Popularity Election</h2>
      <p class="bb-elect-text">
        Each anniversary the JP server holds the Paladin Popularity Election. Voting tickets are earned based on AP spent, then cast for your favorite Paladins. Vote totals measure popularity, not strength.
      </p>
      <p class="bb-elect-text">
        The SSR group winner is implemented with a new costume, plus an exclusive weapon planned. The SR group winner is promoted to SSR at a later date. EN follows JP content, so these rewards are on the way: Elaine's new costume and weapon, then Tsukina's SSR promotion.
      </p>
    </div>

    {ELECTIONS.map((el) => {
      const ssrMax = el.ssr[0].votes;
      const srMax = el.sr[0].votes;
      return (
        <div class="bb-elect-card">
          <div class="bb-elect-card-head">
            <h3 class="bb-elect-card-title">{el.name}</h3>
            <span class="bb-elect-jp">{el.jpName}</span>
          </div>
          <div class="bb-elect-meta">
            <span class="bb-elect-dates">{el.dates}</span>
            <span class="bb-elect-dot">&bull;</span>
            <span class="bb-elect-dates">{el.ticketLine}</span>
          </div>
          <div class="bb-elect-winner-notes">
            <span class="bb-elect-chip bb-elect-chip-ssr">{el.ssrWinnerNote}</span>
            <span class="bb-elect-chip bb-elect-chip-sr">{el.srWinnerNote}</span>
          </div>
          <div class="bb-elect-groups">
            {[
              { label: 'SSR Group', rows: el.ssr, max: ssrMax, chipClass: 'bb-elect-rank-chip-ssr' },
              { label: 'SR Group', rows: el.sr, max: srMax, chipClass: 'bb-elect-rank-chip-sr' },
            ].map((group) => (
              <div class="bb-elect-group">
                <h4 class="bb-elect-group-title">{group.label}</h4>
                <ol class="bb-elect-list">
                  {group.rows.map((row) => (
                    <li class:list={['bb-elect-row', { 'bb-elect-row-winner': row.rank === 1 }]}>
                      <span class:list={['bb-elect-rank-chip', group.chipClass, { 'bb-elect-rank-chip-first': row.rank === 1 }]}>{row.rank}</span>
                      <span class="bb-elect-name">
                        {row.slug ? (
                          <a href={`/guides/busty-burst/characters/${row.slug}/`}>{row.name}</a>
                        ) : (
                          row.name
                        )}
                      </span>
                      <span class="bb-elect-bar-wrap">
                        <span class="bb-elect-bar" style={`width: ${(row.votes / group.max) * 100}%`}></span>
                      </span>
                      <span class="bb-elect-votes">{fmt(row.votes)}</span>
                    </li>
                  ))}
                </ol>
              </div>
            ))}
          </div>
          <div class="bb-elect-detail">
            <p class="bb-elect-detail-line">{el.rewards}</p>
            <p class="bb-elect-detail-line">
              Casting {fmt(el.titleThreshold)} tickets on one SSR Paladin earned the Oshi title, and the top three supporters of each SSR Paladin received the Best Oshi title. Crystal bonus votes did not count toward titles.
            </p>
            {el.missions.length > 0 && (
              <p class="bb-elect-detail-line">
                Ticket use missions: {el.missions.map((m, i) => (
                  <>{i > 0 && ', '}{fmt(m.tickets)} tickets = {m.crystals} crystals</>
                ))}.
              </p>
            )}
            <p class="bb-elect-detail-line">Some Paladins were excluded from voting. The SR group covered Burst-original SR Paladins only.</p>
          </div>
        </div>
      );
    })}
    <p class="bb-elect-footnote">Vote counts from the official in-game results notice. Unlinked names have not released on the EN server yet.</p>
  </section>
</BannerTimelineLayout>

<style>
  .content-section {
    max-width: 980px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .bb-elect-intro,
  .bb-elect-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 10px;
    padding: 20px;
  }
  .bb-elect-title {
    font-size: var(--text-xl);
    margin: 0 0 10px;
  }
  .bb-elect-text {
    font-size: var(--text-sm);
    line-height: 1.6;
    margin: 0 0 8px;
    color: rgba(255, 255, 255, 0.82);
  }
  .bb-elect-card-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 6px;
  }
  .bb-elect-card-title {
    font-size: var(--text-lg);
    margin: 0;
  }
  .bb-elect-jp {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.5);
  }
  .bb-elect-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0 0 12px;
  }
  .bb-elect-dates {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.65);
  }
  .bb-elect-dot {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.35);
  }
  .bb-elect-winner-notes {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 16px;
  }
  .bb-elect-chip {
    display: inline-block;
    border-radius: 5px;
    padding: 4px 10px;
    font-size: var(--text-xs);
    font-weight: 700;
    color: #ffffff;
  }
  .bb-elect-chip-ssr { background: #b8860b; }
  .bb-elect-chip-sr { background: #4878a8; }
  .bb-elect-groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: 20px;
  }
  .bb-elect-group-title {
    font-size: var(--text-base);
    margin: 0 0 8px;
  }
  .bb-elect-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .bb-elect-row {
    display: grid;
    grid-template-columns: 30px minmax(120px, 1.2fr) minmax(80px, 1fr) 84px;
    align-items: center;
    gap: 10px;
    padding: 6px 10px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.03);
    font-size: var(--text-sm);
  }
  .bb-elect-row-winner {
    background: rgba(109, 184, 216, 0.14);
  }
  .bb-elect-rank-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.08);
    font-size: var(--text-2xs);
    font-weight: 700;
    color: rgba(255, 255, 255, 0.7);
  }
  .bb-elect-rank-chip-ssr.bb-elect-rank-chip-first { background: #b8860b; color: #ffffff; }
  .bb-elect-rank-chip-sr.bb-elect-rank-chip-first { background: #4878a8; color: #ffffff; }
  .bb-elect-name a {
    color: var(--bbc-accent, #6db8d8);
    text-decoration: none;
  }
  .bb-elect-bar-wrap {
    display: block;
    height: 6px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }
  .bb-elect-bar {
    display: block;
    height: 100%;
    border-radius: 3px;
    background: rgba(109, 184, 216, 0.55);
  }
  .bb-elect-row-winner .bb-elect-bar {
    background: rgba(109, 184, 216, 0.85);
  }
  .bb-elect-votes {
    font-size: var(--text-2xs);
    color: rgba(255, 255, 255, 0.6);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .bb-elect-detail {
    margin-top: 16px;
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .bb-elect-detail-line {
    font-size: var(--text-2xs);
    color: rgba(255, 255, 255, 0.55);
    margin: 0;
    line-height: 1.5;
  }
  .bb-elect-footnote {
    font-size: var(--text-2xs);
    color: rgba(255, 255, 255, 0.45);
    margin: 0;
  }
  @media (max-width: 680px) {
    .bb-elect-card { padding: 14px; }
    .bb-elect-groups { grid-template-columns: 1fr; }
    .bb-elect-row { grid-template-columns: 30px 1fr 84px; }
    .bb-elect-bar-wrap { display: none; }
  }
</style>
