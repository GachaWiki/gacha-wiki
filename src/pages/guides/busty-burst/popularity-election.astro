---
// Busty Burst Fantasy - JP anniversary Paladin Popularity Election results page
import BannerTimelineLayout from '../../../layouts/busty-burst/BannerTimelineLayout.astro';
import { ELECTIONS, ELECTION_ART_DIMS } from '../../../data/busty-burst/election.js';
import { R2, ELECTION_ART } from '../../../components/busty-burst/bb-r2';

const fmt = (n) => n.toLocaleString('en-US');
---

<BannerTimelineLayout title="JP Popularity Elections - Busty Burst Fantasy" description="Results of the JP server anniversary Paladin Popularity Elections for Busty Burst Fantasy, with vote counts and reward outcomes." gameTitle="JP Popularity Elections">
  <section class="content-section">
    <div class="bb-elect-intro">
      <h2 class="bb-elect-title">Paladin Popularity Election</h2>
      <p class="bb-elect-text">
        Each anniversary the JP server holds the Paladin Popularity Election. Voting tickets are earned based on AP spent, then cast for your favorite Paladins. Vote totals measure popularity, not strength.
      </p>
      <p class="bb-elect-text">
        The SSR group winner is implemented with a new costume, plus an exclusive weapon planned. The SR group winner is promoted to SSR at a later date. EN follows JP content, so these rewards are on the way: Elaine's new costume and weapon, then Tsukina's SSR promotion.
      </p>
    </div>

    {ELECTIONS.map((el) => {
      const ssrMax = el.ssr[0].votes;
      const srMax = el.sr[0].votes;
      return (
        <div class="bb-elect-card">
          {el.banner && (
            <img
              class="bb-elect-banner"
              src={`${R2}/x/${el.banner.tid}-1.webp`}
              alt={`${el.name} key visual`}
              width={el.banner.w}
              height={el.banner.h}
              loading="lazy"
            />
          )}
          <div class="bb-elect-card-head">
            <h3 class="bb-elect-card-title">{el.name}</h3>
            <span class="bb-elect-jp">{el.jpName}</span>
          </div>
          <div class="bb-elect-meta">
            <span class="bb-elect-dates">{el.dates}</span>
            <span class="bb-elect-dot">&bull;</span>
            <span class="bb-elect-dates">{el.ticketLine}</span>
          </div>
          <div class="bb-elect-groups">
            {[
              { label: 'SSR Group', rows: el.ssr, max: ssrMax, note: el.ssrWinnerNote },
              { label: 'SR Group', rows: el.sr, max: srMax, note: el.srWinnerNote },
            ].map((group) => {
              const winnerKey = group.rows[0].art;
              const winnerDims = winnerKey && ELECTION_ART.has(winnerKey) ? ELECTION_ART_DIMS[winnerKey] : null;
              const art = winnerDims
                ? { src: `${R2}/election/rows/${winnerKey}.webp`, w: winnerDims[0], h: winnerDims[1] }
                : null;
              return (
                <div class="bb-elect-group">
                  <h4 class="bb-elect-group-title">{group.label}</h4>
                  <div class="bb-elect-winner">
                    {art && (
                      <img
                        class="bb-elect-winner-img"
                        src={art.src}
                        alt={`${group.rows[0].name} card art`}
                        width={art.w}
                        height={art.h}
                        loading="lazy"
                      />
                    )}
                    <p class="bb-elect-winner-note">{group.note}</p>
                  </div>
                  <ol class="bb-elect-list">
                    {group.rows.map((row) => {
                      const rd = row.art && ELECTION_ART.has(row.art) ? ELECTION_ART_DIMS[row.art] : null;
                      return (
                        <li class:list={['bb-elect-row', { 'bb-elect-row-winner': row.rank === 1 }]}>
                          <span class:list={['bb-elect-rank', { 'bb-elect-rank-first': row.rank === 1 }]}>{row.rank}</span>
                          <span class="bb-elect-name">
                            {rd && (
                              <img
                                class="bb-elect-row-img"
                                src={`${R2}/election/rows/${row.art}.webp`}
                                alt=""
                                width={rd[0]}
                                height={rd[1]}
                                loading="lazy"
                              />
                            )}
                            <span class="bb-elect-name-text">
                              {row.slug ? (
                                <a href={`/guides/busty-burst/characters/${row.slug}/`}>{row.name}</a>
                              ) : (
                                row.name
                              )}
                            </span>
                          </span>
                          <span class="bb-elect-bar-wrap">
                            <span class="bb-elect-bar" style={`width: ${(row.votes / group.max) * 100}%`}></span>
                          </span>
                          <span class="bb-elect-votes">{fmt(row.votes)}</span>
                        </li>
                      );
                    })}
                  </ol>
                </div>
              );
            })}
          </div>
          <div class="bb-elect-detail">
            <p class="bb-elect-detail-line">{el.rewards}</p>
            <p class="bb-elect-detail-line">
              Casting {fmt(el.titleThreshold)} tickets on one SSR Paladin earned the Oshi title, and the top three supporters of each SSR Paladin received the Best Oshi title. Crystal bonus votes did not count toward titles.
            </p>
            {el.missions.length > 0 && (
              <p class="bb-elect-detail-line">
                Ticket use missions: {el.missions.map((m, i) => (
                  <>{i > 0 && ', '}{fmt(m.tickets)} tickets = {m.crystals} crystals</>
                ))}.
              </p>
            )}
            <p class="bb-elect-detail-line">Some Paladins were excluded from voting. The SR group covered Burst-original SR Paladins only.</p>
            <p class="bb-elect-detail-line">
              Sources: <a href={el.jpWikiUrl}>JP wiki event page</a>{el.xPosts.map((p) => (
                <>, <a href={p.url}>{p.label}</a></>
              ))}.
            </p>
          </div>
        </div>
      );
    })}
    <p class="bb-elect-footnote">Vote counts from the official in-game results notice. Card art is from the JP wiki, key visuals from the official X posts. Unlinked names have not released on the EN server yet.</p>
  </section>
</BannerTimelineLayout>

<style>
  .content-section {
    max-width: 980px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .bb-elect-intro,
  .bb-elect-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 10px;
    padding: 20px;
  }
  .bb-elect-title {
    font-size: var(--text-xl);
    margin: 0 0 10px;
  }
  .bb-elect-text {
    font-size: var(--text-sm);
    line-height: 1.6;
    margin: 0 0 8px;
    color: rgba(255, 255, 255, 0.82);
  }
  .bb-elect-banner {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    margin: 0 0 14px;
  }
  .bb-elect-card-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 6px;
  }
  .bb-elect-card-title {
    font-size: var(--text-lg);
    margin: 0;
  }
  .bb-elect-jp {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.5);
  }
  .bb-elect-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0 0 12px;
  }
  .bb-elect-dates {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.65);
  }
  .bb-elect-dot {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.35);
  }
  .bb-elect-groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(440px, 1fr));
    gap: 20px;
  }
  .bb-elect-group-title {
    font-size: var(--text-base);
    margin: 0 0 8px;
  }
  .bb-elect-winner {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 12px;
  }
  .bb-elect-winner-img {
    height: 150px;
    width: auto;
    display: block;
    flex: none;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    background: rgba(255, 255, 255, 0.03);
  }
  .bb-elect-winner-note {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.6;
    margin: 0;
    flex: 1;
  }
  .bb-elect-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .bb-elect-row {
    display: grid;
    grid-template-columns: 24px minmax(150px, 1.4fr) minmax(40px, 1fr) 76px;
    align-items: center;
    gap: 10px;
    padding: 6px 10px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.03);
    font-size: var(--text-sm);
  }
  .bb-elect-row-winner {
    background: rgba(109, 184, 216, 0.14);
  }
  .bb-elect-rank {
    font-size: var(--text-2xs);
    color: rgba(255, 255, 255, 0.6);
    font-variant-numeric: tabular-nums;
  }
  .bb-elect-rank-first {
    color: var(--bbc-accent, #6db8d8);
    font-weight: 700;
  }
  .bb-elect-name {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }
  .bb-elect-row-img {
    height: 40px;
    width: auto;
    flex: none;
    display: block;
    border-radius: 4px;
  }
  .bb-elect-name-text {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .bb-elect-name-text a {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--bbc-accent, #6db8d8);
    text-decoration: none;
  }
  .bb-elect-bar-wrap {
    display: block;
    height: 6px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }
  .bb-elect-bar {
    display: block;
    height: 100%;
    border-radius: 3px;
    background: rgba(109, 184, 216, 0.55);
  }
  .bb-elect-row-winner .bb-elect-bar {
    background: rgba(109, 184, 216, 0.85);
  }
  .bb-elect-votes {
    font-size: var(--text-2xs);
    color: rgba(255, 255, 255, 0.6);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .bb-elect-detail {
    margin-top: 16px;
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .bb-elect-detail-line {
    font-size: var(--text-2xs);
    color: rgba(255, 255, 255, 0.55);
    margin: 0;
    line-height: 1.5;
  }
  .bb-elect-detail-line a {
    color: var(--bbc-accent, #6db8d8);
    text-decoration: none;
  }
  .bb-elect-footnote {
    font-size: var(--text-2xs);
    color: rgba(255, 255, 255, 0.45);
    margin: 0;
  }
  @media (max-width: 640px) {
    .bb-elect-card { padding: 14px; }
    .bb-elect-groups { grid-template-columns: 1fr; }
    .bb-elect-winner-img { height: 110px; }
    .bb-elect-row { grid-template-columns: 24px 1fr 76px; }
    .bb-elect-bar-wrap { display: none; }
  }
</style>
