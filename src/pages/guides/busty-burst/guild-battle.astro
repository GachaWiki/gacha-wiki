---
// Busty Burst Guild Battle index: one container with the intro and the event
// list. Event cards use the game's own art: official event banner + battle map.
import BannerTimelineLayout from '../../../layouts/busty-burst/BannerTimelineLayout.astro';
import { R2 } from '../../../components/busty-burst/bb-r2';
import {
  GUILD_WAR_EVENTS,
  GUILD_WAR_MAP_ART,
  GUILD_WAR_EVENT_BANNERS,
} from '../../../data/busty-burst/guild-battle.js';

const pageTitle = 'Busty Burst Guild Battle - Guild Raid Boss Events';
const pageDescription =
  'Guild Battle in Busty Burst Fantasy: every guild raid boss event (WIND, FIRE, WATER and more) with its boss, stats, skills and rewards.';
const gameTitle = 'Guild Battle';

const getStatusLabel = (status: string) => {
  switch (status) {
    case 'current':
      return 'Active';
    case 'upcoming':
      return 'Upcoming';
    case 'ended':
      return 'Ended';
    default:
      return status;
  }
};

const computeStatus = (startDate: string, endDate: string) => {
  const start = Date.parse(startDate.replace(' ', 'T').replace(/\//g, '-'));
  const end = Date.parse(endDate.replace(' ', 'T').replace(/\//g, '-'));
  if (Number.isNaN(start) || Number.isNaN(end)) return 'ended';
  const now = Date.now();
  if (now < start) return 'upcoming';
  if (now > end) return 'ended';
  return 'current';
};

const formatDate = (dateString: string) => {
  const date = new Date(dateString.replace(' ', 'T').replace(/\//g, '-'));
  const options: Intl.DateTimeFormatOptions = { month: 'short', day: '2-digit', year: 'numeric' };
  return date.toLocaleDateString('en-US', options);
};

const events = [...GUILD_WAR_EVENTS].sort((a, b) => b.startTime.localeCompare(a.startTime)).map(ev => {
  const bgMap = ev.background?.split('/')[1];
  return {
    ...ev,
    live: computeStatus(ev.startTime, ev.endTime),
    cardImage: (bgMap && GUILD_WAR_MAP_ART[bgMap]) || Object.values(GUILD_WAR_MAP_ART)[0],
    banner: GUILD_WAR_EVENT_BANNERS[ev.element || ''],
  };
});
---

<BannerTimelineLayout title={pageTitle} description={pageDescription} gameTitle={gameTitle}>
  <meta
    slot="head"
    content="Busty Burst, Busty Burst Fantasy, guild battle, guild raid boss, alliance war, boss stats, boss skills, Ero Lab games"
  />
  <main class="banner-timeline-content" role="main">
    <section class="gw-panel">
      <p class="gw-intro">
        Guild Battle is the alliance raid boss mode. The whole guild fights the same boss over 40
        cycles, everyone gets 3 runs a day, and the damage turns into Guild Points that decide the
        global and guild rankings at the end. Each event brings its own element-themed boss: click
        an event for its boss database.
      </p>

      <div class="gw-event-grid">
        {events.map(ev => (
          <a class="gw-event-card" href={`/guides/busty-burst/guild-battle/${ev.slug}/`}>
            <div class="gw-event-art">
              <img src={`${R2}/${ev.cardImage}`} alt={`${ev.name} battle map`} width="492" height="300" loading="lazy" />
              <span class={`gw-event-status status-badge status-badge--${ev.live}`}>{getStatusLabel(ev.live)}</span>
            </div>
            <div class="gw-event-body">
              {ev.banner && (
                <img class="gw-event-banner" src={`${R2}/${ev.banner}`} alt={ev.name} width="218" height="60" loading="lazy" />
              )}
              <span class="gw-event-name">{ev.name}</span>
              <span class="gw-event-meta">{formatDate(ev.startTime)} - {formatDate(ev.endTime)}</span>
              <span class="gw-event-meta">{ev.raids[0]?.name} | 40 cycles</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
</BannerTimelineLayout>

<style>
  .gw-panel {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 10px;
    padding: 1.4rem 1.5rem;
    margin-bottom: 1.5rem;
  }
  .gw-intro {
    margin: 0 0 1.25rem;
    color: var(--bb-text-secondary, rgba(255, 255, 255, 0.8));
  }
  .gw-event-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 460px));
    gap: 1rem;
  }
  .gw-event-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 10px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }
  .gw-event-art {
    position: relative;
  }
  .gw-event-art img {
    width: 100%;
    aspect-ratio: 1640 / 1000;
    object-fit: cover;
    display: block;
  }
  .gw-event-status {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
  }
  .gw-event-body {
    padding: 0.85rem 1rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3rem;
  }
  .gw-event-banner {
    width: 218px;
    max-width: 100%;
    height: auto;
    margin-bottom: 0.35rem;
  }
  .gw-event-name {
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--bb-primary-light);
  }
  .gw-event-meta {
    font-size: 0.82rem;
    color: var(--bb-text-secondary, rgba(255, 255, 255, 0.65));
  }
</style>
