---
// Guild Battle event page: ONE page per event (Guild Battle WIND, later FIRE/WATER...)
// with everything on it - dates, the boss with all stages, stats, full skill kits,
// weaknesses, rewards, field mobs, battle maps and event buffs. No summon content.
import BannerTimelineLayout from '../../../../layouts/busty-burst/BannerTimelineLayout.astro';
import { R2 } from '../../../../components/busty-burst/bb-r2';
import ElementImage from '../../../../components/busty-burst/ElementImage.astro';
import SkillIcon from '../../../../components/busty-burst/SkillIcon.astro';
import RarityImage from '../../../../components/busty-burst/RarityImage.astro';
import {
  GUILD_WAR_EVENTS,
  GUILD_WAR_RAIDS,
  GUILD_WAR_MAP_ART,
  GUILD_WAR_EVENT_BANNERS,
  GUILD_WAR_BUFF_ICONS,
  guildWarBossIcon,
} from '../../../../data/busty-burst/guild-battle.js';

export async function getStaticPaths() {
  return GUILD_WAR_EVENTS.map(ev => ({
    params: { slug: ev.slug },
    props: { ev },
  }));
}

const { ev } = Astro.props;
const raids = GUILD_WAR_RAIDS.filter(r => r.seasonId === ev.id);
const first = raids[0]?.stages[0];
const lastStage = raids[0]?.stages[raids[0].stages.length - 1];
const maps = [...new Set(raids.flatMap(r => r.stages.flatMap(s => s.ladder.maps)))];

const pageTitle = `${ev.name} - Busty Burst Guild Battle`;
const pageDescription = `${ev.name}: the guild raid boss event with ${first ? raids[0].name : 'the boss'} over ${first ? raids[0].stages.length : 0} stages. Boss stats, all skills, weaknesses, rewards and event buffs.`;

const formatDate = (dateString: string) => {
  const date = new Date(dateString.replace(' ', 'T').replace(/\//g, '-'));
  const options: Intl.DateTimeFormatOptions = { month: 'short', day: '2-digit', year: 'numeric' };
  return date.toLocaleDateString('en-US', options);
};

const fmt = (n: number) => n.toLocaleString('en-US');
---

<BannerTimelineLayout title={pageTitle} description={pageDescription} gameTitle={ev.name}>
  <meta
    slot="head"
    content="Busty Burst, Busty Burst Fantasy, guild battle, {ev.name}, raid boss, boss stats, boss skills, weakness, Ero Lab games"
  />
  <main class="banner-timeline-content" role="main">
    <p class="intro-text">
      {ev.name} ran {formatDate(ev.startTime)} to {formatDate(ev.endTime)} (UTC). The whole guild
      fights the same raid boss across {first ? raids[0].stages.length : 0} stages and 40 cycles,
      with boss levels {first ? first.ladder.levelRange[0] : ''} to {lastStage ? lastStage.ladder.levelRange[1] : ''}.
    </p>

    {raids.map(raid => (
      <>
        <section class="gw-panel">
          <h2 class="gw-heading">
            {guildWarBossIcon(raid.iconGroup) && (
              <img class="gw-boss-icon" src={`${R2}/${guildWarBossIcon(raid.iconGroup)}`} alt={raid.name} width="106" height="104" loading="lazy" />
            )}
            {raid.name}
            <span class="gw-icon-chip"><ElementImage element={raid.element} width={26} height={26} /><RarityImage rarity={raid.rarity} width={46} height={23} /></span>
          </h2>
          {GUILD_WAR_EVENT_BANNERS[raid.element || ''] && (
            <img class="gw-event-banner" src={`${R2}/${GUILD_WAR_EVENT_BANNERS[raid.element || '']}`} alt={`${ev.name} banner`} width="436" height="120" loading="lazy" />
          )}

          <div class="gw-map-row">
            {maps.map(m => (
              <figure class="gw-map">
                <img src={`${R2}/${GUILD_WAR_MAP_ART[m]}`} alt={`Battle map ${m}`} width="492" height="300" loading="lazy" />
                <figcaption>Battle map {m}</figcaption>
              </figure>
            ))}
          </div>

          <h3 class="gw-subheading">Weaknesses and Resistances</h3>
          <p class="gw-elements">
            <span class="gw-el gw-el-weak"><ElementImage element={first.elementProfile.weak[0]} width={20} height={20} /> Weak: {first.elementProfile.weak.join(', ')}</span>
            <span class="gw-el gw-el-resist">Resists: {first.elementProfile.resist.join(', ')}</span>
          </p>
          <p class="gw-note">
            Ailment immunity: {first.elementProfile.ailmentResist.join(', ')}. Every fight runs
            {first.timeLimitSec} seconds and damage counts even if the timer runs out or the team
            withdraws. Field mobs during the event: {ev.fieldMobs.length} Water R units
            ({ev.fieldMobs.slice(0, 6).join(', ')} and more).
          </p>
        </section>

        {raid.stages.map(stage => (
          <section class="gw-panel">
            <h2 class="gw-heading">
              Stage {stage.index}
              <span class="gw-cycle-chip">Cycles {stage.ladder.cycleRange[0]}-{stage.ladder.cycleRange[1]}</span>
              <span class="gw-cycle-chip">Lv {stage.ladder.levelRange[0]}-{stage.ladder.levelRange[1]}</span>
              <span class="gw-cycle-chip">Score x{stage.ladder.scoreScale[0].toFixed(1)}-x{stage.ladder.scoreScale[1].toFixed(1)}</span>
            </h2>

            <div class="gw-stage-cols">
              <div>
                <h3 class="gw-subheading">Stats</h3>
                <div class="gw-table-wrap">
                  <table class="gw-table">
                    <tbody>
                      <tr><th>HP</th><td>{fmt(stage.stats.hp)}</td></tr>
                      <tr><th>ATK</th><td>{fmt(stage.stats.atk)}</td></tr>
                      <tr><th>MATK</th><td>{fmt(stage.stats.matk)}</td></tr>
                      <tr><th>DEF</th><td>{fmt(stage.stats.def)}</td></tr>
                      <tr><th>MDEF</th><td>{fmt(stage.stats.mdef)}</td></tr>
                      <tr><th>Accuracy / Block</th><td>{fmt(stage.stats.accuracy)} / {fmt(stage.stats.block)}</td></tr>
                      <tr><th>Crit (Phys / Magic)</th><td>{fmt(stage.stats.physCrit)} / {fmt(stage.stats.magicCrit)}</td></tr>
                    </tbody>
                  </table>
                </div>
                <p class="gw-note">Base values; the boss scales with the cycle level inside the stage.</p>
              </div>

              <div>
                <h3 class="gw-subheading">Rewards</h3>
                <div class="gw-table-wrap">
                  <table class="gw-table">
                    <tbody>
                      <tr><th>Per battle</th><td>{fmt(stage.ladder.rewards.gold)} gold + {stage.ladder.rewards.guildCoins} guild coins</td></tr>
                      <tr><th>Kill drops</th><td>{stage.ladder.drops.map(d => `${d.item} x${fmt(d.amount)}`).join(', ')}</td></tr>
                    </tbody>
                  </table>
                </div>
                <p class="gw-note">
                  Skill order: opening {stage.skillRotation.first}, then looping {stage.skillRotation.loop}
                  (2 = Skill 1, 1 = Skill 2, 0 = Normal Attack).
                </p>
              </div>
            </div>

            <h3 class="gw-subheading">Skills</h3>
            {stage.skills.map(skill => (
              <article class="gw-skill">
                <header class="gw-skill-head">
                  {skill.icon && <SkillIcon skillId={skill.icon} alt={skill.name} width={44} height={44} />}
                  <div class="gw-skill-title">
                    <span class="gw-skill-slot">{skill.slot}</span>
                    <span class="gw-skill-name">{skill.name}</span>
                  </div>
                  {skill.damage && <span class="gw-el gw-el-weak">{skill.damage}</span>}
                </header>
                <p class="gw-skill-desc">{skill.description}</p>
                <p class="gw-skill-meta">
                  {skill.castTime !== null && <span>Cast {skill.castTime}s</span>}
                  {skill.target && <span>Target: {skill.target}</span>}
                </p>
              </article>
            ))}
          </section>
        ))}
      </>
    ))}

    {ev.rankingRewards?.length > 0 && (
      <section class="gw-panel">
        <h2 class="gw-heading">Ranking Rewards</h2>
        <p class="gw-note">
          Final guild placement rewards, paid after the ranking settles. Values are the reward
          amounts from the game data; top ranks also earn a ranked guild icon.
        </p>
        <div class="gw-table-wrap">
          <table class="gw-table">
            <thead>
              <tr><th>Rank</th><th>Reward</th><th>Guild Icon</th></tr>
            </thead>
            <tbody>
              {ev.rankingRewards.map(r => (
                <tr>
                  <td>{r.rank === '1' ? '1st' : r.rank === '2' ? '2nd' : r.rank === '3' ? '3rd' : r.rank}</td>
                  <td>{r.reward.toLocaleString('en-US')}</td>
                  <td>{r.guildIcon ? 'Ranked icon ' + r.guildIcon : '-'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {ev.guildShop?.length > 0 && (
      <section class="gw-panel">
        <h2 class="gw-heading">Event Shop</h2>
        <p class="gw-note">
          Spent {ev.coinItem} from battles and rankings. Stock refreshes daily
          {ev.guildShopClose ? `, shop closed ${formatDate(ev.guildShopClose)}` : ''}.
        </p>
        <div class="gw-table-wrap">
          <table class="gw-table">
            <thead>
              <tr><th>Item</th><th>Cost</th><th>Daily Limit</th></tr>
            </thead>
            <tbody>
              {ev.guildShop.map(i => (
                <tr>
                  <td>{i.name}</td>
                  <td>{i.cost.toLocaleString('en-US')} coins</td>
                  <td>x{i.limit}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <section class="gw-panel">
      <h2 class="gw-heading">Event Buffs</h2>
      <div class="gw-buffs">
        <div class="gw-buff">
          <img class="gw-buff-icon" src={`${R2}/${GUILD_WAR_BUFF_ICONS.damage}`} alt="ATK UP" width="78" height="91" loading="lazy" />
          <span class="gw-buff-name">{ev.buffedUnits.damage}</span>
          <span class="gw-buff-label">bonus damage during the event</span>
        </div>
        <div class="gw-buff">
          <img class="gw-buff-icon" src={`${R2}/${GUILD_WAR_BUFF_ICONS.damageTaken}`} alt="DEF UP" width="78" height="91" loading="lazy" />
          <span class="gw-buff-name">{ev.buffedUnits.damageTaken}</span>
          <span class="gw-buff-label">reduced damage taken</span>
        </div>
        <div class="gw-buff">
          <img class="gw-buff-icon" src={`${R2}/${GUILD_WAR_BUFF_ICONS.guildCoins}`} alt="COIN UP" width="78" height="91" loading="lazy" />
          <span class="gw-buff-name">{ev.buffedUnits.guildCoins}</span>
          <span class="gw-buff-label">bonus guild coins</span>
        </div>
      </div>
      <p class="gw-note">
        The buffs cover each paladin's whole variant group. Event coin: {ev.coinItem}.
      </p>
      <p class="gw-backlink"><a href="/guides/busty-burst/guild-battle/">Back to Guild Battle</a></p>
    </section>
  </main>
</BannerTimelineLayout>

<style>
  .gw-panel {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 10px;
    padding: 1.25rem 1.4rem;
    margin-bottom: 1.5rem;
  }
  .gw-heading {
    font-size: 1.35rem;
    margin: 0 0 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    color: var(--bb-primary-light);
  }
  .gw-subheading {
    font-size: 1.02rem;
    margin: 1.25rem 0 0.5rem;
    color: var(--bb-primary-light);
  }
  .gw-boss-icon {
    width: 72px;
    height: auto;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    background: rgba(255, 255, 255, 0.04);
  }
  .gw-cycle-chip {
    background: var(--bb-primary-dark, rgba(255, 255, 255, 0.07));
    border-radius: 5px;
    padding: 0.2rem 0.55rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.8);
  }
  .gw-map-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 0.75rem;
    margin: 0.75rem 0 1rem;
  }
  .gw-map {
    margin: 0;
  }
  .gw-map img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.09);
  }
  .gw-map figcaption {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.6);
    margin-top: 0.3rem;
  }
  .gw-el {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    line-height: 1;
    border-radius: 5px;
    padding: 0.25rem 0.6rem;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .gw-el img {
    display: block;
    width: 20px;
    height: 20px;
    flex: none;
  }
  .gw-event-banner {
    width: 100%;
    max-width: 436px;
    height: auto;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    margin-bottom: 0.75rem;
    display: block;
  }
  .gw-icon-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    line-height: 1;
  }
  .gw-icon-chip img {
    display: block;
  }
  .gw-icon-chip img:first-child {
    width: 26px;
    height: 26px;
    flex: none;
  }
  .gw-icon-chip img:last-child {
    width: 46px;
    height: 18px;
    flex: none;
    object-fit: contain;
  }
  .gw-buff-icon {
    width: 64px;
    height: auto;
    margin-bottom: 0.3rem;
  }
  .gw-el-weak {
    background: rgba(239, 68, 68, 0.18);
    color: #f87171;
  }
  .gw-el-resist {
    background: rgba(96, 165, 250, 0.15);
    color: #93c5fd;
  }
  .gw-note {
    font-size: 0.85rem;
    color: var(--bb-text-secondary, rgba(255, 255, 255, 0.65));
    margin: 0.4rem 0 0;
  }
  .gw-stage-cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.25rem;
  }
  .gw-table-wrap {
    overflow-x: auto;
  }
  .gw-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    min-width: 320px;
  }
  .gw-table th,
  .gw-table td {
    text-align: left;
    padding: 0.55rem 0.7rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
  }
  .gw-table th {
    color: var(--bb-text-secondary, rgba(255, 255, 255, 0.65));
    font-weight: 600;
    font-size: 0.8rem;
    width: 38%;
  }
  .gw-skill {
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 10px;
    padding: 0.8rem 0.9rem;
    margin-bottom: 0.75rem;
  }
  .gw-skill-head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: wrap;
  }
  .gw-skill-title {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
    margin-right: auto;
  }
  .gw-skill-slot {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--bb-primary-light);
  }
  .gw-skill-name {
    font-weight: 700;
  }
  .gw-skill-desc {
    margin: 0.4rem 0 0.2rem;
  }
  .gw-skill-meta {
    margin: 0;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.6);
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .gw-buffs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.75rem;
  }
  .gw-buff {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 10px;
    padding: 0.7rem 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .gw-buff-name {
    font-weight: 700;
  }
  .gw-buff-label {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.7);
  }
  .gw-backlink a {
    color: var(--bb-primary-light);
  }
</style>
