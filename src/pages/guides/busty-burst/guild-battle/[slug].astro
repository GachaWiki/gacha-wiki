---
// Guild Battle raid page: ONE page per raid with everything on it - stage ladder,
// stats, full skill kits, weaknesses, rewards and battle maps.
import BannerTimelineLayout from '../../../../layouts/busty-burst/BannerTimelineLayout.astro';
import { R2 } from '../../../../components/busty-burst/bb-r2';
import {
  GUILD_WAR_RAIDS,
  GUILD_WAR_MAP_ART,
  getGuildWarSeason,
} from '../../../../data/busty-burst/guild-battle.js';

export async function getStaticPaths() {
  return GUILD_WAR_RAIDS.map(raid => ({
    params: { slug: raid.slug },
    props: { raid },
  }));
}

const { raid } = Astro.props;
const season = getGuildWarSeason(raid.seasonId);
const first = raid.stages[0];
const last = raid.stages[raid.stages.length - 1];
const maps = [...new Set(raid.stages.flatMap(s => s.ladder.maps))];

const pageTitle = `${raid.name} - Busty Burst Guild Battle Raid`;
const pageDescription = `Guild Battle raid ${raid.name}: ${raid.element} boss with ${raid.stages.length} stages over cycles ${first.ladder.cycleRange[0]}-${last.ladder.cycleRange[1]}. Stats, all skills, weaknesses and rewards.`;

const fmt = (n: number) => n.toLocaleString('en-US');
---

<BannerTimelineLayout title={pageTitle} description={pageDescription} gameTitle={raid.name}>
  <meta
    slot="head"
    content="Busty Burst, Busty Burst Fantasy, guild battle, raid boss, {raid.name}, boss stats, boss skills, weakness, Ero Lab games"
  />
  <main class="banner-timeline-content" role="main">
    <p class="intro-text">
      Guild Battle raid from Season {raid.seasonId === '110' ? '1' : raid.seasonId}:
      {raid.stages.length} stages across cycles {first.ladder.cycleRange[0]} to
      {last.ladder.cycleRange[1]}, boss levels {first.ladder.levelRange[0]} to
      {last.ladder.levelRange[1]}. {raid.element} element, {raid.rarity} tier.
    </p>

    <section class="gw-panel">
      <h2 class="gw-heading">
        {raid.name}
        <span class="gw-el gw-el-weak">{raid.element}</span>
        <span class="gw-el gw-el-resist">{raid.rarity}</span>
      </h2>

      <div class="gw-map-row">
        {maps.map(m => (
          <figure class="gw-map">
            <img src={`${R2}/${GUILD_WAR_MAP_ART[m]}`} alt={`Battle map ${m}`} width="492" height="300" loading="lazy" />
            <figcaption>Battle map {m}</figcaption>
          </figure>
        ))}
      </div>

      <h3 class="gw-subheading">Weaknesses and Resistances</h3>
      <p class="gw-elements">
        <span class="gw-el gw-el-weak">Weak: {first.elementProfile.weak.join(', ')}</span>
        <span class="gw-el gw-el-resist">Resists: {first.elementProfile.resist.join(', ')}</span>
      </p>
      <p class="gw-note">
        Ailment immunity: {first.elementProfile.ailmentResist.join(', ')}. Every fight runs
        {first.timeLimitSec} seconds and damage counts even if the timer runs out or the team
        withdraws.
      </p>
    </section>

    {raid.stages.map(stage => (
      <section class="gw-panel">
        <h2 class="gw-heading">
          Stage {stage.index}
          <span class="gw-cycle-chip">Cycles {stage.ladder.cycleRange[0]}-{stage.ladder.cycleRange[1]}</span>
          <span class="gw-cycle-chip">Lv {stage.ladder.levelRange[0]}-{stage.ladder.levelRange[1]}</span>
          <span class="gw-cycle-chip">Score x{stage.ladder.scoreScale[0].toFixed(1)}-x{stage.ladder.scoreScale[1].toFixed(1)}</span>
        </h2>

        <div class="gw-stage-cols">
          <div>
            <h3 class="gw-subheading">Stats</h3>
            <div class="gw-table-wrap">
              <table class="gw-table">
                <tbody>
                  <tr><th>HP</th><td>{fmt(stage.stats.hp)}</td></tr>
                  <tr><th>ATK</th><td>{fmt(stage.stats.atk)}</td></tr>
                  <tr><th>MATK</th><td>{fmt(stage.stats.matk)}</td></tr>
                  <tr><th>DEF</th><td>{fmt(stage.stats.def)}</td></tr>
                  <tr><th>MDEF</th><td>{fmt(stage.stats.mdef)}</td></tr>
                  <tr><th>Accuracy / Block</th><td>{fmt(stage.stats.accuracy)} / {fmt(stage.stats.block)}</td></tr>
                  <tr><th>Crit (Phys / Magic)</th><td>{fmt(stage.stats.physCrit)} / {fmt(stage.stats.magicCrit)}</td></tr>
                </tbody>
              </table>
            </div>
            <p class="gw-note">
              Base values; the boss scales with the cycle level inside the stage.
            </p>
          </div>

          <div>
            <h3 class="gw-subheading">Rewards</h3>
            <div class="gw-table-wrap">
              <table class="gw-table">
                <tbody>
                  <tr><th>Per battle</th><td>{fmt(stage.ladder.rewards.gold)} gold + {stage.ladder.rewards.guildCoins} guild coins</td></tr>
                  <tr><th>Kill drops</th><td>{stage.ladder.drops.map(d => `${d.item} x${fmt(d.amount)}`).join(', ')}</td></tr>
                </tbody>
              </table>
            </div>
            <p class="gw-note">
              Skill order: opening {stage.skillRotation.first}, then looping {stage.skillRotation.loop}
              (2 = Skill 1, 1 = Skill 2, 0 = Normal Attack).
            </p>
          </div>
        </div>

        <h3 class="gw-subheading">Skills</h3>
        {stage.skills.map(skill => (
          <article class="gw-skill">
            <header class="gw-skill-head">
              <span class="gw-skill-slot">{skill.slot}</span>
              <span class="gw-skill-name">{skill.name}</span>
              {skill.damage && <span class="gw-el gw-el-weak">{skill.damage}</span>}
            </header>
            <p class="gw-skill-desc">{skill.description}</p>
            <p class="gw-skill-meta">
              {skill.castTime !== null && <span>Cast {skill.castTime}s</span>}
              {skill.target && <span>Target: {skill.target}</span>}
            </p>
          </article>
        ))}
      </section>
    ))}

    {season && (
      <section class="gw-panel">
        <h2 class="gw-heading">Season Buffs</h2>
        <p class="gw-note">
          While this raid runs, {season.buffedUnits.damage} (and her variants) deals bonus damage,
          {season.buffedUnits.damageTaken} takes reduced damage, and {season.buffedUnits.guildCoins}
          earns extra guild coins. Those three are also the season's Pick Up Summon lineup.
        </p>
        <p class="gw-backlink"><a href="/guides/busty-burst/guild-battle/">Back to Guild Battle database</a></p>
      </section>
    )}
  </main>
</BannerTimelineLayout>

<style>
  .gw-panel {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 10px;
    padding: 1.25rem 1.4rem;
    margin-bottom: 1.5rem;
  }
  .gw-heading {
    font-size: 1.35rem;
    margin: 0 0 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .gw-subheading {
    font-size: 1.05rem;
    margin: 1.25rem 0 0.5rem;
  }
  .gw-cycle-chip {
    background: rgba(255, 255, 255, 0.07);
    border-radius: 5px;
    padding: 0.2rem 0.55rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.8);
  }
  .gw-map-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 0.75rem;
    margin: 0.75rem 0 1rem;
  }
  .gw-map {
    margin: 0;
  }
  .gw-map img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.09);
  }
  .gw-map figcaption {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.6);
    margin-top: 0.3rem;
  }
  .gw-el {
    border-radius: 5px;
    padding: 0.25rem 0.6rem;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .gw-el-weak {
    background: rgba(239, 68, 68, 0.18);
    color: #f87171;
  }
  .gw-el-resist {
    background: rgba(96, 165, 250, 0.15);
    color: #93c5fd;
  }
  .gw-note {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.65);
    margin: 0.4rem 0 0;
  }
  .gw-stage-cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.25rem;
  }
  .gw-table-wrap {
    overflow-x: auto;
  }
  .gw-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    min-width: 320px;
  }
  .gw-table th,
  .gw-table td {
    text-align: left;
    padding: 0.55rem 0.7rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
  }
  .gw-table th {
    color: rgba(255, 255, 255, 0.65);
    font-weight: 600;
    font-size: 0.8rem;
    width: 38%;
  }
  .gw-skill {
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 10px;
    padding: 0.8rem 0.9rem;
    margin-bottom: 0.75rem;
  }
  .gw-skill-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .gw-skill-slot {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.55);
  }
  .gw-skill-name {
    font-weight: 700;
  }
  .gw-skill-desc {
    margin: 0.4rem 0 0.2rem;
  }
  .gw-skill-meta {
    margin: 0;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.6);
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .gw-backlink a {
    color: var(--bb-primary, #e8c07d);
  }
</style>
