---
// Horizon Walker redeem codes: active and expired codes from official notices
import HWLandingLayout from '../../../layouts/horizon-walker/LandingLayout.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import {
  horizonWalkerRedeemCodes,
  generateRedeemCodesStructuredData,
} from '../../../data/horizon-walker/redeem-codes.js';
import '../../../styles/games/horizon-walker/hw-redeem-codes.css';

const { meta, availableCodes, expiredCodes, redeemInstructions } = horizonWalkerRedeemCodes;
const title = meta.title;
const description = meta.description;
const gameTitle = 'Redeem Codes';
---

<HWLandingLayout title={title} description={description} gameTitle={gameTitle}>
  <section class="page-content">
    <div class="hw-redeem-main-container">
      <p class="hw-redeem-updated">
        Codes come from official notices and can expire without warning. Last updated:
        <FormattedDate date={meta.lastUpdated} />
      </p>

      <h2 class="hw-redeem-section-title">Available Codes</h2>
      <table class="hw-redeem-table">
        <thead>
          <tr>
            <th>Code</th>
            <th>Rewards</th>
            <th>Expires</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {
            availableCodes.map(codeData => (
              <tr>
                <td class="hw-code-value">{codeData.code}</td>
                <td class="hw-code-rewards">
                  {codeData.rewards}
                  {codeData.platformNote && <span class="hw-code-platform">{codeData.platformNote}</span>}
                </td>
                <td class="hw-code-expiry">{codeData.expiryDate ?? 'Unknown'}</td>
                <td class="hw-code-copy-cell">
                  <button class="hw-copy-button" data-code={codeData.code}>Copy</button>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>

      <h2 class="hw-redeem-section-title">{redeemInstructions.title}</h2>
      <ol class="hw-redeem-steps">
        {
          redeemInstructions.steps.map(step => (
            <li>
              <span class="hw-redeem-step-title">{step.title}</span>
              <span class="hw-redeem-step-desc">{step.description}</span>
            </li>
          ))
        }
      </ol>

      <h2 class="hw-redeem-section-title">Expired Codes</h2>
      {
        expiredCodes.length > 0 ? (
          <table class="hw-redeem-table is-expired">
            <thead>
              <tr>
                <th>Code</th>
                <th>Rewards</th>
                <th>Expired</th>
              </tr>
            </thead>
            <tbody>
              {expiredCodes.map(codeData => (
                <tr>
                  <td class="hw-code-value">{codeData.code}</td>
                  <td class="hw-code-rewards">{codeData.rewards}</td>
                  <td class="hw-code-expiry">{codeData.expiryDate}</td>
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <p class="hw-redeem-empty">No expired codes yet.</p>
        )
      }
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(generateRedeemCodesStructuredData())} />
</HWLandingLayout>

<script>
  // Copy control: modern Clipboard API with a textarea fallback.
  const buttons = document.querySelectorAll<HTMLButtonElement>('.hw-copy-button');
  buttons.forEach(button => {
    button.addEventListener('click', () => {
      const code = button.getAttribute('data-code');
      if (!code) return;
      const done = () => {
        button.textContent = 'Copied';
        button.disabled = true;
        window.setTimeout(() => {
          button.textContent = 'Copy';
          button.disabled = false;
        }, 1600);
      };
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(code).then(done).catch(() => fallback(code, done));
      } else {
        fallback(code, done);
      }
    });
  });

  function fallback(code: string, done: () => void) {
    const ta = document.createElement('textarea');
    ta.value = code;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    ta.setAttribute('readonly', '');
    document.body.appendChild(ta);
    ta.select();
    try {
      document.execCommand('copy');
      done();
    } catch {
      /* ignore */
    }
    document.body.removeChild(ta);
  }
</script>
