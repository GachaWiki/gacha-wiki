---
import CharacterBuildLayout from '../../../../layouts/horizon-walker/CharacterBuildLayout.astro';
import CharacterImage from '../../../../components/horizon-walker/CharacterImage.astro';
import StigmaImage from '../../../../components/horizon-walker/StigmaImage.astro';
import { HWRarityIcon } from '../../../../components/horizon-walker/index.astro';
import { getEnhancedBuilds } from '../../../../data/horizon-walker/builds/builds-data.js';
import { HORIZON_WALKER_CHARACTERS } from '../../../../data/horizon-walker/characters.js';
import { stigmas } from '../../../../data/horizon-walker/stigmas.js';
import { getCharacterBuildConfig } from '../../../../data/horizon-walker/builds/character-build-configs.js';

export async function getStaticPaths() {
  const characters = HORIZON_WALKER_CHARACTERS;
  const builds = getEnhancedBuilds();

  // Only create paths for characters that have builds
  const paths = characters
    .filter(character =>
      builds.some(build => build.buildSlug === character.slug && build.available)
    )
    .map(character => ({
      params: { buildSlug: character.slug },
      props: {
        character,
        build: builds.find(build => build.buildSlug === character.slug && build.available),
      },
    }));

  return paths;
}

const { character, build } = Astro.props;

// Validate that we have both character and build data
if (!character || !build) {
  return Astro.redirect('/guides/horizon-walker/builds/');
}

const title = `${character.name} Build - Horizon Walker`;
const description = `Complete build guide for ${character.name} in Horizon Walker. Includes optimal equipment, stats, and strategies.`;

// Get character-specific build configuration
const buildConfig = getCharacterBuildConfig(character.slug);

// Resolve one stigma recommendation (same shapes as the legacy top-level config)
// into a display model: { type: 'mixed' | 'object' | 'single', ... }
const findStigmaSet = (name: string) =>
  stigmas.EX?.find((stigma: any) => stigma.name === name) ||
  stigmas.SS?.find((stigma: any) => stigma.name === name) ||
  stigmas.S?.find((stigma: any) => stigma.name === name) ||
  stigmas.A?.find((stigma: any) => stigma.name === name) ||
  null;

function resolveStigmaDisplay(rec: any, mixedLayout: any): any {
  if (rec === null || rec === undefined) return null;
  if (typeof rec === 'string' && rec.includes('Mixed 2-Set')) {
    // Explicit per-slot layout from the config wins; fall back to the
    // per-character defaults below for older configs.
    const layout = mixedLayout;
    if (layout && layout.top && layout.bottom && layout.left && layout.right) {
      const setNames = [...new Set([layout.top, layout.bottom, layout.left, layout.right])];
      if (setNames.length === 2) {
        const st1 = stigmas.EX?.find((stigma: any) => stigma.name === setNames[0]);
        const st2 = stigmas.EX?.find((stigma: any) => stigma.name === setNames[1]);
        if (st1 && st2) {
          const pieceFor = (slot: string) =>
            (layout[slot] === setNames[0] ? st1 : st2).pieces[slot];
          return {
            type: 'mixed',
            pieces: {
              stigma1Name: setNames[0],
              stigma2Name: setNames[1],
              top: pieceFor('top'),
              bottom: pieceFor('bottom'),
              left: pieceFor('left'),
              right: pieceFor('right'),
              twoSetBonus1: st1.twoSet,
              twoSetBonus2: st2.twoSet,
            },
          };
        }
      }
    }
    if (character.slug !== 'echidna') {
      // Default to Olivia's build: Reckoning of Sin + The Thousand Mile Weave
      const reckoningOfSin = stigmas.EX?.find(stigma => stigma.name === 'Reckoning of Sin');
      const thousandMileWeave = stigmas.EX?.find(stigma => stigma.name === 'The Thousand Mile Weave');
      if (reckoningOfSin && thousandMileWeave) {
        return {
          type: 'mixed',
          pieces: {
            stigma1Name: 'Reckoning of Sin',
            stigma2Name: 'The Thousand Mile Weave',
            top: thousandMileWeave.pieces.top,
            bottom: reckoningOfSin.pieces.bottom,
            left: reckoningOfSin.pieces.left,
            right: thousandMileWeave.pieces.right,
            twoSetBonus1: reckoningOfSin.twoSet,
            twoSetBonus2: thousandMileWeave.twoSet,
          },
        };
      }
    } else {
      // Echidna: The Eternal Battle + The Wind that Wanders the World
      const eternalBattle = stigmas.EX?.find(stigma => stigma.name === 'The Eternal Battle');
      const windWanders = stigmas.EX?.find(stigma => stigma.name === 'The Wind that Wanders the World');
      if (eternalBattle && windWanders) {
        return {
          type: 'mixed',
          pieces: {
            stigma1Name: 'The Eternal Battle',
            stigma2Name: 'The Wind that Wanders the World',
            top: eternalBattle.pieces.top,
            bottom: windWanders.pieces.bottom,
            left: eternalBattle.pieces.left,
            right: windWanders.pieces.right,
            twoSetBonus1: eternalBattle.twoSet,
            twoSetBonus2: windWanders.twoSet,
          },
        };
      }
    }
    return null;
  }
  if (typeof rec === 'object') {
    return { type: 'object', zeroDupe: findStigmaSet(rec.zeroDupe), fullEx5: findStigmaSet(rec.fullEx5) };
  }
  return { type: 'single', set: findStigmaSet(rec) };
}

// One stigma section per build when the config defines stigmaBuilds,
// otherwise a single legacy section from the top-level config.
const stigmaSections: any[] =
  Array.isArray(buildConfig.stigmaBuilds) && buildConfig.stigmaBuilds.length > 0
    ? buildConfig.stigmaBuilds.map((sb: any) => ({
        label: sb.name || null,
        display: resolveStigmaDisplay(sb.recommendedStigma, sb.mixedSetLayout),
      }))
    : [{ label: null, display: resolveStigmaDisplay(buildConfig.recommendedStigma, buildConfig.mixedSetLayout) }];
---

<CharacterBuildLayout title={title} description={description} characterName={character.name}>
  <div class="character-build-header">
    <div class="character-build-image">
      <CharacterImage
        imageName={character.name}
        alt={`${character.name} character portrait`}
        width={120}
        height={120}
        class="character-build-portrait"
        loading="eager"
      />
    </div>
    <div class="character-build-info">
      <h2 class="character-build-name">{character.name} Build</h2>
      <div class="character-build-badges">
        <span class="hw-badge" data-type="Cost">{build.cost}</span>
        <HWRarityIcon rarity={build.rarity} width={44} height={22} />
        <span class="character-tag damage-scaling">{buildConfig.damageScaling}</span>
      </div>
    </div>
  </div>

  <!-- Core Stats Section -->
  <section class="character-build-section">
    <h3 class="character-build-section-title">Core Stats</h3>
    <!-- Core Stats Explanation -->
    <div class="core-stats-explanation">
      <div class="stat-explanation-grid">
        <span
          ><span class="stat-name">Strength:</span>
          <span class="stat-description">Increases Melee ATK</span></span
        >
        <span
          ><span class="stat-name">Technic:</span>
          <span class="stat-description">Increases Ranged ATK</span></span
        >
        <span
          ><span class="stat-name">Intelligence:</span>
          <span class="stat-description">Increases Magic ATK</span></span
        >
        <span
          ><span class="stat-name">Vitality:</span>
          <span class="stat-description">Increases Max HP</span></span
        >
        <span
          ><span class="stat-name">Agility:</span>
          <span class="stat-description">Increases evasion and AP Recovery</span></span
        >
      </div>
    </div>
    <div class="core-stats-grid">
      <div class="core-stat-card">
        <div class="core-stat-title">Strength</div>
        <div class="core-stat-value">{character.stats?.strength || 'N/A'}</div>
      </div>
      <div class="core-stat-card">
        <div class="core-stat-title">Technic</div>
        <div class="core-stat-value">{character.stats?.technic || 'N/A'}</div>
      </div>
      <div class="core-stat-card">
        <div class="core-stat-title">Intelligence</div>
        <div class="core-stat-value">{character.stats?.intelligence || 'N/A'}</div>
      </div>
      <div class="core-stat-card">
        <div class="core-stat-title">Vitality</div>
        <div class="core-stat-value">{character.stats?.vitality || 'N/A'}</div>
      </div>
      <div class="core-stat-card">
        <div class="core-stat-title">Agility</div>
        <div class="core-stat-value">{character.stats?.agility || 'N/A'}</div>
      </div>
    </div>
  </section>

  <!-- Build Strategy Box -->
  <section class="character-build-section">
    <h3 class="character-build-section-title">Build Note</h3>
    <div class="strategy-box">
      <h4 class="strategy-title">{buildConfig.buildStrategyTitle}</h4>
      <div class="strategy-content">
        {
          buildConfig.buildStrategy.map((strategy, index) => (
            <div class="strategy-point">
              <div class="strategy-text">
                <strong>{strategy.title}</strong> - {strategy.description}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Recommended Stigma Section -->
  {
    stigmaSections.some((s: any) => s.display) && (
      <section class="character-build-section">
        <h3 class="character-build-section-title">Recommended Stigma</h3>
        <div class="stigma-container">
          {stigmaSections
            .filter((s: any) => s.display)
            .map((section: any) => (
          <div class="stigma-build-section">
            {section.label && <div class="stigma-build-label">{section.label}</div>}
            {section.display?.type === 'mixed' ? (
            // Mixed 2-Set Stigma Display
            <>
              <div class="stigma-header">
                <div class="stigma-title-section">
                  <div class="stigma-info-container">
                    <div class="stigma-image-container">
                      <StigmaImage
                        imageName={section.display.pieces.stigma1Name}
                        alt={`${section.display.pieces.stigma1Name} stigma`}
                        width={60}
                        height={60}
                        class="stigma-portrait-small"
                        loading="eager"
                      />
                    </div>
                    <div class="stigma-name-label">
                      <h5>{section.display.pieces.stigma1Name}</h5>
                      <HWRarityIcon rarity="EX" width={36} height={18} />
                    </div>
                  </div>

                  <div class="stigma-plus-sign">+</div>

                  <div class="stigma-info-container">
                    <div class="stigma-image-container">
                      <StigmaImage
                        imageName={section.display.pieces.stigma2Name}
                        alt={`${section.display.pieces.stigma2Name} stigma`}
                        width={60}
                        height={60}
                        class="stigma-portrait-small"
                        loading="eager"
                      />
                    </div>
                    <div class="stigma-name-label">
                      <h5>{section.display.pieces.stigma2Name}</h5>
                      <HWRarityIcon rarity="EX" width={36} height={18} />
                    </div>
                  </div>
                </div>
              </div>

              <div class="stigma-bonuses">
                <div class="stigma-set-bonus">
                  <h5>{section.display.pieces.stigma1Name} (2-Set Bonus)</h5>
                  <p>{section.display.pieces.twoSetBonus1}</p>
                </div>
                <div class="stigma-set-bonus">
                  <h5>{section.display.pieces.stigma2Name} (2-Set Bonus)</h5>
                  <p>{section.display.pieces.twoSetBonus2}</p>
                </div>
              </div>

              <div class="stigma-pieces">
                <h5>Mixed Stigma Pieces</h5>
                <div class="stigma-grid">
                  <div class="stigma-piece">
                    <div class="piece-slot">Top</div>
                    <div class="piece-info">
                      <div class="piece-set-name">{section.display.pieces.top.name}</div>
                      <div class="piece-stat-value">{section.display.pieces.top.stat}</div>
                    </div>
                  </div>
                  <div class="stigma-piece">
                    <div class="piece-slot">Bottom</div>
                    <div class="piece-info">
                      <div class="piece-set-name">{section.display.pieces.bottom.name}</div>
                      <div class="piece-stat-value">{section.display.pieces.bottom.stat}</div>
                    </div>
                  </div>
                  <div class="stigma-piece">
                    <div class="piece-slot">Left</div>
                    <div class="piece-info">
                      <div class="piece-set-name">{section.display.pieces.left.name}</div>
                      <div class="piece-stat-value">{section.display.pieces.left.stat}</div>
                    </div>
                  </div>
                  <div class="stigma-piece">
                    <div class="piece-slot">Right</div>
                    <div class="piece-info">
                      <div class="piece-set-name">{section.display.pieces.right.name}</div>
                      <div class="piece-stat-value">{section.display.pieces.right.stat}</div>
                    </div>
                  </div>
                </div>
              </div>
            </>
            ) : section.display.type === 'object' ? (
            // Object-based Stigma Recommendations - Each stigma in separate section
            <>
              {/* First Stigma Option */}
              <div class="stigma-option-section">
                <div class="stigma-option-label">Option 1: Low Investment / Zero Dupe</div>
                <div class="stigma-header">
                  <div class="stigma-title-section">
                    <div class="stigma-image-container">
                      <StigmaImage
                        imageName={section.display.zeroDupe.name}
                        alt={`${section.display.zeroDupe.name} stigma`}
                        width={60}
                        height={60}
                        class="stigma-portrait-small"
                        loading="eager"
                      />
                    </div>
                    <div class="stigma-title-info">
                      <h4 class="stigma-name">{section.display.zeroDupe.name}</h4>
                      <HWRarityIcon rarity="EX" width={36} height={18} />
                    </div>
                  </div>
                </div>

                <div class="stigma-bonuses">
                  <div class="stigma-set-bonus">
                    <h5>2-Set Bonus</h5>
                    <p>{section.display.zeroDupe.twoSet}</p>
                  </div>
                  {section.display.zeroDupe.fourSet && (
                    <div class="stigma-set-bonus">
                      <h5>4-Set Bonus</h5>
                      <p>{section.display.zeroDupe.fourSet}</p>
                    </div>
                  )}
                </div>

                <div class="stigma-pieces">
                  <h5>Stigma Pieces</h5>
                  <div class="stigma-grid">
                    <div class="stigma-piece">
                      <div class="piece-slot">Top</div>
                      <div class="piece-info">
                        <div class="piece-name">{section.display.zeroDupe.pieces.top.name}</div>
                        <div class="piece-stat">{section.display.zeroDupe.pieces.top.stat}</div>
                      </div>
                    </div>
                    <div class="stigma-piece">
                      <div class="piece-slot">Bottom</div>
                      <div class="piece-info">
                        <div class="piece-name">{section.display.zeroDupe.pieces.bottom.name}</div>
                        <div class="piece-stat">{section.display.zeroDupe.pieces.bottom.stat}</div>
                      </div>
                    </div>
                    <div class="stigma-piece">
                      <div class="piece-slot">Left</div>
                      <div class="piece-info">
                        <div class="piece-name">{section.display.zeroDupe.pieces.left.name}</div>
                        <div class="piece-stat">{section.display.zeroDupe.pieces.left.stat}</div>
                      </div>
                    </div>
                    <div class="stigma-piece">
                      <div class="piece-slot">Right</div>
                      <div class="piece-info">
                        <div class="piece-name">{section.display.zeroDupe.pieces.right.name}</div>
                        <div class="piece-stat">{section.display.zeroDupe.pieces.right.stat}</div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              {/* Divider between options */}
              <div class="stigma-option-divider">
                <span>OR</span>
              </div>

              {/* Second Stigma Option */}
              <div class="stigma-option-section">
                <div class="stigma-option-label">Option 2: Full EX 5 Weapon</div>
                <div class="stigma-header">
                  <div class="stigma-title-section">
                    <div class="stigma-image-container">
                      <StigmaImage
                        imageName={section.display.fullEx5.name}
                        alt={`${section.display.fullEx5.name} stigma`}
                        width={60}
                        height={60}
                        class="stigma-portrait-small"
                        loading="eager"
                      />
                    </div>
                    <div class="stigma-title-info">
                      <h4 class="stigma-name">{section.display.fullEx5.name}</h4>
                      <HWRarityIcon rarity="EX" width={36} height={18} />
                    </div>
                  </div>
                </div>

                <div class="stigma-bonuses">
                  <div class="stigma-set-bonus">
                    <h5>2-Set Bonus</h5>
                    <p>{section.display.fullEx5.twoSet}</p>
                  </div>
                  {section.display.fullEx5.fourSet && (
                    <div class="stigma-set-bonus">
                      <h5>4-Set Bonus</h5>
                      <p>{section.display.fullEx5.fourSet}</p>
                    </div>
                  )}
                </div>

                <div class="stigma-pieces">
                  <h5>Stigma Pieces</h5>
                  <div class="stigma-grid">
                    <div class="stigma-piece">
                      <div class="piece-slot">Top</div>
                      <div class="piece-info">
                        <div class="piece-name">{section.display.fullEx5.pieces.top.name}</div>
                        <div class="piece-stat">{section.display.fullEx5.pieces.top.stat}</div>
                      </div>
                    </div>
                    <div class="stigma-piece">
                      <div class="piece-slot">Bottom</div>
                      <div class="piece-info">
                        <div class="piece-name">{section.display.fullEx5.pieces.bottom.name}</div>
                        <div class="piece-stat">{section.display.fullEx5.pieces.bottom.stat}</div>
                      </div>
                    </div>
                    <div class="stigma-piece">
                      <div class="piece-slot">Left</div>
                      <div class="piece-info">
                        <div class="piece-name">{section.display.fullEx5.pieces.left.name}</div>
                        <div class="piece-stat">{section.display.fullEx5.pieces.left.stat}</div>
                      </div>
                    </div>
                    <div class="stigma-piece">
                      <div class="piece-slot">Right</div>
                      <div class="piece-info">
                        <div class="piece-name">{section.display.fullEx5.pieces.right.name}</div>
                        <div class="piece-stat">{section.display.fullEx5.pieces.right.stat}</div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </>
            ) : section.display?.set ? (
            // Single Stigma Set Display (like Juha, Vlissing)
            <>
              <div class="stigma-header">
                <div class="stigma-title-section">
                  <div class="stigma-image-container">
                    <StigmaImage
                      imageName={section.display.set.name}
                      alt={`${section.display.set.name} stigma`}
                      width={60}
                      height={60}
                      class="stigma-portrait-small"
                      loading="eager"
                    />
                  </div>
                  <div class="stigma-title-info">
                    <h4 class="stigma-name">{section.display.set.name}</h4>
                    <HWRarityIcon rarity="EX" width={36} height={18} />
                  </div>
                </div>
              </div>

              <div class="stigma-bonuses">
                <div class="stigma-set-bonus">
                  <h5>2-Set Bonus</h5>
                  <p>{section.display.set.twoSet}</p>
                </div>
                <div class="stigma-set-bonus">
                  <h5>4-Set Bonus</h5>
                  <p>{section.display.set.fourSet}</p>
                  {section.display.set.specialEffect && (
                    <p class="stigma-special-effect"><strong>[{section.display.set.specialEffect.name}]:</strong> {section.display.set.specialEffect.description}</p>
                  )}
                </div>
              </div>

              <div class="stigma-pieces">
                <h5>Stigma Pieces</h5>
                <div class="stigma-grid">
                  <div class="stigma-piece">
                    <div class="piece-slot">Top</div>
                    <div class="piece-info">
                      <div class="piece-name">{section.display.set.pieces.top.name}</div>
                      <div class="piece-stat">{section.display.set.pieces.top.stat}</div>
                    </div>
                  </div>
                  <div class="stigma-piece">
                    <div class="piece-slot">Bottom</div>
                    <div class="piece-info">
                      <div class="piece-name">{section.display.set.pieces.bottom.name}</div>
                      <div class="piece-stat">{section.display.set.pieces.bottom.stat}</div>
                    </div>
                  </div>
                  <div class="stigma-piece">
                    <div class="piece-slot">Left</div>
                    <div class="piece-info">
                      <div class="piece-name">{section.display.set.pieces.left.name}</div>
                      <div class="piece-stat">{section.display.set.pieces.left.stat}</div>
                    </div>
                  </div>
                  <div class="stigma-piece">
                    <div class="piece-slot">Right</div>
                    <div class="piece-info">
                      <div class="piece-name">{section.display.set.pieces.right.name}</div>
                      <div class="piece-stat">{section.display.set.pieces.right.stat}</div>
                    </div>
                  </div>
                </div>
              </div>
            </>
            ) : (
              <div class="stigma-set-bonus">
                <h5>Stigma Plan</h5>
                <p>{buildConfig.recommendedStigma || 'See build strategy details.'}</p>
              </div>
            )}
          </div>
            ))}

        </div>
      </section>
    )
  }

    )
  }

  {/* Recommended Substats Section */}
  {
    (buildConfig.substatBuilds || buildConfig.recommendedSubstats) && (
      <section class="character-build-section">
        <h3 class="character-build-section-title">Recommended Substats</h3>
        <div class="stigma-container">
          <div class="recommended-substats">
            <h5>Recommended Sub Stats</h5>
            {
              buildConfig.substatBuilds ? (
                <div class="substat-builds">
                  {buildConfig.substatBuilds.map(build => (
                    <div class="substat-build-card">
                      <div class="substat-build-name">{build.name}</div>
                      {build.note && <div class="substat-build-note">{build.note}</div>}
                      <div class="substats-list">
                        {build.stats.map(stat => (
                          <div class="substat-item">
                            <div class="substat-info">
                              <div class="substat-name">{stat.stat}</div>
                              <span
                                class="hw-badge"
                                data-type={stat.priority === 'Highest' ? 'Main' : 'Alt'}
                              >
                                {stat.priority}
                              </span>
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              ) : (
                <div class="substats-list">
                  {buildConfig.recommendedSubstats.map((substat, index) => (
                    <div
                      class={`substat-item ${index < 3 ? 'priority-best' : index === 3 ? 'priority-alternative' : 'priority-optional'}`}
                    >
                      <div class="substat-info">
                        <div class="substat-name">{substat.stat}</div>
                        <div class="substat-priority">{substat.priority}</div>
                      </div>
                      <div class="substat-scale">{substat.scale}</div>
                    </div>
                  ))}
                </div>
              )
            }
            <div class="substats-note">
              <strong>Priority:</strong> {buildConfig.substatsPriority}
            </div>
                    </div>
        </div>
      </section>
    )
  }

  {/* Alternative Build Strategies Section */}
  {
    buildConfig.alternativeBuilds && buildConfig.alternativeBuilds.length > 0 && (
      <section class="character-build-section">
        <h3 class="character-build-section-title">Alternative Build Strategies</h3>
        <div class="alternative-builds-container">
          <div class="alternative-builds-grid">
            {buildConfig.alternativeBuilds.map(build => (
              <div class="alternative-build-card">
                <div class="alternative-build-header">
                  <h4 class="alternative-build-title">{build.title}</h4>
                  {build.recommendedStigma && (
                    <div class="alternative-build-stigma">
                      <div class="stigma-image-container">
                        <StigmaImage
                          imageName={build.recommendedStigma}
                          alt={`${build.recommendedStigma} stigma`}
                          width={64}
                          height={64}
                          class="stigma-portrait-medium"
                          loading="eager"
                        />
                      </div>
                      <div class="stigma-info">
                        <div class="stigma-label">Recommended Stigma</div>
                        <div class="stigma-name">{build.recommendedStigma}</div>
                      </div>
                    </div>
                  )}
                </div>
                <div class="alternative-build-content">
                  <p class="alternative-build-description">{build.description}</p>

                  {build.playstyle && (
                    <div class="alternative-build-playstyle">
                      <h5>Playstyle</h5>
                      <p>{build.playstyle}</p>
                    </div>
                  )}

                  {build.substatsFocus && (
                    <div class="alternative-build-substats">
                      <h5>Substats Priority</h5>
                      <p>{build.substatsFocus}</p>
                    </div>
                  )}

                  {build.note && (
                    <div class="alternative-build-note">
                      <h5>Traits Build Note</h5>
                      <p>{build.note}</p>
                    </div>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    character && (
      <>
        {/* Recommended Traits Section */}
        <section class="character-build-section">
          <h3 class="character-build-section-title">Recommended Traits</h3>
          <div class="recommended-traits">
            {buildConfig.traitBuilds ? (
              <div class="trait-builds">
                {buildConfig.traitBuilds.map(traitBuild => (
                  <div class="trait-build-block">
                    <h5 class="trait-build-title">{traitBuild.name}</h5>
                    <div class="traits-list">
                      {traitBuild.traits.map(trait => (
                        <div class="trait-item">
                          <div class="trait-info">
                            <div class="trait-name">{trait.name}</div>
                          </div>
                          <div class="trait-effects">
                            {trait.effects.map(effect => (
                              <div class="trait-effect">{effect}</div>
                            ))}
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <>
                <h5>Best Traits for {buildConfig.traitsType} (Max {buildConfig.traitsMax || 5} Traits)</h5>
                <div class="traits-list">
                  {buildConfig.recommendedTraits.map((trait, index) => (
                    <div class={`trait-item ${trait.priority === 'Best' ? 'priority-best' : 'priority-alternative'}`}>
                      <div class="trait-info">
                        <div class="trait-name">{trait.name}</div>
                        <span
                          class="hw-badge"
                          data-type={trait.priority === 'Best' ? 'Main' : 'Alt'}
                        >
                          {trait.priority === 'Best' ? 'Main' : 'Alt'}
                        </span>
                      </div>
                      <div class="trait-effects">
                        {trait.effects.map(effect => (
                          <div class="trait-effect">{effect}</div>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
                <div class="traits-note">
                  <strong>Recommended Selection:</strong> {buildConfig.traitRecommendation}
                </div>
              </>
            )}
          </div>
        </section>
      </>
    )
  }
</CharacterBuildLayout>
