---
import CharacterLayout from '../../../layouts/horizon-walker/CharacterLayout.astro';
import {
  HORIZON_WALKER_CHARACTERS,
  gameInfo,
} from '../../../data/horizon-walker/characters.js';
import {
  getStrengthValue,
  getIntelligenceValue,
  getVitalityValue,
  getAgilityValue,
  getTechnicValue,
} from '../../../utils/horizon-walker/character-table-utils.js';
import { CharacterImage, HWRarityIcon } from '../../../components/horizon-walker/index.astro';

// Extract filter options from enhanced data structure
const { rarities } = gameInfo;

// Define race tags for filtering
const raceTags = [
  'Human',
  'Swamp Elf',
  'Wood Elf',
  'Catsidhe',
  'Kobold',
  'Orke',
  'Torta',
  'Lamora',
  'Lamoran',
  'Fairy',
  'Machine',
  'Demon',
  'Elemental',
  'Kesak',
];

// Extract unique races from character tags
const availableRaces = raceTags.filter(race =>
  HORIZON_WALKER_CHARACTERS.some(char => char.tags && char.tags.includes(race))
);

// Calculate enhanced stats for display
const totalCharacters = HORIZON_WALKER_CHARACTERS.length;
const exCount = HORIZON_WALKER_CHARACTERS.filter(char => char.rarity === 'EX').length;
const ssCount = HORIZON_WALKER_CHARACTERS.filter(char => char.rarity === 'SS').length;
const sCount = HORIZON_WALKER_CHARACTERS.filter(char => char.rarity === 'S').length;
const aCount = HORIZON_WALKER_CHARACTERS.filter(char => char.rarity === 'A').length;
const bCount = HORIZON_WALKER_CHARACTERS.filter(char => char.rarity === 'B').length;

// DB table stats: default = base EX rarity stage, toggleable to full EX 6
// (values from each character's computed rarityStages; 5 primary stats)
const getStageStat = (char, field) => {
  if (char.stages?.ex?.[field] !== undefined) return char.stages.ex[field];
  return char.stats?.[field] ?? 'N/A';
};
const stageData = JSON.stringify(
  Object.fromEntries(HORIZON_WALKER_CHARACTERS.filter(c => c.stages).map(c => [c.id, c.stages]))
);

// Character name to filename mapping
const getImageKey = characterName => {
  let filename = characterName
    .replace(/ /g, '_') // Replace spaces with underscores
    .replace(/-/g, '_') // Replace hyphens with underscores
    .replace(/\./g, '_'); // Replace periods with underscores

  // Handle special character naming cases
  if (characterName === 'TX - Manticore') filename = 'TX_Manticore';
  if (characterName === 'Re_De_Da') filename = 'Re_De_Da';
  if (characterName === 'Headless Knight') filename = 'Headless_Knight';

  // Handle Korean character name mappings
  if (characterName === 'Kim Ga-young') filename = 'kim_Ga_young';
  if (characterName === 'Yeon Chae-Young') filename = 'Yeon_Chae-Young';
  if (characterName === 'Min Eun-sol') filename = 'Min_Eun_sol';
  if (characterName === 'So Joo-hee') filename = 'So_Joo_hee';

  return filename;
};

// SEO metadata
const title = 'Horizon Walker Characters Database - All Heroes & Waifus List 2025 | GachaWiki';
const description = `Explore all ${totalCharacters} Horizon Walker characters including ${exCount} EX, ${ssCount} SS, ${sCount} S, ${aCount} A, ${bCount} B rarity heroes. Complete database with stats, costs, classes, elements, and factions. Advanced filtering and mobile-optimized interface.`;
---

<CharacterLayout title={title} description={description}>
  <section class="hw-char-db-page-flex">
    <div class="hw-char-db-main-content">
      <div class="hw-char-db-content-wrapper">
        <!-- Header with stats info -->
        <div class="hw-character-database-header">
          <h1 class="hw-character-database-title">Character Database</h1>
          <p class="hw-character-database-subtitle">
            Level {gameInfo.maxLevel} stats at base EX rarity. Toggle for full EX 6.
          </p>
          <div class="hw-char-db-stats-summary">
            <div class="hw-rarity-stat">
              <HWRarityIcon rarity="EX" width={56} height={28} />
              <span class="hw-rarity-stat-count">{exCount}</span>
            </div>
            <div class="hw-rarity-stat">
              <HWRarityIcon rarity="SS" width={56} height={28} />
              <span class="hw-rarity-stat-count">{ssCount}</span>
            </div>
            <div class="hw-rarity-stat">
              <HWRarityIcon rarity="S" width={56} height={28} />
              <span class="hw-rarity-stat-count">{sCount}</span>
            </div>
            <div class="hw-rarity-stat">
              <HWRarityIcon rarity="A" width={56} height={28} />
              <span class="hw-rarity-stat-count">{aCount}</span>
            </div>
            <div class="hw-rarity-stat">
              <HWRarityIcon rarity="B" width={56} height={28} />
              <span class="hw-rarity-stat-count">{bCount}</span>
            </div>
          </div>
        </div>

        <!-- Filter Bar -->
        <div class="filter-bar">
          <div class="filter-controls">
            <select class="filter-select" id="rarity-filter">
              <option value="">Rarity</option>
              {rarities.map(rarity => <option value={rarity}>{rarity}</option>)}
            </select>
            <select class="filter-select" id="race-filter">
              <option value="">Race</option>
              {availableRaces.map(race => <option value={race}>{race}</option>)}
            </select>
          </div>
          <div class="hw-search-container">
            <input
              type="text"
              class="hw-search-input"
              id="character-search"
              placeholder="Search by name..."
            />
          </div>
          <div class="sort-controls">
            <button class="sort-btn" data-sort="rarity">Rarity</button>
            <button class="sort-btn" data-sort="cost">Cost</button>
            <button class="sort-btn" data-sort="strength">STR</button>
            <button class="sort-btn" data-sort="intelligence">INT</button>
            <button class="sort-btn" data-sort="vitality">VIT</button>
            <button class="sort-btn" data-sort="agility">AGI</button>
            <button class="sort-btn" data-sort="technic">TEC</button>
            <button class="reset-btn" id="reset-table">Reset</button>
          </div>
          <div class="hw-stage-toggle" id="stage-toggle" role="group" aria-label="Rarity stage">
            <button type="button" class="stage-btn active" data-stage="ex">EX</button>
            <button type="button" class="stage-btn" data-stage="ex6">Full EX 6</button>
          </div>
        </div>

        <!-- Desktop table container with touch optimizations -->
        <div class="character-table-container">
          <table class="character-table" id="character-table">
            <thead>
              <tr>
                <th>#</th>
                <th>Image</th>
                <th>Name</th>
                <th>Rarity</th>
                <th>Cost</th>
                <th>STR</th>
                <th>INT</th>
                <th>VIT</th>
                <th>AGI</th>
                <th>TEC</th>
              </tr>
            </thead>
            <tbody id="character-table-body">
              {
                HORIZON_WALKER_CHARACTERS.map((character, idx) => (
                  <tr
                    data-character-id={character.id}
                    data-url={character.detailUrl}
                    data-name={character.name}
                    data-rarity={character.rarity}
                    data-class={character.class}
                    data-element={character.element}
                    data-faction={character.faction}
                    data-tags={character.tags ? character.tags.join(', ') : ''}
                    class="clickable-row"
                    role="button"
                    tabindex="0"
                  >
                    <td>{idx + 1}</td>
                    <td>
                      <div class="desktop-character-image">
                        <CharacterImage
                          imageName={getImageKey(character.name)}
                          alt={character.name}
                          class="character-img"
                          width={80}
                          height={80}
                          loading={idx < 10 ? 'eager' : 'lazy'}
                        />
                      </div>
                    </td>
                    <td>
                      <strong
                        class="character-name"
                        data-long={character.name.length > 12 ? 'true' : 'false'}
                      >
                        {character.name}
                      </strong>
                    </td>
                    <td>
                      <HWRarityIcon
                        rarity={character.rarity}
                        width={48}
                        height={24}
                      />
                    </td>
                    <td data-sort-key="cost">
                      <strong class="cost-value">{character.cost}</strong>
                    </td>
                    <td data-sort-key="strength">
                      <strong class="stat-value" data-field="strength">{getStageStat(character, 'strength')}</strong>
                    </td>
                    <td data-sort-key="intelligence">
                      <strong class="stat-value" data-field="intelligence">{getStageStat(character, 'intelligence')}</strong>
                    </td>
                    <td data-sort-key="vitality">
                      <strong class="stat-value" data-field="vitality">{getStageStat(character, 'vitality')}</strong>
                    </td>
                    <td data-sort-key="agility">
                      <strong class="stat-value" data-field="agility">{getStageStat(character, 'agility')}</strong>
                    </td>
                    <td data-sort-key="technic">
                      <strong class="stat-value" data-field="technic">{getStageStat(character, 'technic')}</strong>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <!-- Mobile card view container with touch optimization -->
        <div class="mobile-card-view" id="mobile-cards-container">
          {
            HORIZON_WALKER_CHARACTERS.map((char, idx) => (
              <div
                class="mobile-character-card"
                data-character-id={char.id}
                data-slug={char.slug}
                data-url={char.detailUrl}
                data-name={char.name}
                data-rarity={char.rarity}
                data-class={char.class}
                data-element={char.element}
                data-faction={char.faction}
                data-tags={char.tags ? char.tags.join(', ') : ''}
                role="button"
                tabindex="0"
                style="cursor:pointer; touch-action: manipulation;"
              >
                {/* Clean header section - image, name, rarity all together */}
                <div class="mobile-card-header">
                  <div class="mobile-card-image">
                    <div class="mobile-character-image">
                      <CharacterImage
                        imageName={getImageKey(char.name)}
                        alt={char.name}
                        class="character-img"
                        width={64}
                        height={64}
                        loading={idx < 6 ? 'eager' : 'lazy'}
                      />
                    </div>
                  </div>
                  <div class="mobile-card-info">
                    <h3 class="character-name" data-long={char.name.length > 12 ? 'true' : 'false'}>
                      {char.name}
                    </h3>
                    <div class="header-badges">
                      <HWRarityIcon rarity={char.rarity} width={40} height={20} />
                      <span class="cost-badge" data-type="Cost">
                        Cost: {char.cost}
                      </span>
                    </div>
                  </div>
                </div>

                {/* Clean stats grid - 5 basic stats */}
                <div class="mobile-card-stats-grid">
                  <div class="stat-item">
                    <span class="stat-label">STR</span>
                    <strong class="stat-value" data-stat="strength" data-field="strength">
                      {getStageStat(char, 'strength')}
                    </strong>
                  </div>
                  <div class="stat-item">
                    <span class="stat-label">INT</span>
                    <strong class="stat-value" data-stat="intelligence" data-field="intelligence">
                      {getStageStat(char, 'intelligence')}
                    </strong>
                  </div>
                  <div class="stat-item">
                    <span class="stat-label">VIT</span>
                    <strong class="stat-value" data-stat="vitality" data-field="vitality">
                      {getStageStat(char, 'vitality')}
                    </strong>
                  </div>
                  <div class="stat-item">
                    <span class="stat-label">AGI</span>
                    <strong class="stat-value" data-stat="agility" data-field="agility">
                      {getStageStat(char, 'agility')}
                    </strong>
                  </div>
                  <div class="stat-item">
                    <span class="stat-label">TEC</span>
                    <strong class="stat-value" data-stat="technic" data-field="technic">
                      {getStageStat(char, 'technic')}
                    </strong>
                  </div>
                </div>

              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Per-character rarity-stage values for the stats toggle -->
  <script type="application/json" id="hw-stage-data" set:html={stageData} />

  <!-- Stats stage toggle: swaps the 5 primary stats between EX and full EX 6 -->
  <script is:inline>
    (function () {
      var dataEl = document.getElementById('hw-stage-data');
      var toggle = document.getElementById('stage-toggle');
      if (!dataEl || !toggle) return;
      var stageMap = {};
      try {
        stageMap = JSON.parse(dataEl.textContent);
      } catch (e) {
        return;
      }
      var buttons = toggle.querySelectorAll('.stage-btn');
      function applyStage(stage) {
        document.querySelectorAll('[data-character-id]').forEach(function (row) {
          var stages = stageMap[row.getAttribute('data-character-id')];
          if (!stages || !stages[stage]) return;
          row.querySelectorAll('[data-field]').forEach(function (el) {
            var value = stages[stage][el.getAttribute('data-field')];
            if (value !== undefined) el.textContent = value;
          });
        });
        buttons.forEach(function (btn) {
          btn.classList.toggle('active', btn.getAttribute('data-stage') === stage);
        });
      }
      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          applyStage(btn.getAttribute('data-stage'));
        });
      });
    })();
  </script>

  <!-- Load the character database script with sorting and filtering functionality -->
  <script src="../../../scripts/horizon-walker/character-database.js"></script>
</CharacterLayout>
