---
import CharacterIndividualLayout from '../../../../layouts/horizon-walker/CharacterIndividualLayout.astro';
import CharacterPageTemplate from '../../../../templates/horizon-walker/CharacterPageTemplate.astro';
import {
  charlotteData,
  charlotteSEO,
  charlotteHighlighting,
} from '../../../../data/horizon-walker/characters/charlotte.js';

export const prerender = true;
---

<CharacterIndividualLayout
  title={charlotteSEO.title}
  description={charlotteSEO.description}
  character={charlotteData}
>
  <CharacterPageTemplate characterData={{ ...charlotteData, highlightPatterns: charlotteHighlighting }} />
</CharacterIndividualLayout>
