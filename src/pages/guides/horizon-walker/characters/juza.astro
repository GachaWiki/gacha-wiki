---
import CharacterIndividualLayout from '../../../../layouts/horizon-walker/CharacterIndividualLayout.astro';
import CharacterPageTemplate from '../../../../templates/horizon-walker/CharacterPageTemplate.astro';
import {
  juzaData,
  juzaSEO,
  juzaHighlighting,
} from '../../../../data/horizon-walker/characters/juza.js';

export const prerender = true;
---

<CharacterIndividualLayout
  title={juzaSEO.title}
  description={juzaSEO.description}
  character={juzaData}
>
  <CharacterPageTemplate characterData={{ ...juzaData, highlightPatterns: juzaHighlighting }} />
</CharacterIndividualLayout>
