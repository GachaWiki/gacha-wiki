---
import CharacterIndividualLayout from '../../../../layouts/horizon-walker/CharacterIndividualLayout.astro';
import CharacterPageTemplate from '../../../../templates/horizon-walker/CharacterPageTemplate.astro';
import {
  miranaData,
  miranaSEO,
  miranaHighlighting,
} from '../../../../data/horizon-walker/characters/mirana.js';

export const prerender = true;
---

<CharacterIndividualLayout
  title={miranaSEO.title}
  description={miranaSEO.description}
  character={miranaData}
>
  <CharacterPageTemplate characterData={{ ...miranaData, highlightPatterns: miranaHighlighting }} />
</CharacterIndividualLayout>
