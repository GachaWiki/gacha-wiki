---
import CharacterIndividualLayout from '../../../../layouts/horizon-walker/CharacterIndividualLayout.astro';
import CharacterPageTemplate from '../../../../templates/horizon-walker/CharacterPageTemplate.astro';
import {
  miraData,
  miraSEO,
  miraHighlighting,
} from '../../../../data/horizon-walker/characters/mira.js';

export const prerender = true;
---

<CharacterIndividualLayout
  title={miraSEO.title}
  description={miraSEO.description}
  character={miraData}
>
  <CharacterPageTemplate characterData={{ ...miraData, highlightPatterns: miraHighlighting }} />
</CharacterIndividualLayout>
