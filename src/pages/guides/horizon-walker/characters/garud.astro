---
import CharacterIndividualLayout from '../../../../layouts/horizon-walker/CharacterIndividualLayout.astro';
import CharacterPageTemplate from '../../../../templates/horizon-walker/CharacterPageTemplate.astro';
import {
  garudData,
  garudSEO,
  garudHighlighting,
} from '../../../../data/horizon-walker/characters/garud.js';

export const prerender = true;
---

<CharacterIndividualLayout
  title={garudSEO.title}
  description={garudSEO.description}
  character={garudData}
>
  <CharacterPageTemplate characterData={{ ...garudData, highlightPatterns: garudHighlighting }} />
</CharacterIndividualLayout>
