---
// Language selection page for Horizon Walker: shown when entering the wiki
// from the games list. Thin wrapper around the shared LanguageSelectTemplate:
// the English wiki plus four wikis using the game's own localization.
import LanguageSelectTemplate from '../../../templates/LanguageSelectTemplate.astro';

export const prerender = true;
---

<LanguageSelectTemplate
  gameKey="horizon-walker"
  gameName="Horizon Walker"
  accent="#e8a53d"
  languages={[
    { lang: 'English', note: 'English wiki', href: '/guides/horizon-walker/' },
    { lang: '中文', htmlLang: 'zh-Hans', note: '官方游戏文本 · 简体中文', href: '/zh/guides/horizon-walker/' },
    { lang: '繁體中文', htmlLang: 'zh-Hant', note: '官方遊戲文本', href: '/zh-tw/guides/horizon-walker/' },
    { lang: '日本語', htmlLang: 'ja', note: '公式ローカライズ', href: '/ja/guides/horizon-walker/' },
    { lang: '한국어', htmlLang: 'ko', note: '공식 로컬라이즈', href: '/ko/guides/horizon-walker/' },
  ]}
/>
