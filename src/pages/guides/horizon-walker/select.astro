---
// Language selection page for Horizon Walker: shown when entering the wiki
// from the games list. Thin wrapper around the shared LanguageSelectTemplate,
// themed with the game's own CSS and background layers: the English wiki plus
// four wikis using the game's own localization.
import LanguageSelectTemplate from '../../../templates/LanguageSelectTemplate.astro';
import HWBaseHead from '../../../components/horizon-walker/HWBaseHead.astro';
import { getGameLanguageInfo } from '../../../data/game-languages';
import '../../../styles/games/horizon-walker/hw-colors.css';
import '../../../styles/games/horizon-walker/hw-layout.css';

export const prerender = true;

const title = 'Horizon Walker Wiki: Choose Language - GachaWiki';
const langs = getGameLanguageInfo('horizon-walker');
---

<LanguageSelectTemplate
  gameKey="horizon-walker"
  gameName="Horizon Walker"
  accent="#e8a53d"
  bodyClass="horizon-walker-body"
  contentClass="horizon-walker-content"
  containerClass="horizon-walker-container"
  mainClass="horizon-walker-main"
  bgLayers={['hw-bg-primary', 'hw-bg-accent-1', 'hw-bg-accent-2']}
  heroClass="title-only-section"
  titleClass="title-only-heading"
  decorativeLines
  languages={langs?.languages ?? []}
>
  <HWBaseHead slot="head" title={title} description="Choose the language for the Horizon Walker wiki: English, Chinese (简体中文/繁體中文), Japanese or Korean." />
</LanguageSelectTemplate>
