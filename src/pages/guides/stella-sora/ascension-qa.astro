---
// Stella Sora Ascension Q&A (Monolith quiz events 114-116)
// Sources: StarTowerEventAction/StarTowerEventOptionAction loc keys, StarTowerNPC names,
// EventOptions reward text ("Choose the correct answer to obtain random ...").
// Correct answers cross-checked against community key (stella.ennead.cc/monolith);
// in the client data the correct option is always slot 3 of 5.
import AscensionQALayout from '../../../layouts/stella-sora/AscensionQALayout.astro';

const R2 = 'https://img.gachawiki.info/stella-sora/star-tower';

const NPC_AVATARS = {
  Portia: `${R2}/portia.png`,
  Beatrixa: `${R2}/beatrixa.png`,
  Bernina: `${R2}/bernina.png`,
  Virigia: `${R2}/virigia.png`,
};

const questions = [
  // Event 114: Musical Notes
  {
    event: 114,
    character: 'Portia',
    question: 'What time do you think counts as "staying up late"?',
    options: [
      "Eight o'clock?",
      "Nine o'clock?",
      "Twelve o'clock?",
      '5 AM?',
      "Eight o'clock tomorrow morning?",
    ],
    correctAnswer: 2,
    reward: 'Random Musical Note ×10!',
  },
  {
    event: 114,
    character: 'Beatrixa',
    question: 'Which of the following helps with maintaining your health?',
    options: [
      'Stay up every night?',
      'Sitting still too long?',
      'Balanced Diet?',
      'Turn into a Stellaroid?',
      'Overeating?',
    ],
    correctAnswer: 2,
    reward: 'Random Musical Note ×10!',
  },
  {
    event: 114,
    character: 'Bernina',
    question: 'Being true to your desire... What do you think that means?',
    options: [
      'Work hard to learn knowledge!',
      'Exercise seriously!',
      'Carpe diem!',
      'Eat in moderation!',
      'Working late into the night!',
    ],
    correctAnswer: 2,
    reward: 'Random Musical Note ×10!',
  },
  {
    event: 114,
    character: 'Virigia',
    question: 'How would you define aiming high?',
    options: [
      'Live however you please.',
      'Seize the pleasure of the moment.',
      'Make a plan and follow it through.',
      "Obey others' orders.",
      'Follow the crowd.',
    ],
    correctAnswer: 2,
    reward: 'Random Musical Note ×10!',
  },
  // Event 115: Potentials
  {
    event: 115,
    character: 'Portia',
    question: "Take a guess... What's the Monolith's favorite number?",
    options: [
      "1? Because there's only one path...",
      "2? Because there's only up and down...",
      '3? Because there are always three options...',
      '4? Because there are 4 of you...',
      '5? Because I always end up with 5 coins left...',
    ],
    correctAnswer: 2,
    reward: 'Random Potential ×1!',
  },
  {
    event: 115,
    character: 'Beatrixa',
    question: 'Which food is better for your health?',
    options: [
      'Eat more Stellaroid?',
      'Eat more grass?',
      'Eat more veg things?',
      'Eat more wood?',
      'Eat more rocks?',
    ],
    correctAnswer: 2,
    reward: 'Random Potential ×1!',
  },
  {
    event: 115,
    character: 'Bernina',
    question: 'Take a guess... Which kind of Trekker do I admire more?',
    options: [
      'Someone clever and sharp.',
      "Someone who's warm and positive.",
      "Someone who's governed by desire.",
      "Someone who's gloomy and pessimistic.",
      "Someone who's foolish and slow.",
    ],
    correctAnswer: 2,
    reward: 'Random Potential ×1!',
  },
  {
    event: 115,
    character: 'Virigia',
    question: 'Take a guess... Which kind of Trekker do I prefer to talk with?',
    options: [
      'Someone who complains nonstop.',
      'Someone who goes with the crowd.',
      'Someone who aims high.',
      'Someone who refuses to think.',
      'Someone who gives in too easily.',
    ],
    correctAnswer: 2,
    reward: 'Random Potential ×1!',
  },
  // Event 116: Rare Potentials
  {
    event: 116,
    character: 'Portia',
    question: 'Quiz time: What is 2 to the power of 10?',
    options: ['64?', '256?', '1024?', '4096?', '65536?'],
    correctAnswer: 2,
    reward: 'Random Rare Potential ×1!',
  },
  {
    event: 116,
    character: 'Beatrixa',
    question: 'Which of the following should you do less of for the sake of your health?',
    options: [
      'Eat less breakfast?',
      'Brush less?',
      "Don't sit too long?",
      'Less time in the sun?',
      'Less exercise?',
    ],
    correctAnswer: 2,
    reward: 'Random Rare Potential ×1!',
  },
  {
    event: 116,
    character: 'Bernina',
    question: 'Quiz time: How many notes are in an octave?',
    options: ['5?', '8?', '12?', '16?', '18?'],
    correctAnswer: 2,
    reward: 'Random Rare Potential ×1!',
  },
  {
    event: 116,
    character: 'Virigia',
    question: 'Quiz time: How many faces does a cube have?',
    options: ['4?', '5?', '6?', '7?', '8?'],
    correctAnswer: 2,
    reward: 'Random Rare Potential ×1!',
  },
];

const EVENT_META = {
  114: { title: 'Musical Notes', reward: 'Random Musical Note ×10!' },
  115: { title: 'Potentials', reward: 'Random Potential ×1!' },
  116: { title: 'Rare Potentials', reward: 'Random Rare Potential ×1!' },
};

// The 25 other Choice Domain event types (StarTowerEvent 101-128), grouped by what
// the interaction is, per the table's own category fields plus the option texts.
const OTHER_EVENTS = [
  {
    group: 'Trades',
    note: 'Swap Stella Coins, Musical Notes or HP for goods. Most also offer a "scraps" fallback if you would rather not pay.',
    events: [
      { id: 101, label: 'Trade for items (Portia\'s shop)' },
      { id: 102, label: 'Trade for Potentials' },
      { id: 104, label: 'Limited item: pay Notes or Coins' },
      { id: 108, label: 'Trade with the music box' },
      { id: 120, label: 'Buy goods or take scraps (Notes)' },
      { id: 121, label: 'Buy goods or take scraps (Potentials)' },
      { id: 122, label: 'Premium goods or scraps (Potentials)' },
    ],
  },
  {
    group: 'Gambles',
    note: 'Bet on a machine, a potion or the Gamble of Destiny. Winning pays Coins or Potentials, losing costs what you wagered, so only gamble what you can spare.',
    events: [
      { id: 105, label: 'Gamble of Destiny (Coins)' },
      { id: 106, label: 'Gamble of Destiny (Potentials)' },
      { id: 109, label: 'Mystery box' },
      { id: 110, label: 'Mystery box' },
      { id: 117, label: 'Magic game machine (Coins)' },
      { id: 118, label: 'Game machine (Coins + Potentials)' },
      { id: 119, label: 'Game machine (Coins + Potentials)' },
      { id: 124, label: 'Machine or potion (Potentials)' },
      { id: 125, label: 'Machine or potion (Potentials)' },
    ],
  },
  {
    group: 'HP trades',
    note: 'Trade a slice of your HP for a reward. Risky mid-run.',
    events: [
      { id: 111, label: 'Heal or trade HP' },
      { id: 112, label: 'Heal or trade HP' },
      { id: 113, label: 'Heal or trade HP' },
      { id: 123, label: 'Offer HP for Potentials' },
    ],
  },
  {
    group: 'Blessings',
    note: 'No strings attached: pick a song for a blessing or accept a gift from the Demons.',
    events: [
      { id: 103, label: 'Follow the music (Coins)' },
      { id: 107, label: 'Pick a song (Musical Notes)' },
      { id: 126, label: 'Gift of friendship (Potentials + Notes)' },
      { id: 127, label: 'Gift of friendship (Potentials + Coins)' },
      { id: 128, label: 'Gift of friendship (Potentials + Coins)' },
    ],
  },
];

// Group questions by event, keeping event order 114, 115, 116
const events = Object.keys(EVENT_META)
  .map(Number)
  .map((eventId) => ({
    id: eventId,
    ...EVENT_META[eventId],
    questions: questions.filter((q) => q.event === eventId),
  }));
---

<AscensionQALayout
  title="Stella Sora Ascension Q&A - Quiz Questions & Answers"
  description="Complete guide to Ascension quiz questions in Stella Sora. Find all questions, correct answers, and rewards including Musical Notes and Potential items."
  gameTitle="Ascension Q&A"
>
  <div class="ascension-qa-container">
    <p class="ascension-intro">
      During Ascension runs, Choice Domain rooms hold an event hosted by the shop assistant Portia,
      the medic Beatrixa, or the two Demons of the Monolith, Bernina and Virigia. Events 114 to 116
      are knowledge quizzes: only the correct answer pays out (Musical Notes or Potentials), a wrong
      answer pays nothing and that option is locked out, but you may pick again. All other event
      types are trades, gambles or gifts, and gamble payouts are decided per run.
    </p>

    <div class="ascension-search" role="search" aria-label="Search quiz questions">
      <input
        type="search"
        class="ascension-search-input"
        id="ascension-search-input"
        placeholder="Search by name or question: Portia, Beatrixa, Bernina, Virigia..."
        aria-label="Search by character name or question"
        autocomplete="off"
      />
    </div>

    {
      events.map((event) => (
        <section class="ascension-event" aria-label={`Event ${event.id}: ${event.title}`}>
          <header class="ascension-event-header">
            <h2 class="ascension-event-title">
              Event {event.id}
              <span class="ascension-event-name">{event.title}</span>
            </h2>
            <span class="ascension-event-reward">{event.reward}</span>
          </header>
          <div class="qa-list">
            {event.questions.map((q) => {
              const searchText = [event.id, event.title, q.character, q.question, ...q.options]
                .join(' ')
                .toLowerCase();
              return (
              <article class="qa-card" data-search={searchText}>
                <header class="qa-header">
                  <img
                    class="qa-avatar"
                    src={NPC_AVATARS[q.character]}
                    alt={`${q.character} portrait`}
                    width="55"
                    height="48"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="qa-character">{q.character}</span>
                </header>
                <h3 class="qa-question">{q.question}</h3>
                <div class="qa-options">
                  {q.options.map((option, optIndex) => (
                    <div class={`qa-option ${optIndex === q.correctAnswer ? 'correct' : ''}`}>
                      <span class="option-num">{optIndex + 1}</span>
                      <span class="option-text">{option}</span>
                      {optIndex === q.correctAnswer && <span class="correct-badge">Correct</span>}
                    </div>
                  ))}
                </div>
              </article>
              );
            })}
          </div>
        </section>
      ))
    }

    <div class="ascension-no-results" id="ascension-no-results" style="display: none;">
      <p class="ascension-no-results-title">No matches found</p>
      <p class="ascension-no-results-hint">
        Try a character name like Portia, or a keyword from a question.
      </p>
    </div>

    <section
      class="ascension-other"
      id="ascension-other"
      aria-label="Other Choice Domain events"
    >
      <h2 class="ascension-other-title">Every other Choice Domain event</h2>
      <p class="ascension-other-intro">
        Quizzes are only 3 of the 28 Choice Domain events (101 to 128). Here is the rest, grouped by
        how they play. Exact Coin payouts are decided per run.
      </p>
      {OTHER_EVENTS.map((group) => (
        <div class="ascension-event-group">
          <h3 class="ascension-event-group-title">{group.group}</h3>
          <p class="ascension-event-group-note">{group.note}</p>
          <ul class="ascension-event-list">
            {group.events.map((e) => {
              const itemSearch = [e.id, e.label, group.group].join(' ').toLowerCase();
              return (
                <li class="ascension-event-item" data-search={itemSearch}>
                  <span class="ascension-event-id">Event {e.id}</span>
                  <span class="ascension-event-label">{e.label}</span>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </section>
  </div>
</AscensionQALayout>

<script>
  // Ascension Q&A live search: filters quiz cards and Choice Domain events by name or text
  function initializeAscensionSearch() {
    const searchInput = document.getElementById('ascension-search-input') as HTMLInputElement | null;
    const noResults = document.getElementById('ascension-no-results');
    const otherSection = document.getElementById('ascension-other');
    if (!searchInput || !noResults || !otherSection) return;

    const eventSections = Array.from(
      document.querySelectorAll<HTMLElement>('.ascension-event')
    );
    const otherGroups = Array.from(
      document.querySelectorAll<HTMLElement>('.ascension-event-group')
    );

    function applyFilters() {
      const term = searchInput.value.toLowerCase().trim();
      let visibleCount = 0;

      eventSections.forEach((section) => {
        let sectionVisible = 0;
        section.querySelectorAll<HTMLElement>('.qa-card').forEach((card) => {
          const show = term === '' || (card.dataset.search || '').includes(term);
          card.style.display = show ? '' : 'none';
          if (show) {
            sectionVisible++;
            visibleCount++;
          }
        });
        section.style.display = sectionVisible > 0 ? '' : 'none';
      });

      let otherVisible = 0;
      otherGroups.forEach((group) => {
        let groupVisible = 0;
        group.querySelectorAll<HTMLElement>('.ascension-event-item').forEach((item) => {
          const show = term === '' || (item.dataset.search || '').includes(term);
          item.style.display = show ? '' : 'none';
          if (show) {
            groupVisible++;
            otherVisible++;
          }
        });
        group.style.display = groupVisible > 0 ? '' : 'none';
      });
      otherSection.style.display = otherVisible > 0 ? '' : 'none';
      visibleCount += otherVisible;

      noResults.style.display = visibleCount === 0 ? '' : 'none';
    }

    searchInput.addEventListener('input', applyFilters);
    applyFilters();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeAscensionSearch);
  } else {
    initializeAscensionSearch();
  }
</script>
