---
// Gene-Sys: Adam tier list (EN): thin wrapper over the shared I18nTierList
// body; all placements, notes, element overrides and pairs live in
// tier-list.js so every locale updates together.
import GSALayout from '../../../layouts/gene-sys-adam/LandingLayout.astro';
import I18nTierList from '../../../components/gene-sys-adam/i18n/I18nTierList.astro';
import { gsaTierSsrCount, GSA_TIER_UPDATED } from '../../../data/gene-sys-adam/tier-list.js';
import { gsaCharacters } from '../../../data/gene-sys-adam/characters.js';
---

<GSALayout
  title="Tier List"
  description={`Gene-Sys: Adam SSR tier list (${GSA_TIER_UPDATED}): all ${gsaTierSsrCount} SSR characters rated by job and by element, from the decrypted skill numbers.`}
