---
// Gene-Sys: Adam update index. The developer ships no external patch notes,
// so entries are reconstructed from diffs of the decrypted Patch tables.
// Art-led teaser cards; each links to its own detail page with the full list.
import GSALayout from '../../../layouts/gene-sys-adam/LandingLayout.astro';
import { GSA_UPDATES } from '../../../data/gene-sys-adam/updates.js';
import '../../../styles/games/gene-sys-adam/gsa-common.css';
import '../../../styles/games/gene-sys-adam/gsa-banners.css';
---

<GSALayout
  title="Updates"
  description="Gene-Sys: Adam update log: every game update reconstructed from the decrypted client tables, newest first."
  gameTitle="Updates"
  crumbName="Updates"
>
  <section>
    <p class="gsa-banner-intro">
      Official posts and their art come from the game's own news feed at
      genesys-adam.com. Waves the developer never posted about are reconstructed
      by diffing the decrypted game tables and are tagged Datamine, so their
      content lists are exact even where dates are approximate. Every entry has
      its own page with the full details.
    </p>

    {GSA_UPDATES.map(u => (
      <article class="gsa-update-card">
        <a class="gsa-update-teaser" href={`/guides/gene-sys-adam/updates/${u.slug}/`}>
          <div class="gsa-update-artwrap">
            {u.image
              ? (
                <div class="gsa-banner-art-pair">
                  <img class="gsa-update-art" src={u.image} alt={u.imageCaption || `${u.title} art`} width={u.imageW || 1280} height={u.imageH || 720} loading="lazy" />
                  {u.image2 && <img class="gsa-update-art" src={u.image2} alt={u.imageCaption || `${u.title} second panel`} width={u.imageW || 1280} height={u.imageH || 720} loading="lazy" />}
                </div>
              )
              : <div class="gsa-update-art-band">{u.date}</div>}
          </div>
          <div class="gsa-update-head">
            <h2 class="gsa-update-title">{u.title}</h2>
            <span class="gsa-update-tag">{u.tag}</span>
            <span class="gsa-update-date">{u.date}</span>
          </div>
          {u.summary && <p class="gsa-update-summary">{u.summary}</p>}
          <span class="gsa-update-more">Read the full update</span>
        </a>
      </article>
    ))}
  </section>
</GSALayout>
