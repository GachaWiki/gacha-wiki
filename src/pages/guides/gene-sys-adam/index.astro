---
// Gene-Sys: Adam game overview landing page (standard wiki landing: hero banner,
// story, facts, download row, resources — mirrors agent-x/majo structure).
import GSALayout from '../../../layouts/gene-sys-adam/LandingLayout.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import DiscordPromo from '../../../components/DiscordPromo.astro';
import GameLanguageLinks from '../../../components/GameLanguageLinks.astro';
import { gsaCharacters } from '../../../data/gene-sys-adam/characters.js';
import { SITE } from '../../../consts';
import '../../../styles/games/gene-sys-adam/gsa-landing.css';

const roster = gsaCharacters.length;
---

<GSALayout
  title="Home"
  description="Gene-Sys: Adam wiki: Sin City revenge RPG. Character database with profiles, stats, skills and growth systems."
  gameTitle="Gene-Sys: Adam"
  ambientVideo={true}
>
  <section class="gsa-content-section">
    <div class="gsa-story">
      <p>
        <strong>Gene-Sys: Adam</strong> (黑色基因) is an R18 dark urban revenge RPG set in a
        crime-ridden metropolis. You follow <strong>Theodore</strong>, a mysterious survivor of
        the plague and countless battlefields, who returns to the land of his birth with a thirst
        for revenge. Recruit agents from the city's factions, uncover the conspiracy behind the
        outbreak, and take back the streets in real-time squad combat.
      </p>
      <p>
        The game launched on in September 2026 with a roster of {roster} profiled
        characters. This wiki is built from the live client data: every table on these pages was
        decrypted from the game files, so numbers match the shipped game exactly.
      </p>
    </div>

    <div class="gsa-download-row">
      <a
        class="gsa-download-btn"
        href="https://game.erolabsshare.live/app/f302f717/Gene_Sys_Adam"
        target="_blank"
        rel="noopener noreferrer"
      >
        Download &amp; Play Gene-Sys: Adam
        <span class="gsa-download-arrow">→</span>
      </a>

      <a
        class="gsa-download-btn"
        href="https://www.genesys-adam.com/"
        target="_blank"
        rel="noopener noreferrer"
      >
        Official Site
        <span class="gsa-download-arrow">→</span>
      </a>
    </div>

    <DiscordPromo accent="#d24a58" />

    <p class="gsa-last-updated">
      Last Updated: <FormattedDate date={new Date('2026-09-17')} />
    </p>
  </section>

  <section class="gsa-resources-section">
    <h2 class="gsa-resources-title">Guides &amp; Resources</h2>

    <div class="gsa-resources-grid">
      <div class="gsa-resource-category">
        <div class="gsa-category-header">
          <h3>Characters</h3>
          <p class="gsa-category-description">
            All {roster} profiled characters with stats, skills, profiles and gacha availability.
          </p>
        </div>
        <div class="gsa-buttons-grid">
          <a href="/guides/gene-sys-adam/characters/" class="gsa-resource-button">Character Database</a>
          <a href="/guides/gene-sys-adam/tier-list/" class="gsa-resource-button">Tier List</a>
          <a href="/guides/gene-sys-adam/armament/" class="gsa-resource-button">Armament</a>
        </div>
      </div>
      <div class="gsa-resource-category">
        <div class="gsa-category-header">
          <h3>Game</h3>
          <p class="gsa-category-description">
            Banner list with pity reference, and the update log reconstructed from the game tables.
          </p>
        </div>
        <div class="gsa-buttons-grid">
          <a href="/guides/gene-sys-adam/banners/" class="gsa-resource-button">Banners</a>
          <a href="/guides/gene-sys-adam/updates/" class="gsa-resource-button">Updates</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Other language wikis -->
  <GameLanguageLinks gameKey="gene-sys-adam" currentHref="/guides/gene-sys-adam/" />
</GSALayout>
