---
// Language selection page for Gene-Sys: Adam: shown when entering the wiki
// from the games list. Thin wrapper around the shared LanguageSelectTemplate,
// themed with the game's own CSS: English wiki or the Traditional Chinese
// wiki (the game's base language).
import LanguageSelectTemplate from '../../../templates/LanguageSelectTemplate.astro';
import { getGameLanguageInfo } from '../../../data/game-languages';
import '../../../styles/games/gene-sys-adam/gsa-common.css';

export const prerender = true;

const langs = getGameLanguageInfo('gene-sys-adam');
---

<LanguageSelectTemplate
  gameKey="gene-sys-adam"
  gameName="Gene-Sys: Adam"
  accent="#e0596b"
  subtitle="Choose a language · 選擇語言 · 言語を選択 · 언어 선택"
  bodyClass="gsa-body"
  contentClass="gsa-content"
  containerClass="gsa-container"
  mainClass="gsa-main"
  bgLayers={['gsa-bg']}
  heroClass="gsa-title-only-section"
  titleClass="gsa-title-only-heading"
  decorativeLines
  languages={langs?.languages ?? []}
/>
