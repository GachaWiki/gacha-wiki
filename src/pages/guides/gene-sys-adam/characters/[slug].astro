---
// Gene-Sys: Adam character detail: header card with portrait, base stats,
// skills with slot unlock stars, growth system, profile (majo-style structure).
import GSALayout from '../../../../layouts/gene-sys-adam/LandingLayout.astro';
import { gsaCharacters, getGsaCharacter } from '../../../../data/gene-sys-adam/characters.js';
import { gsaItems } from '../../../../data/gene-sys-adam/items.js';
import { gsaPropertyTypes } from '../../../../data/gene-sys-adam/property-types.js';
import { getGsaReworkArchive } from '../../../../data/gene-sys-adam/rework-archive.js';
import { gsaPursuitRole, GSA_PURSUIT_ROLES } from '../../../../data/gene-sys-adam/pursuit-roles.js';
import { GSA_TIER_PLACEMENTS, gsaRarityBadge, gsaFullDisplayName } from '../../../../data/gene-sys-adam/tier-list.js';
import { GSA_STATUSES, GSA_CHAR_STATUSES } from '../../../../data/gene-sys-adam/statuses.js';
import '../../../../styles/games/gene-sys-adam/gsa-common.css';
import '../../../../styles/games/gene-sys-adam/gsa-characters.css';

export async function getStaticPaths() {
  return gsaCharacters.map(c => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const c = getGsaCharacter(slug);
if (!c) return Astro.redirect('/guides/gene-sys-adam/characters/');

const reworkArchive = getGsaReworkArchive(slug);

// Pursuit-system role: trigger fires pursuits, enabler applies the initiating
// status, both is self-sufficient. "Pairs with" lists the roster characters
// that feed or consume this character's element chains, computed from the
// same roles data (factual, not editorial).
const pursuit = gsaPursuitRole(slug);
const ROLE_LABEL = {
  trigger: 'Pursuit Trigger',
  enabler: 'Status Enabler',
  both: 'Trigger and Enabler',
  none: 'No Pursuit Role',
};
const bySlug = Object.fromEntries(gsaCharacters.map(x => [x.slug, x]));
const partners = new Set();
if (pursuit.role !== 'none') {
  for (const [s2, r2] of Object.entries(GSA_PURSUIT_ROLES)) {
    if (s2 === slug || !bySlug[s2]) continue;
    const feedsMe =
      (pursuit.role === 'trigger' || pursuit.role === 'both') &&
      r2.applies.some(a => pursuit.triggers.some(t => t.element === a.element));
    const iFeed =
      (pursuit.role === 'enabler' || pursuit.role === 'both') &&
      r2.triggers.some(t => pursuit.applies.some(a => a.element === t.element));
    if (feedsMe || iFeed) partners.add(s2);
  }
}

// Other playable versions of this character: same nameZh, separate unit with
// its own rarity and kit (currently Belle cr040 and Clumsy Cowgirl cr107).
const versions = gsaCharacters
  .filter(x => x.slug !== slug && x.nameZh && x.nameZh === c.nameZh)
  .map(x => ({ ...x, rarity: GSA_TIER_PLACEMENTS[x.slug]?.rarity }));

// Page heading and browser tab use the full name when the roster has two
// units with the same name (Belle / Clumsy Cowgirl Belle).
const displayName = gsaFullDisplayName(c);

// Statuses and buffs this kit touches, from the game's own RoleTypeData
// catalog (icon + buff/debuff kind + explanation where official text exists).
const myStatuses = (GSA_CHAR_STATUSES[slug] || [])
  .map(id => GSA_STATUSES[id])
  .filter(Boolean)
  .sort((a, b) => (a.kind === b.kind ? a.name.localeCompare(b.name) : a.kind === 'debuff' ? -1 : 1));

const profile = c.profile || {};
const stats = c.stats || {};

// Potential stat block: every stat the character owns, straight from
// RoleInfoData (percent fields are stored /100). Groups mirror the in-game
// Stat Details panel order (RoleDisplayProperty ID map): DPS Rating, Defense
// Rating, Status Rating, Special Rating. Zeros are hidden.
const pct = v => `${Number(v) / 100}%`;
// The game shows every row even at 0 (base values before gear and the other
// sources), so zeros stay visible here too. Only the Status Rating
// reductions, which no released character owns at nonzero, stay filtered.
const statGroups = [
  { group: 'DPS Rating', rows: [
    ['Damage Boost %', '0'],
    ['ACC %', stats.hitPer],
    ['Crit %', stats.critPer],
    ['Crit DMG %', stats.critAmpPer],
    ['Block PEN %', stats.blkPenPer],
    ['ATK Speed %', stats.atkHastePer],
  ] },
  { group: 'Defense Rating', rows: [
    ['Evasion %', stats.ddgPer],
    ['Crit Evasion %', stats.critRstPer],
    ['Crit RES %', stats.critDmgRdcPer],
    ['Block %', stats.blkPer],
    ['DMG BLK %', stats.blkRdcPer],
  ] },
  { group: 'Status Rating', rows: [
    ['Freeze RES %', stats.freezeHitRdcPer],
    ['Burn RES %', stats.burnHitRdcPer],
    ['Electrocute RES %', stats.shockHitRdcPer],
    ['Petrify RES %', stats.stoneHitRdcPer],
    ['Light RES %', stats.lightHitRdcPer],
    ['Dark RES %', stats.darkHitRdcPer],
  ] },
  { group: 'Special Rating', rows: [
    ['Critical Heal %', stats.healCritPer],
    ['Critical Heal Bonus %', stats.healCritAmpPer],
    ['Post-Wave HP Recovery %', stats.hpRcvPer],
    ['Mana Amplification %', stats.manaAmpPer],
    ['Cooldown Speed %', stats.cdHastePer],
  ] },
]
  .map(g => ({
    group: g.group,
    rows: g.rows
      .map(([label, value]) => [label, value == null || value === '' ? '0%' : pct(value)]),
  }))
  .filter(g => g.rows.length > 0);
// Raw (per ten-thousand) rating rows for the live table: label -> base value.
const ratingRows = statGroups.map(g => ({
  group: g.group,
  rows: g.rows.map(([label, value]) => [label, Number(value.replace('%', '')) * 100 || 0]),
}));
const basicTiles = [
  ['Attack Range', stats.atkRange],
  ['Basic Attack GCD', stats.normalAttackGCD ? `${Number(stats.normalAttackGCD) / 1000}s` : null],
].filter(([label, value]) => value != null && value !== '');

const resumeParas = profile.resumeParas || (profile.resume ? [profile.resume] : []);

const tierStats = (c.tierStats || []).slice().sort((a, b) => a.tier - b.tier);
const growth = c.growth || { rate: 1, hp: [0, 0, 0, 0, 0, 0], atk: [0, 0, 0, 0, 0, 0] };
---

<GSALayout
  title={displayName}
  description={`${displayName} (${c.nameZh}) guide for Gene-Sys: Adam: profile, base stats, skills.`}
  gameTitle={displayName}
  crumbName={displayName}
>
  <div class="gsa-content-section">
    <div class="gsa-detail-header">
      {c.icon ? (
        <img src={c.icon} alt={c.name} class="gsa-detail-art" />
      ) : (
        <div class="gsa-detail-art-monogram">{c.name?.[0]}</div>
      )}
      <div class="gsa-detail-info">
        <h1>{displayName}</h1>
        <p class="gsa-detail-name-zh">{c.nameZh}</p>
        {c.title && <p class="gsa-detail-title">{c.title}</p>}
        {c.epithet && <p class="gsa-detail-epithet">{c.epithet}</p>}
        <div class="gsa-meta">
          {c.attackType && (
            <span class="gsa-chip gsa-chip-type" title={`Attack type: ${c.attackType.name}`}>
              <img src={c.attackType.icon} alt={c.attackType.name} width="20" height="20" loading="lazy" />
              {c.attackType.name}
            </span>
          )}
          {c.job && (
            <span class="gsa-chip gsa-chip-type">
              {c.job.icon && <img src={c.job.icon} alt={c.job.name} width="20" height="20" loading="lazy" />}
              {c.job.name}
            </span>
          )}
          {c.element && (
            <span class="gsa-chip gsa-chip-elem">
              <img src={c.element.icon} alt={c.element.name} width="20" height="20" loading="lazy" />
              {c.element.name}
            </span>
          )}
          {c.inGacha ? null : <span class="gsa-chip solid-muted">Not in Summons</span>}
        </div>
      </div>
    </div>

    <div class={`gsa-pursuit-box${pursuit.role === 'none' ? ' gsa-pursuit-none' : ''}`}>
      <div class="gsa-pursuit-head">
        <span class={`gsa-chip ${pursuit.role === 'none' ? 'solid-muted' : 'solid-accent'}`}>{ROLE_LABEL[pursuit.role]}</span>
        <span class="gsa-pursuit-title">Pursuit System</span>
      </div>
      {pursuit.role === 'none' ? (
        <p class="gsa-pursuit-line">
          This character does not participate in the Pursuit system: no skill applies a
          pursuit status and no skill carries a pursuit trigger. Their kit is scored on its
          own output and support instead.
        </p>
      ) : (
        <div class="gsa-pursuit-body">
          {pursuit.triggers.map(t => (
            <p class="gsa-pursuit-line">
              Triggers <b>{t.pursuit}</b> ({t.status} pursuit, {t.element}) on final hits
              against {t.status} targets: {t.skills.join(', ')}.
              {t.grades.length > 0 && ` Grade ${t.grades.join('/')}.`}
            </p>
          ))}
          {pursuit.applies.map(a => (
            <p class="gsa-pursuit-line">
              Applies <b>{a.status}</b> ({a.element}){a.grades.length > 0 && ` grade ${a.grades.join('/')}`}
              {a.chance && ` (${a.chance} chance)`}
              {a.via === 'passive' ? ' through a passive effect' : ''}: {a.skills.join(', ')}.
              The pursuit that consumes it fires off any ally with the matching trigger.
            </p>
          ))}
          {pursuit.riders.map(r => <p class="gsa-pursuit-line">{r.en}.</p>)}
          {pursuit.synergy.map(sy => <p class="gsa-pursuit-line">{sy.en}.</p>)}
          {partners.size > 0 && (
            <p class="gsa-pursuit-line gsa-pursuit-partners">
              Pursuit partners on the roster:{' '}
              {[...partners].map((s2, i) => (
                <fragment>
                  {i > 0 && ', '}
                  <a href={`/guides/gene-sys-adam/characters/${s2}/`}>{bySlug[s2]?.name || s2}</a>
                </fragment>
              ))}.
            </p>
          )}
        </div>
      )}
    </div>

    {versions.length > 0 && (
      <div class="gsa-detail-section gsa-versions">
        <h2>Other Versions</h2>
        <p class="gsa-section-note">
          This character has more than one playable version. Each version is a
          separate unit with its own rarity and kit.
        </p>
        <div class="gsa-version-cards">
          {versions.map(v => (
            <a class="gsa-version-card" href={`/guides/gene-sys-adam/characters/${v.slug}/`}>
              {v.icon ? (
                <img class="gsa-version-icon" src={v.icon} alt={gsaFullDisplayName(v)} width="72" height="72" loading="lazy" />
              ) : (
                <span class="gsa-version-icon gsa-version-monogram">{v.name?.[0]}</span>
              )}
              <span class="gsa-version-info">
                <span class="gsa-version-name">{gsaFullDisplayName(v)}</span>
                <span class="gsa-version-meta">
                  {v.rarity && gsaRarityBadge(v.rarity) && (
                    <img class="gsa-version-rarity" src={gsaRarityBadge(v.rarity)} alt={v.rarity} width="38" height="24" loading="lazy" />
                  )}
                  {v.element && (
                    <span class="gsa-chip gsa-chip-elem">
                      <img src={v.element.icon} alt={v.element.name} width="16" height="16" loading="lazy" />
                      {v.element.name}
                    </span>
                  )}
                  {v.job && <span class="gsa-chip gsa-chip-type">{v.job.name}</span>}
                </span>
              </span>
            </a>
          ))}
        </div>
      </div>
    )}

    {
      (profile.birthday || profile.age || profile.height || profile.interest || resumeParas.length) ? (
        <div class="gsa-detail-section">
          <h2>Profile</h2>
          <div class="gsa-facts-list">
            {c.sex && <div class="gsa-facts-row"><span>Sex</span><b>{c.sex}</b></div>}
            {profile.birthday && profile.birthday !== '-1' && <div class="gsa-facts-row"><span>Birthday</span><b>{profile.birthday}</b></div>}
            {profile.age && profile.age !== '-1' && <div class="gsa-facts-row"><span>Age</span><b>{profile.age}</b></div>}
            {profile.height && profile.height !== '-1' && <div class="gsa-facts-row"><span>Height</span><b>{profile.height} cm</b></div>}
            {profile.weight && profile.weight !== '-1' && <div class="gsa-facts-row"><span>Weight</span><b>{profile.weight} kg</b></div>}
            {profile.interest && <div class="gsa-facts-row gsa-facts-long"><span>Interests</span><b>{profile.interest}</b></div>}
            {profile.personality && <div class="gsa-facts-row gsa-facts-long"><span>Personality</span><b>{profile.personality}</b></div>}
          </div>
          {resumeParas.length > 0 && (
            <div class="gsa-story">
              <h3 class="gsa-story-title">Story</h3>
              {resumeParas.map(p => <p>{p}</p>)}
            </div>
          )}
        </div>
      ) : null
    }

    <div class="gsa-detail-section" id="gsa-stats">
      <h2>Stats</h2>
      <p class="gsa-section-note">
        Pick a Level, Class tier, Rank and Affection state to see every stat
        this character gets. Core values come from the game's own stat data:
        the base cell of the tier plus a fixed per-level growth scaled by
        Rank, multiplied by the character's rarity rate, with the Affection
        track applied. Armament, Bond and the Element Altar stack on top of
        these in-game.
      </p>

      <div class="gsa-calc" id="gsa-calc">
        <div class="gsa-calc-controls">
          <label>
            Level
            <span class="gsa-num">
              <input type="number" id="gsa-calc-lv" min="1" max="50" value="50" />
              <button type="button" class="gsa-num-up" aria-label="Increase level">&#9650;</button>
              <button type="button" class="gsa-num-down" aria-label="Decrease level">&#9660;</button>
            </span>
          </label>
          <label>
            Class Tier
            <select id="gsa-calc-tier">
              {tierStats.map(t => (
                <option value={t.tier} selected={t.tier === tierStats.length}>Tier {t.tier}</option>
              ))}
            </select>
          </label>
          <label>
            Rank
            <select id="gsa-calc-star">
              {[1, 2, 3, 4, 5, 6].map(s => (
                <option value={s} selected={s === 6}>{s} stars</option>
              ))}
            </select>
          </label>
          <label>
            Affection
            <select id="gsa-calc-aff">
              <option value="0">Off</option>
              <option value="1" selected>Max</option>
            </select>
          </label>
        </div>
      </div>

      <p class="gsa-section-note" style="margin-top:-2px">
        Class tier advance gates: Lv 2, 10, 20, 25, 30, 40, 40, 50, 50 with
        Rank 1, 1, 2, 3, 4, 5, 6, 6, 6, plus this character's certificate and
        sigils. Level cap is Lv 50 at every tier.
      </p>

      <table class="gsa-stats-table" id="gsa-allstats">
        <tbody>
          <tr class="gsa-stats-group"><th colSpan={2}>Core</th></tr>
          <tr>
            <th scope="row"><span>HP</span>{gsaPropertyTypes['HP'] && <small class="gsa-stat-desc">{gsaPropertyTypes['HP']}</small>}</th>
            <td id="gsa-row-HP">-</td>
          </tr>
          <tr>
            <th scope="row"><span>ATK</span>{gsaPropertyTypes['ATK'] && <small class="gsa-stat-desc">{gsaPropertyTypes['ATK']}</small>}</th>
            <td id="gsa-row-ATK">-</td>
          </tr>
          {basicTiles.length > 0 && (
            <tr class="gsa-stats-group"><th colSpan={2}>Basic</th></tr>
          )}
          {basicTiles.map(([label, value]) => (
            <tr>
              <th scope="row">{label}</th>
              <td>{value}</td>
            </tr>
          ))}
          {ratingRows.map(g => (
            <>
              <tr class="gsa-stats-group"><th colSpan={2}>{g.group}</th></tr>
              {g.rows.map(([label, base]) => (
                <tr>
                  <th scope="row"><span>{label}</span>{gsaPropertyTypes[label] && <small class="gsa-stat-desc">{gsaPropertyTypes[label]}</small>}</th>
                  <td data-rating={label} data-base={base}>{base / 100}%</td>
                </tr>
              ))}
            </>
          ))}
        </tbody>
      </table>

      <script type="application/json" id="gsa-calc-data" set:html={JSON.stringify({ tierStats, growth, affection: c.affection || [] })}></script>
      <script is:inline>
        // Stat calculator: Level + Class tier + Rank + Affection -> all stats.
        // Core: rate * (tierBase + perLevelGrowth * Lv), flat affection ATK
        // added after the rate. Ratings: base + affection track (same
        // per-ten-thousand scale), with the delta shown in brackets.
        (function () {
          var dataEl = document.getElementById('gsa-calc-data');
          var lvIn = document.getElementById('gsa-calc-lv');
          var tierIn = document.getElementById('gsa-calc-tier');
          var starIn = document.getElementById('gsa-calc-star');
          var affIn = document.getElementById('gsa-calc-aff');
          if (!dataEl || !lvIn || !tierIn || !starIn || !affIn) return;
          var data = JSON.parse(dataEl.textContent);
          var fmt = function (n) { return Math.round(n).toLocaleString('en-US'); };
          var norm = function (s) { return String(s).replace(/ %$/, '').replace(/%/g, '').trim(); };
          // row labels now use the game's official EN names, matching the
          // affection track labels directly; aliases kept for safety only
          var ALIAS = {};
          var affMap = {};
          (data.affection || []).forEach(function (a) { affMap[norm(a.label)] = (affMap[norm(a.label)] || 0) + a.value; });
          var affOn = false;
          function statAt(lv, tier, star) {
            var t = data.tierStats.find(function (r) { return r.tier === tier; }) || data.tierStats[data.tierStats.length - 1];
            var g = data.growth;
            var si = Math.max(1, Math.min(6, star)) - 1;
            var atkFlat = affOn ? (affMap['ATK'] || 0) : 0;
            return {
              hp: g.rate * (t.hp + g.hp[si] * lv),
              atk: g.rate * (t.atk + g.atk[si] * lv) + atkFlat,
              hpPer: g.rate * g.hp[si],
              atkPer: g.rate * g.atk[si]
            };
          }
          function renderRows(cur) {
            var hpEl = document.getElementById('gsa-row-HP');
            var atkEl = document.getElementById('gsa-row-ATK');
            if (hpEl) hpEl.textContent = fmt(cur.hp) + ' (+' + fmt(cur.hpPer) + ' per level)';
            if (atkEl) atkEl.textContent = fmt(cur.atk) + ' (+' + fmt(cur.atkPer) + ' per level)';
            var matched = {};
            document.querySelectorAll('#gsa-allstats [data-rating]').forEach(function (td) {
              var base = Number(td.getAttribute('data-base'));
              var key = ALIAS[norm(td.getAttribute('data-rating'))] || norm(td.getAttribute('data-rating'));
              var delta = affOn ? (affMap[key] || 0) : 0;
              if (affMap[key]) matched[key] = true;
              td.textContent = delta ? (base + delta) / 100 + '% (+' + delta / 100 + '%)' : base / 100 + '%';
            });
            var table = document.getElementById('gsa-allstats');
            var extras = Object.keys(affMap).filter(function (k) { return !matched[k] && k !== 'ATK' && k !== 'HP'; });
            if (extras.length && !document.getElementById('gsa-aff-extra-body') && table) {
              var wrap = document.createElement('tbody');
              wrap.id = 'gsa-aff-extra-body';
              wrap.innerHTML = '<tr class="gsa-stats-group"><th colSpan="2">From Affection</th></tr>' +
                extras.map(function (k) {
                  return '<tr><th scope="row">' + k + '</th><td>' + affMap[k] / 100 + '%</td></tr>';
                }).join('');
              table.appendChild(wrap);
            }
            var extraBody = document.getElementById('gsa-aff-extra-body');
            if (extraBody) extraBody.style.display = (affOn && extras.length) ? '' : 'none';
          }
          function render() {
            var lv = Math.max(1, Math.min(50, parseInt(lvIn.value, 10) || 1));
            var tier = parseInt(tierIn.value, 10);
            var star = parseInt(starIn.value, 10);
            affOn = affIn.value === '1';
            renderRows(statAt(lv, tier, star));
          }
          lvIn.addEventListener('input', render);
          tierIn.addEventListener('change', render);
          starIn.addEventListener('change', render);
          affIn.addEventListener('change', render);
          document.querySelectorAll('.gsa-num button').forEach(function (b) {
            b.addEventListener('click', function () {
              var d = b.classList.contains('gsa-num-up') ? 1 : -1;
              lvIn.value = Math.max(1, Math.min(50, (parseInt(lvIn.value, 10) || 1) + d));
              render();
            });
          });
          render();
        })();
      </script>
    </div>

    {(c.gear || []).length > 0 && (
      <div class="gsa-detail-section" id="gsa-armament">
        <h2>Armament</h2>
        <p class="gsa-section-note">
          This character's signature gear (best variant of each slot), straight
          from the game tables. Stat lines are the base values before
          enhancement; gear ratings are flat points, which the game converts
          through its level-scaled curve.
        </p>
        <table class="gsa-stats-table">
          <thead>
            <tr><th>Slot</th><th>Piece</th><th>Stat lines</th></tr>
          </thead>
          <tbody>
            {c.gear.map(g => (
              <tr>
                <th scope="row">{g.slot}</th>
                <td class="gsa-gear-name">{g.name}</td>
                <td class="gsa-gear-stats">
                  {g.stats.map(s => (
                    <span class="gsa-chip solid-muted">{s.label} +{s.pct ? `${s.base / 100}%` : s.base.toLocaleString('en-US')}</span>
                  ))}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="gsa-section-note" style="margin-top:8px">
          <a href="/guides/gene-sys-adam/armament/">Browse every signature piece on the Armament page</a>,
          with EX rank growth, enhancement, star-up and dismantle costs.
        </p>
      </div>
    )}

  {
      c.skills && c.skills.length ? (
        <div class="gsa-detail-section">
          <h2>Skills</h2>
          {reworkArchive && (
            <p class="gsa-rework-pointer">
              {c.name} was reworked on {reworkArchive.date}. The current version is shown here; the pre-rework text is preserved in the{' '}
              <a href="#gsa-rework-archive">Rework Archive</a> at the bottom of this page.
            </p>
          )}
          <div class="gsa-skills">
            {c.skills.map(s => (
              <div class={`gsa-skill ${s.slot === 'Ultimate' ? 'gsa-skill-ult' : ''}`}>
                <div class="gsa-skill-head">
                  <div class="gsa-skill-iconwrap">
                    {s.icon ? (
                      <img src={s.icon} alt="" class="gsa-skill-icon" width="52" height="52" loading="lazy" />
                    ) : (
                      <span class="gsa-skill-icon gsa-skill-icon-ph" aria-hidden="true">{s.name?.[0]}</span>
                    )}
                    {s.slot === 'Ultimate' && <span class="gsa-skill-ex">EX</span>}
                  </div>
                  <div class="gsa-skill-heading">
                    <p class="gsa-skill-name">
                      <span class="gsa-skill-tag">[{s.slot}]</span>
                      {s.name}
                    </p>
                    <div class="gsa-skill-props">
                      {s.mainStat && <p class="gsa-skill-prop"><span>Main Stat:</span> <b>{s.mainStat}</b></p>}
                      {s.type && <p class="gsa-skill-prop"><span>Type:</span> <b>{s.type}</b></p>}
                      {s.cost ? <p class="gsa-skill-prop"><span>Cost:</span> <b>{s.cost} EN</b></p> : null}
                      {s.gcd ? <p class="gsa-skill-prop"><span>Basic Attack GCD:</span> <b>{s.gcd}</b></p> : null}
                      {s.cooldown ? <p class="gsa-skill-prop"><span>Cooldown Time:</span> <b>{s.cooldown}</b></p> : null}
                    </div>
                  </div>
                  {s.unlockStar > 0 && <span class="gsa-chip gsa-star-chip">{s.unlockStar}★</span>}
                </div>
                {s.desc && s.desc.split('\n').map(line => <p class="gsa-skill-desc">{line}</p>)}
                {s.detail && <p class="gsa-skill-detail">{s.detail}</p>}
                {s.awakened && (s.awakened.desc || s.awakened.detail) && (
                  <div class="gsa-skill-awake">
                    <span class="gsa-chip solid-accent">Awakened</span>
                    {s.awakened.desc && s.awakened.desc.split('\n').map(line => <p class="gsa-skill-desc">{line}</p>)}
                    {s.awakened.detail && <p class="gsa-skill-detail">{s.awakened.detail}</p>}
                  </div>
                )}
                {s.statuses?.length ? (
                  <div class="gsa-skill-statuses">
                    {s.statuses.map(st => <span class="gsa-chip solid-muted">{st}</span>)}
                  </div>
                ) : null}
              </div>
            ))}
          </div>
          <p class="gsa-section-note">
            Skill values shown at level 1. Every skill can be raised from Lv 1 to
            Lv 99 (gold costs in the growth panel above); the per-level value
            scaling is computed by the game client at runtime and is not part of
            the data tables. The star chip marks the star level that unlocks the
            skill. Main Stat, Type, Cost and Cooldown Time mirror the in-game
            skill card; skill icons exist only for characters whose art has been
            pulled from the game so far.
          </p>
        </div>
      ) : (
        <div class="gsa-detail-section">
          <h2>Skills</h2>
          <p class="gsa-text-dim">
            This character's skill data is not in the live game tables yet (unreleased kit).
          </p>
        </div>
      )
    }

    {myStatuses.length > 0 && (
      <div class="gsa-detail-section" id="gsa-statuses">
        <h2>Statuses & Buffs</h2>
        <p class="gsa-section-note">
          The buffs and debuffs this kit applies or interacts with, with the game's own icons.
        </p>
        <div class="gsa-status-grid">
          {myStatuses.map(st => (
            <div class={`gsa-status-tile gsa-status-${st.kind}`}>
              <span class="gsa-status-head">
                {st.icon ? (
                  <img class="gsa-status-icon" src={st.icon} alt={st.name} width="28" height="28" loading="lazy" />
                ) : (
                  <span class="gsa-status-icon gsa-status-icon-ph">{st.name?.[0]}</span>
                )}
                <b class="gsa-status-name">{st.name}</b>
                <span class={`gsa-chip ${st.kind === 'buff' ? 'solid-accent' : 'gsa-status-kind-debuff'}`}>{st.kind === 'buff' ? 'Buff' : 'Debuff'}</span>
              </span>
              {st.desc && <p class="gsa-status-desc">{st.desc}</p>}
            </div>
          ))}
        </div>
      </div>
    )}

    {reworkArchive && (
      <div class="gsa-detail-section" id="gsa-rework-archive">
        <h2>Rework Archive</h2>
        <p class="gsa-section-note">
          {reworkArchive.intro}{' '}
          <a href={reworkArchive.patchHref}>{reworkArchive.patchLabel}</a>.
        </p>
        {reworkArchive.unchangedNote && (
          <p class="gsa-section-note">{reworkArchive.unchangedNote}</p>
        )}
        <div class="gsa-rework-list">
          {reworkArchive.items.map(item => (
            <div class="gsa-rework-item">
              <h3 class="gsa-rework-item-title">{item.title}</h3>
              <div class="gsa-rework-grid">
                <div class="gsa-rework-card gsa-rework-before">
                  <span class="gsa-chip solid-muted">Before</span>
                  <div class="gsa-rework-text">
                    {item.before.split('\n').map(line => <p>{line}</p>)}
                  </div>
                </div>
                <div class="gsa-rework-card gsa-rework-after">
                  <span class="gsa-chip solid-accent">After</span>
                  <div class="gsa-rework-text">
                    {item.after.split('\n').map(line => <p>{line}</p>)}
                  </div>
                </div>
              </div>
              {item.note && <p class="gsa-rework-item-note">{item.note}</p>}
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</GSALayout>

