---
// Gene-Sys: Adam character database (grid of all profiled characters,
// categorized by element and job like the in-game roster, sorted by the
// game's own library order from RoleInfoData.battlePosition).
import GSALayout from '../../../../layouts/gene-sys-adam/LandingLayout.astro';
import { gsaCharacters } from '../../../../data/gene-sys-adam/characters.js';
import { GSA_TIER_PLACEMENTS, gsaRarityBadge } from '../../../../data/gene-sys-adam/tier-list.js';
import '../../../../styles/games/gene-sys-adam/gsa-common.css';
import '../../../../styles/games/gene-sys-adam/gsa-characters.css';

const characters = [...gsaCharacters].sort((a, b) => (a.sortOrder ?? 9999) - (b.sortOrder ?? 9999));
const ELEMENT_ORDER = ['Fire', 'Earth', 'Wind', 'Water', 'Light', 'Dark'];
const JOB_ORDER = ['Guardian', 'Striker', 'Sniper', 'Support', 'Breaker'];
const elements = ELEMENT_ORDER
  .map(n => characters.find(c => c.element?.name === n)?.element)
  .filter(Boolean);
const elByName = new Map(elements.map(e => [e.name, e]));
const jobs = JOB_ORDER.filter(j => characters.some(c => c.job?.name === j));
---

<GSALayout
  title="Character Database"
  description={`Complete character database for Gene-Sys: Adam. Browse all ${characters.length} characters with rarity, elements, combat styles, profiles, stats and skills.`}
  gameTitle="Characters"
  crumbName="Characters"
>
  <div class="gsa-content-section">
    <div class="gsa-toolbar">
      <input type="text" class="gsa-search" placeholder="Search name, title or epithet..." id="gsa-search" />
      <span class="gsa-count" id="gsa-count">{characters.length} characters</span>
    </div>
    <div class="gsa-toolbar gsa-toolbar-filters">
      <button class="gsa-filter-btn active" data-filter="all">All</button>
      {ELEMENT_ORDER.map(n => elByName.get(n) && (
        <button class="gsa-filter-btn" data-filter={n.toLowerCase()}>
          <img src={elByName.get(n).icon} alt="" width="14" height="14" loading="lazy" /> {n}
        </button>
      ))}
      <span class="gsa-filter-sep" aria-hidden="true"></span>
      {jobs.map(j => (
        <button class="gsa-filter-btn" data-filter={j.toLowerCase()}>{j}</button>
      ))}
    </div>

    <div class="gsa-grid-cards" id="gsa-grid">
      {characters.map(c => (
        <a class="gsa-card" href={`/guides/gene-sys-adam/characters/${c.slug}/`} data-search={`${c.name} ${c.nameZh} ${c.title} ${c.epithet} ${c.attackType?.name || ''}`.toLowerCase()} data-tags={[(c.element?.name || '').toLowerCase(), (c.job?.name || '').toLowerCase()].filter(Boolean).join(' ')}>
          <div class="gsa-icon-frame">
            {c.icon ? <img src={c.icon} alt={c.name} loading="lazy" /> : <span class="gsa-monogram">{c.name?.[0]}</span>}
          </div>
          <p class="gsa-card-title">{c.name}</p>
          {c.title && <p class="gsa-card-sub">{c.title}</p>}
          <div class="gsa-card-types">
            {(() => { const r = GSA_TIER_PLACEMENTS[c.slug]?.rarity; const b = r && gsaRarityBadge(r); return b ? (
              <img class="gsa-card-rarity" src={b} alt={r} width="42" height="27" loading="lazy" />
            ) : null; })()}
            {c.attackType && (
              <span class="gsa-type-tile" title={`Attack type: ${c.attackType.name}`}>
                <img src={c.attackType.icon} alt={c.attackType.name} width="24" height="24" loading="lazy" />
              </span>
            )}
            {c.element && (
              <span class="gsa-type-tile" title={`Element: ${c.element.name}`}>
                <img src={c.element.icon} alt={c.element.name} width="24" height="24" loading="lazy" />
              </span>
            )}
            {c.job && (
              <span class="gsa-type-tile" title={`Job: ${c.job.name}`}>
                <img src={c.job.icon} alt={c.job.name} width="24" height="24" loading="lazy" />
              </span>
            )}
          </div>
        </a>
      ))}
    </div>
    <p class="gsa-no-results" id="gsa-no-results">No characters match your search.</p>
  </div>
</GSALayout>

<script is:inline>
  // Client-side search and element/job/gacha filters for the character grid.
  (function () {
    var search = document.getElementById('gsa-search');
    var grid = document.getElementById('gsa-grid');
    var cards = grid.querySelectorAll('.gsa-card');
    var noResults = document.getElementById('gsa-no-results');
    var count = document.getElementById('gsa-count');
    var total = cards.length;
    var activeFilter = 'all';
    function apply() {
      var q = (search.value || '').trim().toLowerCase();
      var visible = 0;
      cards.forEach(function (card) {
        var text = card.getAttribute('data-search') || '';
        var tags = card.getAttribute('data-tags') || '';
        var ok = (!q || text.indexOf(q) !== -1) &&
          (activeFilter === 'all' || tags.indexOf(activeFilter) !== -1);
        card.style.display = ok ? '' : 'none';
        if (ok) visible++;
      });
      noResults.style.display = visible === 0 ? 'block' : 'none';
      count.textContent = visible === total ? total + ' characters' : visible + ' of ' + total + ' characters';
    }
    search.addEventListener('input', apply);
    document.querySelectorAll('.gsa-filter-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        document.querySelectorAll('.gsa-filter-btn').forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');
        activeFilter = btn.getAttribute('data-filter');
        apply();
      });
    });
  })();
</script>
