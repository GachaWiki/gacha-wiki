---
// Language selection page for MAJO: Witches Night: shown when entering the
// wiki from the games list. Thin wrapper around the shared
// LanguageSelectTemplate: the English wiki plus four wikis using the game's
// own official localization (zh-Hans, zh-Hant, ja, ko).
import LanguageSelectTemplate from '../../../templates/LanguageSelectTemplate.astro';

export const prerender = true;
---

<LanguageSelectTemplate
  gameKey="majo"
  gameName="MAJO: Witches Night"
  accent="#c084fc"
  languages={[
    { lang: 'English', note: 'English wiki', href: '/guides/majo/' },
    { lang: '简体中文', htmlLang: 'zh-Hans', note: '游戏官方文本 · 魔女之夜', href: '/zh/guides/majo/' },
    { lang: '繁體中文', htmlLang: 'zh-Hant', note: '遊戲官方文本 · 魔女之夜', href: '/zh-tw/guides/majo/' },
    { lang: '日本語', htmlLang: 'ja', note: 'ゲーム公式テキスト · ウィッチーズ・ナイト', href: '/ja/guides/majo/' },
    { lang: '한국어', htmlLang: 'ko', note: '게임 공식 텍스트 · 마녀의 밤', href: '/ko/guides/majo/' },
  ]}
/>
