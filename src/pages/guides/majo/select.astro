---
// Language selection page for MAJO: Witches Night: shown when entering the
// wiki from the games list. Thin wrapper around the shared
// LanguageSelectTemplate, themed as a real majo page: the game's own CSS,
// background layer, container and title heading, with the select card in the
// standard content area. Languages: English plus the four wikis using the
// game's own official localization (zh-Hans, zh-Hant, ja, ko).
import LanguageSelectTemplate from '../../../templates/LanguageSelectTemplate.astro';
import MajoBaseHead from '../../../components/majo/MajoBaseHead.astro';
import { getGameLanguageInfo } from '../../../data/game-languages';
import '../../../styles/games/majo/majo-colors.css';
import '../../../styles/games/majo/majo-layout.css';
import '../../../styles/games/majo/majo-common.css';

export const prerender = true;

const title = 'Choose Language';
const langs = getGameLanguageInfo('majo');
---

<LanguageSelectTemplate
  gameKey="majo"
  gameName="MAJO: Witches Night"
  accent="#a89bd1"
  subtitle="Choose a language · 选择语言 · 言語を選択 · 언어 선택"
  bodyClass="majo-body"
  contentClass="majo-content"
  containerClass="majo-container"
  mainClass="majo-main"
  bgLayers={['majo-bg-primary']}
  heroClass="majo-title-only-section"
  titleClass="majo-title-only-heading"
  decorativeLines
  languages={langs?.languages ?? []}
>
  <MajoBaseHead slot="head" title={title} description="Choose the language for the MAJO: Witches Night wiki: English, Simplified Chinese, Traditional Chinese, Japanese or Korean." />
</LanguageSelectTemplate>
