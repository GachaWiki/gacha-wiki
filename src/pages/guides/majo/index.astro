---
// MAJO: Witches Night game overview landing page (mirrors desire-immortal-realm structure).
import MajoLayout from '../../../layouts/majo/LandingLayout.astro';
import { majoCharacters } from '../../../data/majo/characters.js';
import { SITE } from '../../../consts';
import DiscordPromo from '../../../components/DiscordPromo.astro';
import DiscordButton from '../../../components/DiscordButton.astro';
import GameLanguageLinks from '../../../components/GameLanguageLinks.astro';
import '../../../styles/games/majo/majo-landing.css';

const R2 = 'https://k2b1c5ab57ed98e51.gachawiki.info/majo';
const witches = majoCharacters.length;
---

<MajoLayout
  title="Home"
  description="MAJO: Witches Night (魔女之夜) wiki: Strategy gacha RPG. Witch database, skills, gacha mechanics, and lore."
  gameTitle="MAJO: Witches Night"
>
  <!-- Ambient background video (avg_cg_C04_mc_memory_incident) — full-bleed top, fades out by mid-page -->
  <div class="majo-bg-video-wrap" aria-hidden="true">
    <video class="majo-bg-video" autoplay muted loop playsinline preload="auto">
      <source src="https://k2b1c5ab57ed98e51.gachawiki.info/videos/majo-hero.mp4" type="video/mp4" />
    </video>
  </div>

  <section class="majo-content-section">
    <div class="majo-story">
      <p>
        Memory is the most unreliable thing in this world. In a near future where humanity's
        collective subconscious has been tampered with, you awaken as the era's
        <strong>Observer</strong>, the only one who can perceive the truth. Contract with witches
        from countless parallel worlds, fight beside them in real-time vertical combat, and build
        bonds that go beyond words.
      </p>
      <p>
        <strong>MAJO: Witches Night</strong> (魔女之夜) is an R18 apocalyptic strategy gacha on
        the platform, launched August 12, 2026, with a roster of {witches} witches
        across four classes.
      </p>
    </div>

    <div class="majo-title-video-wrap">
      <!-- Desktop: original ultra-wide loading-screen video; Mobile: 16:9 crop so it is not a thin strip -->
      <video
        class="majo-title-video majo-title-video-wide"
        controls
        preload="metadata"
        playsinline
        poster={`${R2}/hero.webp`}
      >
        <source src="https://k2b1c5ab57ed98e51.gachawiki.info/videos/majo-title.mp4" type="video/mp4" />
      </video>
      <video
        class="majo-title-video majo-title-video-square"
        controls
        preload="metadata"
        playsinline
        poster="https://k2b1c5ab57ed98e51.gachawiki.info/videos/majo-title-16x9-poster.jpg"
      >
        <source src="https://k2b1c5ab57ed98e51.gachawiki.info/videos/majo-title-16x9.mp4" type="video/mp4" />
      </video>
      <p class="majo-title-video-caption">Title theme, from the game's loading screen</p>
    </div>

    <div class="majo-download-row">
      <a
        class="majo-download-btn"
        href="https://game.erolabsshare.live/app/f302f717/MAJO_Witches_Night"
        target="_blank"
        rel="noopener noreferrer"
      >
        Download &amp; Play MAJO: Witches Night
        <span class="majo-download-arrow">→</span>
      </a>

      <DiscordButton label="Join our Discord" class="majo-download-btn majo-discord-btn" />
    </div>
  </section>

  <section class="majo-resources-section">
    <h2 class="majo-resources-title">Guides &amp; Resources</h2>

    <div class="majo-resources-grid">
      <div class="majo-resource-category">
        <div class="majo-category-header">
          <h3>Characters</h3>
          <p class="majo-category-description">
            All {witches} witches with rarity, class, skills and lore.
          </p>
        </div>
        <div class="majo-buttons-grid">
          <a href="/guides/majo/characters/" class="majo-resource-button">Witch Database</a>
          <a href="/guides/majo/tier-list/" class="majo-resource-button">Tier List</a>
          <a href="/guides/majo/teams/" class="majo-resource-button">Team Builds</a>
          <a href="/guides/majo/banners/" class="majo-resource-button">Banners</a>
        </div>
      </div>

      <div class="majo-resource-category">
        <div class="majo-category-header">
          <h3>Equipment</h3>
          <p class="majo-category-description">
            Set bonuses (2/4-piece) and SR equipment for all six gear slots.
          </p>
        </div>
        <div class="majo-buttons-grid">
          <a href="/guides/majo/equipment/" class="majo-resource-button">Pieces &amp; Sets</a>
        </div>
      </div>

      <div class="majo-resource-category">
        <div class="majo-category-header">
          <h3>Items</h3>
          <p class="majo-category-description">
            Currencies, witch crystals, skill books, equipment and cosmetics.
          </p>
        </div>
        <div class="majo-buttons-grid">
          <a href="/guides/majo/items/" class="majo-resource-button">Item Database</a>
        </div>
      </div>

      <div class="majo-resource-category">
        <div class="majo-category-header">
          <h3>Resources</h3>
          <p class="majo-category-description">
            Events, guides and tools, mirroring the game menu above.
          </p>
        </div>
        <div class="majo-buttons-grid">
          <a href="/guides/majo/events/" class="majo-resource-button">Events</a>
          <a href="/guides/majo/law/" class="majo-resource-button">Law System</a>
          <a href="/guides/majo/updates/" class="majo-resource-button">Updates</a>
          <a href="/guides/majo/gallery/" class="majo-resource-button">Gallery</a>
          <a href="/clock/majo/" class="majo-resource-button">Clock</a>
        </div>
      </div>
    </div>
    <GameLanguageLinks
      gameKey="majo"
      currentHref="/guides/majo/"
      title="Other languages · 其他语言 · 他の言語 · 다른 언어"
    />
  </section>

  <DiscordPromo accent="#8577a8" />
</MajoLayout>
