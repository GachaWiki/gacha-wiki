---
// MAJO image gallery: witch lobby illustrations (default/awakened/special) and
// AVG story artwork, served from R2 majo/gallery/ with a vanilla JS lightbox.
import MajoLayout from '../../../../layouts/majo/LandingLayout.astro';
import MajoIcon from '../../../../components/majo/MajoIcon.astro';
import { majoCharacters } from '../../../../data/majo/characters.js';
import { WITCH_ILLUSTRATIONS, STORY_CHAPTERS, EXTRA_ARTWORK } from '../../../../data/majo/gallery.js';
import '../../../../styles/games/majo/majo-gallery.css';

const R2 = 'https://pub-dd9a9c01bc7a43d0bb977b255815a5c4.r2.dev/majo/gallery';

const byId = new Map(majoCharacters.map((c) => [c.id, c]));

const witchGroups = WITCH_ILLUSTRATIONS.map((group) => {
  const witch = byId.get(group.id);
  return witch ? { witch, images: group.images } : null;
}).filter(Boolean);

const lightboxItems: { src: string; caption: string; w: number; h: number }[] = [];
const witchEntries = witchGroups.flatMap(({ witch, images }) =>
  images.map((im) => ({
    src: `${R2}/${im.file}`,
    caption: `${witch.nameEn} ${im.label} illustration`,
    w: im.w,
    h: im.h,
  })),
);
const chapterEntries = STORY_CHAPTERS.flatMap((ch) =>
  ch.images.map((im) => ({
    src: `${R2}/cg/${im.file}`,
    caption: `${ch.subtitle}: ${ch.title}`,
    w: im.w,
    h: im.h,
  })),
);
const extraEntries = EXTRA_ARTWORK.map((im) => ({
  src: `${R2}/cg/${im.file}`,
  caption: 'Extra Artwork',
  w: im.w,
  h: im.h,
}));
lightboxItems.push(...witchEntries, ...chapterEntries, ...extraEntries);
---

<MajoLayout
  title="Gallery"
  description="Image gallery for MAJO: Witches Night. Lobby illustrations for all 31 witches (default, awakened and special) plus story artwork from the game's AVG chapters."
  gameTitle="Gallery"
  crumbName="Gallery"
>
  <p class="majo-gal-note">
    Lobby illustrations and story artwork pulled straight from the game. Click any image to view it
    full size. The story section reveals plot moments through Chapter Six.
  </p>

  <h2 class="majo-gal-section-title">Witch Illustrations</h2>
  <p class="majo-gal-section-sub">
    Each witch's album art: Default is the base look, Awakened unlocks with the awaken system, and
    Special is the rare third scene for a few witches.
  </p>

  {witchGroups.map(({ witch, images }) => (
    <section class="majo-gal-group">
      <div class="majo-gal-group-header">
        <a href={`/guides/majo/characters/${witch.slug}/`} class="majo-gal-name">{witch.nameEn}</a>
        <span class="majo-gal-zh">{witch.nameZh}</span>
        <MajoIcon filename={`CharacterDetails_Icon_${witch.rarity}.png`} alt={witch.rarity} class="majo-icon-rarity" />
        <span class="majo-gal-count">{images.length} {images.length === 1 ? 'artwork' : 'artworks'}</span>
      </div>
      <div class="majo-gal-row">
        {images.map((im) => (
          <button
            class="majo-gal-item"
            type="button"
            aria-label={`View ${witch.nameEn} ${im.label} illustration`}
            data-src={`${R2}/${im.file}`}
            data-caption={`${witch.nameEn} ${im.label} illustration`}
            data-w={im.w}
            data-h={im.h}
          >
            <img
              src={`${R2}/${im.file}`}
              alt={`${witch.nameEn} ${im.label} illustration`}
              width={im.w}
              height={im.h}
              loading="lazy"
              decoding="async"
            />
            <span class="majo-gal-item-label">{im.label}</span>
          </button>
        ))}
      </div>
    </section>
  ))}

  <h2 class="majo-gal-section-title">Story Artwork</h2>
  <p class="majo-gal-section-sub">
    Event illustrations from the story chapters. Spoiler warning: these show key scenes.
  </p>
  {STORY_CHAPTERS.map((ch) => (
    <section class="majo-gal-group">
      <div class="majo-gal-group-header">
        <span class="majo-gal-chapter">{ch.subtitle}</span>
        <span class="majo-gal-chapter-title">{ch.title}</span>
        <span class="majo-gal-count">{ch.images.length} {ch.images.length === 1 ? 'artwork' : 'artworks'}</span>
      </div>
      <div class="majo-gal-row">
        {ch.images.map((im) => (
          <button
            class="majo-gal-item"
            type="button"
            aria-label={`View ${ch.subtitle} artwork`}
            data-src={`${R2}/cg/${im.file}`}
            data-caption={`${ch.subtitle}: ${ch.title}`}
            data-w={im.w}
            data-h={im.h}
          >
            <img
              src={`${R2}/cg/${im.file}`}
              alt={`${ch.title} artwork`}
              width={im.w}
              height={im.h}
              loading="lazy"
              decoding="async"
            />
          </button>
        ))}
      </div>
    </section>
  ))}

  <h2 class="majo-gal-section-title">Extra Artwork</h2>
  <section class="majo-gal-group">
    <div class="majo-gal-row">
      {EXTRA_ARTWORK.map((im) => (
        <button
          class="majo-gal-item"
          type="button"
          aria-label="View extra artwork"
          data-src={`${R2}/cg/${im.file}`}
          data-caption="Extra Artwork"
          data-w={im.w}
          data-h={im.h}
        >
          <img
            src={`${R2}/cg/${im.file}`}
            alt="Extra artwork"
            width={im.w}
            height={im.h}
            loading="lazy"
            decoding="async"
          />
        </button>
      ))}
    </div>
  </section>

  <div class="majo-lightbox" id="majo-lightbox" role="dialog" aria-modal="true" aria-label="Image viewer">
    <button class="majo-lightbox-close" type="button" aria-label="Close viewer">&times;</button>
    <button class="majo-lightbox-prev" type="button" aria-label="Previous image">&#8249;</button>
    <figure class="majo-lightbox-figure">
      <img id="majo-lightbox-img" src="" alt="" />
      <figcaption class="majo-lightbox-caption">
        <span id="majo-lightbox-caption"></span>
        <span id="majo-lightbox-counter"></span>
      </figcaption>
    </figure>
    <button class="majo-lightbox-next" type="button" aria-label="Next image">&#8250;</button>
  </div>

  <script is:inline define:vars={{ lightboxItems }}>
    (function () {
      if (window.__mjGalleryInit) return;
      window.__mjGalleryInit = true;

      var box = document.getElementById('majo-lightbox');
      var img = document.getElementById('majo-lightbox-img');
      var captionEl = document.getElementById('majo-lightbox-caption');
      var counterEl = document.getElementById('majo-lightbox-counter');
      var current = 0;
      var lastFocus = null;

      function render() {
        var item = lightboxItems[current];
        img.src = item.src;
        img.alt = item.caption;
        img.style.aspectRatio = item.w + ' / ' + item.h;
        captionEl.textContent = item.caption;
        counterEl.textContent = (current + 1) + ' / ' + lightboxItems.length;
      }
      function open(index) {
        current = index;
        render();
        lastFocus = document.activeElement;
        box.classList.add('open');
        document.body.style.overflow = 'hidden';
        box.querySelector('.majo-lightbox-close').focus();
      }
      function close() {
        box.classList.remove('open');
        document.body.style.overflow = '';
        if (lastFocus) lastFocus.focus();
      }
      function step(delta) {
        current = (current + delta + lightboxItems.length) % lightboxItems.length;
        render();
      }

      document.querySelectorAll('.majo-gal-item').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var src = btn.getAttribute('data-src');
          var index = lightboxItems.findIndex(function (x) { return x.src === src; });
          if (index >= 0) open(index);
        });
      });
      box.querySelector('.majo-lightbox-close').addEventListener('click', close);
      box.querySelector('.majo-lightbox-prev').addEventListener('click', function () { step(-1); });
      box.querySelector('.majo-lightbox-next').addEventListener('click', function () { step(1); });
      box.addEventListener('click', function (e) {
        if (e.target === box) close();
      });
      document.addEventListener('keydown', function (e) {
        if (!box.classList.contains('open')) return;
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowLeft') step(-1);
        else if (e.key === 'ArrowRight') step(1);
      });
    })();
  </script>
</MajoLayout>
