---
// Muv-Luv Girls Garden game overview landing page (standard wiki landing: hero
// banner, story, download row, resources — mirrors agent-x/majo structure).
import MLGGLayout from '../../../layouts/muv-luv-girls-garden/LandingLayout.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import DiscordPromo from '../../../components/DiscordPromo.astro';
import {
  girlsGardenCharacters,
  TEAMS,
} from '../../../data/muv-luv-girls-garden/characters.js';
import { bannerTimeline } from '../../../data/muv-luv-girls-garden/banners.js';
import '../../../styles/games/muv-luv-girls-garden/mlgg-common.css';
import '../../../styles/games/muv-luv-girls-garden/mlgg-landing.css';

const students = girlsGardenCharacters.length;
const cards = girlsGardenCharacters.reduce((n, c) => n + c.cards.length, 0);
const teamCount = new Set(girlsGardenCharacters.map(c => c.team)).size;
const lastUpdate = bannerTimeline[0]?.date;
---

<MLGGLayout
  title="Home"
  description="Muv-Luv Girls Garden (マブラヴ ガールズガーデン) wiki: student list with all Style Cards, banner history, teams, types and roles. Full-auto idle RPG in the Muv-Luv universe, live in Japan on DMM GAMES and coming worldwide to Steam."
  gameTitle="Muv-Luv Girls Garden"
>
  <!-- Ambient background video (EN version pre-registration PV) — full-bleed top, fades out by mid-page -->
  <div class="mlgg-bg-video-wrap" aria-hidden="true">
    <video class="mlgg-bg-video" autoplay muted loop playsinline preload="auto">
      <source src="https://k2b1c5ab57ed98e51.gachawiki.info/videos/mlgg-hero.mp4" type="video/mp4" />
    </video>
  </div>

  <section class="mlgg-content-section">
    <div class="mlgg-story">
      <p>
        Memory is the one thing you have lost. Deep beneath the academy city of Zar'tum lies
        the Maze, an underground abyss where the laws of reality are distorted and the
        extraordinarily valuable Tatsumiya Ore waits. An amnesiac Commander leads the girls
        of Zar'tum Academy there, aboard giant humanoid machines: the Maze Guarders (MG).
      </p>
      <p>
        Muv-Luv Girls Garden (マブラヴ ガールズガーデン, マブガル) is a full-auto idle RPG by
        EXNOA and KMS, offered on DMM GAMES. It launched in Japan on September 3, 2025 (PC
        browser and DMM GAMES PLAYER, Android via the DMM GAMES STORE since August 27, 2026),
        with a current roster of {students} students across {teamCount} teams and {cards}
        collectible Style Cards, including crossover guests from the main Muv-Luv series.
      </p>
      <div class="mlgg-note">
        A worldwide Steam version by MOEDOKI, Shiravune and aNCHOR has been announced: a free
        playable demo has been live since September 17, 2026 and the full free-to-play game is
        coming soon, in English, Simplified Chinese and Traditional Chinese. This wiki uses the
        official English names and terms extracted from the Steam demo; card waves that the
        demo does not cover still show their Japanese titles. The Japanese DMM release remains
        the live version of the game.
      </div>
    </div>

    <div class="mlgg-download-row">
      <a
        class="mlgg-download-btn"
        href="https://store.steampowered.com/app/4789870/MuvLuv_Girls_Garden/"
        target="_blank"
        rel="noopener noreferrer"
      >
        Steam Page (Full Game, Coming Soon)
        <span class="mlgg-download-arrow">→</span>
      </a>
      <a
        class="mlgg-download-btn"
        href="https://store.steampowered.com/app/5105970/MuvLuv_Girls_Garden_Demo/"
        target="_blank"
        rel="noopener noreferrer"
      >
        Free Steam Demo
        <span class="mlgg-download-arrow">→</span>
      </a>
    </div>
    <div class="mlgg-download-row mlgg-download-row-secondary">
      <a
        class="mlgg-download-ghost"
        href="https://muvluv-girls-garden.com/"
        target="_blank"
        rel="noopener noreferrer"
      >
        Official Site &amp; DMM GAMES (JP)
      </a>
      <a
        class="mlgg-download-ghost"
        href="https://x.com/Muvluv_GG"
        target="_blank"
        rel="noopener noreferrer"
      >
        Official X
      </a>
      <a
        class="mlgg-download-ghost"
        href="https://muvluv-girls-garden.wikiru.jp/"
        target="_blank"
        rel="noopener noreferrer"
      >
        wikiru.jp
      </a>
    </div>

    <DiscordPromo accent="#FA3C8C" />

    {lastUpdate && (
      <p class="mlgg-last-updated">
        Last Updated: <FormattedDate date={new Date(lastUpdate)} />
      </p>
    )}
  </section>

  <section class="mlgg-resources-section">
    <h2 class="mlgg-resources-title">Guides &amp; Resources</h2>

    <div class="mlgg-resources-grid">
      <div class="mlgg-resource-category">
        <div class="mlgg-category-header">
          <h3>Characters</h3>
          <p class="mlgg-category-description">
            The global version's students with official English names, stats
            and skills, plus the full Japan server student list.
          </p>
        </div>
        <div class="mlgg-buttons-grid">
          <a href="/guides/muv-luv-girls-garden/students/" class="mlgg-resource-button">Students (Global)</a>
          <a href="/guides/muv-luv-girls-garden/characters/" class="mlgg-resource-button">Student List (Japan)</a>
          <a href="/guides/muv-luv-girls-garden/tier-list/" class="mlgg-resource-button">Tier List</a>
        </div>
      </div>

      <div class="mlgg-resource-category">
        <div class="mlgg-category-header">
          <h3>Banners</h3>
          <p class="mlgg-category-description">
            Full banner and card release history with banner art, featured students and new
            memories.
          </p>
        </div>
        <div class="mlgg-buttons-grid">
          <a href="/guides/muv-luv-girls-garden/banners/" class="mlgg-resource-button">Banner History</a>
        </div>
      </div>

      <div class="mlgg-resource-category">
        <div class="mlgg-category-header">
          <h3>Game</h3>
          <p class="mlgg-category-description">
            Game facts, the world of Zar'tum, and every team with its school and students.
          </p>
        </div>
        <div class="mlgg-buttons-grid">
          <a href="/guides/muv-luv-girls-garden/info/" class="mlgg-resource-button">Game Info</a>
        </div>
      </div>
    </div>
  </section>
</MLGGLayout>
