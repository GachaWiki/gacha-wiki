// suffixes like "– Part 2" / "(Part.2)" / "– Prologue" become Korean
const zhSuffixes = (s) =>
  s
    .replace(/\s*[–-]\s*Part\.?\s*(\d+)\s*$/i, ' (파트 $1)')
    .replace(/\s*[–-]\s*Prologue\s*$/i, ' (프롤로그)')
    .replace(/\s*\(Part\.?(\d+)\)\s*$/i, ' (파트 $1)');

function highlightZh(raw) {
  const h = raw.trim();
  if (EXACT_ZH[h]) return EXACT_ZH[h];
  let m;
  if ((m = h.match(/^Vanguard\/Weapon Rework\s*:\s*(.+)$/i)))
    return `수호자/무기 리워크: ${nameListZh(m[1])}`;
  if ((m = h.match(/^Vanguard Rework\s*:\s*(.+)$/i))) return `수호자 리워크: ${nameListZh(m[1])}`;
  if ((m = h.match(/^New Vanguard\s*:\s*(.+)$/i))) return `신규 수호자: ${charDisplay(m[1].trim())}`;
  if ((m = h.match(/^New Weapon\s*:\s*(.+)$/i))) return `신규 무기: ${weaponDisplay(m[1].trim())}`;
  if ((m = h.match(/^New Feature\s*[-–:]\s*(.+)$/))) {
    const feat = m[1].trim();
    return `신규 기능: ${FEATURE_ZH[feat] || feat}`;
  }
  if ((m = h.match(/^New Event Pass\s*:\s*(.+)$/))) return `신규 이벤트 패스: ${m[1].trim()}`;
  if ((m = h.match(/^New Pass\s*:\s*(.+)$/))) return `신규 패스: ${m[1].trim()}`;
  if ((m = h.match(/^New Stigma Set\s*:\s*(.+)$/i))) return `신규 성흔 세트: ${m[1].trim()}`;
  if ((m = h.match(/^New Stigma\s*\((.+)\)\s*$/i))) return `신규 성흔: ${m[1].trim()}`;
  if ((m = h.match(/^New Stigma\s*:\s*(.+)$/i))) return `신규 성흔: ${m[1].trim()}`;
  if ((m = h.match(/^New Event\s*:\s*(.+)$/i))) return `신규 이벤트: ${zhSuffixes(m[1].trim())}`;
  if ((m = h.match(/^Event Update\s*:\s*(.+)$/i))) return `이벤트 업데이트: ${zhSuffixes(m[1].trim())}`;
  if ((m = h.match(/^Event\s*:\s*(.+)$/i))) return `이벤트: ${zhSuffixes(m[1].trim())}`;
  return h;
}

const MONTHS = {
  January: 1, February: 2, March: 3, April: 4, May: 5, June: 6, July: 7,
  August: 8, September: 9, October: 10, November: 11, December: 12,
  Jan: 1, Feb: 2, Mar: 3, Apr: 4, Jun: 6, Jul: 7, Aug: 8, Sep: 9, Sept: 9, Oct: 10, Nov: 11, Dec: 12,
};

function titleZh(t) {
  const m = t.match(/^Patch Note\s*-\s*(.+)$/);
  if (!m) return t;
  let inner = m[1];
  let suffix = '';
  if (inner.includes('(+ Update)')) {
    suffix = ' (추가 업데이트 포함)';
    inner = inner.replace(/\s*\(\+ Update\)/, '');
  }
  const mm = inner.match(/^([A-Za-z]+)\.?\s+(\d{1,2})/);
  if (!mm || !MONTHS[mm[1]]) return `업데이트 공지: ${inner}`;
  const isMaint = /maintenance/i.test(inner);
  return `업데이트 공지: ${MONTHS[mm[1]]}월 ${parseInt(mm[2], 10)}일${isMaint ? ' 점검' : ''}${suffix}`;
}

const fmt = (iso) => `${iso.slice(0, 4)}.${iso.slice(5, 7)}.${iso.slice(8, 10)}`;

// group by month like the EN index
const groups = [];
for (const n of patchNotes) {
  const month = n.date.slice(0, 7);
  const label = `${month.slice(0, 4)}년 ${parseInt(month.slice(5, 7), 10)}월`;
  const last = groups[groups.length - 1];
  if (last && last.month === month) last.notes.push(n);
  else groups.push({ month, label, notes: [n] });
}
const newest = patchNotes[0];
const oldest = patchNotes[patchNotes.length - 1];
---

<HwLangLayout lang="ko" ui={HW_ZH}
  title="업데이트 공지 - 호라이즌 워커 한국어 위키 - GachaWiki"
  description={`호라이즌 워커 공식 업데이트 공지 한국어 정리, 총 ${patchNotes.length}편: 신규 수호자, 신규 무기, 이벤트, 밸런스 조정과 버그 수정을 ${fmt(oldest.date)}부터 ${fmt(newest.date)}까지 정리했습니다.`}
  keywords={['호라이즌 워커', '업데이트 공지', '점검', '버전 업데이트']}
  breadcrumbItems={[
    { name: '홈', href: '/' },
    { name: '호라이즌 워커', href: HW_ZH.baseUrl },
    { name: '업데이트 공지' },
  ]}
>
  <section class="hw-guide-hero">
    <h1 class="hw-guide-title">업데이트 공지</h1>
    <p class="hw-guide-subtitle">전체 공식 영어 업데이트 공지의 한국어 정리, {fmt(oldest.date)} ~ {fmt(newest.date)}.</p>
    <DecorativeLines />
  </section>

  <div class="hw-guide-content">
  <div class="pn-index">
    <div class="pn-index-intro">
      <p>
        『호라이즌 워커』 팀은 점검마다 공식 Naver Lounge에 영어 업데이트 공지를 게시합니다. 이 페이지는 전체
        {patchNotes.length}편 공지의 한국어 정리본이며(제목과 주요 사항을 직접 정리), 모든 표와 세부 사항을 담은 원문 전문은 해당 영어 공지 페이지에서 확인할 수 있습니다. 업데이트는 한국 서버 일정을 따르며 한국 서버가 글로벌 서버보다 몇 주 앞서 진행됩니다. 공식 원문의 구체적인 스킬 수치는 N 자리 표시자로 표기됩니다. 이벤트와 가챠 등 고유 명칭은 영어 원문 그대로 표기합니다.
      </p>
    </div>

    <div class="pn-index-controls">
      <input
        type="text"
        id="pn-search-input"
        class="pn-search"
        placeholder="업데이트 공지 검색 (한국어 또는 영어, 예: 코라비, Doomstar, 이벤트)"
        autocomplete="off"
      />
      <span class="pn-count" id="pn-count-el">{patchNotes.length}편 공지</span>
    </div>

    {
      groups.map((g) => (
        <section class="pn-month" data-month={g.month}>
          <h2 class="pn-month-title">{g.label}</h2>
          <div class="pn-cards">
            {g.notes.map((n) => {
              const zhTitle = titleZh(n.title);
              const zhTags = n.highlights.map((h) => highlightZh(h));
              const search = [n.title, zhTitle, ...n.highlights, ...zhTags].join(' ').toLowerCase();
              return (
                <a class="pn-card" href={`${HW_ZH.baseUrl}updates/${n.slug}/`} data-search={search}>
                  <div class="pn-card-date">{fmt(n.date)}</div>
                  <h3 class="pn-card-title">{zhTitle}</h3>
                  {zhTags.length > 0 && (
                    <div class="pn-card-tags">
                      {zhTags.map((t) => (
                        <span class="pn-card-tag">{t}</span>
                      ))}
                    </div>
                  )}
                </a>
              );
            })}
          </div>
        </section>
      ))
    }
  </div>
  </div>
</HwLangLayout>

<script is:inline>
  var input = document.getElementById('pn-search-input');
  var cards = document.querySelectorAll('.pn-card');
  var months = document.querySelectorAll('.pn-month');
  var count = document.getElementById('pn-count-el');
  var total = cards.length;
  input.addEventListener('input', function () {
    var q = input.value.trim().toLowerCase();
    var visible = 0;
    cards.forEach(function (c) {
      var show = !q || c.dataset.search.includes(q);
      c.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    months.forEach(function (m) {
      var any = Array.prototype.some.call(m.querySelectorAll('.pn-card'), function (c) {
        return c.style.display !== 'none';
      });
      m.style.display = any ? '' : 'none';
    });
    count.textContent = q ? visible + ' / ' + total + '편 공지' : total + '편 공지';
  });
</script>

