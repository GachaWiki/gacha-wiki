---
// Korean Trait System page: /ko/guides/horizon-walker/traits/
// Trait names, stat lines and EX passives use the game's official Korean;
// intro and section labels are wiki editorial text.
import HwLangLayout from '../../../../layouts/lang/HwLangLayout.astro';
import TraitsDb from '../../../../components/horizon-walker/TraitsDb.astro';
import { GENERAL_TRAITS, TRAIT_GRADES, EX_SKILLS } from '../../../../data/horizon-walker/traits.js';
import { TRAIT_NAMES_LOC, STAT_LABELS_LOC, EX_SKILLS_LOC } from '../../../../data/horizon-walker/ko/traits-loc.js';
import { HW_ZH } from '../../../../data/horizon-walker/ko/ui.js';

export const prerender = true;

const keyByPassiveName = {};
for (const [k, v] of Object.entries(EX_SKILLS)) keyByPassiveName[v.name] = k;

const effectKo = (line) => {
  const idx = Math.max(line.lastIndexOf(' +'), line.lastIndexOf(' -'));
  if (idx <= 0) return line;
  const label = line.slice(0, idx).trim();
  return `${STAT_LABELS_LOC[label] || label}${line.slice(idx)}`;
};

const rows = GENERAL_TRAITS.map((t) => ({
  id: t.id,
  name: TRAIT_NAMES_LOC[t.id] || t.name,
  grade: t.grade,
  effects: t.effects.map(effectKo),
  passiveKey: t.passive ? (keyByPassiveName[t.passive] || null) : null,
}));

const NOTES = {
  1: '최하위 스탯 특성.',
  2: '하위 스탯 특성.',
  3: '중위 스탯 특성.',
  4: '혼 빚기로 제작 가능(혼 가위 필요).',
  5: '혼 빚기로 제작 가능(혼 가위 필요).',
  6: '혼 빚기로 제작 가능(혼 가위 필요).',
  7: 'EX 패시브 계열마다 여러 선택지가 있습니다. EX 등급 용병이 지참.',
};
const grades = TRAIT_GRADES.map((g) => ({ grade: g.grade, label: `${g.grade}등급`, note: NOTES[g.grade] || '' }));
---

<HwLangLayout lang="ko" ui={HW_ZH}
  title={`특성 시스템 - 일반 특성, 등급, EX 패시브 - 호라이즌 워커 한국어 위키 - GachaWiki`}
  description={`호라이즌 워커 특성 시스템 완전 정리: 전체 ${GENERAL_TRAITS.length}종 일반 특성을 1~7등급별 효과와 함께 수록하고, 7등급 EX 패시브, 혼궤, 혼샘(혼 담기·혼 빚기)과 복구작전 특성 보상을 해설합니다. 특성명과 스탯은 게임 공식 한국어입니다.`}
  keywords={['호라이즌 워커', '특성', '일반 특성', '특성 시스템', '공략']}
  pageTitle="특성 시스템"
  breadcrumbItems={[
    { name: '홈', href: '/' },
    { name: '호라이즌 워커', href: HW_ZH.baseUrl },
    { name: '특성 시스템' },
  ]}
>
  <div class="traits-db">
    <section class="traits-intro">
      <h2 class="traits-intro-heading">특성 시스템의 구조</h2>
      <p class="traits-intro-text">
        일반 특성은 1~7등급으로 나뉩니다. 아이콘과 이름 색상은 등급에 따라 달라지며 1~3등급은 같은 색상을 사용합니다. 등급이 높을수록 강력한 스탯을 제공하고, 7등급 특성은 EX 패시브 스킬을 추가로 부여합니다.
      </p>
      <h3 class="traits-intro-sub">혼궤</h3>
      <p class="traits-intro-text">
        일반 특성을 보관하는 새 인벤토리 탭입니다. 특성별로 최대 50,000개까지 보관할 수 있고, 미보유 특성도 도감처럼 등급 필터로 확인할 수 있습니다. 보관한 특성은 비용 없이 캐릭터에게 장착할 수 있으며, 특성 필터는 제공 스탯 기준 정렬도 지원합니다.
      </p>
      <h3 class="traits-intro-sub">혼샘: 혼 담기와 혼 빚기</h3>
      <p class="traits-intro-text">
        혼 담기는 일반 특성을 혼으로 변환합니다(한 번에 최대 20종, 등급이 높을수록 더 많은 혼 획득). 혼 빚기는 혼을 소모해 선택한 등급의 일반 특성을 무작위로 제작합니다(한 번에 최대 20개). 4등급 이상 제작에는 혼 가위가 필요합니다.
      </p>
      <h3 class="traits-intro-sub">복구작전 보상</h3>
      <p class="traits-intro-text">
        복구작전(본편 4장 스테이지 6-1 클리어 후 해금)에서는 지역 방위 임무 보상으로 일반 특성이 지급됩니다. 긴급 출격 승리 시 4~6등급 특성 3개를 추가로 받습니다. FairyNet 검색으로 등장하는 EX 등급 용병은 항상 7등급 특성을 1개 이상 지참합니다.
      </p>
    </section>

    <TraitsDb
      rows={rows}
      exByPassive={EX_SKILLS_LOC}
      grades={grades}
      strings={{
        all: '전체',
        searchPlaceholder: '특성 이름, 스탯 또는 패시브 검색…',
        empty: '현재 필터에 일치하는 특성이 없습니다.',
        hint: '각 EX 패시브는 패시브가 같고 공격 타입 스탯(근접·원거리·마법)이 다른 특성 옵션을 최대 3가지 제공합니다. 캐릭터의 피해 타입에 맞는 옵션을 고르세요. 마지막 그룹은 패시브 없는 순수 스탯 옵션입니다.',
        optionsLabel: '옵션:',
        pureLabel: '순수 스탯 특성',
        pureDesc: 'EX 패시브 없음: 순수 스탯 라인.',
      }}
    />
  </div>
</HwLangLayout>
