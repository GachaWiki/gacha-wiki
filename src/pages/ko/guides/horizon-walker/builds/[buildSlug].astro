// ---------- stigma resolution (same logic as the EN page) -------------------
const findStigmaSet = (name) =>
  stigmas.EX?.find((stigma) => stigma.name === name) ||
  stigmas.SS?.find((stigma) => stigma.name === name) ||
  stigmas.S?.find((stigma) => stigma.name === name) ||
  stigmas.A?.find((stigma) => stigma.name === name) ||
  null;

function resolveStigmaDisplay(rec, mixedLayout) {
  if (rec === null || rec === undefined) return null;
  if (typeof rec === 'string' && rec.includes('Mixed 2-Set')) {
    const layout = mixedLayout;
    if (layout && layout.top && layout.bottom && layout.left && layout.right) {
      const setNames = [...new Set([layout.top, layout.bottom, layout.left, layout.right])];
      if (setNames.length === 2) {
        const st1 = stigmas.EX?.find((stigma) => stigma.name === setNames[0]);
        const st2 = stigmas.EX?.find((stigma) => stigma.name === setNames[1]);
        if (st1 && st2) {
          const pieceFor = (slot) => (layout[slot] === setNames[0] ? st1 : st2).pieces[slot];
          return {
            type: 'mixed',
            pieces: {
              stigma1Name: setNames[0],
              stigma2Name: setNames[1],
              top: pieceFor('top'),
              bottom: pieceFor('bottom'),
              left: pieceFor('left'),
              right: pieceFor('right'),
              twoSetBonus1: st1.twoSet,
              twoSetBonus2: st2.twoSet,
            },
          };
        }
      }
    }
    if (character.slug !== 'echidna') {
      const reckoningOfSin = stigmas.EX?.find((stigma) => stigma.name === 'Reckoning of Sin');
      const thousandMileWeave = stigmas.EX?.find((stigma) => stigma.name === 'The Thousand Mile Weave');
      if (reckoningOfSin && thousandMileWeave) {
        return {
          type: 'mixed',
          pieces: {
            stigma1Name: 'Reckoning of Sin',
            stigma2Name: 'The Thousand Mile Weave',
            top: thousandMileWeave.pieces.top,
            bottom: reckoningOfSin.pieces.bottom,
            left: reckoningOfSin.pieces.left,
            right: thousandMileWeave.pieces.right,
            twoSetBonus1: reckoningOfSin.twoSet,
            twoSetBonus2: thousandMileWeave.twoSet,
          },
        };
      }
    } else {
      const eternalBattle = stigmas.EX?.find((stigma) => stigma.name === 'The Eternal Battle');
      const windWanders = stigmas.EX?.find((stigma) => stigma.name === 'The Wind that Wanders the World');
      if (eternalBattle && windWanders) {
        return {
          type: 'mixed',
          pieces: {
            stigma1Name: 'The Eternal Battle',
            stigma2Name: 'The Wind that Wanders the World',
            top: eternalBattle.pieces.top,
            bottom: windWanders.pieces.bottom,
            left: eternalBattle.pieces.left,
            right: windWanders.pieces.right,
            twoSetBonus1: eternalBattle.twoSet,
            twoSetBonus2: windWanders.twoSet,
          },
        };
      }
    }
    return null;
  }
  if (typeof rec === 'object') {
    return { type: 'object', zeroDupe: findStigmaSet(rec.zeroDupe), fullEx5: findStigmaSet(rec.fullEx5) };
  }
  return { type: 'single', set: findStigmaSet(rec) };
}

const stigmaSections =
