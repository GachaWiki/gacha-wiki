];
---

<HwLangLayout lang="ko" ui={HW_ZH}
  title={`${zhName} 빌드 - 호라이즌 워커 한국어 위키 - GachaWiki`}
  description={`호라이즌 워커 ${zhName}(${character.name})의 추천 빌드: 빌드 전략, 추천 성흔, 부옵션 우선순위와 특성 선택. 성흔 세트명은 영문 원문 그대로 표기합니다.`}
  keywords={[zhName, character.name, '호라이즌 워커', '빌드', '성흔']}
  pageTitle={`${zhName} 빌드`}
  breadcrumbItems={[
    { name: '홈', href: '/' },
    { name: '호라이즌 워커', href: HW_ZH.baseUrl },
    { name: '추천 빌드', href: `${HW_ZH.baseUrl}builds/` },
    { name: zhName },
  ]}
>
  <div class="character-build-header">
    <div class="character-build-image">
      <CharacterImage
        imageName={character.image || character.name}
        alt={zhName}
        width={120}
        height={120}
        class="character-build-portrait"
        loading="eager"
      />
    </div>
    <div class="character-build-info">
      <h2 class="character-build-name">{zhName} 빌드</h2>
      <p class="zh-cb-en">{character.name} Build</p>
      <div class="character-build-badges">
        <span class="hw-badge" data-type="Cost">비용 {build.cost}</span>
        <HWRarityIcon rarity={build.rarity} width={44} height={22} />
        <span class="character-tag damage-scaling">{scalingZh}</span>
      </div>
      <div class="zh-cb-links">
        <a href={`${HW_ZH.baseUrl}characters/${character.slug}/`}>캐릭터 페이지</a>
        <a href={enPageUrl}>영문 빌드 페이지 보기</a>
        {hasCommunityBuild && <a href={`${HW_ZH.baseUrl}builds/community/${character.slug}/`}>커뮤니티 빌드</a>}
      </div>
    </div>
  </div>

  <!-- Core Stats Section -->
  <section class="character-build-section">
    <h3 class="character-build-section-title">핵심 스탯</h3>
    <div class="core-stats-explanation">
      <div class="stat-explanation-grid">
        <span><span class="stat-name">근력: </span><span class="stat-description">근접 공격력 증가</span></span>
        <span><span class="stat-name">기교: </span><span class="stat-description">사격 공격력 증가</span></span>
        <span><span class="stat-name">지능: </span><span class="stat-description">마법 공격력 증가</span></span>
        <span><span class="stat-name">체질: </span><span class="stat-description">최대 생명력 증가</span></span>
        <span><span class="stat-name">민첩: </span><span class="stat-description">회피와 행동 회복력 증가</span></span>
      </div>
    </div>
    <div class="core-stats-grid">
      {
        coreStats.map((s) => (
          <div class="core-stat-card">
            <div class="core-stat-title">{s.label}</div>
            <div class="core-stat-value">{s.value ?? '데이터 없음'}</div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Build Strategy Box -->
  <section class="character-build-section">
    <h3 class="character-build-section-title">빌드 전략</h3>
    <div class="strategy-box">
      <h4 class="strategy-title">{prose.title}</h4>
      <div class="strategy-content">
        {
          strategyZh.map((s) => (
            <div class="strategy-point">
              <div class="strategy-text">
                <strong>{s.title}</strong>: {s.description}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Recommended Stigma Section -->
  {
    stigmaSections.some((s) => s.display) && (
      <section class="character-build-section">
        <h3 class="character-build-section-title">추천 성흔</h3>
        <div class="stigma-container">
          {stigmaSections
            .filter((s) => s.display)
            .map((section) => (
          <div class="stigma-build-section">
            {section.label && <div class="stigma-build-label">{section.label}</div>}
            {section.display?.type === 'mixed' ? (
              <>
                <div class="stigma-header">
                  <div class="stigma-title-section">
                    <div class="stigma-info-container">
                      <div class="stigma-image-container">
                        <StigmaImage imageName={section.display.pieces.stigma1Name} alt={`${section.display.pieces.stigma1Name} 성흔`} width={60} height={60} class="stigma-portrait-small" loading="eager" />
                      </div>
                      <div class="stigma-name-label">
                        <h5>{section.display.pieces.stigma1Name}</h5>
                        <HWRarityIcon rarity="EX" width={36} height={18} />
                      </div>
                    </div>

                    <div class="stigma-plus-sign">+</div>

                    <div class="stigma-info-container">
                      <div class="stigma-image-container">
                        <StigmaImage imageName={section.display.pieces.stigma2Name} alt={`${section.display.pieces.stigma2Name} 성흔`} width={60} height={60} class="stigma-portrait-small" loading="eager" />
                      </div>
                      <div class="stigma-name-label">
                        <h5>{section.display.pieces.stigma2Name}</h5>
                        <HWRarityIcon rarity="EX" width={36} height={18} />
                      </div>
                    </div>
                  </div>
                </div>

                <div class="stigma-bonuses">
                  <div class="stigma-set-bonus">
                    <h5>{section.display.pieces.stigma1Name} (2세트 효과)</h5>
                    <p>{section.display.pieces.twoSetBonus1}</p>
                  </div>
                  <div class="stigma-set-bonus">
                    <h5>{section.display.pieces.stigma2Name} (2세트 효과)</h5>
                    <p>{section.display.pieces.twoSetBonus2}</p>
                  </div>
                </div>

                <div class="stigma-pieces">
                  <h5>믹스 성흔 부위</h5>
                  <div class="stigma-grid">
                    {['top', 'bottom', 'left', 'right'].map((slot) => (
                      <div class="stigma-piece">
                        <div class="piece-slot">{SLOT_ZH[slot]}</div>
                        <div class="piece-info">
                          <div class="piece-set-name">{section.display.pieces[slot].name}</div>
                          <div class="piece-stat-value">{statZh(section.display.pieces[slot].stat)}</div>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              </>
            ) : section.display.type === 'object' ? (
              <>
                <div class="stigma-option-section">
                  <div class="stigma-option-label">옵션 1: 저투자 (무돌파)</div>
                  <div class="stigma-header">
                    <div class="stigma-title-section">
                      <div class="stigma-image-container">
                        <StigmaImage imageName={section.display.zeroDupe.name} alt={`${section.display.zeroDupe.name} 성흔`} width={60} height={60} class="stigma-portrait-small" loading="eager" />
                      </div>
                      <div class="stigma-title-info">
                        <h4 class="stigma-name">{section.display.zeroDupe.name}</h4>
                        <HWRarityIcon rarity="EX" width={36} height={18} />
                      </div>
                    </div>
                  </div>

                  <div class="stigma-bonuses">
                    <div class="stigma-set-bonus">
                      <h5>2세트 효과</h5>
                      <p>{section.display.zeroDupe.twoSet}</p>
                    </div>
                    {section.display.zeroDupe.fourSet && (
                      <div class="stigma-set-bonus">
                        <h5>4세트 효과</h5>
                        <p>{section.display.zeroDupe.fourSet}</p>
                      </div>
                    )}
                  </div>

                  <div class="stigma-pieces">
                    <h5>성흔 부위</h5>
                    <div class="stigma-grid">
                      {['top', 'bottom', 'left', 'right'].map((slot) => (
                        <div class="stigma-piece">
                          <div class="piece-slot">{SLOT_ZH[slot]}</div>
                          <div class="piece-info">
                            <div class="piece-name">{section.display.zeroDupe.pieces[slot].name}</div>
                            <div class="piece-stat">{statZh(section.display.zeroDupe.pieces[slot].stat)}</div>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>

                <div class="stigma-option-divider">
                  <span>또는</span>
                </div>

                <div class="stigma-option-section">
                  <div class="stigma-option-label">옵션 2: 만돌파 EX5 무기</div>
                  <div class="stigma-header">
                    <div class="stigma-title-section">
                      <div class="stigma-image-container">
                        <StigmaImage imageName={section.display.fullEx5.name} alt={`${section.display.fullEx5.name} 성흔`} width={60} height={60} class="stigma-portrait-small" loading="eager" />
                      </div>
                      <div class="stigma-title-info">
                        <h4 class="stigma-name">{section.display.fullEx5.name}</h4>
                        <HWRarityIcon rarity="EX" width={36} height={18} />
                      </div>
                    </div>
                  </div>

                  <div class="stigma-bonuses">
                    <div class="stigma-set-bonus">
                      <h5>2세트 효과</h5>
                      <p>{section.display.fullEx5.twoSet}</p>
                    </div>
                    {section.display.fullEx5.fourSet && (
                      <div class="stigma-set-bonus">
                        <h5>4세트 효과</h5>
                        <p>{section.display.fullEx5.fourSet}</p>
                      </div>
                    )}
                  </div>

                  <div class="stigma-pieces">
                    <h5>성흔 부위</h5>
                    <div class="stigma-grid">
                      {['top', 'bottom', 'left', 'right'].map((slot) => (
                        <div class="stigma-piece">
                          <div class="piece-slot">{SLOT_ZH[slot]}</div>
                          <div class="piece-info">
                            <div class="piece-name">{section.display.fullEx5.pieces[slot].name}</div>
                            <div class="piece-stat">{statZh(section.display.fullEx5.pieces[slot].stat)}</div>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </>
            ) : section.display?.set ? (
              <>
                <div class="stigma-header">
                  <div class="stigma-title-section">
                    <div class="stigma-image-container">
                      <StigmaImage imageName={section.display.set.name} alt={`${section.display.set.name} 성흔`} width={60} height={60} class="stigma-portrait-small" loading="eager" />
                    </div>
                    <div class="stigma-title-info">
                      <h4 class="stigma-name">{section.display.set.name}</h4>
                      <HWRarityIcon rarity="EX" width={36} height={18} />
                    </div>
                  </div>
                </div>

                <div class="stigma-bonuses">
                  <div class="stigma-set-bonus">
                    <h5>2세트 효과</h5>
                    <p>{section.display.set.twoSet}</p>
                  </div>
                  <div class="stigma-set-bonus">
                    <h5>4세트 효과</h5>
                    <p>{section.display.set.fourSet}</p>
                    {section.display.set.specialEffect && (
                      <p class="stigma-special-effect">[{section.display.set.specialEffect.name}]: {section.display.set.specialEffect.description}</p>
                    )}
                  </div>
                </div>

                <div class="stigma-pieces">
                  <h5>성흔 부위</h5>
                  <div class="stigma-grid">
                    {['top', 'bottom', 'left', 'right'].map((slot) => (
                      <div class="stigma-piece">
                        <div class="piece-slot">{SLOT_ZH[slot]}</div>
                        <div class="piece-info">
                          <div class="piece-name">{section.display.set.pieces[slot].name}</div>
                          <div class="piece-stat">{statZh(section.display.set.pieces[slot].stat)}</div>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              </>
            ) : (
              <div class="stigma-set-bonus">
                <h5>Stigma Plan</h5>
                <p>{buildConfig.recommendedStigma || 'See build strategy details.'}</p>
              </div>
            )}
          </div>
            ))}
        </div>
      </section>
    )
  }

  <!-- Recommended Substats Section -->
  {
    (buildConfig.substatBuilds || buildConfig.recommendedSubstats) && (
      <section class="character-build-section">
        <h3 class="character-build-section-title">추천 부옵션</h3>
        <div class="stigma-container">
          <div class="recommended-substats">
            <h5>부옵션 추천</h5>
            {
              buildConfig.substatBuilds ? (
                <div class="substat-builds">
                  {substatBuildsZh.map((b) => (
                    <div class="substat-build-card">
                      <div class="substat-build-name">{b.name}</div>
                      {b.note && <div class="substat-build-note">{b.note}</div>}
                      <div class="substats-list">
                        {b.stats.map((stat) => (
                          <div class="substat-item">
                            <div class="substat-info">
                              <div class="substat-name">{statZh(stat.stat)}</div>
                              <span
                                class="hw-badge"
                                data-type={stat.priority === 'Highest' ? 'Main' : 'Alt'}
                              >
                                {PRIORITY_ZH[stat.priority] || stat.priority}
                              </span>
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              ) : (
                <div class="substats-list">
                  {buildConfig.recommendedSubstats.map((substat, index) => (
                    <div
                      class={`substat-item ${index < 3 ? 'priority-best' : index === 3 ? 'priority-alternative' : 'priority-optional'}`}
                    >
                      <div class="substat-info">
                        <div class="substat-name">{statZh(substat.stat)}</div>
                        <div class="substat-priority">{PRIORITY_ZH[substat.priority] || substat.priority}</div>
                      </div>
                      <div class="substat-scale">{substat.scale}</div>
                    </div>
                  ))}
                </div>
              )
            }
            <div class="substats-note">
              <strong>우선순위: </strong>{prose.substatsPriority}
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- Alternative Build Strategies Section -->
  {
    altBuildsZh.length > 0 && (
      <section class="character-build-section">
        <h3 class="character-build-section-title">대체 빌드 전략</h3>
        <div class="alternative-builds-container">
          <div class="alternative-builds-grid">
            {altBuildsZh.map((b) => (
              <div class="alternative-build-card">
                <div class="alternative-build-header">
                  <h4 class="alternative-build-title">{b.title}</h4>
                  {b.recommendedStigma && (
                    <div class="alternative-build-stigma">
                      <div class="stigma-image-container">
                        <StigmaImage imageName={b.recommendedStigma} alt={`${b.recommendedStigma} 성흔`} width={64} height={64} class="stigma-portrait-medium" loading="eager" />
                      </div>
                      <div class="stigma-info">
                        <div class="stigma-label">추천 성흔</div>
                        <div class="stigma-name">{b.recommendedStigma}</div>
                      </div>
                    </div>
                  )}
                </div>
                <div class="alternative-build-content">
                  <p class="alternative-build-description">{b.description}</p>

                  {b.playstyle && (
                    <div class="alternative-build-playstyle">
                      <h5>운용 방법</h5>
                      <p>{b.playstyle}</p>
                    </div>
                  )}

                  {b.substatsFocus && (
                    <div class="alternative-build-substats">
                      <h5>부옵션 우선순위</h5>
                      <p>{b.substatsFocus}</p>
                    </div>
                  )}

                  {b.note && (
                    <div class="alternative-build-note">
                      <h5>특성 빌드 메모</h5>
                      <p>{b.note}</p>
                    </div>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Recommended Traits Section -->
  <section class="character-build-section">
    <h3 class="character-build-section-title">추천 특성</h3>
    <div class="recommended-traits">
      {buildConfig.traitBuilds ? (
        <div class="trait-builds">
          {buildConfig.traitBuilds.map((tb) => (
            <div class="trait-build-block">
              <h5 class="trait-build-title">{prose.traitBuildNames?.[tb.name] || tb.name}</h5>
              <div class="traits-list">
                {tb.traits.map((trait) => (
                  <div class="trait-item">
                    <div class="trait-info">
                      <div class="trait-name">
                        {traitZh(trait.name)}
                        <span class="zh-cb-trait-en">{trait.name}</span>
                      </div>
                    </div>
                    <div class="trait-effects">
                      {trait.effects.map((effect) => (
                        <div class="trait-effect">{effectZh(effect)}</div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <>
          <h5>{traitsTypeZh} 최적 특성 (최대 {buildConfig.traitsMax || 5}개)</h5>
          <div class="traits-list">
            {buildConfig.recommendedTraits.map((trait) => (
              <div class={`trait-item ${trait.priority === 'Best' ? 'priority-best' : 'priority-alternative'}`}>
                <div class="trait-info">
                  <div class="trait-name">
                    {traitZh(trait.name)}
                    <span class="zh-cb-trait-en">{trait.name}</span>
                    <span
                      class="hw-badge"
                      data-type={trait.priority === 'Best' ? 'Main' : 'Alt'}
                    >
                      {trait.priority === 'Best' ? '최우선' : '대안'}
                    </span>
                  </div>
                </div>
                <div class="trait-effects">
                  {trait.effects.map((effect) => (
                    <div class="trait-effect">{effectZh(effect)}</div>
                  ))}
                </div>
              </div>
            ))}
          </div>
          {buildConfig.traitRecommendation && (
            <div class="traits-note">
              <strong>추천 선택: </strong>{prose.traitRecommendation || buildConfig.traitRecommendation}
            </div>
          )}
        </>
      )}
    </div>
  </section>
</HwLangLayout>

<style>
  /* ZH-only elements without an EN equivalent: the EN gloss line + quick links */
  .zh-cb-en {
    color: var(--hw-text-very-muted);
    font-size: var(--text-md);
    margin: 0.1rem 0 0.6rem 0;
  }

  .zh-cb-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.7rem;
  }

  .zh-cb-links a {
    color: var(--hw-primary-warm);
    font-size: var(--text-md);
    font-weight: 600;
    text-decoration: none;
    border: 1px solid rgba(232, 165, 71, 0.35);
    border-radius: 8px;
    padding: 0.35rem 0.8rem;
  }

  .zh-cb-trait-en {
    color: var(--hw-text-very-muted);
    font-size: var(--text-xs);
    font-weight: 400;
    margin-left: 0.35rem;
  }
</style>
