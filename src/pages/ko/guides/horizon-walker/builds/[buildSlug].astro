const statZh = (s) => STAT_TOKEN_ZH[s] || HW_ZH_STAT_TYPES[s] || s;

// "Label: +5%" trait effect lines -> official KO label + kept value
const effectZh = (e) => {
  const i = e.indexOf(':');
  if (i < 0) return e;
  const label = e.slice(0, i).trim();
  let value = e.slice(i + 1);
  for (const [en, zh] of Object.entries(STAT_TOKEN_ZH)) value = value.split(en).join(zh);
  return statZh(label) ? `${statZh(label)}: ${value}` : e;
};

