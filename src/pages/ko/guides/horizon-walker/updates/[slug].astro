const zhSuffixes = (s) =>
  s
    .replace(/\s*[–-]\s*Part\.?\s*(\d+)\s*$/i, ' (파트 $1)')
    .replace(/\s*[–-]\s*Prologue\s*$/i, ' (프롤로그)')
    .replace(/\s*\(Part\.?(\d+)\)\s*$/i, ' (파트 $1)');

function highlightZh(raw) {
  const h = raw.trim();
  if (EXACT_ZH[h]) return EXACT_ZH[h];
  let m;
  if ((m = h.match(/^Vanguard\/Weapon Rework\s*:\s*(.+)$/i)))
    return `수호자/무기 리워크: ${nameListZh(m[1])}`;
  if ((m = h.match(/^Vanguard Rework\s*:\s*(.+)$/i))) return `수호자 리워크: ${nameListZh(m[1])}`;
  if ((m = h.match(/^New Vanguard\s*:\s*(.+)$/i))) return `신규 수호자: ${charDisplay(m[1].trim())}`;
  if ((m = h.match(/^New Weapon\s*:\s*(.+)$/i))) return `신규 무기: ${weaponDisplay(m[1].trim())}`;
  if ((m = h.match(/^New Feature\s*[-–:]\s*(.+)$/))) {
    const feat = m[1].trim();
    return `신규 기능: ${FEATURE_ZH[feat] || feat}`;
  }
  if ((m = h.match(/^New Event Pass\s*:\s*(.+)$/))) return `신규 이벤트 패스: ${m[1].trim()}`;
  if ((m = h.match(/^New Pass\s*:\s*(.+)$/))) return `신규 패스: ${m[1].trim()}`;
  if ((m = h.match(/^New Stigma Set\s*:\s*(.+)$/i))) return `신규 성흔 세트: ${m[1].trim()}`;
  if ((m = h.match(/^New Stigma\s*\((.+)\)\s*$/i))) return `신규 성흔: ${m[1].trim()}`;
  if ((m = h.match(/^New Stigma\s*:\s*(.+)$/i))) return `신규 성흔: ${m[1].trim()}`;
  if ((m = h.match(/^New Event\s*:\s*(.+)$/i))) return `신규 이벤트: ${zhSuffixes(m[1].trim())}`;
  if ((m = h.match(/^Event Update\s*:\s*(.+)$/i))) return `이벤트 업데이트: ${zhSuffixes(m[1].trim())}`;
  if ((m = h.match(/^Event\s*:\s*(.+)$/i))) return `이벤트: ${zhSuffixes(m[1].trim())}`;
  return h;
}

const MONTHS = {
  January: 1, February: 2, March: 3, April: 4, May: 5, June: 6, July: 7,
  August: 8, September: 9, October: 10, November: 11, December: 12,
  Jan: 1, Feb: 2, Mar: 3, Apr: 4, Jun: 6, Jul: 7, Aug: 8, Sep: 9, Sept: 9, Oct: 10, Nov: 11, Dec: 12,
};

function titleZh(t) {
  const m = t.match(/^Patch Note\s*-\s*(.+)$/);
  if (!m) return t;
  let inner = m[1];
  let suffix = '';
  if (inner.includes('(+ Update)')) {
    suffix = ' (추가 업데이트 포함)';
    inner = inner.replace(/\s*\(\+ Update\)/, '');
  }
  const mm = inner.match(/^([A-Za-z]+)\.?\s+(\d{1,2})/);
  if (!mm || !MONTHS[mm[1]]) return `업데이트 공지: ${inner}`;
  const isMaint = /maintenance/i.test(inner);
  return `업데이트 공지: ${MONTHS[mm[1]]}월 ${parseInt(mm[2], 10)}일${isMaint ? ' 점검' : ''}${suffix}`;
}

export function getStaticPaths() {
  return patchNotes.map((n) => ({
    params: { slug: n.slug },
  }));
}

const { slug } = Astro.params;
const noteModules = import.meta.glob('/src/data/horizon-walker/patch-notes/*.js');
const loader = noteModules[`/src/data/horizon-walker/patch-notes/${slug}.js`];
if (!loader) {
  return Astro.redirect(`${HW_ZH.baseUrl}updates/`);
}
const { note } = await loader();

const meta = patchNotes.find((n) => n.slug === slug) || note;
const zhTitle = titleZh(note.title);
const posted = `${parseInt(note.date.slice(0, 4), 10)}년 ${parseInt(note.date.slice(5, 7), 10)}월 ${parseInt(
  note.date.slice(8, 10),
  10
)}일`;
const zhTags = note.highlights.map((h) => highlightZh(h));
const firstImage = note.blocks.find((b) => b.k === 'img');
const enPageUrl = `/guides/horizon-walker/updates/${slug}/`;
---

<HwLangLayout lang="ko" ui={HW_ZH}
  title={`${zhTitle} - 호라이즌 워커 한국어 위키 - GachaWiki`}
  description={`${zhTitle} (${posted} 게시) 주요 사항 한국어 정리: ${zhTags.join(', ')}. 전체 내용은 해당 공식 영어 공지에서 확인할 수 있습니다.`}
  keywords={['호라이즌 워커', '업데이트 공지', note.date]}
  breadcrumbItems={[
    { name: '홈', href: '/' },
    { name: '호라이즌 워커', href: HW_ZH.baseUrl },
    { name: '업데이트 공지', href: `${HW_ZH.baseUrl}updates/` },
    { name: zhTitle },
  ]}
>
  <section class="hw-guide-hero">
    <h1 class="hw-guide-title">{zhTitle}</h1>
    <p class="hw-guide-subtitle">{posted}에 게시된 공식 업데이트 공지의 한국어 주요 사항 정리입니다.</p>
    <DecorativeLines />
  </section>

  <div class="hw-guide-content">
  <div class="pn-page">
    <div class="pn-meta-card">
      <div class="pn-meta-row">
        <span class="pn-meta-label">게시일</span>
        <span class="pn-meta-value">{posted}</span>
      </div>
      <div class="pn-meta-row">
        <span class="pn-meta-label">원문 제목</span>
        <span class="pn-meta-value">{note.title}</span>
      </div>
      <div class="pn-meta-row">
        <span class="pn-meta-label">출처</span>
        <a class="pn-meta-link" href={note.sourceUrl} target="_blank" rel="noopener">
          Naver Lounge 공식 게시물
        </a>
      </div>
      <div class="pn-meta-row">
        <span class="pn-meta-label">언어</span>
        <span class="pn-meta-value">공식 영어 공지, 이 페이지는 한국어 주요 사항 정리</span>
      </div>
    </div>

    <p class="pn-schedule-note">
      업데이트 공지는 한국 서버 일정을 따르며, 한국 서버가 글로벌 서버보다 몇 주 앞서 진행됩니다. 공식 원문의 구체적인 스킬 수치는 N 자리 표시자로 표기됩니다. 이벤트와 가챠 등 고유 명칭은 영어 원문 그대로 표기합니다.
    </p>

    {
      firstImage && (
        <div class="pn-banner">
          <img
            src={r2Url('horizon-walker', `patch-notes/${firstImage.src}`)}
            alt={`${zhTitle} 배너 이미지`}
            width={firstImage.w || 960}
            height={firstImage.h || 200}
            loading="eager"
          />
        </div>
      )
    }

    <article class="pn-body">
      <h2 class="pn-sec">이번 업데이트 주요 사항</h2>
      <ul class="pn-points">
        {
          zhTags.map((t) => (
            <li class="pn-point">{t}</li>
          ))
        }
      </ul>
      <p class="pn-note">
        위 내용은 이 공지의 주요 사항을 한국어로 정리한 것입니다. 전체 내용(모든 섹션, 스킬 표와 이미지)은
        <a href={enPageUrl}>해당 영어 공지 페이지</a>에서 확인할 수 있습니다.
      </p>
    </article>

    <div class="pn-footer-nav">
      <a class="pn-back" href={`${HW_ZH.baseUrl}updates/`}>전체 업데이트 공지</a>
      <a class="pn-back" href={enPageUrl}>전체 영어 공지 보기</a>
      <a class="pn-back" href={note.sourceUrl} target="_blank" rel="noopener">
        Naver Lounge에서 원문 보기
      </a>
    </div>
  </div>
  </div>
</HwLangLayout>

