---
// Korean banner timeline: /ko/guides/horizon-walker/banners/
// Same banner-timeline.js data as the EN page (order, grouping, images).
// Banner/search titles stay in English (official proper nouns); character and
// weapon names use the game's official Korean via game-text.js maps. Periods
// use the numeric 2026.01.01 ~ 2026.01.15 format.
import HwLangLayout from '../../../../layouts/lang/HwLangLayout.astro';
import DecorativeLines from '../../../../components/DecorativeLines.astro';
import '../../../../styles/games/horizon-walker/hw-guide.css';
import { bannerRuns, focusedSearches, characterReleases } from '../../../../data/horizon-walker/banner-timeline.js';
import { HORIZON_WALKER_CHARACTERS } from '../../../../data/horizon-walker/characters.js';
import { HW_ZH_NAMES, HW_ZH_INHERITANCE } from '../../../../data/horizon-walker/ko/game-text.js';
import { HW_ZH } from '../../../../data/horizon-walker/ko/ui.js';
import { r2Url } from '../../../../data/r2-config.js';
import { CharacterImage, WeaponImage, HWRarityIcon } from '../../../../components/horizon-walker/index.astro';

export const prerender = true;

const charBySlug = {};
for (const c of HORIZON_WALKER_CHARACTERS) {
  charBySlug[c.slug] = c;
}

// official ZH name of a roster character, by EN name or slug
const zhCharName = (c) => (c ? HW_ZH_NAMES[c.id] || null : null);
const zhBySlug = (slug) => zhCharName(charBySlug[slug]);
// official ZH name of an EX/inheritance weapon (EN loc name keyed)
const zhWeaponName = (name) => HW_ZH_INHERITANCE[name]?.name || null;

// numeric period format, kept identical in spirit to the EN dates
const fmt = (iso) => `${iso.slice(0, 4)}.${iso.slice(5, 7)}.${iso.slice(8, 10)}`;
const fmtShort = (iso) => `${iso.slice(5, 7)}.${iso.slice(8, 10)}`;
const windowLabel = (r) =>
  r.start.slice(0, 4) === r.end.slice(0, 4)
    ? `${fmtShort(r.start)} ~ ${fmt(r.end)}`
    : `${fmt(r.start)} ~ ${fmt(r.end)}`;

const days = (r) =>
  Math.round((Date.parse(r.end + 'T12:00:00Z') - Date.parse(r.start + 'T12:00:00Z')) / 86400000);

const isNew = (r) => r.type === 'debut';
const isActive = (r) =>
  Date.parse(r.start + 'T00:00:00Z') <= Date.now() && Date.now() <= Date.parse(r.end + 'T23:59:59Z');

// group runs by year, newest first (same as EN)
const yearGroups = [];
for (const r of bannerRuns) {
  const year = r.start.slice(0, 4);
  const last = yearGroups[yearGroups.length - 1];
  if (last && last.year === year) last.runs.push(r);
  else yearGroups.push({ year, runs: [r] });
}

// search index: EN names + official ZH names so both work
const searchOf = (r) =>
  r.entries
    .map((e) => [e.name, zhBySlug(e.charSlug), zhWeaponName(e.name)].filter(Boolean).join(' '))
    .join(' ')
    .toLowerCase();

const kindZh = (kind) => (kind === 'vanguard' ? '수호자' : kind === 'weapon' ? '무기' : '가챠');
---

<HwLangLayout lang="ko" ui={HW_ZH}
  title="가챠 타임라인 - 호라이즌 워커 한국어 위키 - GachaWiki"
  description="호라이즌 워커 전체 Special Search 한정 가챠 타임라인: 신규 수호자와 전용 무기 가챠, 복각 가챠의 개시와 종료 날짜를 공식 업데이트 공지에서 정리했습니다."
  keywords={['호라이즌 워커', '가챠', '가챠 타임라인', '복각', 'Special Search']}
  breadcrumbItems={[
    { name: '홈', href: '/' },
    { name: '호라이즌 워커', href: HW_ZH.baseUrl },
    { name: '가챠 타임라인' },
  ]}
>
  <section class="hw-guide-hero">
    <h1 class="hw-guide-title">가챠 타임라인</h1>
    <p class="hw-guide-subtitle">출시부터 현재까지의 모든 Special Search 가챠. 날짜는 공식 업데이트 공지 기준으로 정리했습니다.</p>
    <DecorativeLines />
  </section>

  <div class="hw-guide-content">
  <div class="bt-page">
    <div class="bt-intro">
      <p>
        『호라이즌 워커』의 가챠 시스템은 FairyNet Special Search입니다. 신규 수호자와 전용 무기 가챠는 보통 2주간 열리며, 이후 복각 가챠로 다시 돌아옵니다. 이 타임라인은
        <a href={`${HW_ZH.baseUrl}updates/`}>공식 업데이트 공지</a>의 Special Search 섹션에서 정리했습니다. 공지에 시각이 명시된 가챠는 정확한 기간이며, 나머지는 점검 날짜와 이후의 가챠 종료 공지로 추정한 것입니다(근사로 표기). 날짜는 한국 서버 일정을 따르며 매일 10:00(KST)에 초기화됩니다. 가챠 제목은 게임에서 사용하는 공식 영어 명칭입니다.
      </p>
    </div>

    <div class="bt-controls">
      <div class="bt-filters" role="group" aria-label="가챠 필터">
        <button class="bt-filter active" data-filter="all">전체</button>
        <button class="bt-filter" data-filter="debut">신규 가챠</button>
        <button class="bt-filter" data-filter="rerun">복각</button>
        <button class="bt-filter" data-filter="active">진행 중</button>
      </div>
      <input type="text" id="zhBtSearch" class="bt-search" placeholder="가챠 검색 (한국어 또는 영어, 예: 가루드, Doomstar)" autocomplete="off" />
      <span class="bt-count" id="zhBtCount">{bannerRuns.length}개 가챠</span>
    </div>

    {
      yearGroups.map((g) => (
        <section class="bt-year" data-year={g.year}>
          <h2 class="bt-year-title">{g.year}</h2>
          <div class="bt-cards">
            {g.runs.map((r) => (
              <article
                class={`bt-card ${isNew(r) ? 'bt-new' : 'bt-rerun'} ${r.bannerImage ? 'bt-has-art' : ''}`}
                data-type={r.type}
                data-active={isActive(r) ? '1' : '0'}
                data-start={r.start}
                data-end={r.end}
                data-search={searchOf(r)}
              >
                <div class="bt-card-body">
                  {r.bannerImage && (
                    <a class="bt-art" href={r2Url('horizon-walker', r.bannerImage)} target="_blank" rel="noopener">
                      <img
                        src={r2Url('horizon-walker', r.bannerImage)}
                        alt={`공식 가챠 키 비주얼: ${r.entries.map((e) => e.name).join(', ')}`}
                        loading="lazy"
                        width="700"
                        height="650"
                      />
                    </a>
                  )}
                  <div class="bt-card-info">
                    <header class="bt-card-head">
                      <div class="bt-card-when">
                        <span class="bt-dates">{windowLabel(r)}</span>
                        <span class="bt-len">{days(r)}일</span>
                        {isActive(r) && <span class="bt-badge bt-live">진행 중</span>}
                        <span class={`bt-badge ${isNew(r) ? 'bt-badge-new' : 'bt-badge-rerun'}`}>
                          {isNew(r) ? '신규 가챠' : '복각'}
                        </span>
                      </div>
                      <a class="bt-src" href={`${HW_ZH.baseUrl}updates/${r.sourceNote}/`}>업데이트 공지</a>
                    </header>
                    {(r.approximate || r.reconstructed) && (
                      <p class="bt-flag">
                        {r.reconstructed
                          ? '추정 기간: 해당 가챠는 이후의 가챠 종료 공지에서만 언급되었습니다.'
                          : '근사 기간: 공식 공지에 이 가챠의 정확한 종료일이 없습니다.'}
                      </p>
                    )}
                    <div class={r.bannerImage ? 'bt-chips' : 'bt-entries'}>
                      {r.entries.map((e) => {
                        const ch = e.charSlug ? charBySlug[e.charSlug] : undefined;
                        const icon = e.noteImage ? (
                          <img src={r2Url('horizon-walker', e.noteImage)} alt={e.name} loading="lazy" width="44" height="44" />
                        ) : ch ? (
                          <CharacterImage imageName={ch.image || ch.name} alt={zhCharName(ch) || e.name} width={44} height={44} />
                        ) : e.weaponImage ? (
                          <WeaponImage imageName={e.weaponImage} alt={e.name} width={44} height={44} />
                        ) : null;
                        const kindLine = [kindZh(e.kind), e.kind === 'vanguard' ? zhBySlug(e.charSlug) : zhWeaponName(e.name)]
                          .filter(Boolean)
                          .join(' · ');
                        const inner = (
                          <>
                            {icon && <span class="bt-chip-img">{icon}</span>}
                            <span class="bt-chip-meta">
                              <span class="bt-kind">{kindLine}</span>
                              <span class="bt-name">{e.name}</span>
                            </span>
                          </>
                        );
                        return ch ? (
                          <a class="bt-chip" href={`${HW_ZH.baseUrl}characters/${ch.slug}/`}>{inner}</a>
                        ) : (
                          <span class="bt-chip">{inner}</span>
                        );
                      })}
                    </div>
                  </div>
                </div>
                {r.bannerImage && <p class="bt-art-note">공식 업데이트 공지의 가챠 키 비주얼</p>}
              </article>
            ))}
          </div>
        </section>
      ))
    }

    {
      focusedSearches.length > 0 && (
        <section class="bt-focused">
          <h2 class="bt-year-title">Focused Search 기간</h2>
          <p class="bt-focused-note">
            공식 업데이트 공지에서 공개된 한정 자유 선택 가챠(Focused Search) 기간입니다. 사용하지 않은 Focused Search 티켓은 기간 종료 후 만료됩니다.
          </p>
          <div class="bt-focused-list">
            {focusedSearches.map((f) => (
              <span class="bt-focused-chip">{fmt(f.start)} ~ {fmt(f.end)}</span>
            ))}
          </div>
        </section>
      )
    }

    <section class="bt-releases" id="releases">
      <h2 class="bt-year-title">캐릭터 실장일</h2>
      <p class="bt-focused-note">
        각 수호자 캐릭터를 획득할 수 있게 된 시기로, 공식 업데이트 공지에서 직접 확인했습니다: 출시 라인업, 가챠 첫 등장, 바로 실장으로 구분됩니다. 전용 무기 가챠는 위 카드를 참고하세요.
      </p>
      <div class="bt-controls bt-rel-controls">
        <input type="text" id="zhBtRelSearch" class="bt-search" placeholder="캐릭터 검색 (한국어 또는 영어, 예: 코라비, Korabi)" autocomplete="off" />
        <div class="bt-filters" role="group" aria-label="정렬">
          <button class="bt-filter active" data-rsort="new">최신순</button>
          <button class="bt-filter" data-rsort="old">오래된순</button>
          <button class="bt-filter" data-rsort="az">이름순</button>
        </div>
        <span class="bt-count" id="zhBtRelCount">{characterReleases.length}명 캐릭터</span>
      </div>
      <div class="bt-rel-wrap">
        <table class="bt-rel-table">
          <thead>
            <tr>
              <th>캐릭터</th>
              <th>등급</th>
              <th>실장일</th>
              <th>획득 방법</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="zhBtRelBody">
            {characterReleases.map((c) => {
              const ch = c.slug ? charBySlug[c.slug] : undefined;
              const zh = zhBySlug(c.slug);
              return (
                <tr
                  data-date={c.date}
                  data-name={(zh || c.name).toLowerCase()}
                  data-search={`${c.name} ${zh || ''} ${c.bannerName ?? ''} ${c.via}`.toLowerCase()}
                >
                  <td class="bt-rel-char">
                    <span class="bt-chip-img">
                      {ch ? (
                        <CharacterImage imageName={ch.image || ch.name} alt={zh || c.name} width={40} height={40} />
                      ) : (
                        <span class="bt-noimg-sm" aria-hidden="true">{c.name.slice(0, 1)}</span>
                      )}
                    </span>
                    {c.slug ? (
                      <a class="bt-rel-name" href={`${HW_ZH.baseUrl}characters/${c.slug}/`}>
                        {zh || c.name}
                        <span class="bt-rel-en">{zh ? c.name : ''}</span>
                      </a>
                    ) : (
                      <span class="bt-rel-name">{zh || c.name}</span>
                    )}
                  </td>
                  <td>{c.rarity ? <HWRarityIcon rarity={c.rarity} width={48} height={24} /> : ''}</td>
                  <td class="bt-rel-date">{fmt(c.date)}</td>
                  <td class="bt-rel-how">
                    {c.via === 'launch' ? (
                      <span class="bt-how bt-how-launch">출시 라인업</span>
                    ) : c.via === 'banner' ? (
                      <span class="bt-how bt-how-banner">가챠: {c.bannerName}</span>
                    ) : (
                      <span class="bt-how bt-how-direct">신규 수호자</span>
                    )}
                  </td>
                  <td>{c.sourceNote && <a class="bt-src" href={`${HW_ZH.baseUrl}updates/${c.sourceNote}/`}>공지</a>}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  </div>
  </div>
</HwLangLayout>

<script is:inline>
  // graceful fallback: a broken icon tile becomes the character's initial
  function handleBrokenIcon(img) {
    var wrap = img.closest('.bt-chip-img');
    if (!wrap || wrap.classList.contains('bt-noicon')) return;
    var row = img.closest('tr');
    var name = row ? row.querySelector('.bt-rel-name') : null;
    var label = name ? name.textContent.trim().charAt(0).toUpperCase() : '';
    img.remove();
    wrap.classList.add('bt-noicon');
    wrap.dataset.letter = label || '?';
  }
  document.addEventListener('error', function (ev) {
    var img = ev.target;
    if (!img || img.tagName !== 'IMG') return;
    if (img.closest('.bt-chip-img')) handleBrokenIcon(img);
  }, true);
  document.querySelectorAll('.bt-chip-img img').forEach(function (img) {
    if (img.complete && img.naturalWidth === 0) handleBrokenIcon(img);
  });

  var input = document.getElementById('zhBtSearch');
  var cards = document.querySelectorAll('.bt-card');
  var years = document.querySelectorAll('.bt-year');
  var count = document.getElementById('zhBtCount');
  var total = cards.length;
  var filter = 'all';

  // Recompute the Active state client-side: the static markup reflects build time
  cards.forEach(function (c) {
    var s = Date.parse((c.dataset.start || '') + 'T00:00:00Z');
    var e = Date.parse((c.dataset.end || '') + 'T23:59:59Z');
    if (Number.isNaN(s) || Number.isNaN(e)) return;
    var now = Date.now();
    var live = now >= s && now <= e;
    if ((c.dataset.active || '0') === (live ? '1' : '0')) return;
    c.dataset.active = live ? '1' : '0';
    var when = c.querySelector('.bt-card-when');
    if (!when) return;
    var badge = when.querySelector('.bt-live');
    if (live && !badge) {
      var created = document.createElement('span');
      created.className = 'bt-badge bt-live';
      created.textContent = '진행 중';
      var typeBadge = when.querySelector('.bt-badge-new, .bt-badge-rerun');
      when.insertBefore(created, typeBadge);
    } else if (!live && badge) {
      badge.remove();
    }
  });

  function apply() {
    var q = input.value.trim().toLowerCase();
    var visible = 0;
    cards.forEach(function (c) {
      var okType =
        filter === 'all' ||
        (filter === 'active' ? c.dataset.active === '1' : c.dataset.type === filter);
      var okText = !q || (c.dataset.search || '').includes(q);
      var show = okType && okText;
      c.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    years.forEach(function (y) {
      var any = Array.prototype.some.call(y.querySelectorAll('.bt-card'), function (c) {
        return c.style.display !== 'none';
      });
      y.style.display = any ? '' : 'none';
    });
    count.textContent = q || filter !== 'all' ? visible + ' / ' + total + '개 가챠' : total + '개 가챠';
  }
  input.addEventListener('input', apply);
  document.querySelectorAll('.bt-filter[data-filter]').forEach(function (b) {
    b.addEventListener('click', function () {
      document.querySelectorAll('.bt-filter[data-filter]').forEach(function (x) {
        x.classList.remove('active');
      });
      b.classList.add('active');
      filter = b.dataset.filter;
      apply();
    });
  });

  // release table: filter + sort
  var relBody = document.getElementById('zhBtRelBody');
  if (relBody) {
    var relSearch = document.getElementById('zhBtRelSearch');
    var relCount = document.getElementById('zhBtRelCount');
    var rows = Array.prototype.slice.call(relBody.querySelectorAll('tr'));
    var rsort = 'new';
    function applyRel() {
      var q = relSearch.value.trim().toLowerCase();
      var visible = 0;
      rows.forEach(function (r) {
        var show = !q || (r.dataset.search || '').includes(q);
        r.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      relCount.textContent = q ? visible + ' / ' + rows.length + '명 캐릭터' : rows.length + '명 캐릭터';
    }
    function sortRel() {
      var sorted = rows.slice().sort(function (a, b) {
        if (rsort === 'az') return a.dataset.name.localeCompare(b.dataset.name, 'ko');
        var da = a.dataset.date, db = b.dataset.date;
        return rsort === 'new' ? db.localeCompare(da) : da.localeCompare(db);
      });
      sorted.forEach(function (r) {
        relBody.appendChild(r);
      });
    }
    relSearch.addEventListener('input', applyRel);
    document.querySelectorAll('[data-rsort]').forEach(function (b) {
      b.addEventListener('click', function () {
        document.querySelectorAll('[data-rsort]').forEach(function (x) {
          x.classList.remove('active');
        });
        b.classList.add('active');
        rsort = b.dataset.rsort;
        sortRel();
      });
    });
  }
</script>

<style>
  .bt-page {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }
  .bt-intro {
    background: var(--hw-white-05);
    border: 1px solid var(--hw-border-muted);
    border-radius: 10px;
    padding: 1rem 1.2rem;
  }
  .bt-intro p {
    color: var(--hw-text-muted);
    font-size: var(--text-md);
    line-height: 1.7;
    margin: 0;
  }
  .bt-intro a {
    color: var(--hw-primary-warm);
  }
  .bt-controls {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
  }
  .bt-filters {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .bt-filter {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    color: var(--hw-text-muted);
    font-size: var(--text-md);
    font-weight: 600;
    padding: 0.45rem 0.9rem;
    cursor: pointer;
  }
  .bt-filter.active {
    background: var(--hw-primary-warm-20);
    border-color: var(--hw-primary-warm);
    color: var(--hw-primary-warm);
  }
  .bt-search {
    flex: 1;
    min-width: 200px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    color: var(--hw-text-light);
    font-size: var(--text-body);
    padding: 0.55rem 0.9rem;
    outline: none;
  }
  .bt-search::placeholder {
    color: var(--hw-text-very-muted);
  }
  .bt-count {
    color: var(--hw-text-very-muted);
    font-size: var(--text-md);
    white-space: nowrap;
  }
  .bt-year {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .bt-year-title {
    color: var(--hw-primary-warm);
    font-size: var(--text-lg);
    font-weight: 700;
    margin: 0.4rem 0 0;
    border-bottom: 1px solid var(--hw-border-accent);
    padding-bottom: 0.4rem;
  }
  .bt-cards {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .bt-card {
    background: var(--hw-white-05);
    border: 1px solid var(--hw-border-light);
    border-radius: 10px;
    padding: 0.95rem 1.05rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .bt-card.bt-new {
    border-color: rgba(232, 165, 71, 0.35);
  }
  .bt-card-body {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .bt-card:not(.bt-has-art) .bt-card-body {
    flex-direction: column;
  }
  .bt-art {
    flex: 0 0 440px;
    max-width: 440px;
    display: block;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .bt-art img {
    width: 100%;
    height: auto;
    max-height: 560px;
    object-fit: contain;
    background: rgba(255, 255, 255, 0.02);
    display: block;
  }
  .bt-art-note {
    color: var(--hw-text-very-muted);
    font-size: var(--text-xs);
    margin: -0.3rem 0 0;
