---
// Gene-Sys: Adam ko character detail: shared i18n template.
import GsaI18nLayout from '../../../../../layouts/gene-sys-adam/GsaI18nLayout.astro';
import I18nCharacterDetail from '../../../../../components/gene-sys-adam/i18n/I18nCharacterDetail.astro';
import { GSA_KO } from '../../../../../data/gene-sys-adam/ko/ui.js';
import { gsaCharactersKo } from '../../../../../data/gene-sys-adam/ko/characters.js';
import { gsaStatLabelsKo } from '../../../../../data/gene-sys-adam/ko/stat-labels.js';
import '../../../../../styles/games/gene-sys-adam/gsa-characters.css';

export function getStaticPaths() {
  return gsaCharactersKo.map(c => ({ params: { slug: c.slug } }));
}

const ui = GSA_KO;
const characters = gsaCharactersKo;
const { slug } = Astro.params;
const current = characters.find(c => c.slug === slug);
---

{current && (
<GsaI18nLayout
  ui={ui}
  title={current.name}
  gameTitle={current.name}
  breadcrumbItems={[{ name: ui.gameName, href: ui.baseUrl }, { name: ui.labels.charactersDb, href: ui.baseUrl + 'characters/' }, { name: current.name }]}
>
  <I18nCharacterDetail ui={ui} characters={characters} slug={slug} statLabels={gsaStatLabelsKo} />
</GsaI18nLayout>
)}
