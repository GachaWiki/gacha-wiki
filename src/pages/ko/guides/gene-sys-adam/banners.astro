---
// <localized> banner history page, generated by gen_bu_locales.py from the
// decrypted draw tables (GSA_BANNERS) plus the localized overlay. Card layout
// mirrors the EN/zh-tw pages (gsa-banners.css); names use the game's own text.
import GsaI18nLayout from '../../../../layouts/gene-sys-adam/GsaI18nLayout.astro';
import { GSA_BANNERS } from '../../../../data/gene-sys-adam/banners.js';
import { gsaCharactersKo } from '../../../../data/gene-sys-adam/ko/characters.js';
import { GSA_KO } from '../../../../data/gene-sys-adam/ko/ui.js';
import '../../../../styles/games/gene-sys-adam/gsa-common.css';
import '../../../../styles/games/gene-sys-adam/gsa-banners.css';

const ui = GSA_KO;
const base = ui.baseUrl;

const L = {
  "ui": {
    "statusLive": "진행 중",
    "statusEnded": "종료",
    "statusBeta": "베타 기간",
    "statusScheduled": "예정",
    "secLive": "지금 진행 중",
    "secEnded": "최근 배너",
    "secBeta": "베타 기간(2026년 9월 17일~22일)",
    "secScheduled": "클라이언트 데이터에 로드된 예정 항목",
    "pityLabel": "피티:",
    "eventTokenLabel": "이벤트 토큰:",
    "trainingLabel": "훈련 미션:",
    "unreleased": "미출시",
    "noArt": "아직 배너 아트 없음",
    "bannerArtAlt": "배너 아트",
    "secondPanelAlt": "두 번째 패널",
    "intro": "개최되었거나 개최 예정으로 로드된 모든 이벤트 배너를 게임 자체의 뽑기 테이블에서 읽어 공식 공지와 X 계정(@GeneSysAdamEN)으로 교차 확인했다. 일정은 서버 측에서 구동되므로 각 항목에는 정확한 시각 대신 해당 데이터가 등장한 웨이브를 표기한다. 상시 풀(일반 스카우트, 엘리트 스카우트, 신규 스카우트, 무한 스카우트, 미러)은 이 히스토리에 포함되지 않는다. 2026년 10월 13일 갱신."
  },
  "banners": {
    "black-gold-hunter": {
      "name": "블랙골드 헌터: 카우걸 벨",
      "kind": "이벤트 티켓 스카우트",
      "since": "2026년 10월 13일부터 재개최 중, 11월 3일 06:59(UTC+8)까지 진행",
      "note": "블랙골드 헌터 이벤트가 10월 13일에 돌아왔다(공식 기간은 @GeneSysAdamJP 계정 참조). 이벤트 스테이지에서는 흑시장 금고 8곳을 여는 수배령 보석이 드롭하고, 금고마다 균등 확률의 보상 테이블로 지급되며, 유료와 무료 골드바는 이벤트 육성 보너스를 쌓는다. 티켓 레인에서는 카우걸 벨과 신입 메이드 스기모토 아리나를 뽑을 수 있고, 보석 뽑기 머신에는 120회 뽑기 보증이 걸려 있다. 클라이언트는 10월 13일 배너 아트 패널(Draw_Bg_23)을 내려받았다. 패널 자체는 R18이라 위키에 싣지 않으며, 카드는 공식 이벤트 아트를 사용한다. 로그인 선물도 함께 진행된다.",
      "eventToken": "수배령 보석과 골드바"
    },
    "ogino-rui-rate-up": {
      "name": "오기노 루이 픽업",
      "kind": "단독 픽업",
      "since": "2026년 9월 29일~10월 13일",
      "note": "9월 29일 점검부터 10월 13일 웨이브까지 이어진 단독 배너로, 이 웨이브에서 블랙골드 헌터 재개최가 스카우트 화면을 이어받았다(패널이 단순 배경 아트라 카드에는 픽업 스트립을 표시한다). SSR 확률 2배, 뽑기당 지정 인장 1장, 100회 뽑기 픽업 보증.",
      "eventToken": null
    },
    "sugimoto-arina-rate-up": {
      "name": "스기모토 아리나 픽업",
      "kind": "단독 픽업",
      "since": "2026년 9월 29일~10월 13일",
      "note": "루이 픽업과 같은 기간 2주간 함께 진행됐다. 모든 단독 배너와 동일한 구성: SSR 확률 2배, 뽑기당 지정 인장 1장, 100회 뽑기 픽업 보증.",
      "eventToken": null
    },
    "lunar-splendor": {
      "name": "번화한 유곽의 달빛",
      "kind": "듀얼 픽업",
      "since": "정식 출시, 2026년 9월 22일~11월 3일",
      "note": "정식 출시 기념 리미티드 배너다. 120회 뽑기 픽업 보증, ECoin 티켓 레인, 그리고 히지카타 치즈루의 겟카 나기나타와 신발 부품을 판매하는 교환 상점이 함께한다. 카드 아트는 genesys-adam.com의 공식 이벤트 공지 이미지이며, 인게임 아트 패널은 R18이라 위키에 싣지 않는다. 날짜는 같은 공식 공지 기준이다.",
      "eventToken": "달빛 엠블럼"
    },
    "heavens-door-jessica": {
      "name": "천국의 문: 제시카",
      "kind": "티켓 스카우트",
      "since": "데이터 유지형 베타 기간, 2026년 9월 17일부터",
      "note": "9월 17일 공식 공지에는 베타 빌드에서 진행된 천국의 문 특별 미션과 제시카 티켓 스카우트가 안내되어 있다. 그녀의 리미티드 뽑기 머신(아트 Draw_Bg_36)은 현재 클라이언트 테이블에 다시 설정되어 있다.",
      "eventToken": "【천국의 문】 스카우트 편지"
    },
    "heavens-door-connie": {
      "name": "천국의 문: 코니",
      "kind": "티켓 스카우트",
      "since": "클라이언트 테이블에 설정됨, 실제 개최는 아직 확인 안 됨",
      "note": "천국의 문 스카우트 두 번째 순번(아트 Draw_Bg_46)으로, 활동 파이프라인에서 제시카 뒤에 대기 중이다. 코니의 스킬 데이터는 9월 22일 테이블에서야 완성되었으며, 위키의 그녀의 평가 점수도 그때 다시 매겨졌다.",
      "eventToken": "【천국의 문】 스카우트 편지"
    },
    "war-and-music": {
      "name": "전쟁 속 페스티벌",
      "kind": "듀얼 픽업",
      "since": "클라이언트 테이블에 설정됨, 실제 개최는 아직 확인 안 됨",
      "note": "엘레나와 빅토리아의 듀얼 리미티드 배너(아트 패널 Draw_Bg_34_1과 _34_2)로, 매혹의 그림자 엠블럼 모으기 이벤트와 함께한다. 뽑기 머신은 활동 파이프라인에서 천국의 문 웨이브 뒤에 위치하며, 출시를 기다리던 중 10월 2일 테이블에서 픽업 두 캐릭터의 키트가 모두 재조정되었다.",
      "eventToken": "매혹의 그림자 엠블럼"
    },
    "lingering-echoes": {
      "name": "현혹의 선율",
      "kind": "듀얼 픽업",
      "since": "클라이언트 테이블에 설정됨, 실제 개최는 아직 확인 안 됨",
      "note": "다음 신규 캐릭터 웨이브다. 청음과 랑잠의 듀얼 리미티드 배너(아트 패널 Draw_Bg_40_1과 _40_2)가 뮤직 엠블럼 모으기 이벤트와 함께한다. 현재 활동 파이프라인의 마지막 순번이며, 두 캐릭터의 키트는 이미 테이블에 완성된 상태로 들어 있다.",
      "eventToken": "뮤직 엠블럼"
    },
    "solo-rotation-queue": {
      "name": "단독 픽업 대기열",
      "kind": "단독 픽업",
      "since": "클라이언트 테이블에 설정됨, 실제 개최는 아직 확인 안 됨",
      "note": "단독 뽑기 머신 3종(밀레나, 링링, 애나벨)이 현재 테이블에 이벤트 로테이션 뒤 순번으로 설정되어 있으며, 동일한 100회 뽑기 픽업 보증이 적용된다. 다운로드 1,000,000 돌파 기념 스카우트도 프리로드되어 있다.",
      "eventToken": null
    }
  }
};

// featured units without a wiki page yet: game-official localized names
const UNRELEASED_NAMES = {
  "qing-yin": "청음",
  "leng-zhen": "랑잠",
  "elena": "엘레나",
  "victoria": "빅토리아",
  "connie": "코니"
};
// training lists localized per banner (source lists use EN names)
const TRAINING_LOC = {
  "black-gold-hunter": [
    "벨"
  ],
  "ogino-rui-rate-up": [],
  "sugimoto-arina-rate-up": [],
  "lunar-splendor": [
    "코마치 사야카",
    "히지카타 치즈루"
  ],
  "heavens-door-jessica": [
    "제시카"
  ],
  "heavens-door-connie": [
    "코니"
  ],
  "war-and-music": [
    "엘레나",
    "빅토리아"
  ],
  "lingering-echoes": [
    "청음",
    "랑잠"
  ],
  "solo-rotation-queue": []
};

const STATUS_LABEL = {
  live: L.ui.statusLive,
  ended: L.ui.statusEnded,
  beta: L.ui.statusBeta,
  scheduled: L.ui.statusScheduled,
};

const SECTIONS = [
  { key: 'live', title: L.ui.secLive },
  { key: 'ended', title: L.ui.secEnded },
  { key: 'beta', title: L.ui.secBeta },
  { key: 'scheduled', title: L.ui.secScheduled },
];

const bySlug = Object.fromEntries(gsaCharactersKo.map(c => [c.slug, c]));

function charCard(slug) {
  const c = bySlug[slug];
  if (!c) {
    return { name: UNRELEASED_NAMES[slug] || slug, meta: L.ui.unreleased, icon: null, slug, unreleased: true };
  }
  const bits = [c.title, c.element?.name, c.job?.name].filter(Boolean);
  return { name: c.name, meta: bits.join(', '), icon: c.icon, slug, unreleased: false };
}
---

<GsaI18nLayout
  ui={ui}
  title="배너 히스토리"
  description="복호화된 게임 테이블을 기반으로 개최되었거나 개최 예정으로 로드된 모든 이벤트 배너를 픽업 캐릭터 및 피티와 함께 정리했다."
  gameTitle="배너 히스토리"
  breadcrumbItems={[{ name: ui.gameName, href: base }, { name: '배너 히스토리' }]}
>
  <section>
    <p class="gsa-banner-intro">{L.ui.intro}</p>

    {SECTIONS.map(sec => {
      const cards = GSA_BANNERS.filter(b => b.status === sec.key);
      return cards.length > 0 && (
        <fragment>
          <h2 class="gsa-banner-section-title">{sec.title}</h2>
          <div class="gsa-bn-list">
            {cards.map(b => {
              const loc = L.banners[b.slug] || {};
              return (
              <article class={`gsa-bn-card${b.status === 'live' ? ' gsa-bn-card-live' : ''}`}>
                <div class="gsa-bn-art">
                  {b.image
                    ? (
                      <div class="gsa-bn-art-imgs">
                        <img src={b.image} alt={`${loc.name} ${L.ui.bannerArtAlt}`} width="1920" height="1080" loading="lazy" decoding="async" />
                        {b.image2 && <img src={b.image2} alt={`${loc.name} ${L.ui.secondPanelAlt}`} width="1920" height="1080" loading="lazy" decoding="async" />}
                      </div>
                    )
                    : (
                      <div class="gsa-bn-art-none">
                        {b.featured.length > 0 && b.featured.every(slug => charCard(slug)?.icon)
                          ? b.featured.map(slug => {
                              const c = charCard(slug);
                              return <img class="gsa-bn-art-icon" src={c.icon} alt={c.name} width="110" height="110" loading="lazy" />;
                            })
                          : <span>{L.ui.noArt}</span>}
                      </div>
                    )}
                </div>
                <div class="gsa-bn-body">
                  <div class="gsa-bn-top">
                    <span class="gsa-bn-kind">{loc.kind}</span>
                    <span class={`gsa-bn-status gsa-bn-status-${b.status}`}>{STATUS_LABEL[b.status]}</span>
                    <span class="gsa-bn-since">{loc.since}</span>
                  </div>
                  <h3 class="gsa-bn-title">{loc.name}</h3>
                  <p class="gsa-bn-sub">{b.name}</p>
                  <div class="gsa-banner-featured">
                    {b.featured.map(slug => {
                      const c = charCard(slug);
                      if (!c || c.unreleased) {
                        return (
                          <span class="gsa-banner-char">
                            <span class="gsa-banner-char-thumb gsa-monogram">?</span>
                            <span>
                              <span class="gsa-banner-char-name">{c?.name ?? slug}</span>
                              <span class="gsa-banner-char-meta">{L.ui.unreleased}</span>
                            </span>
                          </span>
                        );
                      }
                      return (
                        <a class="gsa-banner-char" href={`${base}characters/${slug}/`}>
                          {c.icon
                            ? <img class="gsa-banner-char-thumb" src={c.icon} alt={c.name} width="44" height="44" loading="lazy" />
                            : <span class="gsa-banner-char-thumb gsa-monogram">{c.name?.[0]}</span>}
                          <span>
                            <span class="gsa-banner-char-name">{c.name}</span>
                            <span class="gsa-banner-char-meta">{c.meta}</span>
                          </span>
                        </a>
                      );
                    })}
                  </div>
                  <div class="gsa-banner-facts">
                    {b.pity && <span class="gsa-banner-fact"><b>{L.ui.pityLabel}</b> {b.pity}</span>}
                    {loc.eventToken && <span class="gsa-banner-fact"><b>{L.ui.eventTokenLabel}</b> {loc.eventToken}</span>}
                    {(TRAINING_LOC[b.slug] || []).length > 0 && <span class="gsa-banner-fact"><b>{L.ui.trainingLabel}</b> {TRAINING_LOC[b.slug].join(', ')}</span>}
                  </div>
                  <p class="gsa-bn-note">{loc.note}</p>
                </div>
              </article>
              );
            })}
          </div>
        </fragment>
      );
    })}
  </section>
</GsaI18nLayout>
